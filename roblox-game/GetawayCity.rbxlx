<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Getaway City: every tunable number lives here so you can balance the game
-- without touching gameplay code. Shared by server and client.

local Config = {}

Config.GameName = "Getaway City"
Config.DataStoreName = "GetawayCity_PlayerData_v1"
Config.LeaderboardStoreName = "GetawayCity_TopCash_v1"

---------------------------------------------------------------------------
-- Players
---------------------------------------------------------------------------
Config.StartingCash = 500
Config.WalkSpeed = 16
Config.JumpHeight = 7.2
Config.RespawnDelay = 4

-- Daily login reward: DailyReward * streak (streak capped at DailyStreakCap)
Config.DailyReward = 250
Config.DailyStreakCap = 7

---------------------------------------------------------------------------
-- Teams
---------------------------------------------------------------------------
Config.Teams = {
	Police = { Name = "Police", Color = BrickColor.new("Bright blue") },
	Criminal = { Name = "Criminals", Color = BrickColor.new("Really red") },
	Prisoner = { Name = "Prisoners", Color = BrickColor.new("Neon orange") },
}
-- Police may make up at most this share of the server (always at least 1 slot)
Config.MaxPoliceShare = 0.4

---------------------------------------------------------------------------
-- Robberies
-- Position = center of the building on the ground. Door is on the +Z side.
---------------------------------------------------------------------------
Config.Robberies = {
	{
		Id = "GasStation", Name = "Fuel Stop",
		Position = Vector3.new(-170, 0, -40), Size = Vector3.new(30, 14, 24),
		Color = Color3.fromRGB(235, 200, 90),
		Duration = 10, Payout = 350, Cooldown = 90, Xp = 30, MinLevel = 1,
	},
	{
		Id = "Jewelry", Name = "Sparkle Jewelers",
		Position = Vector3.new(160, 0, 100), Size = Vector3.new(40, 18, 32),
		Color = Color3.fromRGB(170, 120, 210),
		Duration = 20, Payout = 1200, Cooldown = 180, Xp = 80, MinLevel = 1,
	},
	{
		Id = "Bank", Name = "City Bank",
		Position = Vector3.new(0, 0, -60), Size = Vector3.new(60, 24, 44),
		Color = Color3.fromRGB(200, 190, 160),
		Duration = 30, Payout = 2000, Cooldown = 240, Xp = 120, MinLevel = 2,
	},
	{
		Id = "Museum", Name = "City Museum",
		Position = Vector3.new(-40, 0, 220), Size = Vector3.new(56, 26, 40),
		Color = Color3.fromRGB(150, 160, 175),
		Duration = 40, Payout = 3500, Cooldown = 300, Xp = 180, MinLevel = 4,
	},
}
-- After the first robber triggers the alarm, the store stays robbable for
-- Duration + AlarmGrace seconds, then closes for its Cooldown.
Config.AlarmGrace = 25
-- Bounty added = Payout * BountyPerPayout
Config.BountyPerPayout = 0.5
Config.MaxBag = 5000
Config.VipMaxBag = 10000

---------------------------------------------------------------------------
-- Police
---------------------------------------------------------------------------
Config.ArrestRange = 9
Config.ArrestBaseReward = 150
Config.ArrestBountyShare = 0.75 -- cop earns this share of the robber's bounty
Config.ArrestXp = 60
Config.TaserRange = 40
Config.TaserCooldown = 6
Config.TaserStun = 2.5

---------------------------------------------------------------------------
-- Criminals / Jail
---------------------------------------------------------------------------
Config.BoostSpeed = 30
Config.BoostDuration = 4
Config.BoostCooldown = 20
Config.JailTime = 60
Config.EscapeBounty = 150
Config.EscapeXp = 40
Config.VentTime = 8 -- seconds a prisoner must stay at the vent to escape

---------------------------------------------------------------------------
-- Key map locations (ground-level centers)
---------------------------------------------------------------------------
Config.Locations = {
	PoliceStation = Vector3.new(0, 0, -260),
	Jail = Vector3.new(260, 0, -260),
	Hideout = Vector3.new(-300, 0, 260),
	Dealership = Vector3.new(-300, 0, -300),
}
Config.MapSize = 900

---------------------------------------------------------------------------
-- Vehicles (speeds in studs/second; players walk at 16)
---------------------------------------------------------------------------
-- Style picks the body shape: Car, Hyper, Monster, Kart or Flyer.
-- Glow is the underglow color (looks amazing at night).
-- Fly = true makes it a flying car (E = up, Q = down).
Config.Vehicles = {
	-- Everyone (Hideout)
	Sedan = { Display = "Street Sedan", Price = 0, MaxSpeed = 70, TurnRate = 1.9, Style = "Car", Color = Color3.fromRGB(80, 85, 95), Glow = Color3.fromRGB(120, 160, 255) },
	Muscle = { Display = "Muscle Car", Price = 4000, MaxSpeed = 95, TurnRate = 1.8, Style = "Car", Color = Color3.fromRGB(200, 60, 40), Glow = Color3.fromRGB(255, 120, 40) },
	Supercar = { Display = "Supercar", Price = 15000, MaxSpeed = 125, TurnRate = 1.7, Style = "Hyper", Color = Color3.fromRGB(250, 200, 30), Glow = Color3.fromRGB(255, 230, 80) },
	-- Insane Motors dealership
	Monster = { Display = "Monster Truck", Price = 20000, MaxSpeed = 95, TurnRate = 1.6, Style = "Monster", Color = Color3.fromRGB(60, 200, 80), Glow = Color3.fromRGB(80, 255, 120) },
	Rocket = { Display = "Rocket Kart", Price = 30000, MaxSpeed = 150, TurnRate = 2.5, Style = "Kart", Color = Color3.fromRGB(255, 90, 20), Glow = Color3.fromRGB(255, 60, 0), AlwaysFlames = true },
	Hyperion = { Display = "Hyperion X", Price = 50000, MaxSpeed = 180, TurnRate = 1.6, Style = "Hyper", Color = Color3.fromRGB(150, 40, 255), Glow = Color3.fromRGB(200, 80, 255) },
	SkyRider = { Display = "SkyRider (flies!)", Price = 75000, MaxSpeed = 120, TurnRate = 1.8, Style = "Flyer", Color = Color3.fromRGB(30, 200, 230), Glow = Color3.fromRGB(0, 255, 255), Fly = true },
	-- Police only (Police Station)
	Cruiser = { Display = "Police Cruiser", Price = 0, MaxSpeed = 95, TurnRate = 1.9, Style = "Car", Color = Color3.fromRGB(30, 50, 120), Glow = Color3.fromRGB(60, 100, 255), Team = "Police", Police = true },
	Interceptor = { Display = "Police Interceptor", Price = 8000, MaxSpeed = 125, TurnRate = 1.8, Style = "Car", Color = Color3.fromRGB(20, 20, 25), Glow = Color3.fromRGB(60, 100, 255), Team = "Police", Police = true },
	Thunder = { Display = "Thunder Pursuit", Price = 40000, MaxSpeed = 175, TurnRate = 1.7, Style = "Hyper", Color = Color3.fromRGB(15, 25, 60), Glow = Color3.fromRGB(80, 140, 255), Team = "Police", Police = true },
	SkyPatrol = { Display = "Sky Patrol (flies!)", Price = 60000, MaxSpeed = 120, TurnRate = 1.8, Style = "Flyer", Color = Color3.fromRGB(240, 240, 250), Glow = Color3.fromRGB(80, 140, 255), Team = "Police", Police = true, Fly = true },
}

-- Nitro: hold F (or the NITRO button). Fuel drains while used, then recharges.
Config.Nitro = { Multiplier = 1.6, Duration = 3, Recharge = 7 }
Config.BoostPadMultiplier = 1.8
Config.FlySpeedVertical = 45
Config.FlyMaxAltitude = 300

-- Airtime off ramps pays cash: StuntCashPerSecond per second in the air
Config.StuntMinAirtime = 0.7
Config.StuntCashPerSecond = 80
Config.StuntMaxCash = 400

-- Police spike strips slow criminal cars that drive over them
Config.SpikeCooldown = 12
Config.SpikeLifetime = 25
Config.SpikeSlowdown = 0.35 -- car top speed multiplier while spiked
Config.SpikeDuration = 6

-- Cash drops fall from the sky; first player to reach the crate wins
Config.CashDrop = { Interval = 150, FallTime = 12, Lifetime = 90, Min = 400, Max = 1200 }

-- Full day/night cycle length (neon and underglow shine at night)
Config.DayLengthMinutes = 12

---------------------------------------------------------------------------
-- Monetization. Create these in the Creator Dashboard, then paste the IDs.
-- An ID of 0 means "not set up yet" and the button is hidden/disabled.
---------------------------------------------------------------------------
Config.GamePasses = {
	VIP = 0, -- 2x robbery & arrest cash, bigger bag
}
Config.VipMultiplier = 2
Config.CashProducts = {
	{ Id = 0, Cash = 2500, Label = "$2,500" },
	{ Id = 0, Cash = 10000, Label = "$10,000" },
	{ Id = 0, Cash = 35000, Label = "$35,000" },
}

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000013"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000005"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Getaway City - server entry point. Builds the map and starts every service.
local Services = script.Parent:WaitForChild("Services")

local Remotes = require(Services.Remotes)
local MapBuilder = require(Services.MapBuilder)
local DataService = require(Services.DataService)
local ShopService = require(Services.ShopService)
local TeamService = require(Services.TeamService)
local JailService = require(Services.JailService)
local ArrestService = require(Services.ArrestService)
local ToolService = require(Services.ToolService)
local RobberyService = require(Services.RobberyService)
local VehicleService = require(Services.VehicleService)
local FunService = require(Services.FunService)

local _ = Remotes -- created on require so clients can find them immediately

local map = MapBuilder.Build()

DataService.Init(map)
ShopService.Init()
TeamService.Init(map)
JailService.Init(map)
ArrestService.Init()
RobberyService.Init(map)
VehicleService.Init(map)
FunService.Init(map)

TeamService.OnCharacterSpawned(ToolService.GiveTools)

print("[Getaway City] Server ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">ArrestService</string><ProtectedString name="Source"><![CDATA[-- Police actions: handcuff arrests and taser stuns. All checks are server-side.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local TeamService = require(script.Parent.TeamService)
local JailService = require(script.Parent.JailService)

local ArrestService = {}

local lastCuff = {}
local lastTase = {}

local function rootOf(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart"), humanoid
end

function ArrestService.IsWanted(player)
	return player.Team == TeamService.Teams.Criminal
		and ((player:GetAttribute("Bounty") or 0) > 0 or (player:GetAttribute("Bag") or 0) > 0)
end

-- Nearest wanted criminal within range; requireFacing limits to a cone in front of the cop
local function findTarget(cop, range, requireFacing)
	local copRoot = rootOf(cop)
	if not copRoot then
		return nil
	end
	local best, bestDist = nil, range
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= cop and ArrestService.IsWanted(player) then
			local root = rootOf(player)
			if root then
				local offset = root.Position - copRoot.Position
				local dist = offset.Magnitude
				local facingOk = true
				if requireFacing and dist > 4 then
					facingOk = copRoot.CFrame.LookVector:Dot(offset.Unit) > 0.6
				end
				if dist <= bestDist and facingOk then
					best, bestDist = player, dist
				end
			end
		end
	end
	return best
end

function ArrestService.TryArrest(cop)
	if cop.Team ~= TeamService.Teams.Police then
		return
	end
	local now = os.clock()
	if lastCuff[cop] and now - lastCuff[cop] < 0.5 then
		return
	end
	lastCuff[cop] = now

	local target = findTarget(cop, Config.ArrestRange, false)
	if not target then
		return
	end
	local bounty = target:GetAttribute("Bounty") or 0
	local reward = (Config.ArrestBaseReward + math.floor(bounty * Config.ArrestBountyShare)) * DataService.Multiplier(cop)
	DataService.AddCash(cop, reward)
	DataService.AddXp(cop, Config.ArrestXp)
	DataService.Increment(cop, "Arrests")

	target:SetAttribute("Bag", 0)
	target:SetAttribute("Bounty", 0)
	JailService.Jail(target)

	Remotes.Notify(cop, ("You arrested %s and earned $%d!"):format(target.Name, reward), "good")
	Remotes.NotifyAll(("%s was arrested by Officer %s"):format(target.Name, cop.Name), "info")
end

local function zap(fromPos, toPos)
	local dist = (toPos - fromPos).Magnitude
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(120, 200, 255)
	beam.Size = Vector3.new(0.2, 0.2, dist)
	beam.CFrame = CFrame.lookAt(fromPos, toPos) * CFrame.new(0, 0, -dist / 2)
	beam.Parent = workspace
	Debris:AddItem(beam, 0.15)
end

function ArrestService.TryTase(cop)
	if cop.Team ~= TeamService.Teams.Police then
		return
	end
	local now = os.clock()
	if lastTase[cop] and now - lastTase[cop] < Config.TaserCooldown then
		return
	end
	local target = findTarget(cop, Config.TaserRange, true)
	if not target then
		return
	end
	lastTase[cop] = now

	local copRoot = rootOf(cop)
	local root, humanoid = rootOf(target)
	if not copRoot or not root then
		return
	end
	zap(copRoot.Position, root.Position)

	-- Knock them out of vehicles and freeze them briefly
	humanoid.Sit = false
	local stunnedUntil = workspace:GetServerTimeNow() + Config.TaserStun
	target:SetAttribute("StunnedUntil", stunnedUntil)
	humanoid.WalkSpeed = 0
	humanoid.JumpHeight = 0
	Remotes.Notify(target, "You've been TASED!", "bad")
	task.delay(Config.TaserStun, function()
		if humanoid.Parent and target:GetAttribute("StunnedUntil") == stunnedUntil then
			humanoid.WalkSpeed = Config.WalkSpeed
			humanoid.JumpHeight = Config.JumpHeight
			target:SetAttribute("StunnedUntil", nil)
		end
	end)
end

---------------------------------------------------------------------------
-- Spike strips: thrown in front of the cop, they pop the tires of any
-- criminal-driven car that rolls over them (big slowdown, no nitro).
---------------------------------------------------------------------------
local strips = {} -- [cop] = { Part = Part, Expires = number }
local lastSpike = {}

function ArrestService.PlaceSpikes(cop)
	if cop.Team ~= TeamService.Teams.Police then
		return
	end
	local now = os.clock()
	if lastSpike[cop] and now - lastSpike[cop] < Config.SpikeCooldown then
		Remotes.Notify(cop, ("Spike strip ready in %ds"):format(math.ceil(Config.SpikeCooldown - (now - lastSpike[cop]))), "info")
		return
	end
	local root = rootOf(cop)
	if not root then
		return
	end
	lastSpike[cop] = now
	if strips[cop] then
		strips[cop].Part:Destroy()
	end

	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.zAxis
	local position = Vector3.new(root.Position.X, 0.2, root.Position.Z) + flat * 10

	local strip = Instance.new("Part")
	strip.Name = "SpikeStrip"
	strip.Anchored = true
	strip.CanCollide = false
	strip.Size = Vector3.new(26, 0.4, 3)
	strip.CFrame = CFrame.lookAt(position, position + flat)
	strip.Color = Color3.fromRGB(45, 45, 50)
	strip.Material = Enum.Material.DiamondPlate
	strip.Parent = workspace
	for i = -6, 6 do
		local spike = Instance.new("Part")
		spike.Name = "Spike"
		spike.Anchored = true
		spike.CanCollide = false
		spike.Size = Vector3.new(0.6, 0.8, 0.6)
		spike.Color = Color3.fromRGB(255, 50, 50)
		spike.Material = Enum.Material.Neon
		spike.CFrame = strip.CFrame * CFrame.new(i * 2, 0.5, 0)
		spike.Parent = strip
	end
	strips[cop] = { Part = strip, Expires = now + Config.SpikeLifetime }
	Remotes.Notify(cop, "Spike strip deployed!", "info")
end

local function overStrip(strip, position)
	local localPos = strip.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= strip.Size.X / 2 + 2 and math.abs(localPos.Z) <= 10 and localPos.Y < 10
end

local function tickSpikes()
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for cop, info in pairs(strips) do
		if now > info.Expires or not cop.Parent or not info.Part.Parent then
			info.Part:Destroy()
			strips[cop] = nil
		else
			for _, car in ipairs(workspace:GetChildren()) do
				local body = car:IsA("Model") and car:GetAttribute("VehicleKey") and car.PrimaryPart
				local seat = body and car:FindFirstChild("DriveSeat")
				local occupant = seat and seat.Occupant
				local driver = occupant and Players:GetPlayerFromCharacter(occupant.Parent)
				if driver and driver.Team == TeamService.Teams.Criminal
					and (body:GetAttribute("SpikedUntil") or 0) < serverNow
					and overStrip(info.Part, body.Position) then
					body:SetAttribute("SpikedUntil", serverNow + Config.SpikeDuration)
					for _, d in ipairs(car:GetDescendants()) do
						if d:IsA("Fire") and d.Name == "NitroFire" then
							d.Enabled = false
						end
					end
					Remotes.Notify(driver, "POP! Your tires got spiked!", "bad")
					Remotes.Notify(cop, ("You spiked %s's car!"):format(driver.Name), "good")
				end
			end
		end
	end
end

function ArrestService.Init()
	Players.PlayerRemoving:Connect(function(player)
		lastCuff[player] = nil
		lastTase[player] = nil
		lastSpike[player] = nil
		if strips[player] then
			strips[player].Part:Destroy()
			strips[player] = nil
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.1)
			tickSpikes()
		end
	end)
end

return ArrestService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Player data: loading/saving with DataStores, leaderstats, XP/levels,
-- daily rewards and the global top-cash leaderboard.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)

local DataService = {}

local store, board
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
	board = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
end)

local profiles = {} -- [Player] = { Data = table, CanSave = bool, Vip = bool }

local function defaultData()
	return {
		Cash = Config.StartingCash,
		Xp = 0,
		Arrests = 0,
		Robberies = 0,
		Escapes = 0,
		OwnedVehicles = { Sedan = true, Cruiser = true },
		LastDaily = 0,
		DailyStreak = 0,
		Receipts = {},
	}
end

local function reconcile(data)
	local defaults = defaultData()
	for key, value in pairs(defaults) do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

function DataService.LevelFromXp(xp)
	return math.floor(math.sqrt(xp / 100)) + 1
end

local function key(player)
	return "u_" .. player.UserId
end

local function refreshStats(player)
	local profile = profiles[player]
	local stats = player:FindFirstChild("leaderstats")
	if not profile or not stats then
		return
	end
	stats.Cash.Value = profile.Data.Cash
	stats.Level.Value = DataService.LevelFromXp(profile.Data.Xp)
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.GetLevel(player)
	local profile = profiles[player]
	return profile and DataService.LevelFromXp(profile.Data.Xp) or 1
end

function DataService.IsVip(player)
	local profile = profiles[player]
	return profile ~= nil and profile.Vip
end

function DataService.SetVip(player, isVip)
	local profile = profiles[player]
	if profile then
		profile.Vip = isVip
		player:SetAttribute("VIP", isVip)
	end
end

function DataService.Multiplier(player)
	return DataService.IsVip(player) and Config.VipMultiplier or 1
end

function DataService.MaxBag(player)
	return DataService.IsVip(player) and Config.VipMaxBag or Config.MaxBag
end

function DataService.AddCash(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.Data.Cash = math.max(0, profile.Data.Cash + math.floor(amount))
	refreshStats(player)
end

function DataService.SpendCash(player, amount)
	local profile = profiles[player]
	if not profile or profile.Data.Cash < amount then
		return false
	end
	profile.Data.Cash = profile.Data.Cash - amount
	refreshStats(player)
	return true
end

function DataService.AddXp(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	local before = DataService.LevelFromXp(profile.Data.Xp)
	profile.Data.Xp = profile.Data.Xp + amount
	local after = DataService.LevelFromXp(profile.Data.Xp)
	refreshStats(player)
	if after > before then
		Remotes.Notify(player, "LEVEL UP! You are now level " .. after, "good")
	end
end

function DataService.Increment(player, field, amount)
	local profile = profiles[player]
	if profile and type(profile.Data[field]) == "number" then
		profile.Data[field] = profile.Data[field] + (amount or 1)
	end
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	local ok = pcall(function()
		store:SetAsync(key(player), profile.Data)
	end)
	if ok and board then
		pcall(function()
			board:SetAsync(tostring(player.UserId), profile.Data.Cash)
		end)
	end
	return ok
end

local function giveDaily(player)
	local profile = profiles[player]
	local now = os.time()
	local data = profile.Data
	if now - data.LastDaily < 86400 then
		return
	end
	if now - data.LastDaily < 172800 then
		data.DailyStreak = math.min(data.DailyStreak + 1, Config.DailyStreakCap)
	else
		data.DailyStreak = 1
	end
	data.LastDaily = now
	local reward = Config.DailyReward * data.DailyStreak
	DataService.AddCash(player, reward)
	task.delay(6, function()
		if player.Parent then
			Remotes.Notify(player, ("Daily reward: $%d (day %d streak). Come back tomorrow for more!"):format(reward, data.DailyStreak), "good")
		end
	end)
end

local function onPlayerAdded(player)
	local data, success = nil, false
	if store then
		for attempt = 1, 3 do
			success = pcall(function()
				data = store:GetAsync(key(player))
			end)
			if success then
				break
			end
			task.wait(attempt * 2)
		end
	end
	if not player.Parent then
		return
	end
	if type(data) ~= "table" then
		data = defaultData()
	end
	profiles[player] = { Data = reconcile(data), CanSave = success, Vip = false }
	if not success then
		warn("[DataService] Could not load data for " .. player.Name .. "; progress will NOT be saved this session.")
	end

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Parent = stats
	stats.Parent = player

	player:SetAttribute("Bag", 0)
	player:SetAttribute("Bounty", 0)
	refreshStats(player)
	giveDaily(player)
	player:SetAttribute("DataLoaded", true)
end

local function onPlayerRemoving(player)
	DataService.Save(player)
	profiles[player] = nil
end

-- Waits until a player's profile exists (or they leave)
function DataService.WaitForProfile(player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	return profiles[player]
end

---------------------------------------------------------------------------
-- Global leaderboard (top cash), drawn on a board in the hideout
---------------------------------------------------------------------------
local nameCache = {}
local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function updateBoard(list)
	if not board or not list then
		return
	end
	local ok, page = pcall(function()
		return board:GetSortedAsync(false, 10):GetCurrentPage()
	end)
	if not ok then
		return
	end
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for rank, entry in ipairs(page) do
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 40)
		label.BackgroundTransparency = 1
		label.TextColor3 = rank == 1 and Color3.fromRGB(255, 215, 80) or Color3.new(1, 1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.LayoutOrder = rank
		label.Text = ("%d. %s  -  $%d"):format(rank, nameFor(tonumber(entry.key)), entry.value)
		label.Parent = list
	end
end

function DataService.Init(map)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	-- Autosave + leaderboard refresh
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in ipairs(Players:GetPlayers()) do
				DataService.Save(player)
			end
			updateBoard(map.LeaderboardList)
		end
	end)
	task.delay(5, function()
		updateBoard(map.LeaderboardList)
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending = pending + 1
			task.spawn(function()
				DataService.Save(player)
				pending = pending - 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">FunService</string><ProtectedString name="Source"><![CDATA[-- The extra-fun systems:
--   * Stunt cash: big air off ramps pays out (measured on the server)
--   * Cash drops: a crate parachutes into the city; first player to reach it wins
--   * Day/night cycle: neon, street lamps and car underglow shine at night
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local VehicleService = require(script.Parent.VehicleService)

local FunService = {}

---------------------------------------------------------------------------
-- Stunts
---------------------------------------------------------------------------
local air = {} -- [car Model] = { Start = clock, Driver = Player }

local function driverOf(car)
	local seat = car:FindFirstChild("DriveSeat")
	local occupant = seat and seat.Occupant
	return occupant and Players:GetPlayerFromCharacter(occupant.Parent)
end

local function tickStunts()
	local now = os.clock()
	for _, car in pairs(VehicleService.GetCars()) do
		local body = car.PrimaryPart
		if body and car.Parent and not car:GetAttribute("Fly") then
			local height = body.Position.Y - (car:GetAttribute("RideHeight") or 1)
			local state = air[car]
			if height > 4 then
				if not state then
					air[car] = { Start = now, Driver = driverOf(car) }
				end
			elseif state and height < 1.5 then
				air[car] = nil
				local airtime = now - state.Start
				local driver = state.Driver
				if driver and driver.Parent and driverOf(car) == driver and airtime >= Config.StuntMinAirtime then
					local cash = math.min(Config.StuntMaxCash, math.floor(airtime * Config.StuntCashPerSecond)) * DataService.Multiplier(driver)
					DataService.AddCash(driver, cash)
					local label = airtime >= 2 and "INSANE STUNT!" or (airtime >= 1.3 and "BIG AIR!" or "STUNT!")
					Remotes.Notify(driver, ("%s %.1fs airtime  +$%d"):format(label, airtime, cash), "good")
				end
			end
		end
	end
	for car in pairs(air) do
		if not car.Parent then
			air[car] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Cash drops
---------------------------------------------------------------------------
local landmarks = {}
local dropSpots = {}

local function nearestLandmark(position)
	local bestName, bestDist = "the city", math.huge
	for _, mark in ipairs(landmarks) do
		local d = (mark.Position - position).Magnitude
		if d < bestDist then
			bestName, bestDist = mark.Name, d
		end
	end
	return bestName
end

local function spawnDrop()
	local spot = dropSpots[math.random(1, #dropSpots)] + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
	local reward = math.random(Config.CashDrop.Min, Config.CashDrop.Max)

	local crate = Instance.new("Part")
	crate.Name = "CashDrop"
	crate.Size = Vector3.new(5, 5, 5)
	crate.Anchored = true
	crate.CanCollide = false
	crate.Material = Enum.Material.Neon
	crate.Color = Color3.fromRGB(255, 210, 60)
	crate.CFrame = CFrame.new(spot + Vector3.new(0, 220, 0))
	crate.Parent = workspace

	local chute = Instance.new("Part")
	chute.Name = "Parachute"
	chute.Size = Vector3.new(16, 1, 16)
	chute.Anchored = true
	chute.CanCollide = false
	chute.Color = Color3.fromRGB(240, 60, 60)
	chute.Material = Enum.Material.Fabric
	chute.CFrame = crate.CFrame * CFrame.new(0, 12, 0)
	chute.Parent = crate

	local beacon = Instance.new("PointLight")
	beacon.Range = 30
	beacon.Brightness = 4
	beacon.Color = Color3.fromRGB(255, 210, 60)
	beacon.Parent = crate

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 120, 0, 40)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 3000
	gui.Parent = crate
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = "$" .. reward
	text.TextColor3 = Color3.fromRGB(255, 220, 80)
	text.TextStrokeTransparency = 0
	text.Font = Enum.Font.GothamBlack
	text.TextScaled = true
	text.Parent = gui

	local landing = CFrame.new(spot + Vector3.new(0, 2.5, 0))
	local info = TweenInfo.new(Config.CashDrop.FallTime, Enum.EasingStyle.Linear)
	TweenService:Create(crate, info, { CFrame = landing }):Play()
	TweenService:Create(chute, info, { CFrame = landing * CFrame.new(0, 12, 0) }):Play()
	task.delay(Config.CashDrop.FallTime, function()
		if chute.Parent then
			chute:Destroy()
		end
	end)

	Remotes.NotifyAll(("CASH DROP! $%d is falling near %s. Go go go!"):format(reward, nearestLandmark(spot)), "alarm")

	local expires = os.clock() + Config.CashDrop.FallTime + Config.CashDrop.Lifetime
	task.spawn(function()
		while crate.Parent and os.clock() < expires do
			task.wait(0.2)
			if crate.Position.Y < 14 then
				for _, player in ipairs(Players:GetPlayers()) do
					local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - crate.Position).Magnitude < 10 then
						local amount = reward * DataService.Multiplier(player)
						DataService.AddCash(player, amount)
						Remotes.NotifyAll(("%s grabbed the cash drop (+$%d)!"):format(player.Name, amount), "good")
						crate:Destroy()
						return
					end
				end
			end
		end
		if crate.Parent then
			crate:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function FunService.Init(map)
	local L = Config.Locations
	landmarks = {
		{ Name = "the Police Station", Position = L.PoliceStation },
		{ Name = "the Jail", Position = L.Jail },
		{ Name = "the Hideout", Position = L.Hideout },
		{ Name = "Insane Motors", Position = L.Dealership },
	}
	for _, rob in ipairs(Config.Robberies) do
		table.insert(landmarks, { Name = rob.Name, Position = rob.Position })
	end
	dropSpots = map.DropSpots

	-- Stunt tracking
	task.spawn(function()
		while true do
			task.wait(0.1)
			tickStunts()
		end
	end)

	-- Cash drops
	task.spawn(function()
		while true do
			task.wait(Config.CashDrop.Interval)
			if #Players:GetPlayers() > 0 then
				spawnDrop()
			end
		end
	end)

	-- Day/night: start at golden hour so new players see the neon kick in
	Lighting.ClockTime = 16.5
	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	task.spawn(function()
		while true do
			local dt = task.wait(0.5)
			Lighting.ClockTime = (Lighting.ClockTime + dt * hoursPerSecond) % 24
		end
	end)
end

return FunService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">JailService</string><ProtectedString name="Source"><![CDATA[-- Jail time, automatic release and secret-vent breakouts.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local TeamService = require(script.Parent.TeamService)

local JailService = {}

local ventProgress = {}

function JailService.Jail(player)
	player:SetAttribute("RobName", nil)
	player:SetAttribute("RobProgress", nil)
	player:SetAttribute("JailRelease", workspace:GetServerTimeNow() + Config.JailTime)
	TeamService.SetTeam(player, "Prisoner", true)
	Remotes.Notify(player, ("You've been arrested! Serve %ds... or find a way out."):format(Config.JailTime), "bad")
end

local function release(player)
	player:SetAttribute("JailRelease", nil)
	TeamService.SetTeam(player, "Criminal", true)
	Remotes.Notify(player, "You served your time. Back to the Hideout!", "info")
end

local function escape(player, map)
	player:SetAttribute("JailRelease", nil)
	TeamService.SetTeam(player, "Criminal", false)
	player:SetAttribute("Bounty", (player:GetAttribute("Bounty") or 0) + Config.EscapeBounty)
	DataService.Increment(player, "Escapes")
	DataService.AddXp(player, Config.EscapeXp)
	if player.Character then
		player.Character:PivotTo(map.EscapeExit)
	end
	Remotes.Notify(player, "You crawled through the vent and ESCAPED! Get out of here!", "good")
	Remotes.NotifyTeam(TeamService.Teams.Police, player.Name .. " has escaped from jail!", "alarm")
end

function JailService.Init(map)
	local prisonerTeam = TeamService.Teams.Prisoner
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = workspace:GetServerTimeNow()
			for _, player in ipairs(prisonerTeam:GetPlayers()) do
				local releaseAt = player:GetAttribute("JailRelease")
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if not releaseAt or now >= releaseAt then
					ventProgress[player] = nil
					player:SetAttribute("RobName", nil)
					player:SetAttribute("RobProgress", nil)
					release(player)
				elseif root and (root.Position - map.Vent.Position).Magnitude < 6 then
					-- Stay at the vent long enough to unscrew it
					local seconds = (ventProgress[player] or 0) + 0.5
					ventProgress[player] = seconds
					player:SetAttribute("RobName", "the vent cover")
					player:SetAttribute("RobProgress", math.clamp(seconds / Config.VentTime, 0, 1))
					if seconds >= Config.VentTime then
						ventProgress[player] = nil
						player:SetAttribute("RobName", nil)
						player:SetAttribute("RobProgress", nil)
						escape(player, map)
					end
				elseif ventProgress[player] then
					ventProgress[player] = nil
					player:SetAttribute("RobName", nil)
					player:SetAttribute("RobProgress", nil)
				end
			end
		end
	end)

	-- Players who leave while jailed come back as criminals (jail is per-session)
	Players.PlayerRemoving:Connect(function(player)
		ventProgress[player] = nil
		player:SetAttribute("JailRelease", nil)
	end)
end

return JailService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds the whole city from code so the game works in an empty place.
-- Feel free to replace any of this with a hand-built map later: the rest of
-- the game only needs the markers returned by MapBuilder.Build().
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

-- Foot of the one-way mega ramp (beside the south road, launching east)
MapBuilder.MegaRampStart = Vector3.new(-300, 0, -118)

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Parent" then
			p[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

-- Flat decoration lying on the ground. Not collidable, so cars glide over it.
local function decal(parent, name, center, sizeX, sizeZ, color, material)
	return part({
		Parent = parent, Name = name,
		Size = Vector3.new(sizeX, 0.2, sizeZ),
		Position = center + Vector3.new(0, 0.05, 0),
		Color = color, Material = material or Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
end

-- Box building with a doorway on the +Z side (doorWidth 0 = solid walls)
local function building(parent, name, center, size, color, doorWidth, wallMaterial)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local t = 2
	local h = size.Y
	local cx, cz = center.X, center.Z
	local mat = wallMaterial or Enum.Material.Concrete

	local function wall(n, s, pos)
		return part({ Parent = model, Name = n, Size = s, Position = pos, Color = color, Material = mat })
	end

	decal(model, "Floor", center, size.X, size.Z, Color3.fromRGB(120, 115, 110), Enum.Material.Slate)
	wall("Back", Vector3.new(size.X, h, t), Vector3.new(cx, h / 2, cz - size.Z / 2 + t / 2))
	wall("Left", Vector3.new(t, h, size.Z), Vector3.new(cx - size.X / 2 + t / 2, h / 2, cz))
	wall("Right", Vector3.new(t, h, size.Z), Vector3.new(cx + size.X / 2 - t / 2, h / 2, cz))
	local frontZ = cz + size.Z / 2 - t / 2
	if doorWidth and doorWidth > 0 then
		local seg = (size.X - doorWidth) / 2
		wall("FrontL", Vector3.new(seg, h, t), Vector3.new(cx - size.X / 2 + seg / 2, h / 2, frontZ))
		wall("FrontR", Vector3.new(seg, h, t), Vector3.new(cx + size.X / 2 - seg / 2, h / 2, frontZ))
		local doorH = math.min(12, h - 2)
		wall("Lintel", Vector3.new(doorWidth, h - doorH, t), Vector3.new(cx, doorH + (h - doorH) / 2, frontZ))
	else
		wall("Front", Vector3.new(size.X, h, t), Vector3.new(cx, h / 2, frontZ))
	end
	part({
		Parent = model, Name = "Roof", Size = Vector3.new(size.X, 1, size.Z),
		Position = Vector3.new(cx, h + 0.5, cz), Color = color:Lerp(Color3.new(0, 0, 0), 0.3), Material = mat,
	})
	return model
end

-- Big floating sign above a building; returns the TextLabel so it can be updated
local function sign(parent, position, text, color)
	local anchor = part({
		Parent = parent, Name = "SignAnchor", Size = Vector3.new(1, 1, 1),
		Position = position, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(28, 0, 6, 0)
	gui.MaxDistance = 600
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 0.35
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.2, 0)
	corner.Parent = label
	return label
end

local function vehiclePad(parent, position, yaw, vehicleKey, pads)
	local def = Config.Vehicles[vehicleKey]
	local pad = part({
		Parent = parent, Name = "Pad_" .. vehicleKey,
		Size = Vector3.new(14, 0.2, 22),
		CFrame = CFrame.new(position + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, math.rad(yaw), 0),
		Color = def.Color, Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false,
	})
	local kiosk = part({
		Parent = parent, Name = "Kiosk_" .. vehicleKey, Size = Vector3.new(3, 5, 3),
		CFrame = pad.CFrame * CFrame.new(9, 2.5, 0), Color = Color3.fromRGB(40, 40, 45),
	})
	table.insert(pads, { Pad = pad, Kiosk = kiosk, VehicleKey = vehicleKey })
end

local function tree(parent, position)
	part({
		Parent = parent, Name = "Trunk", Size = Vector3.new(2, 10, 2), Position = position + Vector3.new(0, 5, 0),
		Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Wood,
	})
	local leaves = part({
		Parent = parent, Name = "Leaves", Size = Vector3.new(10, 10, 10), Position = position + Vector3.new(0, 13, 0),
		Color = Color3.fromRGB(60, 140, 60), Material = Enum.Material.Grass,
	})
	leaves.Shape = Enum.PartType.Ball
end


-- Tilted slab whose top surface starts at ground level and rises along `dir`
local RAMP_WIDTH = 30
local function rampSlab(parent, footCenter, dir, length, angleDeg, color)
	local theta = math.rad(angleDeg)
	local thickness = 2
	local yaw = math.atan2(dir.X, dir.Z)
	local centerHeight = (length / 2) * math.sin(theta) - (thickness / 2) * math.cos(theta)
	local horizontal = (length / 2) * math.cos(theta)
	local center = footCenter + dir * horizontal + Vector3.new(0, centerHeight, 0)
	return part({
		Parent = parent, Name = "Ramp", Size = Vector3.new(RAMP_WIDTH, thickness, length),
		CFrame = CFrame.new(center) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-theta, 0, 0),
		Color = color, Material = Enum.Material.DiamondPlate,
	})
end

-- Two slabs back to back: a jump hump you can hit from either direction
local function hump(parent, center, alongX)
	local dir = alongX and Vector3.xAxis or Vector3.zAxis
	local length, angle = 26, 24
	local run = length * math.cos(math.rad(angle))
	rampSlab(parent, center - dir * run, dir, length, angle, Color3.fromRGB(255, 170, 30))
	rampSlab(parent, center + dir * run, -dir, length, angle, Color3.fromRGB(255, 170, 30))
end

local function boostPad(parent, center, alongX)
	return part({
		Parent = parent, Name = "BoostPad",
		Size = alongX and Vector3.new(20, 0.2, 14) or Vector3.new(14, 0.2, 20),
		Position = center + Vector3.new(0, 0.12, 0),
		Color = Color3.fromRGB(0, 230, 255), Material = Enum.Material.Neon, Transparency = 0.15, CanCollide = false,
	})
end

local function lamp(parent, position)
	part({
		Parent = parent, Name = "LampPost", Size = Vector3.new(0.8, 16, 0.8), Position = position + Vector3.new(0, 8, 0),
		Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal,
	})
	local head = part({
		Parent = parent, Name = "LampHead", Size = Vector3.new(2.4, 0.8, 2.4), Position = position + Vector3.new(0, 16.4, 0),
		Color = Color3.fromRGB(255, 230, 170), Material = Enum.Material.Neon, CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Range = 40
	light.Brightness = 1.4
	light.Color = Color3.fromRGB(255, 220, 160)
	light.Parent = head
end

function MapBuilder.Build()
	-- Remove the default Studio template parts so they don't clash with the city
	for _, name in ipairs({ "Baseplate", "SpawnLocation" }) do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end

	local existing = workspace:FindFirstChild("City")
	if existing then
		existing:Destroy()
	end
	local city = Instance.new("Folder")
	city.Name = "City"
	city.Parent = workspace

	local map = { Spawns = {}, RobZones = {}, Signs = {}, VehiclePads = {} }
	local L = Config.Locations
	local half = Config.MapSize / 2

	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
	if not Lighting:FindFirstChild("CityBloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "CityBloom"
		bloom.Intensity = 0.8
		bloom.Size = 30
		bloom.Threshold = 0.9
		bloom.Parent = Lighting
		local color = Instance.new("ColorCorrectionEffect")
		color.Name = "CityColor"
		color.Saturation = 0.15
		color.Contrast = 0.08
		color.Parent = Lighting
	end

	-- Ground + invisible border walls
	part({
		Parent = city, Name = "Ground", Size = Vector3.new(Config.MapSize, 2, Config.MapSize),
		Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(90, 140, 75), Material = Enum.Material.Grass,
	})
	for _, info in ipairs({
		{ Vector3.new(Config.MapSize, 80, 4), Vector3.new(0, 40, half) },
		{ Vector3.new(Config.MapSize, 80, 4), Vector3.new(0, 40, -half) },
		{ Vector3.new(4, 80, Config.MapSize), Vector3.new(half, 40, 0) },
		{ Vector3.new(4, 80, Config.MapSize), Vector3.new(-half, 40, 0) },
	}) do
		part({ Parent = city, Name = "Border", Size = info[1], Position = info[2], Transparency = 1 })
	end

	-- Roads (visual only)
	local roads = Instance.new("Folder")
	roads.Name = "Roads"
	roads.Parent = city
	local asphalt = Color3.fromRGB(45, 45, 50)
	local roadXs = { -120, 100 }
	local roadZs = { -150, 40, 160 }
	for _, x in ipairs(roadXs) do
		decal(roads, "Road", Vector3.new(x, 0, 0), 30, Config.MapSize, asphalt, Enum.Material.Asphalt)
	end
	for _, z in ipairs(roadZs) do
		decal(roads, "Road", Vector3.new(0, 0.01, z), Config.MapSize, 30, asphalt, Enum.Material.Asphalt)
	end

	-- Where cash drops can land (road intersections and open streets)
	map.DropSpots = {}
	for _, x in ipairs(roadXs) do
		for _, z in ipairs(roadZs) do
			table.insert(map.DropSpots, Vector3.new(x, 0, z))
		end
	end
	for _, spot in ipairs({
		Vector3.new(-300, 0, 40), Vector3.new(300, 0, 40), Vector3.new(0, 0, 160),
		Vector3.new(250, 0, 160), Vector3.new(-250, 0, -150), Vector3.new(-120, 0, 330), Vector3.new(100, 0, -330),
	}) do
		table.insert(map.DropSpots, spot)
	end

	-- Street lamps along every road
	local lamps = Instance.new("Folder")
	lamps.Name = "Lamps"
	lamps.Parent = city
	for i = -4, 4 do
		local t = i * 90 + 45
		for _, x in ipairs(roadXs) do
			lamp(lamps, Vector3.new(x + 18, 0, t))
		end
		for _, z in ipairs(roadZs) do
			lamp(lamps, Vector3.new(t, 0, z - 18))
		end
	end

	-- Stunt humps on the roads, a one-way MEGA RAMP, and boost pads
	local stunts = Instance.new("Folder")
	stunts.Name = "Stunts"
	stunts.Parent = city
	hump(stunts, Vector3.new(-120, 0, -320), false)
	hump(stunts, Vector3.new(100, 0, 300), false)
	hump(stunts, Vector3.new(320, 0, 40), true)
	hump(stunts, Vector3.new(-230, 0, 160), true)
	hump(stunts, Vector3.new(230, 0, -150), true)
	local megaStart = MapBuilder.MegaRampStart
	local mega = rampSlab(stunts, megaStart, Vector3.xAxis, 60, 22, Color3.fromRGB(255, 60, 140))
	mega.Name = "MegaRamp"
	sign(stunts, megaStart + Vector3.new(30, 34, 0), "MEGA RAMP", Color3.fromRGB(255, 120, 200))

	local boostFolder = Instance.new("Folder")
	boostFolder.Name = "BoostPads"
	boostFolder.Parent = city
	for _, info in ipairs({
		{ Vector3.new(-120, 0, -40), false }, { Vector3.new(100, 0, -60), false },
		{ Vector3.new(-120, 0, 260), false }, { Vector3.new(100, 0, 180 + 40), false },
		{ Vector3.new(-60, 0, 40), true }, { Vector3.new(220, 0, 40), true },
		{ Vector3.new(0, 0, 160), true }, { Vector3.new(-260, 0, -150), true },
		{ MapBuilder.MegaRampStart - Vector3.new(14, 0, 0), true },
	}) do
		boostPad(boostFolder, info[1], info[2])
	end
	map.BoostPads = boostFolder

	-- Robbery targets
	for _, rob in ipairs(Config.Robberies) do
		local model = building(city, rob.Name, rob.Position, rob.Size, rob.Color, 14)
		local zone = part({
			Parent = model, Name = "RobZone",
			Size = Vector3.new(rob.Size.X - 6, 12, rob.Size.Z - 6),
			Position = rob.Position + Vector3.new(0, 6, 0),
			Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false,
		})
		-- loot props so the inside doesn't look empty
		for i = -1, 1 do
			part({
				Parent = model, Name = "Loot", Size = Vector3.new(4, 3, 4),
				Position = rob.Position + Vector3.new(i * 10, 1.5, -rob.Size.Z / 4),
				Color = Color3.fromRGB(240, 200, 60), Material = Enum.Material.Neon,
			})
		end
		map.RobZones[rob.Id] = zone
		map.Signs[rob.Id] = sign(model, rob.Position + Vector3.new(0, rob.Size.Y + 6, 0), rob.Name, Color3.new(1, 1, 1))
	end

	-- Police station
	local ps = L.PoliceStation
	local station = building(city, "Police Station", ps, Vector3.new(50, 20, 36), Color3.fromRGB(70, 90, 140), 14)
	sign(station, ps + Vector3.new(0, 26, 0), "POLICE", Color3.fromRGB(120, 170, 255))
	map.Spawns.Police = CFrame.new(ps + Vector3.new(0, 3, 0))
	vehiclePad(city, ps + Vector3.new(-20, 0, 45), 0, "Cruiser", map.VehiclePads)
	vehiclePad(city, ps + Vector3.new(20, 0, 45), 0, "Interceptor", map.VehiclePads)
	vehiclePad(city, ps + Vector3.new(-20, 0, 75), 0, "Thunder", map.VehiclePads)
	vehiclePad(city, ps + Vector3.new(20, 0, 75), 0, "SkyPatrol", map.VehiclePads)

	-- Jail: tall solid walls, cells inside, and a secret vent for breakouts
	local jp = L.Jail
	local jailSize = Vector3.new(80, 30, 70)
	local jail = building(city, "Jail", jp, jailSize, Color3.fromRGB(110, 110, 115), 0)
	sign(jail, jp + Vector3.new(0, 36, 0), "CITY JAIL", Color3.fromRGB(255, 160, 60))
	for i = -2, 2 do
		part({
			Parent = jail, Name = "CellWall", Size = Vector3.new(1, 12, 20),
			Position = jp + Vector3.new(i * 14, 6, -jailSize.Z / 2 + 11), Color = Color3.fromRGB(80, 80, 85),
		})
	end
	map.Spawns.Prisoner = CFrame.new(jp + Vector3.new(0, 3, 10))
	map.Vent = part({
		Parent = jail, Name = "Vent", Size = Vector3.new(4, 3, 0.4),
		Position = jp + Vector3.new(-jailSize.X / 2 + 6, 1.5, -jailSize.Z / 2 + 2.3),
		Color = Color3.fromRGB(40, 40, 40), Material = Enum.Material.DiamondPlate,
	})
	map.EscapeExit = CFrame.new(jp + Vector3.new(-jailSize.X / 2 - 12, 3, -jailSize.Z / 2 + 4))

	-- Criminal hideout
	local hp = L.Hideout
	local hideout = building(city, "Hideout", hp, Vector3.new(50, 16, 40), Color3.fromRGB(90, 60, 50), 16, Enum.Material.Brick)
	sign(hideout, hp + Vector3.new(0, 22, 0), "HIDEOUT", Color3.fromRGB(255, 90, 90))
	map.Spawns.Criminal = CFrame.new(hp + Vector3.new(0, 3, -8))
	map.CashZone = part({
		Parent = hideout, Name = "CashZone", Size = Vector3.new(16, 0.3, 12),
		Position = hp + Vector3.new(0, 0.1, 6), Color = Color3.fromRGB(60, 220, 90),
		Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false,
	})
	sign(hideout, hp + Vector3.new(0, 7, 6), "CASH IN HERE", Color3.fromRGB(120, 255, 140)).Parent.Size = UDim2.new(14, 0, 3, 0)
	vehiclePad(city, hp + Vector3.new(-40, 0, 50), 0, "Sedan", map.VehiclePads)
	vehiclePad(city, hp + Vector3.new(-15, 0, 50), 0, "Muscle", map.VehiclePads)
	vehiclePad(city, hp + Vector3.new(10, 0, 50), 0, "Supercar", map.VehiclePads)

	-- Insane Motors: the dealership for the wild stuff
	local dp = L.Dealership
	local showroom = Instance.new("Model")
	showroom.Name = "Insane Motors"
	showroom.Parent = city
	decal(showroom, "Showroom", dp, 150, 70, Color3.fromRGB(30, 30, 40), Enum.Material.Marble)
	for _, x in ipairs({ -75, 75 }) do
		part({
			Parent = showroom, Name = "Pillar", Size = Vector3.new(3, 24, 3), Position = dp + Vector3.new(x, 12, -36),
			Color = Color3.fromRGB(255, 60, 140), Material = Enum.Material.Neon,
		})
	end
	part({
		Parent = showroom, Name = "Arch", Size = Vector3.new(153, 3, 3), Position = dp + Vector3.new(0, 25, -36),
		Color = Color3.fromRGB(255, 60, 140), Material = Enum.Material.Neon,
	})
	sign(showroom, dp + Vector3.new(0, 32, -36), "INSANE MOTORS", Color3.fromRGB(255, 120, 200))
	for i, key in ipairs({ "Monster", "Rocket", "Hyperion", "SkyRider" }) do
		vehiclePad(showroom, dp + Vector3.new(-54 + (i - 1) * 34, 0, 5), 0, key, map.VehiclePads)
	end

	-- Global leaderboard board next to the hideout
	local boardPart = part({
		Parent = city, Name = "Leaderboard", Size = Vector3.new(24, 16, 1),
		CFrame = CFrame.new(hp + Vector3.new(40, 9, 10)) * CFrame.Angles(0, math.rad(-90), 0),
		Color = Color3.fromRGB(25, 25, 30),
	})
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 25
	surface.Parent = boardPart
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.15, 0)
	title.BackgroundTransparency = 1
	title.Text = "RICHEST IN THE CITY"
	title.TextColor3 = Color3.fromRGB(255, 215, 80)
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.Parent = surface
	local list = Instance.new("Frame")
	list.Size = UDim2.new(0.9, 0, 0.8, 0)
	list.Position = UDim2.new(0.05, 0, 0.17, 0)
	list.BackgroundTransparency = 1
	list.Parent = surface
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	map.LeaderboardList = list

	-- Filler buildings + trees for a city feel (deterministic layout)
	local rng = Random.new(1337)
	local keyPoints = { L.PoliceStation, L.Jail, L.Hideout, L.Dealership, L.Dealership + Vector3.new(-60, 0, 0), L.Dealership + Vector3.new(60, 0, 0), MapBuilder.MegaRampStart + Vector3.new(30, 0, 0) }
	for _, rob in ipairs(Config.Robberies) do
		table.insert(keyPoints, rob.Position)
	end
	local function clear(pos, radius)
		for _, p in ipairs(keyPoints) do
			if (p - pos).Magnitude < radius then
				return false
			end
		end
		for _, x in ipairs(roadXs) do
			if math.abs(pos.X - x) < 35 then
				return false
			end
		end
		for _, z in ipairs(roadZs) do
			if math.abs(pos.Z - z) < 35 then
				return false
			end
		end
		return true
	end
	local filler = Instance.new("Folder")
	filler.Name = "Filler"
	filler.Parent = city
	local placed = 0
	for _ = 1, 300 do
		if placed >= 30 then
			break
		end
		local pos = Vector3.new(rng:NextInteger(-400, 400), 0, rng:NextInteger(-400, 400))
		if clear(pos, 90) then
			placed = placed + 1
			local h = rng:NextInteger(20, 70)
			part({
				Parent = filler, Name = "Tower", Size = Vector3.new(rng:NextInteger(20, 34), h, rng:NextInteger(20, 34)),
				Position = pos + Vector3.new(0, h / 2, 0),
				Color = Color3.fromHSV(rng:NextNumber(), 0.15, rng:NextNumber(0.55, 0.85)), Material = Enum.Material.Concrete,
			})
		end
	end
	for _ = 1, 60 do
		local pos = Vector3.new(rng:NextInteger(-430, 430), 0, rng:NextInteger(-430, 430))
		if clear(pos, 85) then
			tree(filler, pos)
		end
	end

	return map
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Creates the RemoteEvents shared with clients (ReplicatedStorage.Remotes).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local Remotes = { Events = {} }

local function event(name)
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	Remotes.Events[name] = remote
	return remote
end

event("ChooseTeam") -- client -> server: ("Police" | "Criminal")
event("Notify") -- server -> client: (text, kind) kind = "info" | "good" | "bad" | "alarm"
event("Nitro") -- client -> server: (on: boolean) toggles the driven car's nitro flames

function Remotes.Notify(player, text, kind)
	Remotes.Events.Notify:FireClient(player, text, kind or "info")
end

function Remotes.NotifyAll(text, kind)
	Remotes.Events.Notify:FireAllClients(text, kind or "info")
end

function Remotes.NotifyTeam(team, text, kind)
	for _, player in ipairs(team:GetPlayers()) do
		Remotes.Events.Notify:FireClient(player, text, kind or "info")
	end
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">RobberyService</string><ProtectedString name="Source"><![CDATA[-- The core criminal loop: stand inside an open store to fill your bag,
-- survive the alarm, then bring the bag to the Hideout to turn it into cash.
--
-- Store states (mirrored to ReplicatedStorage.RobberyStatus for the HUD):
--   OPEN   -> can be robbed
--   ALARM  -> someone started robbing it; police are alerted; closes soon
--   CLOSED -> cooling down until ReopenAt
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local TeamService = require(script.Parent.TeamService)

local RobberyService = {}

local states = {} -- [id] = { Status, AlarmEnds, ReopenAt, Value, Completed = {[player]=true} }
local progress = {} -- [player] = { [id] = seconds }
local warned = {} -- [player] = os.clock() of last "level too low" / "bag full" hint

local function inside(zone, position)
	local localPos = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

-- Footprint check for flat pads: inside the X/Z area and within 8 studs above it
local function onPad(pad, position)
	local localPos = pad.CFrame:PointToObjectSpace(position)
	local half = pad.Size / 2
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Z) <= half.Z and localPos.Y >= -1 and localPos.Y <= 8
end

local function formatTime(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function hint(player, text)
	local now = os.clock()
	if not warned[player] or now - warned[player] > 6 then
		warned[player] = now
		Remotes.Notify(player, text, "bad")
	end
end

local function setStatus(rob, status, now)
	local state = states[rob.Id]
	state.Status = status
	state.Value.Value = status
	if status == "ALARM" then
		state.AlarmEnds = now + rob.Duration + Config.AlarmGrace
		Remotes.NotifyTeam(TeamService.Teams.Police, ("ALARM! %s is being robbed!"):format(rob.Name), "alarm")
	elseif status == "CLOSED" then
		state.ReopenAt = now + rob.Cooldown
		state.Value:SetAttribute("ReopenAt", state.ReopenAt)
		state.Completed = {}
		for _, perPlayer in pairs(progress) do
			perPlayer[rob.Id] = nil
		end
	elseif status == "OPEN" then
		Remotes.NotifyAll(("%s is open for business..."):format(rob.Name), "info")
	end
end

local function updateSign(rob, label, now)
	local state = states[rob.Id]
	if state.Status == "OPEN" then
		label.Text = rob.Name .. " - OPEN"
		label.TextColor3 = Color3.fromRGB(110, 255, 130)
	elseif state.Status == "ALARM" then
		label.Text = "ALARM! " .. rob.Name
		label.TextColor3 = (math.floor(now * 2) % 2 == 0) and Color3.fromRGB(255, 70, 70) or Color3.new(1, 1, 1)
	else
		label.Text = rob.Name .. " - CLOSED " .. formatTime(state.ReopenAt - now)
		label.TextColor3 = Color3.fromRGB(170, 170, 170)
	end
end

local function complete(player, rob)
	local state = states[rob.Id]
	state.Completed[player] = true
	progress[player][rob.Id] = nil

	local bag = player:GetAttribute("Bag") or 0
	local space = DataService.MaxBag(player) - bag
	local loot = math.min(rob.Payout * DataService.Multiplier(player), space)
	player:SetAttribute("Bag", bag + loot)
	player:SetAttribute("Bounty", (player:GetAttribute("Bounty") or 0) + math.floor(rob.Payout * Config.BountyPerPayout))
	DataService.AddXp(player, rob.Xp)
	DataService.Increment(player, "Robberies")
	Remotes.Notify(player, ("You grabbed $%d! Get it to the Hideout before the cops catch you!"):format(loot), "good")
end

local function tickPlayer(player, map, now, dt)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local robbing = nil

	if root and player.Team == TeamService.Teams.Criminal then
		for _, rob in ipairs(Config.Robberies) do
			local state = states[rob.Id]
			if state.Status ~= "CLOSED" and not state.Completed[player] and inside(map.RobZones[rob.Id], root.Position) then
				robbing = rob
				break
			end
		end

		-- Cash in at the hideout
		local bag = player:GetAttribute("Bag") or 0
		if bag > 0 and onPad(map.CashZone, root.Position) then
			DataService.AddCash(player, bag)
			player:SetAttribute("Bag", 0)
			Remotes.Notify(player, ("Cashed in $%d! Nice getaway."):format(bag), "good")
		end
	end

	if robbing then
		if DataService.GetLevel(player) < robbing.MinLevel then
			hint(player, ("You need level %d to rob %s."):format(robbing.MinLevel, robbing.Name))
			robbing = nil
		elseif (player:GetAttribute("Bag") or 0) >= DataService.MaxBag(player) then
			hint(player, "Your bag is full! Cash it in at the Hideout.")
			robbing = nil
		end
	end

	if robbing then
		local state = states[robbing.Id]
		if state.Status == "OPEN" then
			setStatus(robbing, "ALARM", now)
		end
		progress[player] = progress[player] or {}
		local seconds = (progress[player][robbing.Id] or 0) + dt
		progress[player][robbing.Id] = seconds
		player:SetAttribute("RobName", robbing.Name)
		player:SetAttribute("RobProgress", math.clamp(seconds / robbing.Duration, 0, 1))
		if seconds >= robbing.Duration then
			complete(player, robbing)
		end
	elseif player:GetAttribute("RobName") and player.Team ~= TeamService.Teams.Prisoner then
		player:SetAttribute("RobName", nil)
		player:SetAttribute("RobProgress", nil)
	end
end

function RobberyService.Init(map)
	local statusFolder = Instance.new("Folder")
	statusFolder.Name = "RobberyStatus"
	for order, rob in ipairs(Config.Robberies) do
		local value = Instance.new("StringValue")
		value.Name = rob.Id
		value.Value = "OPEN"
		value:SetAttribute("DisplayName", rob.Name)
		value:SetAttribute("Order", order)
		value:SetAttribute("MinLevel", rob.MinLevel)
		value.Parent = statusFolder
		states[rob.Id] = { Status = "OPEN", AlarmEnds = 0, ReopenAt = 0, Value = value, Completed = {} }
	end
	statusFolder.Parent = ReplicatedStorage

	Players.PlayerRemoving:Connect(function(player)
		progress[player] = nil
		warned[player] = nil
		for _, state in pairs(states) do
			state.Completed[player] = nil
		end
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local clock = os.clock()
			local dt = clock - last
			last = clock
			local now = workspace:GetServerTimeNow()

			for _, rob in ipairs(Config.Robberies) do
				local state = states[rob.Id]
				if state.Status == "ALARM" and now >= state.AlarmEnds then
					setStatus(rob, "CLOSED", now)
				elseif state.Status == "CLOSED" and now >= state.ReopenAt then
					setStatus(rob, "OPEN", now)
				end
			end

			for _, player in ipairs(Players:GetPlayers()) do
				tickPlayer(player, map, now, dt)
			end

			for _, rob in ipairs(Config.Robberies) do
				updateSign(rob, map.Signs[rob.Id], now)
			end
		end
	end)
end

return RobberyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: VIP game pass and cash developer products.
-- Set the IDs in Shared/Config.lua after creating them in the Creator Dashboard.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local productsById = {}
for _, product in ipairs(Config.CashProducts) do
	if product.Id ~= 0 then
		productsById[product.Id] = product
	end
end

local function checkVip(player)
	local passId = Config.GamePasses.VIP
	if passId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	if ok and owns then
		DataService.SetVip(player, true)
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productsById[info.ProductId]
	local profile = DataService.Get(player)
	if not product or not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Idempotency: never grant the same purchase twice
	local receipts = profile.Data.Receipts
	for _, id in ipairs(receipts) do
		if id == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	DataService.AddCash(player, product.Cash)
	table.insert(receipts, info.PurchaseId)
	while #receipts > 50 do
		table.remove(receipts, 1)
	end

	if DataService.Save(player) or RunService:IsStudio() then
		Remotes.Notify(player, ("Thanks for your purchase! +$%d"):format(product.Cash), "good")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Roll back so the retry doesn't double-grant
	DataService.AddCash(player, -product.Cash)
	table.remove(receipts)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt

	local function onJoin(player)
		if DataService.WaitForProfile(player) then
			checkVip(player)
		end
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onJoin, player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.GamePasses.VIP then
			DataService.SetVip(player, true)
			Remotes.Notify(player, "VIP unlocked! You now earn 2x cash and carry a bigger bag.", "good")
		end
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">TeamService</string><ProtectedString name="Source"><![CDATA[-- Teams, team selection, spawning and respawning.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)

local TeamService = { Teams = {} }

local spawns
local teamChangedListeners = {}
local characterListeners = {}
local lastRequest = {}

function TeamService.OnTeamChanged(callback)
	table.insert(teamChangedListeners, callback)
end

-- callback(player, character, teamKey)
function TeamService.OnCharacterSpawned(callback)
	table.insert(characterListeners, callback)
end

function TeamService.GetKey(player)
	for teamKey, team in pairs(TeamService.Teams) do
		if player.Team == team then
			return teamKey
		end
	end
	return nil
end

local function policeSlotsFree()
	local total = #Players:GetPlayers()
	local cap = math.max(1, math.floor(total * Config.MaxPoliceShare))
	return #TeamService.Teams.Police:GetPlayers() < cap
end

-- Moves a player to a team. respawn=true reloads their character at the team spawn.
function TeamService.SetTeam(player, teamKey, respawn)
	local team = TeamService.Teams[teamKey]
	if not team then
		return
	end
	local changed = player.Team ~= team
	player.Neutral = false
	player.Team = team
	if changed then
		for _, callback in ipairs(teamChangedListeners) do
			task.spawn(callback, player, teamKey)
		end
	end
	if respawn then
		player:LoadCharacter()
	end
end

local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")
	humanoid.WalkSpeed = Config.WalkSpeed
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = Config.JumpHeight

	local teamKey = TeamService.GetKey(player)
	if teamKey and spawns[teamKey] then
		if not character.Parent then
			character.AncestryChanged:Wait()
		end
		task.wait()
		local offset = Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
		character:PivotTo(spawns[teamKey] + offset)
		root.AssemblyLinearVelocity = Vector3.zero
	end

	for _, callback in ipairs(characterListeners) do
		task.spawn(callback, player, character, teamKey)
	end

	humanoid.Died:Connect(function()
		-- Dropping the loot bag on death keeps chases meaningful
		if (player:GetAttribute("Bag") or 0) > 0 then
			player:SetAttribute("Bag", 0)
			Remotes.Notify(player, "You died and dropped your loot bag!", "bad")
		end
		task.delay(Config.RespawnDelay, function()
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
end

local function onChooseTeam(player, teamKey)
	if teamKey ~= "Police" and teamKey ~= "Criminal" then
		return
	end
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 2 then
		return
	end
	lastRequest[player] = now

	if not DataService.WaitForProfile(player) then
		return
	end
	local current = TeamService.GetKey(player)
	if current == "Prisoner" then
		Remotes.Notify(player, "Nice try. You can't switch teams while in jail!", "bad")
		return
	end
	if current == teamKey and player.Character then
		return
	end
	if teamKey == "Police" and not policeSlotsFree() then
		Remotes.Notify(player, "The police force is full right now. Try again soon!", "bad")
		return
	end
	-- Switching sides forfeits any loot and bounty
	player:SetAttribute("Bag", 0)
	player:SetAttribute("Bounty", 0)
	TeamService.SetTeam(player, teamKey, true)

	if teamKey == "Police" then
		Remotes.Notify(player, "You're a cop! Use Handcuffs on criminals with a bounty. Watch for robbery alarms.", "info")
	else
		Remotes.Notify(player, "You're a criminal! Rob a store, then bring the loot back to the Hideout to cash in.", "info")
	end
end

function TeamService.Init(map)
	spawns = map.Spawns
	Players.CharacterAutoLoads = false

	for teamKey, info in pairs(Config.Teams) do
		local team = Teams:FindFirstChild(info.Name)
		if not team then
			team = Instance.new("Team")
			team.Name = info.Name
			team.TeamColor = info.Color
			team.AutoAssignable = false
			team.Parent = Teams
		end
		TeamService.Teams[teamKey] = team
	end

	local function setup(player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
	end
	Players.PlayerAdded:Connect(setup)
	for _, player in ipairs(Players:GetPlayers()) do
		setup(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)

	Remotes.Events.ChooseTeam.OnServerEvent:Connect(onChooseTeam)
end

return TeamService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">ToolService</string><ProtectedString name="Source"><![CDATA[-- Builds and hands out team tools: Handcuffs + Taser for police, Boost for criminals.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local ArrestService = require(script.Parent.ArrestService)

local ToolService = {}

local lastBoost = {}

local function makeTool(name, tip, color, onActivated)
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.ToolTip = tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.6, 0.6, 1.4)
	handle.Color = color
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	tool.Activated:Connect(function()
		local character = tool.Parent
		local player = character and game:GetService("Players"):GetPlayerFromCharacter(character)
		if player then
			onActivated(player)
		end
	end)
	return tool
end

local function boost(player)
	local now = os.clock()
	if lastBoost[player] and now - lastBoost[player] < Config.BoostCooldown then
		Remotes.Notify(player, ("Boost recharging: %ds"):format(math.ceil(Config.BoostCooldown - (now - lastBoost[player]))), "info")
		return
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or player:GetAttribute("StunnedUntil") then
		return
	end
	lastBoost[player] = now
	humanoid.WalkSpeed = Config.BoostSpeed
	task.delay(Config.BoostDuration, function()
		if humanoid.Parent and not player:GetAttribute("StunnedUntil") then
			humanoid.WalkSpeed = Config.WalkSpeed
		end
	end)
end

function ToolService.GiveTools(player, character, teamKey)
	local backpack = player:WaitForChild("Backpack")
	if player.Character ~= character then
		return
	end
	if teamKey == "Police" then
		makeTool("Handcuffs", "Get close to a wanted criminal and click", Color3.fromRGB(180, 180, 190), ArrestService.TryArrest).Parent = backpack
		makeTool("Taser", "Stun a wanted criminal in front of you (knocks them out of cars)", Color3.fromRGB(240, 220, 40), ArrestService.TryTase).Parent = backpack
		makeTool("Spike Strip", "Throw spikes on the road to pop a getaway car's tires", Color3.fromRGB(255, 60, 60), ArrestService.PlaceSpikes).Parent = backpack
	elseif teamKey == "Criminal" then
		makeTool("Boost", "Short burst of speed to escape the cops", Color3.fromRGB(230, 60, 60), boost).Parent = backpack
	end
end

return ToolService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[-- Builds drivable vehicles from parts and handles buying/spawning them at pads.
--
-- Physics: an invisible-ish "Body" slab slides on the ground with zero friction.
-- A LinearVelocity drives it (Plane mode = ground car; Vector mode = flying)
-- and an AngularVelocity handles steering while keeping the car level, so cars
-- never flip and fly flat off ramps. Everything else is welded decoration.
-- The driver's client sets the movers (see client/Driving.client.lua) because
-- the driver owns the car's physics.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local TeamService = require(script.Parent.TeamService)

local VehicleService = {}

local spawned = {} -- [player] = Model
local lastSpawn = {}
local lastNitro = {}

local DARK = Color3.fromRGB(25, 25, 28)
local GLASS = Color3.fromRGB(150, 200, 230)
local NEON = Enum.Material.Neon

-- Piece list entry: { name, size, offset (relative to body center), color, material?, extra? }
-- Seats: { className, offset }. Exhausts: offsets where nitro flames come out.
local function styleSpec(def)
	local main = def.Color
	local glow = def.Glow or main
	local style = def.Style or "Car"

	if style == "Hyper" then
		local pieces = {
			{ "Cabin", Vector3.new(6, 1.4, 5.5), Vector3.new(0, 1.5, 1), Color3.fromRGB(40, 40, 60), Enum.Material.Glass, { Transparency = 0.35 } },
			{ "Nose", Vector3.new(7.6, 0.6, 4), Vector3.new(0, 1.0, -5), main },
			{ "Wing", Vector3.new(8.4, 0.3, 1.6), Vector3.new(0, 2.6, 6.8), main },
			{ "WingPostL", Vector3.new(0.4, 1.6, 0.4), Vector3.new(-2.5, 1.6, 6.8), DARK },
			{ "WingPostR", Vector3.new(0.4, 1.6, 0.4), Vector3.new(2.5, 1.6, 6.8), DARK },
			{ "StripeL", Vector3.new(0.2, 0.4, 13), Vector3.new(-4.05, 0, 0), glow, NEON },
			{ "StripeR", Vector3.new(0.2, 0.4, 13), Vector3.new(4.05, 0, 0), glow, NEON },
			{ "HeadL", Vector3.new(2, 0.3, 0.2), Vector3.new(-2.6, 0.3, -7.55), Color3.new(1, 1, 1), NEON },
			{ "HeadR", Vector3.new(2, 0.3, 0.2), Vector3.new(2.6, 0.3, -7.55), Color3.new(1, 1, 1), NEON },
			{ "Tail", Vector3.new(7, 0.3, 0.2), Vector3.new(0, 0.4, 7.55), Color3.fromRGB(255, 30, 30), NEON },
		}
		for _, x in ipairs({ -4.1, 4.1 }) do
			for _, z in ipairs({ -5, 5 }) do
				table.insert(pieces, { "Wheel", Vector3.new(1.4, 2.6, 2.6), Vector3.new(x, 0.5, z), DARK, Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder } })
			end
		end
		return {
			Body = Vector3.new(8, 1.6, 15), Pieces = pieces, RoofY = 2.45,
			Seats = { { "VehicleSeat", Vector3.new(-1.4, 0.95, 1) }, { "Seat", Vector3.new(1.4, 0.95, 1) } },
			Exhausts = { Vector3.new(-1.2, -0.2, 7.7), Vector3.new(1.2, -0.2, 7.7) },
		}
	elseif style == "Monster" then
		local pieces = {
			{ "Frame", Vector3.new(8, 1.2, 14), Vector3.new(0, 3.6, 0), DARK, Enum.Material.Metal },
			{ "Cab", Vector3.new(8, 4, 6.5), Vector3.new(0, 6.3, -1.5), main, nil, { Transparency = 0.15 } },
			{ "Hood", Vector3.new(8, 1.8, 4.5), Vector3.new(0, 5.1, -6.5), main },
			{ "Grille", Vector3.new(7, 1.2, 0.3), Vector3.new(0, 5.1, -8.8), glow, NEON },
			{ "BedBack", Vector3.new(8, 2, 0.5), Vector3.new(0, 5.2, 6.8), main },
			{ "BedL", Vector3.new(0.5, 2, 7), Vector3.new(-3.75, 5.2, 3.5), main },
			{ "BedR", Vector3.new(0.5, 2, 7), Vector3.new(3.75, 5.2, 3.5), main },
			{ "LightBar", Vector3.new(7, 0.5, 0.6), Vector3.new(0, 8.6, -3.5), Color3.fromRGB(255, 250, 220), NEON },
		}
		for _, x in ipairs({ -5.3, 5.3 }) do
			for _, z in ipairs({ -5.5, 5.5 }) do
				table.insert(pieces, { "Wheel", Vector3.new(2.6, 7, 7), Vector3.new(x, 3, z), DARK, Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder } })
			end
		end
		return {
			Body = Vector3.new(9, 1, 15), HideBody = true, Pieces = pieces, RoofY = 8.55,
			Seats = {
				{ "VehicleSeat", Vector3.new(-1.5, 4.6, -1.5) }, { "Seat", Vector3.new(1.5, 4.6, -1.5) },
				{ "Seat", Vector3.new(-2, 4.6, 4) }, { "Seat", Vector3.new(2, 4.6, 4) },
			},
			Exhausts = { Vector3.new(-3, 8.5, 1.9), Vector3.new(3, 8.5, 1.9) },
		}
	elseif style == "Kart" then
		local pieces = {
			{ "Engine", Vector3.new(3, 1.5, 1.8), Vector3.new(0, 1.2, 3.2), DARK, Enum.Material.Metal },
			{ "Bumper", Vector3.new(5.2, 0.4, 0.4), Vector3.new(0, 0, -4.1), glow, NEON },
			{ "RollBar", Vector3.new(3, 0.3, 0.3), Vector3.new(0, 3.2, 1.8), DARK, Enum.Material.Metal },
			{ "RollL", Vector3.new(0.3, 2.4, 0.3), Vector3.new(-1.35, 2, 1.8), DARK, Enum.Material.Metal },
			{ "RollR", Vector3.new(0.3, 2.4, 0.3), Vector3.new(1.35, 2, 1.8), DARK, Enum.Material.Metal },
			{ "Fin", Vector3.new(0.3, 2, 2), Vector3.new(0, 1.8, 3.4), main },
		}
		for _, x in ipairs({ -2.9, 2.9 }) do
			for _, z in ipairs({ -3, 3 }) do
				table.insert(pieces, { "Wheel", Vector3.new(1.2, 2, 2), Vector3.new(x, 0.5, z), DARK, Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder } })
			end
		end
		return {
			Body = Vector3.new(5, 1, 8), Pieces = pieces, RoofY = 3.5,
			Seats = { { "VehicleSeat", Vector3.new(0, 0.8, 0.6) } },
			Exhausts = { Vector3.new(-0.9, 1.4, 4.6), Vector3.new(0.9, 1.4, 4.6) },
		}
	elseif style == "Flyer" then
		local pieces = {
			{ "Wings", Vector3.new(18, 0.4, 4), Vector3.new(0, 0.2, 1.5), main },
			{ "TipL", Vector3.new(0.4, 0.6, 1), Vector3.new(-9, 0.3, 1.5), Color3.fromRGB(255, 40, 40), NEON },
			{ "TipR", Vector3.new(0.4, 0.6, 1), Vector3.new(9, 0.3, 1.5), Color3.fromRGB(40, 255, 80), NEON },
			{ "Canopy", Vector3.new(5, 1.8, 6.5), Vector3.new(0, 1.6, -0.5), GLASS, Enum.Material.Glass, { Transparency = 0.45 } },
			{ "Tail", Vector3.new(0.4, 3, 2.5), Vector3.new(0, 2.2, 5.6), main },
			{ "ThrusterL", Vector3.new(2, 2, 1), Vector3.new(-2, 0.2, 6.8), glow, NEON },
			{ "ThrusterR", Vector3.new(2, 2, 1), Vector3.new(2, 0.2, 6.8), glow, NEON },
		}
		return {
			Body = Vector3.new(7, 1.6, 13), Pieces = pieces, RoofY = 2.75,
			Seats = {
				{ "VehicleSeat", Vector3.new(-1.4, 1.1, -1.5) }, { "Seat", Vector3.new(1.4, 1.1, -1.5) },
				{ "Seat", Vector3.new(-1.4, 1.1, 1.8) }, { "Seat", Vector3.new(1.4, 1.1, 1.8) },
			},
			Exhausts = { Vector3.new(-2, 0.2, 7.6), Vector3.new(2, 0.2, 7.6) },
		}
	end

	-- Default "Car"
	local pieces = {
		{ "Cabin", Vector3.new(6.4, 2.6, 7), Vector3.new(0, 2.3, 1), GLASS, Enum.Material.Glass, { Transparency = 0.5 } },
		{ "Hood", Vector3.new(6.8, 0.6, 4.5), Vector3.new(0, 1.3, -4.6), main },
		{ "HeadL", Vector3.new(1.2, 0.6, 0.2), Vector3.new(-2.6, -0.2, -7.05), Color3.fromRGB(255, 250, 220), NEON },
		{ "HeadR", Vector3.new(1.2, 0.6, 0.2), Vector3.new(2.6, -0.2, -7.05), Color3.fromRGB(255, 250, 220), NEON },
		{ "TailL", Vector3.new(1.2, 0.6, 0.2), Vector3.new(-2.6, -0.2, 7.05), Color3.fromRGB(255, 40, 40), NEON },
		{ "TailR", Vector3.new(1.2, 0.6, 0.2), Vector3.new(2.6, -0.2, 7.05), Color3.fromRGB(255, 40, 40), NEON },
	}
	if def.Police then
		table.insert(pieces, { "Stripe", Vector3.new(7.05, 0.5, 8), Vector3.new(0, -0.4, 1), Color3.new(1, 1, 1) })
	end
	for _, x in ipairs({ -3.8, 3.8 }) do
		for _, z in ipairs({ -4.5, 4.5 }) do
			table.insert(pieces, { "Wheel", Vector3.new(1.2, 3, 3), Vector3.new(x, 0.5, z), DARK, Enum.Material.Rubber, { Shape = Enum.PartType.Cylinder } })
		end
	end
	return {
		Body = Vector3.new(7, 2, 14), Pieces = pieces, RoofY = 3.85,
		Seats = {
			{ "VehicleSeat", Vector3.new(-1.5, 1.3, 0) }, { "Seat", Vector3.new(1.5, 1.3, 0) },
			{ "Seat", Vector3.new(-1.5, 1.3, 3) }, { "Seat", Vector3.new(1.5, 1.3, 3) },
		},
		Exhausts = { Vector3.new(-1.8, -0.5, 7.3), Vector3.new(1.8, -0.5, 7.3) },
	}
end

local function buildCar(vehicleKey)
	local def = Config.Vehicles[vehicleKey]
	local spec = styleSpec(def)
	local half = spec.Body.Y / 2

	local model = Instance.new("Model")
	model.Name = def.Display
	model:SetAttribute("VehicleKey", vehicleKey)
	model:SetAttribute("MaxSpeed", def.MaxSpeed)
	model:SetAttribute("TurnRate", def.TurnRate)
	model:SetAttribute("Fly", def.Fly == true)
	model:SetAttribute("RideHeight", half)

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = spec.Body
	body.CFrame = CFrame.new(0, half, 0)
	body.Color = def.Color
	body.Material = Enum.Material.SmoothPlastic
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Transparency = spec.HideBody and 1 or 0
	body.CustomPhysicalProperties = PhysicalProperties.new(0.6, 0, 0, 100, 100)
	body.Parent = model
	model.PrimaryPart = body

	local function weld(p)
		p.Massless = true
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
	end

	local function piece(className, name, size, offset, color, material, props)
		local p = Instance.new(className)
		p.Name = name
		p.Size = size
		p.CFrame = body.CFrame * CFrame.new(offset)
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false
		for k, v in pairs(props or {}) do
			p[k] = v
		end
		weld(p)
		return p
	end

	for _, info in ipairs(spec.Pieces) do
		piece("Part", info[1], info[2], info[3], info[4], info[5], info[6])
	end

	if def.Police then
		piece("Part", "LightRed", Vector3.new(2, 0.5, 1), Vector3.new(-1, spec.RoofY, 1), Color3.fromRGB(255, 30, 30), NEON)
		piece("Part", "LightBlue", Vector3.new(2, 0.5, 1), Vector3.new(1, spec.RoofY, 1), Color3.fromRGB(30, 80, 255), NEON)
	end

	-- Seats (first one is the driver's VehicleSeat)
	local driveSeat
	for i, info in ipairs(spec.Seats) do
		local seat = piece(info[1], i == 1 and "DriveSeat" or ("Seat" .. i), Vector3.new(2, 0.6, 2), info[2], DARK)
		seat.CanCollide = true
		if i == 1 then
			seat.HeadsUpDisplay = false
			driveSeat = seat
		end
	end

	-- Exhaust flames (nitro). Rocket karts keep them lit all the time.
	for _, offset in ipairs(spec.Exhausts) do
		local pipe = piece("Part", "Exhaust", Vector3.new(0.6, 0.6, 0.6), offset, DARK, Enum.Material.Metal)
		local fire = Instance.new("Fire")
		fire.Name = "NitroFire"
		fire.Size = 4
		fire.Heat = 12
		fire.Color = Color3.fromRGB(80, 160, 255)
		fire.SecondaryColor = Color3.fromRGB(255, 120, 30)
		fire.Enabled = def.AlwaysFlames == true
		fire.Parent = pipe
	end

	-- Underglow
	local glow = Instance.new("PointLight")
	glow.Color = def.Glow or def.Color
	glow.Range = 18
	glow.Brightness = 3
	glow.Parent = body

	-- Movers
	local attachment = Instance.new("Attachment")
	attachment.Name = "Root"
	attachment.Parent = body

	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"
	drive.Attachment0 = attachment
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	drive.PrimaryTangentAxis = Vector3.xAxis
	drive.SecondaryTangentAxis = Vector3.zAxis
	drive.PlaneVelocity = Vector2.zero
	drive.VectorVelocity = Vector3.zero
	drive.MaxForce = 150000
	drive.Parent = body

	local steer = Instance.new("AngularVelocity")
	steer.Name = "Steer"
	steer.Attachment0 = attachment
	steer.RelativeTo = Enum.ActuatorRelativeTo.World
	steer.AngularVelocity = Vector3.zero
	steer.MaxTorque = 5000000
	steer.Parent = body

	return model, body, driveSeat, half
end

local function setFlames(car, on)
	local def = Config.Vehicles[car:GetAttribute("VehicleKey") or ""]
	if def and def.AlwaysFlames then
		on = true
	end
	for _, d in ipairs(car:GetDescendants()) do
		if d:IsA("Fire") and d.Name == "NitroFire" then
			d.Enabled = on
		end
	end
end

function VehicleService.Despawn(player)
	local car = spawned[player]
	if car then
		car:Destroy()
		spawned[player] = nil
	end
end

-- All spawned cars: { [player] = Model }
function VehicleService.GetCars()
	return spawned
end

local function spawnFor(player, vehicleKey, padCFrame)
	local def = Config.Vehicles[vehicleKey]
	local model, body, seat, half = buildCar(vehicleKey)
	local drive = body.Drive
	model:SetAttribute("Owner", player.UserId)

	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant
		if occupant then
			local driver = Players:GetPlayerFromCharacter(occupant.Parent)
			if not driver or (def.Team and TeamService.GetKey(driver) ~= def.Team) then
				occupant.Sit = false
				if driver then
					Remotes.Notify(driver, "Only " .. def.Team .. " can drive this.", "bad")
				end
				return
			end
			if def.Fly then
				drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			end
			pcall(function()
				body:SetNetworkOwner(driver)
			end)
		else
			-- No driver: stop, drop to the ground, flames off
			drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
			drive.PlaneVelocity = Vector2.zero
			drive.VectorVelocity = Vector3.zero
			setFlames(model, false)
			pcall(function()
				body:SetNetworkOwner(nil)
			end)
		end
	end)

	VehicleService.Despawn(player)
	model:PivotTo(padCFrame * CFrame.new(0, half + 0.3, 0))
	model.Parent = workspace
	spawned[player] = model
	pcall(function()
		body:SetNetworkOwner(nil)
	end)
end

local function onPadTriggered(player, vehicleKey, pad)
	local def = Config.Vehicles[vehicleKey]
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local now = os.clock()
	if lastSpawn[player] and now - lastSpawn[player] < 3 then
		return
	end
	local teamKey = TeamService.GetKey(player)
	if not teamKey or teamKey == "Prisoner" then
		return
	end
	if def.Team and teamKey ~= def.Team then
		Remotes.Notify(player, "This vehicle is for " .. def.Team .. " only.", "bad")
		return
	end
	if not profile.Data.OwnedVehicles[vehicleKey] then
		if not DataService.SpendCash(player, def.Price) then
			Remotes.Notify(player, ("You need $%d to buy the %s. Rob stores, grab cash drops and hit stunt jumps!"):format(def.Price, def.Display), "bad")
			return
		end
		profile.Data.OwnedVehicles[vehicleKey] = true
		Remotes.NotifyAll(("%s just bought the %s!"):format(player.Name, def.Display), "good")
	end
	lastSpawn[player] = now
	spawnFor(player, vehicleKey, pad.CFrame)
end

local function onNitro(player, on)
	if type(on) ~= "boolean" then
		return
	end
	local now = os.clock()
	if on and lastNitro[player] and now - lastNitro[player] < 0.2 then
		return
	end
	lastNitro[player] = now
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat and seat.Name == "DriveSeat" and seat.Parent then
		local body = seat.Parent:FindFirstChild("Body")
		local spiked = body and (body:GetAttribute("SpikedUntil") or 0) > workspace:GetServerTimeNow()
		setFlames(seat.Parent, on and not spiked)
	end
end

function VehicleService.Init(map)
	for _, info in ipairs(map.VehiclePads) do
		local def = Config.Vehicles[info.VehicleKey]
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Spawn"
		prompt.ObjectText = def.Price > 0 and ("%s ($%d to unlock)"):format(def.Display, def.Price) or (def.Display .. " (free)")
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = info.Kiosk
		prompt.Triggered:Connect(function(player)
			onPadTriggered(player, info.VehicleKey, info.Pad)
		end)
	end

	Remotes.Events.Nitro.OnServerEvent:Connect(onNitro)

	TeamService.OnTeamChanged(function(player)
		VehicleService.Despawn(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		VehicleService.Despawn(player)
		lastSpawn[player] = nil
		lastNitro[player] = nil
	end)
end

return VehicleService
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000018"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000017"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000016"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX00000014"><Properties><string name="Name">Driving</string><ProtectedString name="Source"><![CDATA[-- Drives the vehicle you're sitting in. The driver owns the car's physics, so
-- setting the movers here is smooth and lag-free.
--
-- Controls:  W/S or arrows = gas/brake, A/D = steer (VehicleSeat input; works
-- with gamepad and the mobile thumbstick too)
--            F = NITRO      E / Q = fly up / down (flying cars)
-- On-screen NITRO / UP / DOWN buttons appear while driving (for phones).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local NitroRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Nitro")
local camera = workspace.CurrentCamera

local ACCEL = 50 -- studs/s^2
local BRAKE = 100
local COAST = 25
local BASE_FOV = 70

local speed = 0
local fuel = 1
local currentSeat = nil
local held = { Nitro = false, Up = false, Down = false }
local nitroOn = false
local fovTween = nil
local lastPadBoost = 0

---------------------------------------------------------------------------
-- Driving HUD
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "DrivingUI"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local dash = Instance.new("Frame")
dash.AnchorPoint = Vector2.new(1, 1)
dash.Position = UDim2.new(1, -16, 1, -150)
dash.Size = UDim2.new(0, 200, 0, 92)
dash.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
dash.BackgroundTransparency = 0.25
dash.Parent = gui
Instance.new("UICorner", dash).CornerRadius = UDim.new(0, 12)

local speedLabel = Instance.new("TextLabel")
speedLabel.BackgroundTransparency = 1
speedLabel.Position = UDim2.new(0, 12, 0, 6)
speedLabel.Size = UDim2.new(1, -24, 0, 46)
speedLabel.Font = Enum.Font.GothamBlack
speedLabel.TextScaled = true
speedLabel.TextXAlignment = Enum.TextXAlignment.Left
speedLabel.TextColor3 = Color3.new(1, 1, 1)
speedLabel.Text = "0 MPH"
speedLabel.Parent = dash

local fuelBack = Instance.new("Frame")
fuelBack.Position = UDim2.new(0, 12, 0, 58)
fuelBack.Size = UDim2.new(1, -24, 0, 12)
fuelBack.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
fuelBack.Parent = dash
Instance.new("UICorner", fuelBack).CornerRadius = UDim.new(1, 0)
local fuelFill = Instance.new("Frame")
fuelFill.Size = UDim2.fromScale(1, 1)
fuelFill.BackgroundColor3 = Color3.fromRGB(0, 220, 255)
fuelFill.Parent = fuelBack
Instance.new("UICorner", fuelFill).CornerRadius = UDim.new(1, 0)

local statusLabel = Instance.new("TextLabel")
statusLabel.BackgroundTransparency = 1
statusLabel.Position = UDim2.new(0, 12, 0, 72)
statusLabel.Size = UDim2.new(1, -24, 0, 16)
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextScaled = true
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.TextColor3 = Color3.fromRGB(180, 190, 210)
statusLabel.Text = "NITRO [F]"
statusLabel.Parent = dash

local function holdButton(text, position, color, key)
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(1, 1)
	b.Position = position
	b.Size = UDim2.new(0, 84, 0, 60)
	b.BackgroundColor3 = color
	b.BackgroundTransparency = 0.15
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Parent = gui
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 14)
	local pad = Instance.new("UIPadding", b)
	pad.PaddingTop = UDim.new(0, 12)
	pad.PaddingBottom = UDim.new(0, 12)
	b.MouseButton1Down:Connect(function()
		held[key] = true
	end)
	b.MouseButton1Up:Connect(function()
		held[key] = false
	end)
	b.MouseLeave:Connect(function()
		held[key] = false
	end)
	return b
end

local nitroButton = holdButton("NITRO", UDim2.new(1, -224, 1, -150), Color3.fromRGB(0, 150, 220), "Nitro")
local upButton = holdButton("UP", UDim2.new(1, -312, 1, -150), Color3.fromRGB(60, 160, 80), "Up")
local downButton = holdButton("DOWN", UDim2.new(1, -400, 1, -150), Color3.fromRGB(160, 80, 60), "Down")
local _ = nitroButton

local keyMap = { [Enum.KeyCode.F] = "Nitro", [Enum.KeyCode.E] = "Up", [Enum.KeyCode.Q] = "Down", [Enum.KeyCode.ButtonX] = "Nitro" }
UserInputService.InputBegan:Connect(function(input, processed)
	local key = keyMap[input.KeyCode]
	if key and not processed then
		held[key] = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	local key = keyMap[input.KeyCode]
	if key then
		held[key] = false
	end
end)

local function setFov(fov)
	if fovTween then
		fovTween:Cancel()
	end
	fovTween = TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { FieldOfView = fov })
	fovTween:Play()
end

local function setNitro(on)
	if on ~= nitroOn then
		nitroOn = on
		NitroRemote:FireServer(on)
		setFov(on and 88 or BASE_FOV)
	end
end

---------------------------------------------------------------------------
-- Boost pads
---------------------------------------------------------------------------
local padsFolder = nil
local function onBoostPad(position)
	if not padsFolder then
		local city = workspace:FindFirstChild("City")
		padsFolder = city and city:FindFirstChild("BoostPads")
		if not padsFolder then
			return false
		end
	end
	for _, pad in ipairs(padsFolder:GetChildren()) do
		local p = pad.CFrame:PointToObjectSpace(position)
		if math.abs(p.X) <= pad.Size.X / 2 and math.abs(p.Z) <= pad.Size.Z / 2 and p.Y < 6 then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Main loop
---------------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if not seat or not seat:IsA("VehicleSeat") or seat.Name ~= "DriveSeat" then
		if currentSeat then
			currentSeat = nil
			speed = 0
			setNitro(false)
			gui.Enabled = false
		end
		fuel = math.min(1, fuel + dt / Config.Nitro.Recharge)
		return
	end
	local car = seat.Parent
	local body = car and car:FindFirstChild("Body")
	local drive = body and body:FindFirstChild("Drive")
	local steer = body and body:FindFirstChild("Steer")
	if not drive or not steer then
		return
	end
	if seat ~= currentSeat then
		currentSeat = seat
		speed = 0
		gui.Enabled = true
	end

	local flying = car:GetAttribute("Fly") == true
	upButton.Visible = flying
	downButton.Visible = flying

	local maxSpeed = car:GetAttribute("MaxSpeed") or 70
	local turnRate = car:GetAttribute("TurnRate") or 1.8
	local spiked = (body:GetAttribute("SpikedUntil") or 0) > workspace:GetServerTimeNow()
	if spiked then
		maxSpeed = maxSpeed * Config.SpikeSlowdown
	end

	local throttle = seat.ThrottleFloat
	local steerInput = seat.SteerFloat

	-- Nitro
	local wantNitro = held.Nitro and throttle > 0 and fuel > 0 and not spiked
	if wantNitro then
		fuel = math.max(0, fuel - dt / Config.Nitro.Duration)
	else
		fuel = math.min(1, fuel + dt / Config.Nitro.Recharge)
	end
	setNitro(wantNitro)
	local topSpeed = wantNitro and maxSpeed * Config.Nitro.Multiplier or maxSpeed

	local target = throttle * topSpeed
	if throttle < 0 then
		target = throttle * maxSpeed * 0.4 -- reverse is slower
	end
	local rate
	if throttle == 0 then
		rate = COAST
	elseif (target > 0 and speed < 0) or (target < 0 and speed > 0) then
		rate = BRAKE
	else
		rate = wantNitro and ACCEL * 2.5 or ACCEL
	end
	if speed < target then
		speed = math.min(speed + rate * dt, target)
	elseif speed > target then
		speed = math.max(speed - rate * dt, target)
	end

	-- Boost pads launch you instantly
	if not flying and not spiked and os.clock() - lastPadBoost > 1 and onBoostPad(body.Position) then
		lastPadBoost = os.clock()
		speed = math.max(speed, maxSpeed * Config.BoostPadMultiplier)
		fuel = 1
		setFov(95)
		task.delay(0.6, function()
			if not nitroOn then
				setFov(BASE_FOV)
			end
		end)
	end

	local look = body.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.01 then
		flat = flat.Unit
	end

	if flying and drive.VelocityConstraintMode == Enum.VelocityConstraintMode.Vector then
		local vertical = 0
		if held.Up then
			vertical = Config.FlySpeedVertical
		elseif held.Down then
			vertical = -Config.FlySpeedVertical
		end
		if body.Position.Y > Config.FlyMaxAltitude and vertical > 0 then
			vertical = 0
		end
		drive.VectorVelocity = Vector3.new(flat.X * speed, vertical, flat.Z * speed)
	else
		drive.PlaneVelocity = Vector2.new(flat.X * speed, flat.Z * speed)
	end

	-- Steering scales up with speed and flips in reverse, like a real car
	local grip = math.clamp(math.abs(speed) / 25, 0, 1)
	local direction = speed >= 0 and 1 or -1
	steer.AngularVelocity = Vector3.new(0, -steerInput * turnRate * grip * direction, 0)

	-- HUD
	speedLabel.Text = ("%d MPH"):format(math.floor(body.AssemblyLinearVelocity.Magnitude * 0.9))
	speedLabel.TextColor3 = wantNitro and Color3.fromRGB(0, 230, 255) or Color3.new(1, 1, 1)
	fuelFill.Size = UDim2.fromScale(fuel, 1)
	if spiked then
		statusLabel.Text = "TIRES SPIKED!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	elseif flying then
		statusLabel.Text = "NITRO [F]  UP [E]  DOWN [Q]"
		statusLabel.TextColor3 = Color3.fromRGB(180, 190, 210)
	else
		statusLabel.Text = "NITRO [F]"
		statusLabel.TextColor3 = Color3.fromRGB(180, 190, 210)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000015"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Getaway City - all player UI: team menu, HUD, store status, robbery bar,
-- notifications and the shop. Built in code so there are no assets to import.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local WHITE = Color3.new(1, 1, 1)
local PANEL = Color3.fromRGB(20, 22, 30)
local GREEN = Color3.fromRGB(90, 230, 120)
local RED = Color3.fromRGB(240, 70, 70)
local BLUE = Color3.fromRGB(70, 140, 255)
local ORANGE = Color3.fromRGB(255, 160, 60)
local GOLD = Color3.fromRGB(255, 210, 80)

local function new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function padding(px)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
	})
end

local function money(n)
	local s = tostring(math.floor(n or 0))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return "$" .. formatted
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or WHITE
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextScaled = props.TextScaled ~= false
	return new("TextLabel", props)
end

local function button(props, onClick)
	props.AutoButtonColor = true
	props.TextColor3 = props.TextColor3 or WHITE
	props.Font = props.Font or Enum.Font.GothamBlack
	props.TextScaled = true
	local b = new("TextButton", props, { corner(10), padding(6) })
	b.Activated:Connect(onClick)
	return b
end

local gui = new("ScreenGui", {
	Name = "GetawayUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

---------------------------------------------------------------------------
-- HUD (left side)
---------------------------------------------------------------------------
local hud = new("Frame", {
	Parent = gui, Name = "HUD", Position = UDim2.new(0, 12, 0.28, 0), Size = UDim2.new(0, 210, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = PANEL, BackgroundTransparency = 0.25,
}, { corner(12), padding(10), new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })

local teamLabel = label({ Parent = hud, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Text = "" })
local cashLabel = label({ Parent = hud, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 2, Text = "$0", TextColor3 = GREEN, Font = Enum.Font.GothamBlack })
local levelLabel = label({ Parent = hud, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 3, Text = "Level 1" })
local bagLabel = label({ Parent = hud, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 4, Text = "", TextColor3 = GOLD })
local bountyLabel = label({ Parent = hud, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, Text = "", TextColor3 = RED })
local jailLabel = label({ Parent = hud, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 6, Text = "", TextColor3 = ORANGE, TextWrapped = true })

local buttonRow = new("Frame", { Parent = hud, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 7, BackgroundTransparency = 1 }, {
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
})

---------------------------------------------------------------------------
-- Team selection menu
---------------------------------------------------------------------------
local menu = new("Frame", {
	Parent = gui, Name = "TeamMenu", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.35, ZIndex = 10,
})
label({
	Parent = menu, Text = string.upper(Config.GameName), Size = UDim2.new(0.8, 0, 0.12, 0), Position = UDim2.new(0.1, 0, 0.08, 0),
	Font = Enum.Font.GothamBlack, TextColor3 = GOLD, ZIndex = 11,
})
label({
	Parent = menu, Text = "Pick a side", Size = UDim2.new(0.6, 0, 0.05, 0), Position = UDim2.new(0.2, 0, 0.21, 0), ZIndex = 11,
})
local cards = new("Frame", {
	Parent = menu, Size = UDim2.new(0.8, 0, 0.5, 0), Position = UDim2.new(0.1, 0, 0.3, 0), BackgroundTransparency = 1, ZIndex = 11,
}, {
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0.04, 0),
	}),
})

local function teamCard(teamKey, title, blurb, color)
	local card = button({
		Parent = cards, Size = UDim2.new(0.4, 0, 1, 0), BackgroundColor3 = color, Text = "", ZIndex = 12,
	}, function()
		Remotes:WaitForChild("ChooseTeam"):FireServer(teamKey)
		if player.Character then
			-- already spawned: close the menu (the server respawns us if the team changes)
			menu.Visible = false
			hud.Visible = true
		end
	end)
	label({ Parent = card, Text = title, Size = UDim2.new(1, 0, 0.3, 0), Font = Enum.Font.GothamBlack, ZIndex = 13 })
	label({
		Parent = card, Text = blurb, Size = UDim2.new(1, 0, 0.55, 0), Position = UDim2.new(0, 0, 0.38, 0),
		Font = Enum.Font.GothamMedium, TextWrapped = true, ZIndex = 13,
	})
end
teamCard("Police", "POLICE", "Respond to alarms, chase robbers and cuff them to collect their bounty.", Color3.fromRGB(35, 80, 190))
teamCard("Criminal", "CRIMINAL", "Rob stores, outrun the cops and stash your loot at the Hideout.", Color3.fromRGB(180, 40, 40))

local function setMenuVisible(visible)
	menu.Visible = visible
	hud.Visible = not visible
end

---------------------------------------------------------------------------
-- Store status panel (right side)
---------------------------------------------------------------------------
local statusPanel = new("Frame", {
	Parent = gui, Name = "Stores", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0.28, 0),
	Size = UDim2.new(0, 230, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = PANEL, BackgroundTransparency = 0.25,
}, { corner(12), padding(10), new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
label({ Parent = statusPanel, Text = "STORES", Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, TextColor3 = GOLD })
local statusRows = {}
local statusFolder = ReplicatedStorage:WaitForChild("RobberyStatus")

---------------------------------------------------------------------------
-- Robbery progress bar (above the hotbar)
---------------------------------------------------------------------------
local robBar = new("Frame", {
	Parent = gui, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Size = UDim2.new(0, 360, 0, 46),
	BackgroundColor3 = PANEL, BackgroundTransparency = 0.2, Visible = false,
}, { corner(10) })
local robFill = new("Frame", {
	Parent = robBar, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = GOLD, BorderSizePixel = 0,
}, { corner(10) })
local robText = label({ Parent = robBar, Size = UDim2.new(1, -16, 1, -12), Position = UDim2.new(0, 8, 0, 6), Text = "", ZIndex = 2 })

---------------------------------------------------------------------------
-- Notifications (top center)
---------------------------------------------------------------------------
local notifyList = new("Frame", {
	Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(0.6, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 30,
}, { new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })

local kindColors = { info = WHITE, good = GREEN, bad = ORANGE, alarm = RED }
local function notify(text, kind)
	local items = {}
	for _, child in ipairs(notifyList:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(items, child)
		end
	end
	if #items >= 4 then
		items[1]:Destroy()
	end
	local item = label({
		Parent = notifyList, Text = text, Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 0.25,
		BackgroundColor3 = PANEL, TextColor3 = kindColors[kind] or WHITE, TextWrapped = true,
	})
	corner(8).Parent = item
	padding(4).Parent = item
	task.delay(kind == "alarm" and 7 or 5, function()
		if item.Parent then
			local tween = TweenService:Create(item, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			item:Destroy()
		end
	end)
end
Remotes:WaitForChild("Notify").OnClientEvent:Connect(notify)

---------------------------------------------------------------------------
-- Shop
---------------------------------------------------------------------------
local shop = new("Frame", {
	Parent = gui, Name = "Shop", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 340, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = PANEL, Visible = false, ZIndex = 20,
}, { corner(14), padding(14), new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
label({ Parent = shop, Text = "SHOP", Size = UDim2.new(1, 0, 0, 34), TextColor3 = GOLD, LayoutOrder = 0, ZIndex = 21 })

local function shopButton(order, text, color, enabled, onClick)
	button({
		Parent = shop, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 44), ZIndex = 21,
		BackgroundColor3 = enabled and color or Color3.fromRGB(70, 70, 75),
		Text = enabled and text or (text .. " (coming soon)"),
	}, function()
		if enabled then
			onClick()
		end
	end)
end

local vipId = Config.GamePasses.VIP
shopButton(1, "VIP: 2x Cash + Big Bag", GOLD, vipId ~= 0, function()
	MarketplaceService:PromptGamePassPurchase(player, vipId)
end)
for i, product in ipairs(Config.CashProducts) do
	shopButton(1 + i, product.Label .. " Cash", Color3.fromRGB(40, 150, 70), product.Id ~= 0, function()
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end)
end
shopButton(10, "Close", Color3.fromRGB(90, 90, 100), true, function()
	shop.Visible = false
end)

---------------------------------------------------------------------------
-- HUD buttons
---------------------------------------------------------------------------
local function teamKey()
	if not player.Team then
		return nil
	end
	for key, info in pairs(Config.Teams) do
		if player.Team.Name == info.Name then
			return key
		end
	end
	return nil
end

button({ Parent = buttonRow, Size = UDim2.new(0.5, -3, 1, 0), BackgroundColor3 = Color3.fromRGB(60, 60, 75), Text = "TEAM" }, function()
	if teamKey() == "Prisoner" then
		notify("You can't switch teams while in jail!", "bad")
		return
	end
	setMenuVisible(true)
end)
button({ Parent = buttonRow, Size = UDim2.new(0.5, -3, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 150, 70), Text = "SHOP" }, function()
	shop.Visible = not shop.Visible
end)

---------------------------------------------------------------------------
-- Menu camera + showing/hiding the menu
---------------------------------------------------------------------------
local camera = workspace.CurrentCamera
local function menuCamera()
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(Vector3.new(-260, 140, 320), Vector3.new(0, 0, -40))
end

setMenuVisible(true)
menuCamera()

player.CharacterAdded:Connect(function(character)
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = character:WaitForChild("Humanoid")
	setMenuVisible(false)
end)

---------------------------------------------------------------------------
-- Refresh loop
---------------------------------------------------------------------------
local teamText = {
	Police = { "POLICE OFFICER", BLUE },
	Criminal = { "CRIMINAL", RED },
	Prisoner = { "PRISONER", ORANGE },
}

local function refreshStatus(now, myLevel)
	for _, value in ipairs(statusFolder:GetChildren()) do
		local row = statusRows[value]
		if not row then
			row = label({
				Parent = statusPanel, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = value:GetAttribute("Order") or 99,
				TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamMedium,
			})
			statusRows[value] = row
		end
		local name = value:GetAttribute("DisplayName") or value.Name
		local minLevel = value:GetAttribute("MinLevel") or 1
		if value.Value == "OPEN" then
			row.Text = name .. ": OPEN"
			row.TextColor3 = GREEN
		elseif value.Value == "ALARM" then
			row.Text = name .. ": ALARM!"
			row.TextColor3 = RED
		else
			local left = math.max(0, math.ceil((value:GetAttribute("ReopenAt") or now) - now))
			row.Text = ("%s: closed %d:%02d"):format(name, math.floor(left / 60), left % 60)
			row.TextColor3 = Color3.fromRGB(160, 160, 160)
		end
		if myLevel < minLevel then
			row.Text = row.Text .. " (Lv " .. minLevel .. ")"
		end
	end
end

while true do
	task.wait(0.2)
	local now = workspace:GetServerTimeNow()
	local key = teamKey()
	local stats = player:FindFirstChild("leaderstats")
	local cash = stats and stats:FindFirstChild("Cash")
	local level = stats and stats:FindFirstChild("Level")
	local myLevel = level and level.Value or 1

	cashLabel.Text = money(cash and cash.Value or 0)
	levelLabel.Text = "Level " .. myLevel .. (player:GetAttribute("VIP") and "  |  VIP" or "")
	local info = key and teamText[key]
	teamLabel.Text = info and info[1] or ""
	teamLabel.TextColor3 = info and info[2] or WHITE

	local isCriminal = key == "Criminal"
	bagLabel.Visible = isCriminal
	bountyLabel.Visible = isCriminal
	bagLabel.Text = "Bag: " .. money(player:GetAttribute("Bag"))
	bountyLabel.Text = "Bounty: " .. money(player:GetAttribute("Bounty"))

	local release = player:GetAttribute("JailRelease")
	jailLabel.Visible = key == "Prisoner" and release ~= nil
	if release then
		jailLabel.Text = ("Released in %ds... or find a way out"):format(math.max(0, math.ceil(release - now)))
	end

	local robName = player:GetAttribute("RobName")
	robBar.Visible = robName ~= nil
	if robName then
		local p = player:GetAttribute("RobProgress") or 0
		robFill.Size = UDim2.new(p, 0, 1, 0)
		robText.Text = (key == "Prisoner" and "Unscrewing %s... %d%%" or "Robbing %s... %d%%"):format(robName, math.floor(p * 100))
	end

	refreshStatus(now, myLevel)
end
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
