# ---------------------------------------------------------------------------
# Velora environment. Copy to .env.local for local development.
# Never commit real values. Only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for credits, storage signing and status sync. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for auth email redirect links), e.g. https://velora.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Runway API (https://dev.runwayml.com). Name required by the official @runwayml/sdk.
RUNWAYML_API_SECRET=

# Prompt enhancement (optional). LLM_PROVIDER currently supports: anthropic
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional model override (defaults to claude-opus-5)
LLM_MODEL=

# Credits granted once to each new account (default 100)
VELORA_SIGNUP_CREDITS=100

# Secret for the background status sweep (/api/cron/sync). Vercel Cron sends it automatically.
CRON_SECRET=
