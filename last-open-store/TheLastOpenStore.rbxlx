		Prefers = { "Drinks", "Sweets" }, Flexible = true, PriceMult = 1.3, TipChance = 0.6, Tip = 0.3,
		Spawn = { Time = "Night", RequiresClue = "f2" }, Mystery = "founder", Speed = 1,
		Lines = { Enter = { "My grandparent ran the first store here, before it closed. Did you know?" }, Happy = { "There was a photo of the opening night, somewhere in the empty lot..." }, Sad = { "Maybe another night." }, Good = { "This place feels just like the old stories." }, Bad = { "I hoped it would feel more welcoming." } } },
}

CustomerTypes.ById = {}
for _, t in ipairs(CustomerTypes.List) do
	CustomerTypes.ById[t.Id] = t
end

-- Hint shown in the journal before you've met a customer type
function CustomerTypes.Hint(t)
	local s = t.Spawn
	if s.RequiresClue then
		return "Appears once a certain story begins..."
	elseif s.HourMin then
		return "Only appears late at night, around 11 PM."
	elseif s.Weather then
		return s.Time == "Night" and "Only on rainy nights." or "Only when it rains."
	elseif s.Time == "Night" then
		return "Only comes out at night."
	elseif s.Time == "Day" then
		return "Only visits during the day."
	end
	return "Visits any time."
end

return CustomerTypes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Turns a set of owned upgrades into the store's live stats.
local Config = require(script.Parent.Config)
local Upgrades = require(script.Parent.Upgrades)

local Effects = {}

function Effects.Defaults()
	return {
		SlotCapacity = Config.BaseSlotCapacity,
		Expansion = 1,
		Patience = 1,
		CheckoutDelay = nil, -- nil = you must ring customers up yourself
		RestockInterval = nil, -- nil = no stock clerk
		CustomerRate = 1,
		MaxCustomers = Config.MaxCustomersPerStore,
		PriceMult = 1,
		StockDiscount = 0,
		NightRate = 1,
		NightPrice = 1,
		RareChance = 1,
		TipChance = 0,
	}
end

function Effects.Compute(owned)
	local stats = Effects.Defaults()
	for id in pairs(owned or {}) do
		local upgrade = Upgrades.ById[id]
		if upgrade then
			for _, e in ipairs(upgrade.Effects) do
				local current = stats[e.Stat]
				if e.Op == "Add" then
					stats[e.Stat] = (current or 0) + e.Value
				elseif e.Op == "Max" then
					stats[e.Stat] = math.max(current or e.Value, e.Value)
				elseif e.Op == "Min" then
					stats[e.Stat] = current and math.min(current, e.Value) or e.Value
				end
			end
		end
	end
	return stats
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[-- Night events (10, one may roll each night, shared by the whole server)
-- and weekly events (rotate every Monday 00:00 UTC).
local Events = {}

Events.Night = {
	{ Id = "Downpour", Name = "Downpour", Weight = 14, Weather = "Storm",
		Desc = "A storm rolls in. Soaked travelers flood into open stores: +40% customers.",
		Mods = { CustomerRate = 1.4, TypeBoost = { wanderer = 4 } }, Color = Color3.fromRGB(90, 150, 255) },
	{ Id = "Craving", Name = "Craving Wave", Weight = 14,
		Desc = "The whole town suddenly wants %s! Those sell for double tonight.",
		Mods = { CategoryMult = 2 }, Color = Color3.fromRGB(255, 150, 60) },
	{ Id = "Fog", Name = "Fog Night", Weight = 10, Weather = "Fog",
		Desc = "A thick fog. Mysterious customers are three times as likely to appear.",
		Mods = { MysteryMult = 3 }, Color = Color3.fromRGB(180, 190, 210) },
	{ Id = "MoonlightMarket", Name = "Moonlight Market", Weight = 9,
		Desc = "Limited time: Moonlight Mooncakes can be ordered tonight only.",
		Mods = { CustomerRate = 1.1 }, Color = Color3.fromRGB(240, 210, 140) },
	{ Id = "Message", Name = "Mysterious Message", Weight = 9,
		Desc = "A folded note appeared on every counter. Read yours.",
		Mods = {}, Color = Color3.fromRGB(220, 120, 255) },
	{ Id = "Blackout", Name = "Blackout", Weight = 9,
		Desc = "The streetlights went out, but your store is still glowing. Tips are doubled.",
		Mods = { TipMult = 2, CustomerRate = 1.15 }, Color = Color3.fromRGB(255, 220, 120) },
	{ Id = "ShootingStars", Name = "Shooting Stars", Weight = 10,
		Desc = "Stars are falling around town! Catch them, and order Shooting Star Candy tonight.",
		Mods = {}, Color = Color3.fromRGB(255, 250, 190) },
	{ Id = "NightOwls", Name = "Night Owl Parade", Weight = 10,
		Desc = "The night owls are out in force: +30% customers, mostly night owls and gamers.",
		Mods = { CustomerRate = 1.3, TypeBoost = { nightowl = 4, gamer = 4 } }, Color = Color3.fromRGB(150, 120, 255) },
	{ Id = "CollectorsNight", Name = "Collector's Night", Weight = 9,
		Desc = "Collectors are in town paying 3x for rare items. Vintage Comics can be ordered tonight.",
		Mods = { TypeBoost = { collector = 6 }, RareMult = 3 }, Color = Color3.fromRGB(90, 170, 255) },
	{ Id = "Aurora", Name = "Aurora", Weight = 4,
		Desc = "Very rare: the sky shimmers green. All sales +25% and Aurora Jelly is available!",
		Mods = { PriceMult = 1.25 }, Color = Color3.fromRGB(120, 255, 180) },
}
Events.NightById = {}
for _, e in ipairs(Events.Night) do
	Events.NightById[e.Id] = e
end

Events.Weekly = {
	{ Id = "SnackWeek", Name = "Snack Week", Desc = "Snacks sell for 20% more all week.", Category = "Snacks", Mult = 1.2 },
	{ Id = "DrinkWeek", Name = "Hydration Week", Desc = "Drinks sell for 20% more all week.", Category = "Drinks", Mult = 1.2 },
	{ Id = "SweetWeek", Name = "Sweet Tooth Week", Desc = "Sweets sell for 20% more all week.", Category = "Sweets", Mult = 1.2 },
	{ Id = "NoodleWeek", Name = "Noodle Week", Desc = "Instant food sells for 20% more all week.", Category = "Instant", Mult = 1.2 },
	{ Id = "HomeWeek", Name = "Home Essentials Week", Desc = "Household goods sell for 20% more all week.", Category = "Household", Mult = 1.2 },
}

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Products</string><ProtectedString name="Source"><![CDATA[-- All 50 products. Cost = wholesale price, Price = shelf price.
-- Cold products (drinks) must go in a Cooler; everything else on a Shelf.
-- Availability:
--   Level        normal products unlock as you level up
--   Event        only orderable during that night event (rare collectibles)
--   Weather      only orderable during that weather
--   Secret       unlocked by solving mystery clues
local Products = {}
Products.List = {}
Products.ById = {}

Products.Categories = { "Snacks", "Drinks", "Instant", "Sweets", "Household" }
Products.RarityColors = {
	Common = Color3.fromRGB(190, 196, 210),
	Uncommon = Color3.fromRGB(110, 220, 140),
	Rare = Color3.fromRGB(90, 170, 255),
	Legendary = Color3.fromRGB(255, 190, 70),
	Secret = Color3.fromRGB(220, 120, 255),
}

local function add(id, name, category, cost, price, level, rarity, color, shape, extra)
	local product = {
		Id = id, Name = name, Category = category, Cost = cost, Price = price,
		Level = level, Rarity = rarity, Color = color, Shape = shape,
		Cold = category == "Drinks",
		Order = #Products.List + 1,
	}
	for k, v in pairs(extra or {}) do
		product[k] = v
	end
	table.insert(Products.List, product)
	Products.ById[id] = product
end

local C = Color3.fromRGB

-- Snacks (8)
add("chips", "Salted Chips", "Snacks", 4, 7, 1, "Common", C(240, 200, 60), "Bag")
add("puffs", "Cheese Puffs", "Snacks", 4, 7, 1, "Common", C(255, 150, 40), "Bag")
add("pretzel", "Pretzel Twists", "Snacks", 5, 9, 2, "Common", C(180, 120, 60), "Bag")
add("seaweed", "Seaweed Crisps", "Snacks", 6, 11, 3, "Common", C(40, 120, 70), "Box")
add("curls", "Spicy Corn Curls", "Snacks", 7, 13, 4, "Uncommon", C(230, 60, 40), "Bag")
add("trailmix", "Trail Mix", "Snacks", 9, 16, 5, "Uncommon", C(150, 110, 70), "Jar")
add("ricecracker", "Rice Crackers", "Snacks", 10, 18, 6, "Uncommon", C(235, 225, 200), "Box")
add("popcorn", "Midnight Popcorn", "Snacks", 12, 22, 8, "Uncommon", C(60, 50, 120), "Bag")

-- Drinks (9) - need a cooler
add("cola", "Cola", "Drinks", 3, 6, 1, "Common", C(200, 30, 40), "Can")
add("lemonfizz", "Lemon Fizz", "Drinks", 3, 6, 1, "Common", C(250, 240, 90), "Can")
add("water", "Bottled Water", "Drinks", 2, 4, 1, "Common", C(150, 210, 255), "Bottle")
add("icedtea", "Iced Tea", "Drinks", 4, 8, 2, "Common", C(170, 90, 40), "Bottle")
add("energy", "Volt Energy", "Drinks", 7, 13, 4, "Uncommon", C(80, 255, 120), "Can")
add("coldbrew", "Cold Brew", "Drinks", 9, 16, 5, "Uncommon", C(60, 40, 30), "Bottle")
add("melonmilk", "Melon Milk", "Drinks", 10, 18, 6, "Uncommon", C(150, 230, 150), "Box")
add("yuzu", "Sparkling Yuzu", "Drinks", 13, 24, 9, "Rare", C(255, 210, 60), "Bottle")
add("bubbletea", "Bubble Tea Kit", "Drinks", 16, 30, 10, "Rare", C(210, 170, 140), "Bottle")

-- Instant food (7)
add("noodles", "Cup Noodles", "Instant", 5, 9, 2, "Common", C(240, 80, 60), "Jar")
add("riceball", "Rice Ball", "Instant", 6, 11, 3, "Common", C(245, 245, 245), "Box")
add("dumplings", "Frozen Dumplings", "Instant", 10, 18, 5, "Uncommon", C(220, 220, 255), "Box")
add("hotbun", "Steamed Bun", "Instant", 9, 17, 6, "Uncommon", C(250, 235, 210), "Box")
add("curry", "Instant Curry", "Instant", 12, 22, 7, "Uncommon", C(200, 140, 30), "Box")
add("ramen", "Late-Night Ramen", "Instant", 15, 28, 9, "Rare", C(255, 120, 60), "Jar")
add("pizza", "Microwave Pizza", "Instant", 20, 36, 11, "Rare", C(220, 60, 50), "Box")

-- Sweets (7)
add("gummy", "Gummy Worms", "Sweets", 3, 6, 1, "Common", C(255, 100, 180), "Bag")
add("choco", "Chocolate Bar", "Sweets", 4, 8, 2, "Common", C(110, 60, 40), "Box")
add("mints", "Mint Tin", "Sweets", 5, 9, 3, "Common", C(120, 230, 210), "Box")
add("mochi", "Strawberry Mochi", "Sweets", 10, 18, 6, "Uncommon", C(255, 170, 190), "Box")
add("pudding", "Caramel Pudding", "Sweets", 12, 22, 8, "Uncommon", C(230, 170, 70), "Jar")
add("starcandy", "Star Candy", "Sweets", 14, 26, 10, "Rare", C(255, 230, 120), "Jar")
add("marshmallow", "Cloud Marshmallows", "Sweets", 18, 32, 12, "Rare", C(250, 250, 255), "Bag")

-- Household (6)
add("umbrella", "Umbrella", "Household", 12, 22, 3, "Common", C(60, 90, 200), "Bottle")
add("batteries", "Batteries", "Household", 8, 15, 4, "Common", C(40, 40, 45), "Box")
add("charger", "Phone Charger", "Household", 18, 32, 7, "Uncommon", C(240, 240, 240), "Box")
add("flashlight", "Flashlight", "Household", 20, 36, 8, "Uncommon", C(255, 200, 40), "Bottle")
add("raincoat", "Raincoat", "Household", 26, 46, 10, "Rare", C(255, 220, 40), "Bag")
add("nightlight", "Moon Night-Light", "Household", 30, 55, 13, "Rare", C(200, 210, 255), "Jar")

-- Rare collectibles (8)
add("glowsoda", "Glow Soda", "Drinks", 25, 50, 12, "Rare", C(100, 255, 220), "Can")
add("goldsticks", "Golden Biscuit Sticks", "Snacks", 30, 60, 14, "Legendary", C(255, 200, 60), "Box")
add("luckycharm", "Lucky Cat Charm", "Household", 45, 90, 16, "Legendary", C(255, 240, 230), "Jar")
add("cocoa", "Rainy Day Cocoa", "Instant", 14, 30, 1, "Rare", C(120, 70, 50), "Jar", { Weather = "Rain" })
add("aurorajelly", "Aurora Jelly", "Sweets", 40, 95, 1, "Legendary", C(120, 255, 180), "Jar", { Event = "Aurora" })
add("shootingcandy", "Shooting Star Candy", "Sweets", 20, 48, 1, "Rare", C(255, 250, 200), "Bag", { Event = "ShootingStars" })
add("mooncake", "Moonlight Mooncake", "Sweets", 22, 50, 1, "Rare", C(240, 210, 140), "Box", { Event = "MoonlightMarket" })
add("comic", "Vintage Comic", "Household", 60, 140, 1, "Legendary", C(230, 80, 60), "Box", { Event = "CollectorsNight" })

-- Secret products (5), unlocked by mysteries
add("stamp", "Vintage Stamp", "Household", 15, 40, 1, "Secret", C(200, 90, 70), "Box", { Secret = true })
add("lemonade", "Lighthouse Lemonade", "Drinks", 12, 32, 1, "Secret", C(255, 250, 150), "Bottle", { Secret = true })
add("buttoncookie", "Button Cookies", "Sweets", 10, 28, 1, "Secret", C(210, 160, 110), "Jar", { Secret = true })
add("toffee", "Clockwork Toffee", "Sweets", 14, 36, 1, "Secret", C(190, 130, 50), "Box", { Secret = true })
add("foundersoda", "Founder's Soda", "Drinks", 20, 60, 1, "Secret", C(255, 150, 90), "Bottle", { Secret = true })

-- Can this product be ordered right now?
-- ctx = { Level, Secrets = {id=true}, EventId, Weather }
function Products.CanOrder(product, ctx)
	if product.Secret then
		if ctx.Secrets and ctx.Secrets[product.Id] then
			return true
		end
		return false, "Secret: solve a mystery"
	end
	if product.Event then
		if ctx.EventId == product.Event then
			return true
		end
		return false, "Only during a special night event"
	end
	if product.Weather then
		if ctx.Weather == product.Weather or (product.Weather == "Rain" and ctx.Weather == "Storm") then
			return true
		end
		return false, "Only when it rains"
	end
	if (ctx.Level or 1) < product.Level then
		return false, "Reach level " .. product.Level
	end
	return true
end

return Products
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Unlocks</string><ProtectedString name="Source"><![CDATA[-- Checks "any of" unlock rules for cosmetics.
-- ctx = { Level, Achievements, Solved, Robux, Month, SeasonUnlocks, Streak, BestStreak }
local Unlocks = {}

local MYSTERY_NAMES = {
	letters = "Letters to Nowhere",
	lighthouse = "The Lighthouse Hum",
	buttons = "The Cat Who Pays in Buttons",
	clock = "The Stopped Clock",
	founder = "The Store That Was Here Before",
}
local MONTHS = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }

local function check(rule, ctx)
	local t = rule.Type
	if t == "Free" then
		return true
	elseif t == "Level" then
		return (ctx.Level or 1) >= rule.Level, "Reach level " .. rule.Level
	elseif t == "Achievement" then
		return ctx.Achievements and ctx.Achievements[rule.Id] ~= nil, "Achievement reward"
	elseif t == "Mystery" then
		return ctx.Solved and ctx.Solved[rule.Id] ~= nil, "Solve \"" .. (MYSTERY_NAMES[rule.Id] or "a mystery") .. "\""
	elseif t == "Season" then
		local ok = (ctx.Month == rule.Month) or (ctx.SeasonUnlocks and ctx.SeasonUnlocks[tostring(rule.Month)] ~= nil)
		return ok, "Log in during " .. MONTHS[rule.Month]
	elseif t == "Streak" then
		return (ctx.BestStreak or 0) >= rule.Days, rule.Days .. "-day login streak"
	elseif t == "Robux" then
		return ctx.Robux and ctx.Robux[rule.Key] ~= nil, "Robux"
	end
	return false, "Locked"
end

-- returns unlocked, reasonText (first non-Robux reason, for display)
function Unlocks.Check(rules, ctx)
	local reason = nil
	for _, rule in ipairs(rules or {}) do
		local ok, why = check(rule, ctx)
		if ok then
			return true
		end
		if not reason and rule.Type ~= "Robux" then
			reason = why
		end
	end
	return false, reason or "Locked"
end

function Unlocks.RobuxKey(rules)
	for _, rule in ipairs(rules or {}) do
		if rule.Type == "Robux" then
			return rule.Key
		end
	end
	return nil
end

function Unlocks.Context(data, level)
	return {
		Level = level,
		Achievements = data.Achievements,
		Solved = data.Solved,
		Robux = data.Owned.Robux,
		Month = os.date("!*t").month,
		SeasonUnlocks = data.SeasonUnlocks,
		BestStreak = data.Daily.BestStreak,
	}
end

Unlocks.MysteryNames = MYSTERY_NAMES
return Unlocks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[-- 30 store upgrades in 6 branches. Each has a cost, a level requirement, an
-- optional prerequisite and one or more effects that Effects.lua aggregates.
-- Effect ops: Add (numbers stack), Max (highest wins), Min (lowest wins).
local Upgrades = {}
Upgrades.List = {}
Upgrades.ById = {}
Upgrades.Branches = { "Shelves", "Service", "Marketing", "Pricing", "Night", "Special" }

local function add(id, branch, name, desc, cost, level, requires, effects)
	local u = { Id = id, Branch = branch, Name = name, Desc = desc, Cost = cost, Level = level, Requires = requires, Effects = effects, Order = #Upgrades.List + 1 }
	table.insert(Upgrades.List, u)
	Upgrades.ById[id] = u
end

local function fx(stat, op, value)
	return { Stat = stat, Op = op, Value = value }
end

-- Shelves & expansion
add("sturdyShelves", "Shelves", "Sturdy Shelves", "+4 items per shelf slot.", 150, 1, nil, { fx("SlotCapacity", "Add", 4) })
add("tallShelves", "Shelves", "Tall Shelves", "+4 more items per slot.", 900, 4, "sturdyShelves", { fx("SlotCapacity", "Add", 4) })
add("warehouseRacks", "Shelves", "Warehouse Racks", "+8 more items per slot.", 6000, 10, "tallShelves", { fx("SlotCapacity", "Add", 8) })
add("expandCorner", "Shelves", "Corner Store Expansion", "Knock down the back wall: +2 shelves, +1 cooler.", 1200, 3, nil, { fx("Expansion", "Max", 2) })
add("expandMiniMart", "Shelves", "Mini Mart Expansion", "Expand again: +2 shelves, +1 cooler.", 8000, 8, "expandCorner", { fx("Expansion", "Max", 3) })
add("expandNightMarket", "Shelves", "Night Market Expansion", "The full store: +2 shelves, +1 cooler.", 30000, 15, "expandMiniMart", { fx("Expansion", "Max", 4) })

-- Service
add("friendlyBell", "Service", "Friendly Door Bell", "Customers wait 15% longer.", 200, 2, nil, { fx("Patience", "Add", 0.15) })
add("queueMats", "Service", "Comfy Queue Mats", "Customers wait another 15% longer.", 1500, 5, "friendlyBell", { fx("Patience", "Add", 0.15) })
add("music", "Service", "Lo-fi Store Radio", "Customers wait 20% longer.", 5000, 9, "queueMats", { fx("Patience", "Add", 0.2) })
add("cashier", "Service", "Part-time Cashier", "Auto rings up customers after 6s.", 2500, 6, nil, { fx("CheckoutDelay", "Min", 6) })
add("scanner", "Service", "Speedy Scanner", "Auto checkout after 3s.", 9000, 11, "cashier", { fx("CheckoutDelay", "Min", 3) })
add("express", "Service", "Express Lane", "Auto checkout after 1.5s.", 25000, 16, "scanner", { fx("CheckoutDelay", "Min", 1.5) })
add("stockClerk", "Service", "Stock Clerk", "Refills one shelf slot from the backroom every 10s.", 4000, 7, nil, { fx("RestockInterval", "Min", 10) })
add("nightClerk", "Service", "Night Clerk", "Refills a slot every 4s.", 15000, 13, "stockClerk", { fx("RestockInterval", "Min", 4) })

-- Marketing
add("posters", "Marketing", "Window Posters", "+15% customers.", 300, 2, nil, { fx("CustomerRate", "Add", 0.15) })
add("neonSign", "Marketing", "Neon Sign", "+15% customers.", 1800, 5, "posters", { fx("CustomerRate", "Add", 0.15) })
add("flyers", "Marketing", "Street Flyers", "+20% customers.", 7000, 9, "neonSign", { fx("CustomerRate", "Add", 0.2) })
add("buzz", "Marketing", "Town Buzz", "+25% customers.", 20000, 14, "flyers", { fx("CustomerRate", "Add", 0.25) })
add("doorway", "Marketing", "Extra Doorway", "+1 customer in the store at once.", 1000, 4, nil, { fx("MaxCustomers", "Add", 1) })
add("aisles", "Marketing", "Wider Aisles", "+1 customer at once.", 6000, 9, "doorway", { fx("MaxCustomers", "Add", 1) })
add("entrance", "Marketing", "Grand Entrance", "+2 customers at once.", 22000, 15, "aisles", { fx("MaxCustomers", "Add", 2) })

-- Pricing
add("priceTags", "Pricing", "Neat Price Tags", "Products sell for 5% more.", 500, 3, nil, { fx("PriceMult", "Add", 0.05) })
add("displays", "Pricing", "Premium Displays", "Products sell for 10% more.", 4500, 8, "priceTags", { fx("PriceMult", "Add", 0.1) })
add("boutique", "Pricing", "Boutique Lighting", "Products sell for 10% more.", 18000, 13, "displays", { fx("PriceMult", "Add", 0.1) })
add("bulkCard", "Pricing", "Bulk Buyer Card", "Stock costs 10% less.", 800, 4, nil, { fx("StockDiscount", "Add", 0.1) })
add("wholesale", "Pricing", "Wholesale Contract", "Stock costs another 10% less.", 10000, 12, "bulkCard", { fx("StockDiscount", "Add", 0.1) })

-- Night
add("nightLamps", "Night", "Cozy Night Lamps", "+25% customers at night.", 2000, 6, nil, { fx("NightRate", "Add", 0.25) })
add("lateMenu", "Night", "Late-Night Menu", "Night sales earn 15% more.", 12000, 12, "nightLamps", { fx("NightPrice", "Add", 0.15) })

-- Special
add("luckyStatue", "Special", "Lucky Cat Statue", "Mysterious customers visit 50% more often.", 7500, 10, nil, { fx("RareChance", "Add", 0.5) })
add("tipJar", "Special", "Tip Jar", "+15% chance customers leave a tip.", 350, 2, nil, { fx("TipChance", "Add", 0.15) })

return Upgrades
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[-- Small helpers shared by server and client.
local Util = {}

function Util.Money(n)
	n = math.floor(n or 0)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (n < 0 and "-$" or "$") .. out
end

function Util.Clock(clockTime)
	local hours = math.floor(clockTime) % 24
	local minutes = math.floor((clockTime % 1) * 60)
	local suffix = hours >= 12 and "PM" or "AM"
	local h12 = hours % 12
	if h12 == 0 then
		h12 = 12
	end
	return ("%d:%02d %s"):format(h12, minutes, suffix)
end

-- UTC day number; daily rewards/challenges roll over at 00:00 UTC
function Util.DayNumber(timestamp)
	return math.floor((timestamp or os.time()) / 86400)
end

function Util.WeekNumber(timestamp)
	-- weeks start on Monday (Unix epoch was a Thursday)
	return math.floor(((timestamp or os.time()) / 86400 + 3) / 7)
end

function Util.Stars(rating)
	local full = math.floor(rating + 0.5)
	return string.rep("★", full) .. string.rep("☆", 5 - full)
end

function Util.Count(t)
	local n = 0
	for _ in pairs(t or {}) do
		n = n + 1
	end
	return n
end

function Util.IsNight(clockTime, nightStart, nightEnd)
	return clockTime >= nightStart or clockTime < nightEnd
end

-- Deterministic shuffle so every server picks the same daily challenges
function Util.SeededPick(list, count, seed)
	local rng = Random.new(seed)
	local indices = {}
	for i = 1, #list do
		indices[i] = i
	end
	for i = #indices, 2, -1 do
		local j = rng:NextInteger(1, i)
		indices[i], indices[j] = indices[j], indices[i]
	end
	local picked = {}
	for i = 1, math.min(count, #indices) do
		table.insert(picked, list[indices[i]])
	end
	return picked
end

return Util
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000021"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000020"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000000F"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- The Last Open Store - server entry point.
-- Builds the town, then starts every service. DataService starts LAST so all
-- listeners exist before the first player's save finishes loading.
local Services = script.Parent:WaitForChild("Services")

local Log = require(Services.Log)
local WorldBuilder = require(Services.WorldBuilder)
local CycleService = require(Services.CycleService)
local EconomyService = require(Services.EconomyService)
local StoreService = require(Services.StoreService)
local CustomerService = require(Services.CustomerService)
local ProgressionService = require(Services.ProgressionService)
local MysteryService = require(Services.MysteryService)
local SocialService = require(Services.SocialService)
local ShopService = require(Services.ShopService)
local StateService = require(Services.StateService)
local DataService = require(Services.DataService)

local started = os.clock()
local world = WorldBuilder.Build()

CycleService.Init(world)
EconomyService.Init(StoreService.EffectsFor)
StoreService.Init(world)
CustomerService.Init(world)
ProgressionService.Init(world)
MysteryService.Init(world)
SocialService.Init()
ShopService.Init()
StateService.Init()
DataService.Init()

print(("[LOS] The Last Open Store is open (built in %.2fs)"):format(os.clock() - started))
Log.Info("Boot", "debug logging enabled")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000001F"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Bus</string><ProtectedString name="Source"><![CDATA[-- A tiny in-server event bus so services can react to each other without
-- requiring each other (no circular dependencies).
--   Bus.On("Sale", function(player, info) ... end)
--   Bus.Fire("Sale", player, info)
-- Listeners run in their own thread; one failing listener never breaks others.
local Log = require(script.Parent.Log)

local Bus = {}
local listeners = {}

function Bus.On(name, callback)
	listeners[name] = listeners[name] or {}
	table.insert(listeners[name], callback)
end

function Bus.Fire(name, ...)
	local list = listeners[name]
	if not list then
		return
	end
	for _, callback in ipairs(list) do
		task.spawn(function(...)
			local ok, err = pcall(callback, ...)
			if not ok then
				Log.Warn("Bus", name, err)
			end
		end, ...)
	end
end

return Bus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">CustomerService</string><ProtectedString name="Source"><![CDATA[-- Customer AI + ambient pedestrians.
--
-- Each customer is a real R15 character driven by one coroutine:
--   sidewalk -> door -> browse shelves (by personality) -> queue -> pay or
--   give up -> leave. Shelf stock is removed when they pick items up and put
--   back if they leave angry, so shelves always reflect reality.
-- Spawning is one 0.5s loop over all stores; movement uses Humanoid:MoveTo
-- (pathfinding inside stores) with a stuck-recovery fallback.
local PathfindingService = game:GetService("PathfindingService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Products = require(Shared:WaitForChild("Products"))
local CustomerTypes = require(Shared:WaitForChild("CustomerTypes"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Util = require(Shared:WaitForChild("Util"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local CycleService = require(script.Parent.CycleService)
local StoreService = require(script.Parent.StoreService)
local StoreBuilder = require(script.Parent.StoreBuilder)

local CustomerService = {}

local NPC_GROUP = "LOS_NPC"
local PLAYER_GROUP = "LOS_Players"
local SKIN = { Color3.fromRGB(255, 220, 190), Color3.fromRGB(235, 190, 150), Color3.fromRGB(200, 150, 110), Color3.fromRGB(150, 100, 70), Color3.fromRGB(110, 75, 55) }

local folder
local template
local customers = {} -- set of customer objects
local perStore = {} -- [store] = count

local function pick(list)
	return list[math.random(1, #list)]
end

---------------------------------------------------------------------------
-- NPC model
---------------------------------------------------------------------------
local function buildFallbackTemplate()
	local model = Instance.new("Model")
	model.Name = "Customer"
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Parent = model
	local function limb(name, size, offset)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = root.CFrame * CFrame.new(offset)
		p.CanCollide = false
		p.Massless = true
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
		return p
	end
	limb("UpperTorso", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0))
	local head = limb("Head", Vector3.new(1.3, 1.3, 1.3), Vector3.new(0, 1.7, 0))
	head.Shape = Enum.PartType.Ball
	limb("LeftUpperLeg", Vector3.new(0.9, 2, 0.9), Vector3.new(-0.5, -2, 0))
	limb("RightUpperLeg", Vector3.new(0.9, 2, 0.9), Vector3.new(0.5, -2, 0))
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 3
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function buildTemplate()
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		Log.Warn("Customers", "using block NPCs (couldn't build R15 rig):", model)
		return buildFallbackTemplate()
	end
	model.Name = "Customer"
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	return model
end

local function makeGui(head, name)
	local gui = Instance.new("BillboardGui")
	gui.Name = "CustomerGui"
	gui.Size = UDim2.new(0, 220, 0, 96)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.MaxDistance = 70
	gui.Adornee = head
	gui.Parent = head
	local bubble = Instance.new("TextLabel")
	bubble.Name = "Bubble"
	bubble.Size = UDim2.new(1, 0, 0, 52)
	bubble.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bubble.BackgroundTransparency = 0.05
	bubble.TextColor3 = Color3.fromRGB(30, 30, 40)
	bubble.Font = Enum.Font.GothamMedium
	bubble.TextScaled = true
	bubble.TextWrapped = true
	bubble.Visible = false
	bubble.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = bubble
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = bubble
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Position = UDim2.new(0, 0, 0, 56)
	nameLabel.Size = UDim2.new(1, 0, 0, 20)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.Text = name
	nameLabel.Parent = gui
	local barBack = Instance.new("Frame")
	barBack.Name = "Patience"
	barBack.Position = UDim2.new(0.2, 0, 0, 80)
	barBack.Size = UDim2.new(0.6, 0, 0, 8)
	barBack.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	barBack.Visible = false
	barBack.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(90, 230, 130)
	fill.BorderSizePixel = 0
	fill.Parent = barBack
	return { Gui = gui, Bubble = bubble, Bar = barBack, Fill = fill, Name = nameLabel }
end

local function setupAnimations(c)
	local animator = c.Humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = c.Humanoid
	end
	local tracks = {}
	for key, id in pairs(Config.NPCAnimations) do
		local ok, track = pcall(function()
			local anim = Instance.new("Animation")
			anim.AnimationId = id
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Looped = true
			tracks[key] = track
		end
	end
	if tracks.Idle then
		tracks.Idle:Play()
	end
	c.Humanoid.Running:Connect(function(speed)
		if not tracks.Walk then
			return
		end
		if speed > 0.5 then
			if not tracks.Walk.IsPlaying then
				tracks.Walk:Play(0.15)
			end
			tracks.Walk:AdjustSpeed(speed / 12)
		elseif tracks.Walk.IsPlaying then
			tracks.Walk:Stop(0.2)
		end
	end)
end

local function spawnNpc(typeDef, position, showGui)
	local model = template:Clone()
	local skin = pick(SKIN)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CollisionGroup = NPC_GROUP
			local n = d.Name
			if n:find("Torso") or n:find("Arm") or n:find("Hand") then
				d.Color = typeDef and typeDef.Shirt or Color3.fromHSV(math.random(), 0.4, 0.8)
			elseif n:find("Leg") or n:find("Foot") then
				d.Color = typeDef and typeDef.Pants or Color3.fromRGB(50, 55, 70)
			elseif n == "Head" then
				d.Color = (typeDef and typeDef.Id == "buttons") and typeDef.Shirt or skin
			end
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = Config.NPCWalkSpeed * (typeDef and typeDef.Speed or 1)
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	model:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	if typeDef and typeDef.Scale then
		pcall(function()
			model:ScaleTo(typeDef.Scale)
		end)
	end
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local c = { Model = model, Humanoid = humanoid, Root = root, Type = typeDef }
	local head = model:FindFirstChild("Head")
	if showGui and head then
		c.Gui = makeGui(head, typeDef.Name)
	end
	setupAnimations(c)
	return c
end

---------------------------------------------------------------------------
-- Movement + speech
---------------------------------------------------------------------------
-- Humanoid:MoveTo gives up after 8 seconds, so long walks re-issue it every
-- 6 seconds until the target is reached or the overall timeout expires.
local function moveTo(c, target, timeout)
	local started = os.clock()
	while c.Model.Parent and os.clock() - started < timeout do
		local done, reached = false, false
		local conn = c.Humanoid.MoveToFinished:Connect(function(r)
			done = true
			reached = r
		end)
		c.Humanoid:MoveTo(target)
		local legStart = os.clock()
		while not done and c.Model.Parent and os.clock() - legStart < 6 and os.clock() - started < timeout do
			task.wait(0.1)
		end
		conn:Disconnect()
		if done then
			local flat = ((c.Root.Position - target) * Vector3.new(1, 0, 1)).Magnitude
			if reached or flat < 3 then
				return true
			end
			task.wait(0.2) -- blocked; try again shortly
		end
	end
	return false
end

local pathParams = { AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 5 }

local function walk(c, target, usePath)
	if not c.Model.Parent then
		return
	end
	local speed = math.max(c.Humanoid.WalkSpeed, 4)
	local function timeFor(from)
		return (from - target).Magnitude / speed + 2
	end
	local followed = false
	if usePath then
		local path = PathfindingService:CreatePath(pathParams)
		local ok = pcall(function()
			path:ComputeAsync(c.Root.Position, target)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			followed = true
			local last = c.Root.Position
			for i, waypoint in ipairs(path:GetWaypoints()) do
				if i > 1 then
					if not c.Model.Parent then
						return
					end
					moveTo(c, waypoint.Position, (waypoint.Position - last).Magnitude / speed + 1.5)
					last = waypoint.Position
				end
			end
		end
	end
	if not followed then
		moveTo(c, target, timeFor(c.Root.Position))
	end
	-- stuck recovery
	if c.Model.Parent and (c.Root.Position - target) * Vector3.new(1, 0, 1) ~= Vector3.zero then
		local flatDist = ((c.Root.Position - target) * Vector3.new(1, 0, 1)).Magnitude
		if flatDist > 5 then
			c.Model:PivotTo(CFrame.new(target + Vector3.new(0, 3, 0)))
		end
	end
end

local function say(c, text, seconds)
	if not c.Gui or not text then
		return
	end
	c.Gui.Bubble.Text = text
	c.Gui.Bubble.Visible = true
	c.SayToken = (c.SayToken or 0) + 1
	local token = c.SayToken
	task.delay(seconds or 3.5, function()
		if c.SayToken == token and c.Gui and c.Gui.Bubble.Parent then
			c.Gui.Bubble.Visible = false
		end
	end)
end

local function face(c, point)
	local p = c.Root.Position
	c.Root.CFrame = CFrame.lookAt(p, Vector3.new(point.X, p.Y, point.Z))
end

local function despawn(c)
	customers[c] = nil
	if c.Store and perStore[c.Store] then
		perStore[c.Store] = math.max(0, perStore[c.Store] - 1)
	end
	if c.Model then
		c.Model:Destroy()
	end
end

---------------------------------------------------------------------------
-- Choosing who comes in
---------------------------------------------------------------------------
local function eligible(t, data)
	local s = t.Spawn
	local night = CycleService.IsNight()
	local weather = CycleService.Weather()
	if s.Time == "Day" and night then
		return false
	end
	if s.Time == "Night" and not night then
		return false
	end
	if s.Weather == "Rain" and weather ~= "Rain" and weather ~= "Storm" then
		return false
	end
	if s.HourMin then
		local clock = CycleService.Clock()
		if clock < s.HourMin or clock >= s.HourMax then
			return false
		end
	end
	if s.RequiresClue and not data.Clues[s.RequiresClue] then
		return false
	end
	return true
end

local function chooseType(store, data)
	local mods = CycleService.Mods()
	local mysteryChance = Config.MysteryCustomerChance * store.Effects.RareChance * (mods.MysteryMult or 1)
	if math.random() < mysteryChance then
		local options = {}
		for _, t in ipairs(CustomerTypes.List) do
			if t.Mystery and eligible(t, data) then
				table.insert(options, t)
			end
		end
		if #options > 0 then
			return pick(options)
		end
	end
	local total, weighted = 0, {}
	for _, t in ipairs(CustomerTypes.List) do
		if not t.Mystery and eligible(t, data) then
			local w = t.Weight * ((mods.TypeBoost and mods.TypeBoost[t.Id]) or 1)
			total = total + w
			table.insert(weighted, { t, w })
		end
	end
	local roll = math.random() * total
	for _, entry in ipairs(weighted) do
		roll = roll - entry[2]
		if roll <= 0 then
			return entry[1]
		end
	end
	return weighted[1] and weighted[1][1]
end

local function wants(t, product)
	if t.Mystery and product.Secret then
		return true -- mysterious visitors are drawn to secret products
	end
	if t.Rarities then
		return table.find(t.Rarities, product.Rarity) ~= nil
	end
	return table.find(t.Prefers, product.Category) ~= nil
end

---------------------------------------------------------------------------
-- Reviews
---------------------------------------------------------------------------
local function review(store, c, stars, angry)
	local t = c.Type
	if not (t.AlwaysReview or math.random() < (angry and 0.6 or Config.ReviewChance)) then
		return
	end
	local text = stars >= 4 and pick(t.Lines.Good) or pick(t.Lines.Bad)
	StoreService.AddReview(store.Owner, t.Name, stars, text)
end

---------------------------------------------------------------------------
-- Paying (called by StoreService when the customer is rung up)
---------------------------------------------------------------------------
local function onCheckout(store, c, by)
	local owner = store.Owner
	local data = owner and DataService.Get(owner)
	if not data then
		return
	end
	local waitTime = os.clock() - (c.ArrivedAt or os.clock())
	local revenue, tip, categories = EconomyService.PriceSale(c.Cart, { Customer = c.Type, Effects = store.Effects, WaitTime = waitTime })
	EconomyService.AddCash(owner, revenue + tip, "Sale")
	EconomyService.AddXp(owner, math.ceil(revenue * 0.6) + 2)

	local items = 0
	for _, line in ipairs(c.Cart) do
		items = items + line.Q
		data.Products[line.P] = (data.Products[line.P] or 0) + line.Q
	end
	data.Stats.Served = data.Stats.Served + 1
	data.Stats.Sold = data.Stats.Sold + items
	local firstMeet = data.Customers[c.Type.Id] == nil
	data.Customers[c.Type.Id] = (data.Customers[c.Type.Id] or 0) + 1
	if firstMeet then
		Net.Notify(owner, ("New customer met: %s. %s"):format(c.Type.Name, c.Type.Desc), "good")
	end

	local effect = Cosmetics.EffectById[data.Store.Effect] or Cosmetics.EffectById.None
	local text = "+" .. Util.Money(revenue) .. (tip > 0 and ("  (+" .. Util.Money(tip) .. " tip)") or "")
	Net.Events.Floating:FireAllClients(store.Register.Position + Vector3.new(0, 2, 0), text, Color3.fromRGB(120, 255, 150), effect.Colors)
	say(c, pick(c.Type.Lines.Happy), 3)

	local patienceTotal = c.PatienceTotal or 30
	local frac = math.clamp(waitTime / patienceTotal, 0, 1)
	local stars = 5 - (frac > 0.66 and 2 or (frac > 0.33 and 1 or 0)) - (c.Missing and 1 or 0)
	if c.Type.Strict and (frac > 0.15 or c.Missing) then
		stars = stars - 1
	end
	review(store, c, math.clamp(stars, 1, 5), false)

	local info = {
		Customer = c.Type.Id, Cart = c.Cart, Revenue = revenue, Tip = tip, Items = items,
		Categories = categories, Night = CycleService.IsNight(), WaitTime = waitTime, ByHand = by ~= nil,
	}
	Bus.Fire("Sale", owner, info)
	Bus.Fire("CustomerServed", owner, c.Type.Id, c.Cart)
	Bus.Fire("Dirty", owner)
end

---------------------------------------------------------------------------
-- The customer's visit
---------------------------------------------------------------------------
local function visit(c)
	local store = c.Store
	local owner = store.Owner
	local function alive()
		return c.Model.Parent ~= nil and store.Active and store.Owner == owner
	end
	local t = c.Type
	local data = DataService.Get(owner)
	if not data then
		return
	end

	walk(c, StoreBuilder.WorldPoint(store, StoreBuilder.DoorOutside), false)
	if not alive() then
		return
	end
	walk(c, StoreBuilder.WorldPoint(store, StoreBuilder.DoorInside), false)
	if not alive() then
		return
	end
	say(c, pick(t.Lines.Enter), 3.5)

	-- Decide what to look for
	local stocked = StoreService.Stocked(store)
	local matching = {}
	for _, entry in ipairs(stocked) do
		local product = Products.ById[entry.P]
		if product and wants(t, product) then
			table.insert(matching, entry)
		end
	end
	if #matching == 0 then
		c.Missing = true
		if t.Flexible then
			matching = stocked
		end
	end
	-- Mysterious customers go for secret products first
	table.sort(matching, function(a, b)
		local pa, pb = Products.ById[a.P], Products.ById[b.P]
		if t.Mystery and pa.Secret ~= pb.Secret then
			return pa.Secret == true
		end
		return false
	end)
	if not t.Mystery then
		for i = #matching, 2, -1 do
			local j = math.random(1, i)
			matching[i], matching[j] = matching[j], matching[i]
		end
	end

	local budget = math.random(t.Budget[1], t.Budget[2])
	local wantCount = math.random(t.Items[1], t.Items[2])
	c.Cart = {}
	local seen = {}
	for _, entry in ipairs(matching) do
		if #c.Cart >= wantCount or not alive() then
			break
		end
		if not seen[entry.P] then
			seen[entry.P] = true
			local product = Products.ById[entry.P]
			local maxByBudget = math.floor(budget / product.Price)
			local qty = math.clamp(math.random(1, 2), 1, math.max(1, maxByBudget))
			if maxByBudget >= 1 or (#c.Cart == 0 and product.Price <= budget * 2) then
				walk(c, entry.Front, true)
				if not alive() then
					return
				end
				face(c, store.Units[entry.Unit].CFrame.Position)
				task.wait(math.random(12, 26) / 10)
				local taken = StoreService.Take(store, entry.Unit, entry.Slot, entry.P, qty)
				if taken > 0 then
					table.insert(c.Cart, { P = entry.P, Q = taken, Unit = entry.Unit, Slot = entry.Slot })
					budget = budget - product.Price * taken
				else
					c.Missing = true -- someone else grabbed the last one
				end
			end
		end
	end

	local function giveBack()
		for _, line in ipairs(c.Cart) do
			StoreService.Return(store, line.Unit, line.Slot, line.P, line.Q)
		end
		c.Cart = {}
	end

	if #c.Cart == 0 then
		say(c, pick(t.Lines.Sad), 3)
		if c.Missing then
			review(store, c, 2, false)
		end
		return
	end

	-- Queue up
	c.PatienceTotal = t.Patience * store.Effects.Patience
	c.State = "Queued"
	local joinedAt = os.clock()
	while alive() and not StoreService.JoinQueue(store, c) do
		task.wait(0.5)
		if os.clock() - joinedAt > c.PatienceTotal / 2 then
			say(c, pick(t.Lines.Sad), 3)
			giveBack()
			review(store, c, 1, true)
			data.Stats.Angry = data.Stats.Angry + 1
			return
		end
	end
	if c.Gui then
		c.Gui.Bar.Visible = true
	end
	local lastIndex = nil
	local queueStart = os.clock()
	while alive() and c.State == "Queued" do
		local index, point = StoreService.QueuePosition(store, c)
		if not index then
			break
		end
		if index ~= lastIndex then
			lastIndex = index
			c.AtCounter = false
			walk(c, point, false)
			face(c, store.Register.Position)
			if index == 1 and c.State == "Queued" then
				c.AtCounter = true
				c.ArrivedAt = os.clock()
				if store.Owner then
					Net.Events.Tutorial:FireClient(store.Owner, "CustomerWaiting")
				end
			end
		end
		local elapsed = os.clock() - queueStart
		local left = 1 - elapsed / c.PatienceTotal
		if c.Gui then
			c.Gui.Fill.Size = UDim2.fromScale(math.clamp(left, 0, 1), 1)
			c.Gui.Fill.BackgroundColor3 = left > 0.5 and Color3.fromRGB(90, 230, 130) or (left > 0.25 and Color3.fromRGB(255, 200, 60) or Color3.fromRGB(240, 70, 70))
		end
		if left <= 0 and c.State == "Queued" then
			StoreService.LeaveQueue(store, c)
			c.State = "Angry"
			say(c, pick(t.Lines.Sad), 3)
			giveBack()
			review(store, c, 1, true)
			data.Stats.Angry = data.Stats.Angry + 1
			Bus.Fire("CustomerLeftAngry", owner, t.Id)
			break
		end
		task.wait(0.25)
	end
	if c.Gui then
		c.Gui.Bar.Visible = false
	end
	if c.State == "Paid" then
		task.wait(1.2)
	end
end

local function runCustomer(c)
	local ok, err = pcall(visit, c)
	if not ok then
		Log.Warn("Customers", "visit failed:", err)
	end
	-- If something interrupted the visit mid-queue, make sure nothing is stuck
	if c.Store and c.State == "Queued" then
		StoreService.LeaveQueue(c.Store, c)
		for _, line in ipairs(c.Cart or {}) do
			StoreService.Return(c.Store, line.Unit, line.Slot, line.P, line.Q)
		end
	end
	if c.Model.Parent and c.Store.Active then
		pcall(function()
			walk(c, StoreBuilder.WorldPoint(c.Store, StoreBuilder.DoorInside), true)
			walk(c, StoreBuilder.WorldPoint(c.Store, StoreBuilder.DoorOutside), false)
			walk(c, StoreBuilder.WorldPoint(c.Store, pick(StoreBuilder.Sidewalk)), false)
		end)
	end
	despawn(c)
end

local function countAll()
	local n = 0
	for _ in pairs(customers) do
		n = n + 1
	end
	return n
end

local function spawnCustomer(store, typeDef)
	local start = StoreBuilder.WorldPoint(store, pick(StoreBuilder.Sidewalk))
	local c = spawnNpc(typeDef, start, true)
	c.Store = store
	c.State = "Arriving"
	customers[c] = true
	perStore[store] = (perStore[store] or 0) + 1
	task.spawn(runCustomer, c)
end

---------------------------------------------------------------------------
-- Pedestrians (ambient life)
---------------------------------------------------------------------------
local function pedestrian(route)
	while true do
		local c = spawnNpc(nil, route[1], false)
		local ok = pcall(function()
			for lap = 1, 3 do
				for _, point in ipairs(route) do
					walk(c, point + Vector3.new(math.random(-2, 2), 0, math.random(-2, 2)), false)
				end
				if lap == 3 then
					break
				end
			end
		end)
		if not ok then
			Log.Warn("Customers", "pedestrian route failed")
		end
		c.Model:Destroy()
		task.wait(math.random(3, 10))
	end
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function CustomerService.Init(worldRefs)
	folder = Instance.new("Folder")
	folder.Name = "Customers"
	folder.Parent = workspace

	pcall(function()
		PhysicsService:RegisterCollisionGroup(NPC_GROUP)
		PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(NPC_GROUP, NPC_GROUP, false)
		PhysicsService:CollisionGroupSetCollidable(NPC_GROUP, PLAYER_GROUP, false)
	end)
	local function groupCharacter(character)
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CollisionGroup = PLAYER_GROUP
			end
		end
		character.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				d.CollisionGroup = PLAYER_GROUP
			end
		end)
	end
	local function onPlayer(player)
		player.CharacterAdded:Connect(groupCharacter)
		if player.Character then
			groupCharacter(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayer(player)
	end

	template = buildTemplate()
	StoreService.OnCheckout = onCheckout

	-- Owner is leaving: put every cart back on the shelves (before the
	-- final save), then remove the store's customers.
	StoreService.OnClosing = function(store)
		for c in pairs(customers) do
			if c.Store == store then
				if c.State ~= "Paid" then
					for _, line in ipairs(c.Cart or {}) do
						StoreService.Return(store, line.Unit, line.Slot, line.P, line.Q)
					end
				end
				c.Cart = {}
				c.State = "Closed"
				despawn(c)
			end
		end
		perStore[store] = 0
	end

	-- Spawner
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, store in pairs(StoreService.All()) do
				local data = store.Active and store.Owner and DataService.Get(store.Owner)
				if data then
					local fx = store.Effects
					local mods = CycleService.Mods()
					local rate = fx.CustomerRate * (mods.CustomerRate or 1)
					if CycleService.IsNight() then
						rate = rate * Config.NightCustomerBonus * fx.NightRate
					end
					rate = rate * (0.7 + (data.Rating.Value / 5) * 0.6)
					if data.Level <= 2 then
						rate = rate * 1.3 -- a lively first few minutes
					end
					store.SpawnTimer = (store.SpawnTimer or 0) + 0.5
					local interval = Config.CustomerSpawnInterval / rate
					if store.SpawnTimer >= interval then
						store.SpawnTimer = 0
						local hasStock = #StoreService.Stocked(store) > 0
						if hasStock and (perStore[store] or 0) < fx.MaxCustomers and countAll() < Config.GlobalCustomerCap then
							local typeDef = chooseType(store, data)
							if typeDef then
								spawnCustomer(store, typeDef)
							end
						end
					end
				end
			end
		end
	end)

	for i = 1, Config.Pedestrians do
		local route = worldRefs.Waypoints[(i - 1) % #worldRefs.Waypoints + 1]
		task.delay(i * 2, pedestrian, route)
	end
end

return CustomerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">CycleService</string><ProtectedString name="Source"><![CDATA[-- Day/night cycle, weather, lighting moods, nightly random events and the
-- weekly event. Shared by the whole server; state is mirrored to clients via
-- attributes on ReplicatedStorage.WorldState.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Events = require(Shared:WaitForChild("Events"))
local Products = require(Shared:WaitForChild("Products"))
local Util = require(Shared:WaitForChild("Util"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)

local CycleService = {}

local state = {
	Night = false,
	EventId = nil,
	Event = nil,
	Mods = {},
	Weather = "Clear",
	NightId = 0,
	LastEventId = nil,
	Hour = -1,
}

local worldState = Instance.new("Folder")
worldState.Name = "WorldState"
worldState.Parent = ReplicatedStorage

local atmosphere, colorCorrection, bloom
local refs
local stars = {}

function CycleService.IsNight()
	return state.Night
end
function CycleService.EventId()
	return state.EventId
end
function CycleService.Event()
	return state.Event
end
function CycleService.Weather()
	return state.Weather
end
function CycleService.Mods()
	return state.Mods
end
function CycleService.NightId()
	return state.NightId
end
function CycleService.Clock()
	return Lighting.ClockTime
end
function CycleService.Weekly()
	local list = Events.Weekly
	return list[(Util.WeekNumber() % #list) + 1]
end

---------------------------------------------------------------------------
-- Lighting moods
---------------------------------------------------------------------------
local function tween(object, props, seconds)
	TweenService:Create(object, TweenInfo.new(seconds or 6, Enum.EasingStyle.Sine), props):Play()
end

local function applyMood()
	local night = state.Night
	local weather = state.Weather
	local eventId = state.EventId
	local lightingProps = {
		Ambient = night and Color3.fromRGB(35, 35, 55) or Color3.fromRGB(80, 80, 90),
		OutdoorAmbient = night and Color3.fromRGB(55, 60, 90) or Color3.fromRGB(130, 130, 140),
		Brightness = night and 1.2 or 2.2,
	}
	local atmoProps = {
		Density = night and 0.36 or 0.28,
		Haze = night and 1.6 or 1,
		Color = night and Color3.fromRGB(95, 105, 150) or Color3.fromRGB(200, 185, 165),
		Decay = night and Color3.fromRGB(50, 60, 100) or Color3.fromRGB(110, 110, 120),
	}
	local ccProps = {
		TintColor = night and Color3.fromRGB(215, 222, 255) or Color3.fromRGB(255, 250, 245),
		Contrast = night and 0.12 or 0.05,
		Saturation = night and 0.12 or 0.05,
	}
	if weather == "Rain" or weather == "Storm" then
		atmoProps.Density = atmoProps.Density + (weather == "Storm" and 0.12 or 0.06)
		lightingProps.Brightness = lightingProps.Brightness * 0.75
		ccProps.Saturation = ccProps.Saturation - 0.1
	elseif weather == "Fog" then
		atmoProps.Density = 0.62
		atmoProps.Haze = 3
		atmoProps.Color = Color3.fromRGB(170, 175, 190)
	end
	if eventId == "Aurora" then
		ccProps.TintColor = Color3.fromRGB(205, 255, 230)
		atmoProps.Color = Color3.fromRGB(110, 230, 170)
		atmoProps.Decay = Color3.fromRGB(70, 160, 200)
	end
	tween(Lighting, lightingProps)
	tween(atmosphere, atmoProps)
	tween(colorCorrection, ccProps)

	-- Wet streets shine in the rain
	local wet = weather == "Rain" or weather == "Storm"
	for _, p in ipairs(refs.WetParts) do
		p.Reflectance = wet and 0.18 or 0
	end
	-- Street lamps: on at night unless there's a blackout
	local lampsOn = night and eventId ~= "Blackout"
	for _, lamp in ipairs(refs.Lamps) do
		lamp.Light.Enabled = lampsOn
		lamp.Head.Material = lampsOn and Enum.Material.Neon or Enum.Material.SmoothPlastic
		lamp.Head.Color = lampsOn and Color3.fromRGB(255, 225, 170) or Color3.fromRGB(90, 90, 95)
	end
end

local function publish()
	local e = state.Event
	worldState:SetAttribute("Night", state.Night)
	worldState:SetAttribute("Weather", state.Weather)
	worldState:SetAttribute("EventId", state.EventId or "")
	worldState:SetAttribute("EventName", e and e.Name or "")
	worldState:SetAttribute("EventDesc", e and state.EventDesc or "")
	worldState:SetAttribute("EventColor", e and e.Color or Color3.new(1, 1, 1))
	local weekly = CycleService.Weekly()
	worldState:SetAttribute("WeeklyName", weekly.Name)
	worldState:SetAttribute("WeeklyDesc", weekly.Desc)
	-- products orderable only right now (for the order menu)
	local limited = {}
	for _, product in ipairs(Products.List) do
		if (product.Event and product.Event == state.EventId) or (product.Weather and (state.Weather == "Rain" or state.Weather == "Storm")) then
			table.insert(limited, product.Id)
		end
	end
	worldState:SetAttribute("Limited", table.concat(limited, ","))
end

---------------------------------------------------------------------------
-- Shooting stars
---------------------------------------------------------------------------
local function clearStars()
	for _, star in ipairs(stars) do
		if star.Parent then
			star:Destroy()
		end
	end
	stars = {}
end

local function spawnStars()
	clearStars()
	local lanes = { 18, -18, 105, -105, 178, -158 }
	local folder = workspace:FindFirstChild("Town")
	for _ = 1, 16 do
		local star = Instance.new("Part")
		star.Name = "ShootingStar"
		star.Shape = Enum.PartType.Ball
		star.Size = Vector3.new(2, 2, 2)
		star.Anchored = true
		star.CanCollide = false
		star.Material = Enum.Material.Neon
		star.Color = Color3.fromRGB(255, 245, 170)
		star.Position = Vector3.new(math.random(-340, 340), 3.5, lanes[math.random(1, #lanes)] + math.random(-4, 4))
		local light = Instance.new("PointLight")
		light.Range = 14
		light.Brightness = 3
		light.Color = star.Color
		light.Parent = star
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = star.Color
		sparkle.Parent = star
		star:SetAttribute("Bob", true)
		star.Parent = folder
		table.insert(stars, star)
	end
	task.spawn(function()
		while state.EventId == "ShootingStars" and #stars > 0 do
			task.wait(0.3)
			for i = #stars, 1, -1 do
				local star = stars[i]
				for _, player in ipairs(Players:GetPlayers()) do
					local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					if root and star.Parent and (root.Position - star.Position).Magnitude < 7 then
						star:Destroy()
						table.remove(stars, i)
						Bus.Fire("StarCaught", player)
						break
					end
				end
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Phase changes
---------------------------------------------------------------------------
local function rollWeather(chanceRain)
	if math.random() < chanceRain then
		return "Rain"
	end
	return "Clear"
end

local function startNight()
	state.Night = true
	state.NightId = os.time()
	state.Event = nil
	state.EventId = nil
	state.Mods = {}
	state.EventDesc = nil
	if math.random() < Config.NightEventChance then
		local total = 0
		for _, e in ipairs(Events.Night) do
			if e.Id ~= state.LastEventId then
				total = total + e.Weight
			end
		end
		local roll = math.random() * total
		for _, e in ipairs(Events.Night) do
			if e.Id ~= state.LastEventId then
				roll = roll - e.Weight
				if roll <= 0 then
					state.Event = e
					break
				end
			end
		end
	end
	local e = state.Event
	if e then
		state.EventId = e.Id
		state.LastEventId = e.Id
		local mods = table.clone(e.Mods)
		state.EventDesc = e.Desc
		if e.Id == "Craving" then
			mods.Category = Products.Categories[math.random(1, #Products.Categories)]
			state.EventDesc = e.Desc:format(mods.Category:lower())
		end
		state.Mods = mods
		state.Weather = e.Weather or rollWeather(0.35)
	else
		state.Weather = rollWeather(0.4)
	end
	publish()
	applyMood()
	if e then
		Net.NotifyAll(("Tonight: %s. %s"):format(e.Name, state.EventDesc), "event")
		if e.Id == "ShootingStars" then
			spawnStars()
		end
		Bus.Fire("EventStarted", e.Id)
	else
		Net.NotifyAll("Night falls. Every other store in town has closed. Yours is the last one open.", "event")
	end
	Log.Info("Cycle", "night", state.NightId, state.EventId, state.Weather)
	Bus.Fire("NightStarted", state.NightId)
end

local function startDay()
	local endedEvent = state.EventId
	state.Night = false
	state.Event = nil
	state.EventId = nil
	state.EventDesc = nil
	state.Mods = {}
	state.Weather = rollWeather(0.2)
	clearStars()
	publish()
	applyMood()
	Net.NotifyAll("The sun is up. A new day on the block!", "event")
	if endedEvent then
		Bus.Fire("EventEnded", endedEvent)
	end
	Bus.Fire("DayStarted")
end

function CycleService.Init(worldRefs)
	refs = worldRefs
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	colorCorrection = Lighting:FindFirstChild("LOSColor") or Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "LOSColor"
	colorCorrection.Parent = Lighting
	bloom = Lighting:FindFirstChild("LOSBloom") or Instance.new("BloomEffect")
	bloom.Name = "LOSBloom"
	bloom.Intensity = 0.9
	bloom.Size = 28
	bloom.Threshold = 0.88
	bloom.Parent = Lighting
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.GlobalShadows = true
	Lighting.ClockTime = Config.StartClockTime

	state.Night = Util.IsNight(Lighting.ClockTime, Config.NightStart, Config.NightEnd)
	state.Weather = "Rain" -- the game opens on a rainy evening
	publish()
	applyMood()

	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.5)
			local now = os.clock()
			local dt = now - last
			last = now
			Lighting.ClockTime = (Lighting.ClockTime + dt * hoursPerSecond) % 24
			local night = Util.IsNight(Lighting.ClockTime, Config.NightStart, Config.NightEnd)
			if night ~= state.Night then
				if night then
					startNight()
				else
					startDay()
				end
			end
			local hour = math.floor(Lighting.ClockTime)
			if hour ~= state.Hour then
				state.Hour = hour
				Bus.Fire("Hour", hour)
			end
		end
	end)
end

return CycleService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Player saves with session locking.
--
-- * Load uses UpdateAsync to claim a lock { JobId, Time } on the save. If
--   another live server holds it (player hopped servers and the old server
--   hasn't saved yet), we wait and retry instead of loading stale data. This
--   is what prevents cross-server item/cash duplication.
-- * Save uses UpdateAsync and refuses to write if another server took the lock.
-- * If loading fails (DataStores down / Studio without API access), the player
--   can still play, but nothing is saved, so good data is never overwritten.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)

local DataService = {}

local store
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if not ok then
		Log.Warn("Data", "DataStores unavailable; progress will not save.", err)
	end
end

local profiles = {} -- [Player] = { Data, CanSave, Key }
local saveHooks = {}
local releaseHooks = {}

local VERSION = 1

local function defaults()
	return {
		Version = VERSION,
		Cash = Config.StartingCash,
		Xp = 0,
		Level = 1,
		Inventory = table.clone(Config.StartingInventory),
		-- ["u<unit>s<slot>"] = { P = productId, Q = qty }. New stores open
		-- pre-stocked so the first customers arrive within seconds.
		Shelves = {
			u1s1 = { P = "chips", Q = 8 }, u1s2 = { P = "gummy", Q = 8 },
			u2s1 = { P = "puffs", Q = 6 }, u3s1 = { P = "cola", Q = 8 }, u3s2 = { P = "water", Q = 6 },
		},
		Upgrades = {},
		Store = { Name = "", SignColor = 1, Theme = "Classic", Uniform = "Classic", Layout = "Classic", Effect = "Coins", DecorOn = {} },
		Owned = { Decor = {}, Robux = {} },
		Rating = { Value = 3.5, Count = 0, Recent = {} },
		Stats = { Served = 0, Earned = 0, Stocked = 0, FiveStars = 0, Nights = 0, Stars = 0, Visits = 0, Angry = 0, Sold = 0 },
		Products = {}, -- discovered: [productId] = number sold
		Customers = {}, -- met: [typeId] = number served
		EventsSeen = {},
		Achievements = {},
		Secrets = {},
		Clues = {}, -- [clueId] = UTC day found
		ClueCounters = {}, -- [clueId] = { nightId, ... }
		Solved = {},
		Title = "",
		Daily = { LastDay = 0, Streak = 0, BestStreak = 0 },
		Challenges = { Day = 0, List = {} },
		SeasonUnlocks = {},
		Settings = { Rain = true, LowGraphics = false, Bubbles = true, UIScale = 1, Volume = 0.5 },
		RatedStores = {}, -- [ownerUserId] = day
		FriendBonus = {}, -- [userId] = day
		Tutorial = 1,
		Receipts = {},
	}
end

-- Structural tables get new sub-fields filled in. Maps of player content
-- (Shelves, Inventory, ...) are never merged, or empty slots would refill.
local DEEP_RECONCILE = { Store = true, Owned = true, Rating = true, Stats = true, Daily = true, Challenges = true, Settings = true }

-- Fill in any fields added in later versions
local function reconcile(data)
	local base = defaults()
	for key, value in pairs(base) do
		if data[key] == nil then
			data[key] = value
		elseif DEEP_RECONCILE[key] and type(data[key]) == "table" then
			for subKey, subValue in pairs(value) do
				if data[key][subKey] == nil and type(subKey) == "string" then
					data[key][subKey] = subValue
				end
			end
		end
	end
	data.Version = VERSION
	return data
end

local function keyFor(player)
	return "p_" .. player.UserId
end

local function claim(key)
	local lockedByOther = false
	local loaded = nil
	local ok, err = pcall(function()
		store:UpdateAsync(key, function(old)
			local now = os.time()
			if old and old.Lock and old.Lock.JobId ~= game.JobId and now - (old.Lock.Time or 0) < Config.SessionLockTimeout then
				lockedByOther = true
				return nil -- cancel the write
			end
			local data = old and old.Data or nil
			loaded = data
			return { Data = data, Lock = { JobId = game.JobId, Time = now } }
		end)
	end)
	return ok, lockedByOther, loaded, err
end

local function load(player)
	if not store then
		return reconcile(defaults()), false
	end
	local key = keyFor(player)
	for attempt = 1, 8 do
		local ok, locked, data, err = claim(key)
		if ok and not locked then
			return reconcile(type(data) == "table" and data or defaults()), true
		end
		if not player.Parent then
			return nil, false
		end
		if locked then
			Log.Info("Data", player.Name, "save is locked by another server, retrying", attempt)
		else
			Log.Warn("Data", "load failed for", player.Name, err)
		end
		task.wait(math.min(2 * attempt, 8))
	end
	return nil, false
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.Data
end

function DataService.Profile(player)
	return profiles[player]
end

function DataService.WaitFor(player)
	while player.Parent and not profiles[player] do
		task.wait(0.1)
	end
	return profiles[player]
end

-- hook(player, data) runs right before each successful save (leaderboards)
function DataService.OnSave(hook)
	table.insert(saveHooks, hook)
end

-- hook(player, data) runs synchronously when a player leaves, BEFORE the
-- final save (used to put customers' carts back on the shelves)
function DataService.BeforeRelease(hook)
	table.insert(releaseHooks, hook)
end

-- release = true on leave/shutdown: clears the session lock
function DataService.Save(player, release)
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	if profile.Saving then
		-- wait for the in-flight save so we don't race
		local started = os.clock()
		while profile.Saving and os.clock() - started < 15 do
			task.wait(0.1)
		end
	end
	profile.Saving = true
	local lostLock = false
	local ok, err = pcall(function()
		store:UpdateAsync(profile.Key, function(old)
			if old and old.Lock and old.Lock.JobId ~= game.JobId then
				lostLock = true
				return nil
			end
			return { Data = profile.Data, Lock = (not release) and { JobId = game.JobId, Time = os.time() } or nil }
		end)
	end)
	profile.Saving = false
	if lostLock then
		Log.Warn("Data", "another server took over", player.Name, "- this copy will not be saved")
		profile.CanSave = false
		return false
	end
	if not ok then
		Log.Warn("Data", "save failed for", player.Name, err)
		return false
	end
	for _, hook in ipairs(saveHooks) do
		pcall(hook, player, profile.Data)
	end
	Log.Info("Data", "saved", player.Name)
	return true
end

local function onPlayerAdded(player)
	local data, canSave = load(player)
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("Your save is still being written by another server. Please rejoin in a minute.")
		return
	end
	if not canSave then
		Log.Warn("Data", "running", player.Name, "without saving (Studio needs API access enabled)")
	end
	profiles[player] = { Data = data, CanSave = canSave, Key = keyFor(player) }

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = data.Cash
	cash.Parent = stats
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = data.Level
	level.Parent = stats
	stats.Parent = player

	player:SetAttribute("Saving", canSave)
	Bus.Fire("ProfileLoaded", player, data)
end

local function onPlayerRemoving(player)
	if profiles[player] then
		for _, hook in ipairs(releaseHooks) do
			local ok, err = pcall(hook, player, profiles[player].Data)
			if not ok then
				Log.Warn("Data", "release hook failed", err)
			end
		end
		DataService.Save(player, true)
		profiles[player] = nil
	end
end

function DataService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in ipairs(Players:GetPlayers()) do
			pending = pending + 1
			task.spawn(function()
				DataService.Save(player, true)
				pending = pending - 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- Cash, XP/levels, ordering stock and pricing sales. The ONLY place money
-- is created or spent. Every request is validated here on the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Products = require(Shared:WaitForChild("Products"))
local Events = require(Shared:WaitForChild("Events"))
local Util = require(Shared:WaitForChild("Util"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local CycleService = require(script.Parent.CycleService)

local EconomyService = {}

local function refreshLeaderstats(player, data)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Cash.Value = data.Cash
		stats.Level.Value = data.Level
	end
end

function EconomyService.AddCash(player, amount, reason)
	local data = DataService.Get(player)
	amount = math.floor(amount)
	if not data or amount == 0 then
		return
	end
	data.Cash = math.max(0, data.Cash + amount)
	if reason == "Sale" and amount > 0 then
		data.Stats.Earned = data.Stats.Earned + amount
	end
	refreshLeaderstats(player, data)
	Log.Info("Economy", player.Name, reason or "?", amount, "->", data.Cash)
	Bus.Fire("Dirty", player)
end

function EconomyService.Spend(player, amount)
	local data = DataService.Get(player)
	amount = math.floor(amount)
	if not data or amount < 0 or data.Cash < amount then
		return false
	end
	data.Cash = data.Cash - amount
	refreshLeaderstats(player, data)
	Bus.Fire("Dirty", player)
	return true
end

function EconomyService.AddXp(player, xp)
	local data = DataService.Get(player)
	if not data or xp <= 0 then
		return
	end
	data.Xp = data.Xp + math.floor(xp)
	local leveled = false
	while data.Level < Config.MaxLevel and data.Xp >= Config.XpForLevel(data.Level) do
		data.Xp = data.Xp - Config.XpForLevel(data.Level)
		data.Level = data.Level + 1
		leveled = true
	end
	if leveled then
		refreshLeaderstats(player, data)
		Net.Notify(player, ("Level up! You're now level %d. New products and upgrades may be unlocked."):format(data.Level), "level")
		Bus.Fire("LevelUp", player, data.Level)
	end
	Bus.Fire("Dirty", player)
end

-- Context used to check whether a product can be ordered right now
function EconomyService.OrderContext(player)
	local data = DataService.Get(player)
	return {
		Level = data and data.Level or 1,
		Secrets = data and data.Secrets or {},
		EventId = CycleService.EventId(),
		Weather = CycleService.Weather(),
	}
end

function EconomyService.StockCost(product, qty, effects)
	local discount = math.clamp(effects and effects.StockDiscount or 0, 0, 0.5)
	return math.ceil(product.Cost * qty * (1 - discount))
end

-- Prices a sale. cart = { { P = id, Q = n }, ... }
-- info = { Customer = typeDef, Effects = storeEffects, WaitTime = seconds }
-- Returns revenue (int), tip (int), and per-category counts
function EconomyService.PriceSale(cart, info)
	local mods = CycleService.Mods()
	local weekly = CycleService.Weekly()
	local effects = info.Effects
	local customer = info.Customer
	local night = CycleService.IsNight()
	local revenue = 0
	local categories = {}
	for _, line in ipairs(cart) do
		local product = Products.ById[line.P]
		if product then
			local mult = effects.PriceMult * (customer.PriceMult or 1) * (mods.PriceMult or 1)
			if night then
				mult = mult * effects.NightPrice
			end
			if mods.CategoryMult and mods.Category == product.Category then
				mult = mult * mods.CategoryMult
			end
			if weekly and weekly.Category == product.Category then
				mult = mult * weekly.Mult
			end
			if mods.RareMult and customer.Id == "collector" and product.Rarity ~= "Common" and product.Rarity ~= "Uncommon" then
				mult = mult * mods.RareMult
			end
			revenue = revenue + product.Price * line.Q * mult
			categories[product.Category] = (categories[product.Category] or 0) + line.Q
		end
	end
	revenue = math.floor(revenue + 0.5)
	local tip = 0
	local tipChance = (customer.TipChance or 0) + (effects.TipChance or 0)
	local fastEnough = not customer.FastTipOnly or (info.WaitTime or 99) <= 4
	if fastEnough and math.random() < tipChance then
		tip = math.max(1, math.floor(revenue * (customer.Tip or 0.1) * (mods.TipMult or 1)))
	end
	return revenue, tip, categories
end

---------------------------------------------------------------------------
-- Requests
---------------------------------------------------------------------------
function EconomyService.Init(getEffects)
	-- getEffects(player) -> store effects (provided by StoreService)
	Net.Handle("BuyStock", { Rate = 4, Burst = 8 }, function(player, payload)
		local data = DataService.Get(player)
		if not data then
			return Net.Fail("Still loading...")
		end
		local productId = Net.Key(payload.Product, Products.ById)
		local qty = Net.Int(payload.Qty, 1, Config.MaxOrderQuantity)
		if not productId or not qty then
			return Net.Fail("Invalid order.")
		end
		local product = Products.ById[productId]
		local ok, reason = Products.CanOrder(product, EconomyService.OrderContext(player))
		if not ok then
			return Net.Fail(reason)
		end
		local cost = EconomyService.StockCost(product, qty, getEffects(player))
		if not EconomyService.Spend(player, cost) then
			return Net.Fail(("You need %s for that order."):format(Util.Money(cost)))
		end
		data.Inventory[productId] = (data.Inventory[productId] or 0) + qty
		local firstTime = data.Products[productId] == nil
		if firstTime then
			data.Products[productId] = 0
			Net.Notify(player, ("New product discovered: %s!"):format(product.Name), "good")
		end
		Bus.Fire("BoughtStock", player, productId, qty)
		Bus.Fire("Dirty", player)
		return Net.Ok(("Ordered %d x %s for %s. Stock it on a %s!"):format(qty, product.Name, Util.Money(cost), product.Cold and "cooler" or "shelf"))
	end)
end

EconomyService.WeeklyList = Events.Weekly
return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Log</string><ProtectedString name="Source"><![CDATA[-- Tagged logging. Info only prints when Config.Debug is on.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Log = {}

function Log.Info(tag, ...)
	if Config.Debug then
		print("[LOS][" .. tag .. "]", ...)
	end
end

function Log.Warn(tag, ...)
	warn("[LOS][" .. tag .. "]", ...)
end

-- Runs fn in a protected call and logs failures with context
function Log.Try(tag, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		Log.Warn(tag, err)
	end
	return ok, err
end

return Log
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">MysteryService</string><ProtectedString name="Source"><![CDATA[-- The mystery system. Clue definitions live in ServerStorage so they can't
-- be read by clients ahead of time; the client only ever receives clues the
-- player has found plus a hint for the next one.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))
local Util = require(Shared:WaitForChild("Util"))
local Mysteries = require(ServerStorage:WaitForChild("ServerData"):WaitForChild("Mysteries"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local CycleService = require(script.Parent.CycleService)

local MysteryService = {}

-- Notes found on counters during the Mysterious Message event
local MESSAGES = {
	"The lighthouse keeper never missed a single night.",
	"Some letters take fifty years to arrive.",
	"Count the buttons. Cats can't sew.",
	"When the clock moves again, the town will remember.",
	"The first light on this street was a little store, just like yours.",
	"Look where the grass grows tallest after midnight.",
}

local zoneRefs = {}
local objectRefs = {}

---------------------------------------------------------------------------
-- Clue rules
---------------------------------------------------------------------------
local function solvedCount(data)
	return Util.Count(data.Solved)
end

-- Can this clue be found right now? Returns ok, reason ("newday" when only
-- the "come back another day" rule blocks it)
local function prerequisitesMet(data, clue)
	if data.Clues[clue.Id] then
		return false, "found"
	end
	if clue.RequiresSolved and solvedCount(data) < clue.RequiresSolved then
		return false, "locked"
	end
	local latest = 0
	for _, req in ipairs(clue.Requires or {}) do
		local day = data.Clues[req]
		if not day then
			return false, "locked"
		end
		latest = math.max(latest, day)
	end
	if clue.NewDay and Util.DayNumber() <= latest then
		return false, "newday"
	end
	return true
end

local function award(player, data, clue)
	data.Clues[clue.Id] = Util.DayNumber()
	Net.Notify(player, "New clue! " .. clue.Text, "clue")
	if clue.UnlockProduct then
		data.Secrets[clue.UnlockProduct] = true
		local product = Products.ById[clue.UnlockProduct]
		Net.Notify(player, ("Secret product unlocked: %s. Order it from the Order menu!"):format(product and product.Name or clue.UnlockProduct), "good")
	end
	Bus.Fire("ClueFound", player, clue.Id)

	local mystery = Mysteries.ById[clue.Mystery]
	local all = true
	for _, c in ipairs(mystery.Clues) do
		if not data.Clues[c.Id] then
			all = false
			break
		end
	end
	if all and not data.Solved[mystery.Id] then
		data.Solved[mystery.Id] = Util.DayNumber()
		EconomyService.AddCash(player, mystery.Reward, "Mystery")
		EconomyService.AddXp(player, 300)
		if mystery.Id == "founder" then
			data.Title = "Keeper of the Last Light"
		end
		Net.Notify(player, ("MYSTERY SOLVED: %s! +%s. %s"):format(mystery.Name, Util.Money(mystery.Reward), mystery.RewardText), "level")
		Bus.Fire("MysterySolved", player, mystery.Id)
		Log.Info("Mystery", player.Name, "solved", mystery.Id)
	end
	Bus.Fire("Dirty", player)
end

local function timeOk(clue)
	if clue.Night and not CycleService.IsNight() then
		return false
	end
	if clue.HourMin then
		local clock = CycleService.Clock()
		if clock < clue.HourMin or clock >= clue.HourMax then
			return false
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Triggers
---------------------------------------------------------------------------
local function onObject(player, objectId)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local blockedByDay = false
	local any = false
	for _, mystery in ipairs(Mysteries.List) do
		for _, clue in ipairs(mystery.Clues) do
			if clue.Type == "Object" and clue.Object == objectId then
				any = true
				local ok, reason = prerequisitesMet(data, clue)
				if ok then
					award(player, data, clue)
					return
				elseif reason == "newday" then
					blockedByDay = true
				end
			end
		end
	end
	local info = Mysteries.Objects[objectId]
	if objectId == "messageNote" and not blockedByDay then
		Net.Notify(player, "The note says: \"" .. MESSAGES[math.random(1, #MESSAGES)] .. "\"", "clue")
		return
	end
	if blockedByDay then
		Net.Notify(player, "It won't budge tonight. Maybe try again tomorrow...", "info")
	elseif info and info.Flavor ~= "" then
		Net.Notify(player, info.Flavor, "info")
	elseif any then
		Net.Notify(player, "You've already learned what this can tell you.", "info")
	end
end

local function onServe(player, customerId, cart)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local bought = {}
	for _, line in ipairs(cart or {}) do
		bought[line.P] = true
	end
	for _, mystery in ipairs(Mysteries.List) do
		for _, clue in ipairs(mystery.Clues) do
			if clue.Customer == customerId then
				local ok = prerequisitesMet(data, clue)
				if ok and clue.Type == "Serve" and (not clue.Product or bought[clue.Product]) then
					award(player, data, clue)
				elseif ok and clue.Type == "Pattern" and CycleService.IsNight() then
					local nights = data.ClueCounters[clue.Id] or {}
					local nightId = CycleService.NightId()
					if not table.find(nights, nightId) then
						table.insert(nights, nightId)
						data.ClueCounters[clue.Id] = nights
						if #nights >= clue.Nights then
							award(player, data, clue)
						else
							Net.Notify(player, ("You notice a pattern... (%d/%d nights)"):format(#nights, clue.Nights), "clue")
						end
					end
				end
			end
		end
	end
end

local function checkZones()
	for _, player in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if data and root then
			for _, mystery in ipairs(Mysteries.List) do
				for _, clue in ipairs(mystery.Clues) do
					if clue.Type == "Zone" and not data.Clues[clue.Id] then
						local zone = zoneRefs[clue.Zone]
						if zone and (root.Position - zone.Position).Magnitude <= zone.Radius and timeOk(clue) and prerequisitesMet(data, clue) then
							award(player, data, clue)
						end
					end
				end
			end
		end
	end
end

local function updateObjects()
	local night = CycleService.IsNight()
	for id, ref in pairs(objectRefs) do
		local info = Mysteries.Objects[id]
		local visible = not (info and info.Night) or night
		ref.Prompt.Enabled = visible
		ref.Part.Transparency = visible and 0 or 1
	end
end

---------------------------------------------------------------------------
-- Journal data for the client (only what the player has earned)
---------------------------------------------------------------------------
function MysteryService.Journal(data)
	local list = {}
	local solved = solvedCount(data)
	for _, mystery in ipairs(Mysteries.List) do
		local entry = { Id = mystery.Id, Name = mystery.Name, Solved = data.Solved[mystery.Id] ~= nil, Clues = {}, Found = 0, Total = #mystery.Clues }
		local hinted = false
		for _, clue in ipairs(mystery.Clues) do
			if data.Clues[clue.Id] then
				entry.Found = entry.Found + 1
				table.insert(entry.Clues, { Found = true, Text = clue.Text })
			else
				local ok, reason = prerequisitesMet(data, clue)
				if not hinted and (ok or reason == "newday") then
					hinted = true
					table.insert(entry.Clues, { Found = false, Hint = clue.Hint })
				else
					table.insert(entry.Clues, { Found = false })
				end
			end
		end
		if mystery.RequiresSolved and solved < mystery.RequiresSolved then
			entry.Locked = "Solve any other mystery to begin this one."
		end
		if entry.Solved then
			entry.Reward = mystery.RewardText
		end
		table.insert(list, entry)
	end
	return list
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function MysteryService.Init(worldRefs)
	zoneRefs = worldRefs.Zones
	objectRefs = worldRefs.MysteryObjects
	for id, ref in pairs(objectRefs) do
		ref.Prompt.Triggered:Connect(function(player)
			Bus.Fire("MysteryObject", player, id)
		end)
	end
	updateObjects()

	Bus.On("MysteryObject", onObject)
	Bus.On("CustomerServed", onServe)
	Bus.On("NightStarted", updateObjects)
	Bus.On("DayStarted", updateObjects)

	task.spawn(function()
		while true do
			task.wait(1)
			checkZones()
		end
	end)
end

return MysteryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[-- All client <-> server traffic goes through here.
--
-- Client -> server: ONE RemoteFunction "Request"(action, payload). Every action
-- is registered with Net.Handle, has its own rate limit (token bucket), gets
-- type-checked input, and runs inside pcall so a bad request can never crash
-- a service. The client never sends amounts of money - only intentions.
--
-- Server -> client: RemoteEvents (State, Notify, OpenStock, OpenRate, ...).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Log = require(script.Parent.Log)

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"
folder.Parent = ReplicatedStorage

local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = folder

Net.Events = {}
for _, name in ipairs({ "State", "Notify", "OpenStock", "OpenRate", "Floating", "Tutorial" }) do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	Net.Events[name] = remote
end

local handlers = {}
local buckets = {} -- [player][action] = { Tokens, Last }

-- opts = { Rate = tokens per second, Burst = max tokens }
function Net.Handle(action, opts, fn)
	handlers[action] = { Fn = fn, Rate = opts.Rate or 2, Burst = opts.Burst or 4 }
end

local function allow(player, action, handler)
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[action]
	if not bucket then
		bucket = { Tokens = handler.Burst, Last = now }
		perPlayer[action] = bucket
	end
	bucket.Tokens = math.min(handler.Burst, bucket.Tokens + (now - bucket.Last) * handler.Rate)
	bucket.Last = now
	if bucket.Tokens < 1 then
		return false
	end
	bucket.Tokens = bucket.Tokens - 1
	return true
end

request.OnServerInvoke = function(player, action, payload)
	if type(action) ~= "string" then
		return { ok = false, msg = "Bad request." }
	end
	local handler = handlers[action]
	if not handler then
		Log.Warn("Net", player.Name, "unknown action", action)
		return { ok = false, msg = "Unknown action." }
	end
	if payload ~= nil and type(payload) ~= "table" then
		return { ok = false, msg = "Bad request." }
	end
	if not allow(player, action, handler) then
		return { ok = false, msg = "Slow down a little!" }
	end
	local ok, result = pcall(handler.Fn, player, payload or {})
	if not ok then
		Log.Warn("Net", action, "failed for", player.Name, result)
		return { ok = false, msg = "Something went wrong. Please try again." }
	end
	return result or { ok = true }
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

---------------------------------------------------------------------------
-- Input validation helpers (return nil when invalid)
---------------------------------------------------------------------------
function Net.Int(value, min, max)
	if type(value) ~= "number" or value ~= value or value % 1 ~= 0 then
		return nil
	end
	if value < min or value > max then
		return nil
	end
	return value
end

function Net.Str(value, maxLength)
	if type(value) ~= "string" or #value > maxLength then
		return nil
	end
	return value
end

function Net.Key(value, map)
	if type(value) ~= "string" or map[value] == nil then
		return nil
	end
	return value
end

function Net.Bool(value)
	if type(value) ~= "boolean" then
		return nil
	end
	return value
end

---------------------------------------------------------------------------
-- Server -> client helpers
---------------------------------------------------------------------------
-- kind: "info" | "good" | "bad" | "event" | "review" | "clue" | "level"
function Net.Notify(player, text, kind)
	Net.Events.Notify:FireClient(player, text, kind or "info")
end

function Net.NotifyAll(text, kind)
	Net.Events.Notify:FireAllClients(text, kind or "info")
end

function Net.Fail(msg)
	return { ok = false, msg = msg }
end

function Net.Ok(msg)
	return { ok = true, msg = msg }
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">ProgressionService</string><ProtectedString name="Source"><![CDATA[-- Upgrades, achievements, daily rewards & challenges, collections, seasonal
-- unlocks, global leaderboards and the first-time tutorial.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))
local Effects = require(Shared:WaitForChild("Effects"))
local Achievements = require(Shared:WaitForChild("Achievements"))
local Challenges = require(Shared:WaitForChild("Challenges"))
local Events = require(Shared:WaitForChild("Events"))
local Util = require(Shared:WaitForChild("Util"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local ProgressionService = {}

-- Tutorial steps (client shows the text; server decides when each is done)
ProgressionService.TutorialSteps = { "RingUp", "Order", "Stock", "Upgrade" }

---------------------------------------------------------------------------
-- Daily challenges
---------------------------------------------------------------------------
local function ensureChallenges(player, data)
	local today = Util.DayNumber()
	if data.Challenges.Day == today then
		return
	end
	local picks = Util.SeededPick(Challenges.List, Config.DailyChallengesPerDay, today * 7919 + player.UserId % 100003)
	local list = {}
	for _, def in ipairs(picks) do
		table.insert(list, { Id = def.Id, Progress = 0, Claimed = false })
	end
	data.Challenges = { Day = today, List = list }
end

local function progress(player, key, amount)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	ensureChallenges(player, data)
	for _, entry in ipairs(data.Challenges.List) do
		local def = Challenges.ById[entry.Id]
		if def and def.Key == key and entry.Progress < def.Goal then
			entry.Progress = math.min(def.Goal, entry.Progress + amount)
			if entry.Progress >= def.Goal then
				Net.Notify(player, ("Daily challenge complete: %s! Claim it in the Daily menu."):format(def.Desc), "good")
			end
		end
	end
end

---------------------------------------------------------------------------
-- Achievements
---------------------------------------------------------------------------
function ProgressionService.StatValues(data)
	return {
		Served = data.Stats.Served,
		Earned = data.Stats.Earned,
		Stocked = data.Stats.Stocked,
		FiveStars = data.Stats.FiveStars,
		ProductsFound = Util.Count(data.Products),
		CustomersMet = Util.Count(data.Customers),
		Clues = Util.Count(data.Clues),
		Mysteries = Util.Count(data.Solved),
		Nights = data.Stats.Nights,
		Expansion = Effects.Compute(data.Upgrades).Expansion,
		Stars = data.Stats.Stars,
		Visits = data.Stats.Visits,
	}
end

local pendingCheck = {}
local function checkAchievements(player)
	if pendingCheck[player] then
		return
	end
	pendingCheck[player] = true
	task.delay(1.5, function()
		pendingCheck[player] = nil
		local data = DataService.Get(player)
		if not data then
			return
		end
		local values = ProgressionService.StatValues(data)
		for _, a in ipairs(Achievements.List) do
			if not data.Achievements[a.Id] and (values[a.Stat] or 0) >= a.Goal then
				data.Achievements[a.Id] = Util.DayNumber()
				-- AddCash marks the state dirty, which re-checks once and finds nothing new
				EconomyService.AddCash(player, a.Reward, "Achievement")
				Net.Notify(player, ("Achievement unlocked: %s (+%s)"):format(a.Name, Util.Money(a.Reward)), "level")
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Tutorial
---------------------------------------------------------------------------
local function tutorialDone(player, step)
	local data = DataService.Get(player)
	if not data or data.Tutorial > #ProgressionService.TutorialSteps then
		return
	end
	if ProgressionService.TutorialSteps[data.Tutorial] == step then
		data.Tutorial = data.Tutorial + 1
		if data.Tutorial > #ProgressionService.TutorialSteps then
			EconomyService.AddCash(player, 250, "Tutorial")
			Net.Notify(player, "Tutorial complete! +$250. The night is yours, shopkeeper.", "level")
		end
		Bus.Fire("Dirty", player)
	end
end

---------------------------------------------------------------------------
-- Leaderboards
---------------------------------------------------------------------------
local earnedStore, ratingStore
pcall(function()
	earnedStore = DataStoreService:GetOrderedDataStore(Config.LeaderboardEarned)
	ratingStore = DataStoreService:GetOrderedDataStore(Config.LeaderboardRating)
end)
local boardCache = { Earned = {}, Rating = {} }
local nameCache = {}

local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function fetchBoard(store, isRating)
	if not store then
		return {}
	end
	local ok, page = pcall(function()
		return store:GetSortedAsync(false, 10):GetCurrentPage()
	end)
	if not ok then
		return nil
	end
	local list = {}
	for rank, entry in ipairs(page) do
		local value = isRating and (entry.value / 100) or entry.value
		table.insert(list, { Rank = rank, Name = nameFor(tonumber(entry.key)), Value = value })
	end
	return list
end

local function drawBoard(frame, list, isRating)
	if not frame then
		return
	end
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for _, entry in ipairs(list) do
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0.1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextColor3 = entry.Rank == 1 and Color3.fromRGB(255, 210, 90) or Color3.new(1, 1, 1)
		label.LayoutOrder = entry.Rank
		label.Text = ("%d. %s  %s"):format(entry.Rank, entry.Name, isRating and ("%.2f ★"):format(entry.Value) or Util.Money(entry.Value))
		label.Parent = frame
	end
end

function ProgressionService.Leaderboards()
	return boardCache
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function ProgressionService.Init(worldRefs)
	Net.Handle("BuyUpgrade", { Rate = 2, Burst = 4 }, function(player, payload)
		local data = DataService.Get(player)
		local id = data and Net.Key(payload.Id, Upgrades.ById)
		if not id then
			return Net.Fail("Unknown upgrade.")
		end
		local u = Upgrades.ById[id]
		if data.Upgrades[id] then
			return Net.Fail("Already owned.")
		end
		if u.Requires and not data.Upgrades[u.Requires] then
			return Net.Fail("Requires " .. Upgrades.ById[u.Requires].Name .. " first.")
		end
		if data.Level < u.Level then
			return Net.Fail("Reach level " .. u.Level .. " first.")
		end
		if not EconomyService.Spend(player, u.Cost) then
			return Net.Fail("You need " .. Util.Money(u.Cost) .. ".")
		end
		data.Upgrades[id] = true
		Bus.Fire("UpgradesChanged", player)
		Bus.Fire("UpgradeBought", player, id)
		Bus.Fire("Dirty", player)
		return Net.Ok(u.Name .. " installed!")
	end)

	Net.Handle("ClaimDaily", { Rate = 0.5, Burst = 2 }, function(player)
		local data = DataService.Get(player)
		if not data then
			return Net.Fail("Still loading.")
		end
		local today = Util.DayNumber()
		local d = data.Daily
		if d.LastDay == today then
			return Net.Fail("Already claimed today. Come back tomorrow!")
		end
		d.Streak = (d.LastDay == today - 1) and (d.Streak + 1) or 1
		d.LastDay = today
		d.BestStreak = math.max(d.BestStreak, d.Streak)
		local index = (d.Streak - 1) % #Config.DailyRewards + 1
		local reward = Config.DailyRewards[index]
		EconomyService.AddCash(player, reward, "Daily")
		local extra = ""
		if d.BestStreak == 7 and index == 7 then
			extra = " You unlocked the Hearts checkout effect and Sakura Night theme!"
		end
		Bus.Fire("Dirty", player)
		return Net.Ok(("Day %d reward: %s!%s"):format(d.Streak, Util.Money(reward), extra))
	end)

	Net.Handle("ClaimChallenge", { Rate = 2, Burst = 4 }, function(player, payload)
		local data = DataService.Get(player)
		local index = Net.Int(payload.Index, 1, Config.DailyChallengesPerDay)
		if not data or not index then
			return Net.Fail("Invalid challenge.")
		end
		ensureChallenges(player, data)
		local entry = data.Challenges.List[index]
		local def = entry and Challenges.ById[entry.Id]
		if not def then
			return Net.Fail("Invalid challenge.")
		end
		if entry.Claimed then
			return Net.Fail("Already claimed.")
		end
		if entry.Progress < def.Goal then
			return Net.Fail("Not finished yet.")
		end
		entry.Claimed = true
		local reward = def.Reward + data.Level * 15
		EconomyService.AddCash(player, reward, "Challenge")
		EconomyService.AddXp(player, 40 + data.Level * 5)
		Bus.Fire("Dirty", player)
		return Net.Ok("Challenge reward: " .. Util.Money(reward) .. "!")
	end)

	Net.Handle("SkipTutorial", { Rate = 0.5, Burst = 1 }, function(player)
		local data = DataService.Get(player)
		if data then
			data.Tutorial = #ProgressionService.TutorialSteps + 1
			Bus.Fire("Dirty", player)
		end
		return Net.Ok()
	end)

	Net.Handle("RestartTutorial", { Rate = 0.5, Burst = 1 }, function(player)
		local data = DataService.Get(player)
		if data then
			data.Tutorial = 1
			Bus.Fire("Dirty", player)
		end
		return Net.Ok()
	end)

	Net.Handle("GetLeaderboards", { Rate = 0.5, Burst = 2 }, function()
		return { ok = true, Boards = boardCache }
	end)

	-- Progress hooks ------------------------------------------------------
	Bus.On("ProfileLoaded", function(player, data)
		ensureChallenges(player, data)
		local month = os.date("!*t").month
		if month == 10 or month == 12 then
			data.SeasonUnlocks[tostring(month)] = true
		end
		checkAchievements(player)
	end)

	Bus.On("Sale", function(player, info)
		progress(player, "Served", 1)
		progress(player, "Earned", info.Revenue)
		for category, count in pairs(info.Categories) do
			progress(player, "Sold_" .. category, count)
		end
		if info.Night then
			progress(player, "NightSales", 1)
		end
		if info.ByHand and info.WaitTime <= 4 then
			progress(player, "FastCheckout", 1)
		end
		if info.ByHand then
			tutorialDone(player, "RingUp")
		end
		checkAchievements(player)
	end)
	Bus.On("BoughtStock", function(player)
		tutorialDone(player, "Order")
		checkAchievements(player)
	end)
	Bus.On("Stocked", function(player, amount)
		progress(player, "Stocked", amount)
		tutorialDone(player, "Stock")
		checkAchievements(player)
	end)
	Bus.On("UpgradeBought", function(player)
		tutorialDone(player, "Upgrade")
		checkAchievements(player)
	end)
	Bus.On("Review", function(player, stars)
		if stars == 5 then
			progress(player, "FiveStars", 1)
		end
		checkAchievements(player)
	end)
	Bus.On("Visit", function(player)
		progress(player, "Visits", 1)
		checkAchievements(player)
	end)
	Bus.On("ClueFound", checkAchievements)
	Bus.On("MysterySolved", checkAchievements)
	Bus.On("UpgradesChanged", checkAchievements)

	Bus.On("NightStarted", function()
		for _, player in ipairs(Players:GetPlayers()) do
			checkAchievements(player)
		end
	end)

	Bus.On("StarCaught", function(player)
		local data = DataService.Get(player)
		if not data then
			return
		end
		data.Stats.Stars = data.Stats.Stars + 1
		local reward = 40 + data.Level * 5
		EconomyService.AddCash(player, reward, "Star")
		Net.Notify(player, ("You caught a shooting star! +%s (%d caught)"):format(Util.Money(reward), data.Stats.Stars), "good")
		checkAchievements(player)
	end)

	Bus.On("EventStarted", function(eventId)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			if data and not data.EventsSeen[eventId] then
				data.EventsSeen[eventId] = true
				local e = Events.NightById[eventId]
				Net.Notify(player, ("New event discovered: %s (logged in your Journal)"):format(e and e.Name or eventId), "good")
				Bus.Fire("Dirty", player)
			end
		end
	end)

	-- Leaderboards: written on save, read every 2 minutes
	DataService.OnSave(function(player, data)
		if earnedStore then
			pcall(function()
				earnedStore:SetAsync(tostring(player.UserId), math.floor(data.Stats.Earned))
			end)
		end
		if ratingStore and data.Rating.Count >= 5 then
			pcall(function()
				ratingStore:SetAsync(tostring(player.UserId), math.floor(data.Rating.Value * 100))
			end)
		end
	end)
	task.spawn(function()
		task.wait(8)
		while true do
			local earned = fetchBoard(earnedStore, false)
			local rating = fetchBoard(ratingStore, true)
			if earned then
				boardCache.Earned = earned
			end
			if rating then
				boardCache.Rating = rating
			end
			drawBoard(worldRefs.Leaderboards.Earned, boardCache.Earned, false)
			drawBoard(worldRefs.Leaderboards.Rating, boardCache.Rating, true)
			Log.Info("Progression", "leaderboards refreshed")
			task.wait(120)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		pendingCheck[player] = nil
	end)
end

ProgressionService.EnsureChallenges = ensureChallenges
return ProgressionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Optional Robux cosmetics (Developer Products). Purely cosmetic - every item
-- can also be earned in-game. Receipts are idempotent and only confirmed to
-- Roblox after the grant is saved, so a failed save is retried, not lost.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local byProductId = {}
for _, product in ipairs(Config.RobuxProducts) do
	if product.ProductId ~= 0 then
		byProductId[product.ProductId] = product
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local product = byProductId[info.ProductId]
	if not player or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, id in ipairs(data.Receipts) do
		if id == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	local alreadyOwned = data.Owned.Robux[product.Key] ~= nil
	data.Owned.Robux[product.Key] = true
	table.insert(data.Receipts, info.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	if DataService.Save(player, false) or RunService:IsStudio() then
		Net.Notify(player, ("Thank you! %s unlocked. Equip it in Customize."):format(product.Name), "good")
		Bus.Fire("Dirty", player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- roll back and let Roblox retry later
	if not alreadyOwned then
		data.Owned.Robux[product.Key] = nil
	end
	table.remove(data.Receipts)
	Log.Warn("Shop", "save failed, receipt will be retried", info.PurchaseId)
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">SocialService</string><ProtectedString name="Source"><![CDATA[-- Multiplayer: visiting stores, rating them, friend bonuses.
--
-- Trading is intentionally NOT implemented: a safe trade needs both
-- inventories to commit atomically across saves, and a half-applied trade is
-- the classic duplication exploit. Gifting/visiting gives the social loop
-- without that risk.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StoreService = require(script.Parent.StoreService)
local StoreBuilder = require(script.Parent.StoreBuilder)

local SocialService = {}

local friendCache = {} -- [a][b] = bool
local lastStore = {} -- [player] = owner userId currently inside
local visitedThisSession = {} -- [player] = { [ownerId] = true }

local function areFriends(a, b)
	friendCache[a] = friendCache[a] or {}
	if friendCache[a][b.UserId] == nil then
		local ok, result = pcall(function()
			return a:IsFriendsWith(b.UserId)
		end)
		friendCache[a][b.UserId] = ok and result or false
	end
	return friendCache[a][b.UserId]
end

local function onEnteredStore(visitor, owner)
	visitedThisSession[visitor] = visitedThisSession[visitor] or {}
	if visitedThisSession[visitor][owner.UserId] then
		return
	end
	visitedThisSession[visitor][owner.UserId] = true
	local vData = DataService.Get(visitor)
	local oData = DataService.Get(owner)
	if not vData or not oData then
		return
	end
	vData.Stats.Visits = vData.Stats.Visits + 1
	Net.Notify(owner, visitor.DisplayName .. " is visiting your store!", "info")
	Bus.Fire("Visit", visitor, owner)

	if areFriends(visitor, owner) then
		local today = Util.DayNumber()
		local key = tostring(owner.UserId)
		if vData.FriendBonus[key] ~= today then
			vData.FriendBonus[key] = today
			oData.FriendBonus[tostring(visitor.UserId)] = today
			EconomyService.AddCash(visitor, Config.FriendVisitBonus, "Friend")
			EconomyService.AddCash(owner, Config.FriendVisitBonus, "Friend")
			Net.Notify(visitor, ("Friendly visit bonus! You and %s both got %s."):format(owner.DisplayName, Util.Money(Config.FriendVisitBonus)), "good")
			Net.Notify(owner, ("Friendly visit bonus from %s! +%s"):format(visitor.DisplayName, Util.Money(Config.FriendVisitBonus)), "good")
		end
	end
	Bus.Fire("Dirty", visitor)
end

function SocialService.Init()
	Net.Handle("GetStores", { Rate = 1, Burst = 3 }, function(player)
		local list = {}
		for _, store in pairs(StoreService.All()) do
			local owner = store.Owner
			local data = owner and DataService.Get(owner)
			if data then
				table.insert(list, {
					UserId = owner.UserId,
					Name = owner.DisplayName,
					StoreName = store.Model:GetAttribute("StoreName") or "",
					Rating = data.Rating.Value,
					Reviews = data.Rating.Count,
					Level = data.Level,
					Title = data.Title,
					Friend = owner ~= player and areFriends(player, owner) or false,
					Mine = owner == player,
				})
			end
		end
		table.sort(list, function(a, b)
			return a.Rating > b.Rating
		end)
		return { ok = true, Stores = list }
	end)

	Net.Handle("Visit", { Rate = 0.3, Burst = 2 }, function(player, payload)
		local userId = Net.Int(payload.UserId, -(2 ^ 53), 2 ^ 53) -- Studio test players have negative ids
		local target = userId and Players:GetPlayerByUserId(userId)
		local store = target and StoreService.ForPlayer(target)
		local character = player.Character
		if not store or not character then
			return Net.Fail("That store isn't open right now.")
		end
		local spot = StoreBuilder.WorldPoint(store, StoreBuilder.DoorOutside - Vector3.new(0, 0, 6))
		character:PivotTo(CFrame.lookAt(spot + Vector3.new(0, 3, 0), store.CFrame.Position + Vector3.new(0, 3, 0)))
		return Net.Ok(target == player and "Welcome back to your store." or ("Welcome to " .. (store.Model:GetAttribute("StoreName") or "the store") .. "!"))
	end)

	Net.Handle("RateStore", { Rate = 0.5, Burst = 2 }, function(player, payload)
		local data = DataService.Get(player)
		local userId = Net.Int(payload.Owner, -(2 ^ 53), 2 ^ 53)
		local stars = Net.Int(payload.Stars, 1, 5)
		local owner = userId and Players:GetPlayerByUserId(userId)
		local store = owner and StoreService.ForPlayer(owner)
		if not data or not stars or not store then
			return Net.Fail("That store isn't open.")
		end
		if owner == player then
			return Net.Fail("You can't rate your own store!")
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root or StoreService.StoreAt(root.Position) ~= store then
			return Net.Fail("Rate a store while you're inside it.")
		end
		local today = Util.DayNumber()
		local key = tostring(owner.UserId)
		if data.RatedStores[key] == today then
			return Net.Fail("You already rated this store today.")
		end
		data.RatedStores[key] = today
		local text = stars >= 4 and "Great store, I'll be back!" or (stars == 3 and "Pretty nice store." or "Could use some work.")
		StoreService.AddReview(owner, player.DisplayName .. " (player)", stars, text)
		Bus.Fire("Dirty", player)
		return Net.Ok("Thanks for rating! The shopkeeper will see your review.")
	end)

	-- Who is inside whose store
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				local store = root and StoreService.StoreAt(root.Position)
				local owner = store and store.Owner
				local ownerId = owner and owner.UserId or 0
				if ownerId ~= (lastStore[player] or 0) then
					lastStore[player] = ownerId
					if owner and owner ~= player then
						task.spawn(onEnteredStore, player, owner)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		friendCache[player] = nil
		lastStore[player] = nil
		visitedThisSession[player] = nil
	end)
end

return SocialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">StateService</string><ProtectedString name="Source"><![CDATA[-- Sends each player a snapshot of everything their UI needs. Changes are
-- batched: services call Bus.Fire("Dirty", player) and at most ~4 snapshots
-- per second go out per player.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Challenges = require(Shared:WaitForChild("Challenges"))
local Effects = require(Shared:WaitForChild("Effects"))
local Util = require(Shared:WaitForChild("Util"))

local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local MysteryService = require(script.Parent.MysteryService)
local ProgressionService = require(script.Parent.ProgressionService)

local StateService = {}

local dirty = {}

local function snapshot(player)
	local profile = DataService.Profile(player)
	local data = profile and profile.Data
	if not data then
		return nil
	end
	ProgressionService.EnsureChallenges(player, data)
	local challenges = {}
	for i, entry in ipairs(data.Challenges.List) do
		local def = Challenges.ById[entry.Id]
		if def then
			challenges[i] = { Desc = def.Desc, Goal = def.Goal, Progress = entry.Progress, Claimed = entry.Claimed, Reward = def.Reward + data.Level * 15 }
		end
	end
	return {
		Cash = data.Cash,
		Level = data.Level,
		Xp = data.Xp,
		XpNeed = Config.XpForLevel(data.Level),
		Inventory = data.Inventory,
		Shelves = data.Shelves,
		Upgrades = data.Upgrades,
		Effects = Effects.Compute(data.Upgrades),
		Store = data.Store,
		Rating = data.Rating,
		Stats = data.Stats,
		StatValues = ProgressionService.StatValues(data),
		Products = data.Products,
		Customers = data.Customers,
		EventsSeen = data.EventsSeen,
		Achievements = data.Achievements,
		Secrets = data.Secrets,
		Solved = data.Solved,
		Owned = data.Owned,
		SeasonUnlocks = data.SeasonUnlocks,
		Month = os.date("!*t").month,
		Daily = { LastDay = data.Daily.LastDay, Streak = data.Daily.Streak, BestStreak = data.Daily.BestStreak, Today = Util.DayNumber(), SecondsLeft = 86400 - os.time() % 86400 },
		Challenges = challenges,
		Journal = MysteryService.Journal(data),
		Settings = data.Settings,
		Tutorial = data.Tutorial,
		Title = data.Title,
		Saving = profile.CanSave,
		PlotIndex = player:GetAttribute("PlotIndex") or 0,
	}
end

function StateService.Push(player)
	local state = snapshot(player)
	if state then
		Net.Events.State:FireClient(player, state)
	end
end

local SETTINGS = {
	Rain = "boolean", LowGraphics = "boolean", Bubbles = "boolean",
	UIScale = "number", Volume = "number",
}

function StateService.Init()
	Bus.On("Dirty", function(player)
		if player then
			dirty[player] = true
		end
	end)
	Bus.On("ProfileLoaded", function(player)
		StateService.Push(player)
	end)

	Net.Handle("GetState", { Rate = 1, Burst = 3 }, function(player)
		return { ok = true, State = snapshot(player) }
	end)

	Net.Handle("SetSetting", { Rate = 4, Burst = 8 }, function(player, payload)
		local data = DataService.Get(player)
		local key = type(payload.Key) == "string" and payload.Key
		local kind = key and SETTINGS[key]
		if not data or not kind or type(payload.Value) ~= kind then
			return Net.Fail("Invalid setting.")
		end
		local value = payload.Value
		if kind == "number" then
			if value ~= value then
				return Net.Fail("Invalid setting.")
			end
			value = math.clamp(value, key == "UIScale" and 0.7 or 0, key == "UIScale" and 1.3 or 1)
		end
		data.Settings[key] = value
		dirty[player] = true
		return Net.Ok()
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			for player in pairs(dirty) do
				dirty[player] = nil
				if player.Parent then
					StateService.Push(player)
				end
			end
		end
	end)

	-- the daily countdown and day rollover should stay fresh
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				dirty[player] = true
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
end

return StateService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">StoreBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds and restyles one player store. Pure visuals + markers: all store
-- logic lives in StoreService.
--
-- Store-local space: origin = interior floor center, the door faces local -Z
-- (toward the street). Interior is 60 x 40 (x: -30..30, z: -20..20).
-- A stockroom partition hides the back of the store until it's expanded.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Products = require(Shared:WaitForChild("Products"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local StoreBuilder = {}

local C = Color3.fromRGB
local M = Enum.Material

StoreBuilder.UnitCount = 12
StoreBuilder.ShelfSize = Vector3.new(12, 6, 3)
StoreBuilder.CoolerSize = Vector3.new(8, 8, 3.5)

function StoreBuilder.IsCooler(unitIndex)
	return unitIndex % 3 == 0
end

-- Which expansion level unlocks each unit (3 units per level)
function StoreBuilder.UnitTier(unitIndex)
	return math.ceil(unitIndex / 3)
end

-- Partition position for each expansion level (nil = fully open)
local PARTITION_Z = { -0.5, 6.75, 13.75 }

-- Layout presets: { x, z, yawDegrees } per unit. All keep the checkout lane
-- (x > 12, z < -1) clear and every unit inside its tier's open area.
StoreBuilder.Layouts = {
	Classic = {
		{ -14, -5, 0 }, { 2, -5, 0 }, { -28.25, -5.5, -90 },
		{ -14, 3, 0 }, { 2, 3, 0 }, { -28.25, 2.2, -90 },
		{ -14, 10.5, 0 }, { 2, 10.5, 0 }, { -28.25, 9, -90 },
		{ -14, 17.5, 0 }, { 2, 17.5, 0 }, { 14, 18.25, 0 },
	},
	TwinAisles = {
		{ -8, -5, 0 }, { 6, -5, 0 }, { -28.25, -5.5, -90 },
		{ -8, 3, 0 }, { 6, 3, 0 }, { 28.25, 2.2, 90 },
		{ -8, 10.5, 0 }, { 6, 10.5, 0 }, { 28.25, 9, 90 },
		{ -8, 17.5, 0 }, { 6, 17.5, 0 }, { -26, 18.25, 0 },
	},
	MarketHall = {
		{ -15, -5, 0 }, { 1, -5, 0 }, { -28.25, -5.5, -90 },
		{ -6, 3, 0 }, { 10, 3, 0 }, { -28.25, 2.2, -90 },
		{ -6, 10.5, 0 }, { 10, 10.5, 0 }, { 28.25, 9, 90 },
		{ -18, 17.5, 0 }, { -2, 17.5, 0 }, { 14, 18.25, 0 },
	},
}

StoreBuilder.QueuePoints = {
	Vector3.new(25.5, 0, -8.2), Vector3.new(21, 0, -8.2), Vector3.new(16.5, 0, -8.2),
	Vector3.new(25.5, 0, -4.6), Vector3.new(21, 0, -4.6), Vector3.new(16.5, 0, -4.6),
}
StoreBuilder.DoorOutside = Vector3.new(0, 0, -25)
StoreBuilder.DoorInside = Vector3.new(0, 0, -16)
StoreBuilder.Sidewalk = { Vector3.new(-24, 0, -52), Vector3.new(24, 0, -52) }
StoreBuilder.OwnerSpawn = Vector3.new(22, 3, -17)

local function part(parent, name, size, cframe, color, material, extra)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(extra or {}) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function surfaceText(target, face, text, color, ppS)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppS or 30
	gui.LightInfluence = 0
	gui.Parent = target
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = color
	t.Text = text
	t.Parent = gui
	return t
end

local function prompt(parent, action, object, distance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.HoldDuration = 0
	p.MaxActivationDistance = distance or 10
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------
-- Units (shelves and coolers)
---------------------------------------------------------------------------
local function buildUnit(store, index)
	local cooler = StoreBuilder.IsCooler(index)
	local model = Instance.new("Model")
	model.Name = "Unit" .. index
	local shelfParts = {}
	local size = cooler and StoreBuilder.CoolerSize or StoreBuilder.ShelfSize
	local hx, hz = size.X / 2, size.Z / 2
	local origin = CFrame.new()

	local back = part(model, "Back", Vector3.new(size.X, size.Y, 0.4), origin * CFrame.new(0, size.Y / 2, hz - 0.2), C(230, 230, 235))
	table.insert(shelfParts, back)
	table.insert(shelfParts, part(model, "Base", Vector3.new(size.X, 0.6, size.Z), origin * CFrame.new(0, 0.3, 0), C(230, 230, 235)))
	table.insert(shelfParts, part(model, "SideL", Vector3.new(0.3, size.Y, size.Z), origin * CFrame.new(-hx + 0.15, size.Y / 2, 0), C(230, 230, 235)))
	table.insert(shelfParts, part(model, "SideR", Vector3.new(0.3, size.Y, size.Z), origin * CFrame.new(hx - 0.15, size.Y / 2, 0), C(230, 230, 235)))
	local rows
	if cooler then
		table.insert(shelfParts, part(model, "Top", Vector3.new(size.X, 0.4, size.Z), origin * CFrame.new(0, size.Y - 0.2, 0), C(230, 230, 235)))
		table.insert(shelfParts, part(model, "Board", Vector3.new(size.X - 0.6, 0.2, size.Z - 0.6), origin * CFrame.new(0, 3.6, 0.1), C(200, 220, 235), M.Glass))
		part(model, "GlassDoor", Vector3.new(size.X - 0.6, size.Y - 1, 0.15), origin * CFrame.new(0, size.Y / 2, -hz + 0.1), C(200, 230, 255), M.Glass, { Transparency = 0.7, CanCollide = false })
		local glow = part(model, "ColdGlow", Vector3.new(size.X - 0.8, 0.2, 0.4), origin * CFrame.new(0, size.Y - 0.6, -hz + 0.6), C(170, 220, 255), M.Neon, { CanCollide = false })
		local light = Instance.new("SurfaceLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 8
		light.Brightness = 1.5
		light.Color = C(190, 225, 255)
		light.Parent = glow
		rows = { 1.2, 4.2 }
	else
		table.insert(shelfParts, part(model, "Board1", Vector3.new(size.X - 0.6, 0.25, size.Z - 0.4), origin * CFrame.new(0, 2.3, 0.1), C(230, 230, 235)))
		table.insert(shelfParts, part(model, "Board2", Vector3.new(size.X - 0.6, 0.25, size.Z - 0.4), origin * CFrame.new(0, 4.3, 0.1), C(230, 230, 235)))
		rows = { 1.2, 3.05 }
	end
	local strip = part(model, "TagStrip", Vector3.new(size.X - 0.4, 0.5, 0.1), origin * CFrame.new(0, 0.65, -hz - 0.05), C(255, 255, 255), M.SmoothPlastic, { CanCollide = false })
	local tagGui = Instance.new("SurfaceGui")
	tagGui.Face = Enum.NormalId.Front
	tagGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tagGui.PixelsPerStud = 40
	tagGui.LightInfluence = 0
	tagGui.Parent = strip
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Parent = tagGui
	local tags = {}
	for slot = 1, Config.SlotsPerUnit do
		local t = Instance.new("TextLabel")
		t.Size = UDim2.new(1 / Config.SlotsPerUnit, 0, 1, 0)
		t.BackgroundTransparency = 1
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.TextColor3 = C(30, 30, 40)
		t.Text = "empty"
		t.Parent = tagGui
		tags[slot] = t
	end
	local items = Instance.new("Folder")
	items.Name = "Items"
	items.Parent = model
	model.WorldPivot = CFrame.new()
	model.Parent = store.Model

	local p = prompt(back, cooler and "Stock Cooler" or "Stock Shelf", cooler and "Cooler" or "Shelf", 10)
	return {
		Index = index, Model = model, Cooler = cooler, Size = size, Rows = rows,
		ShelfParts = shelfParts, Tags = tags, Items = items, Prompt = p, CFrame = CFrame.new(),
	}
end

---------------------------------------------------------------------------
-- Decorations (fixed spots)
---------------------------------------------------------------------------
local DECOR_BUILDERS = {
	Plant = function(f, cf)
		part(f, "Pot", Vector3.new(2, 2, 2), cf * CFrame.new(-27, 1, -17.5), C(170, 90, 60), M.Slate)
		local leaves = part(f, "Leaves", Vector3.new(3.5, 3.5, 3.5), cf * CFrame.new(-27, 3.6, -17.5), C(60, 150, 80), M.LeafyGrass)
		leaves.Shape = Enum.PartType.Ball
	end,
	Calendar = function(f, cf)
		local cal = part(f, "Calendar", Vector3.new(0.1, 4, 3), cf * CFrame.new(-29.9, 8, -12), C(255, 250, 240))
		surfaceText(cal, Enum.NormalId.Right, "=^.^=\nCAT\nCALENDAR", C(230, 110, 150), 40)
	end,
	Bench = function(f, cf)
		part(f, "Bench", Vector3.new(8, 0.6, 2.4), cf * CFrame.new(-14, 2, -23.5), C(120, 80, 50), M.WoodPlanks)
		part(f, "BenchLegs", Vector3.new(7, 1.7, 1.6), cf * CFrame.new(-14, 0.85, -23.5), C(60, 60, 65), M.Metal)
	end,
	StringLights = function(f, cf)
		for i = -12, 12 do
			local bulb = part(f, "Bulb", Vector3.new(0.5, 0.5, 0.5), cf * CFrame.new(i * 2.3, 12.6 - math.abs(math.sin(i * 0.5)) * 0.6, -19.6), C(255, 210 - (i % 3) * 40, 120 + (i % 2) * 80), M.Neon, { CanCollide = false })
			bulb.Shape = Enum.PartType.Ball
		end
	end,
	Gumball = function(f, cf)
		part(f, "Stand", Vector3.new(1.2, 3, 1.2), cf * CFrame.new(-11, 1.5, -18), C(200, 40, 40), M.Metal)
		local globe = part(f, "Globe", Vector3.new(2.4, 2.4, 2.4), cf * CFrame.new(-11, 4.1, -18), C(255, 255, 255), M.Glass, { Transparency = 0.4 })
		globe.Shape = Enum.PartType.Ball
		for i = 1, 6 do
			local g = part(f, "Gum", Vector3.new(0.5, 0.5, 0.5), cf * CFrame.new(-11 + math.sin(i) * 0.6, 3.6 + (i % 3) * 0.3, -18 + math.cos(i) * 0.6), Color3.fromHSV(i / 6, 0.7, 1), M.Neon, { CanCollide = false })
			g.Shape = Enum.PartType.Ball
		end
	end,
	FishTank = function(f, cf)
		part(f, "Tank", Vector3.new(2.6, 1.8, 1.4), cf * CFrame.new(26.6, 4.9, -12), C(120, 200, 255), M.Glass, { Transparency = 0.5 })
		part(f, "Fish", Vector3.new(0.5, 0.3, 0.2), cf * CFrame.new(26.4, 5, -12), C(255, 140, 40), M.Neon, { CanCollide = false })
	end,
	LuckyCat = function(f, cf)
		part(f, "CatBody", Vector3.new(1.2, 1.4, 1), cf * CFrame.new(17.2, 4.7, -12), C(255, 250, 245))
		local paw = part(f, "Paw", Vector3.new(0.35, 0.8, 0.35), cf * CFrame.new(17.8, 5.6, -12.3), C(255, 250, 245), M.SmoothPlastic, { CanCollide = false })
		CollectionService:AddTag(paw, "Wave")
		part(f, "Collar", Vector3.new(1.25, 0.2, 1.05), cf * CFrame.new(17.2, 5.1, -12), C(220, 40, 40))
	end,
	Arcade = function(f, cf)
		part(f, "Cabinet", Vector3.new(3, 7, 3), cf * CFrame.new(-20, 3.5, -18), C(40, 30, 70))
		local screen = part(f, "Screen", Vector3.new(2.4, 2, 0.1), cf * CFrame.new(-20, 5, -19.55), C(80, 255, 200), M.Neon, { CanCollide = false })
		CollectionService:AddTag(screen, "Flicker")
	end,
	RoofSign = function(f, cf)
		local s = part(f, "RoofSign", Vector3.new(22, 4, 0.5), cf * CFrame.new(0, 19.5, -12), C(20, 20, 25))
		local t = surfaceText(s, Enum.NormalId.Front, "OPEN 24/7", C(255, 70, 90), 40)
		t.TextStrokeColor3 = C(255, 70, 90)
		t.TextStrokeTransparency = 0.3
		part(f, "RoofSignLegs", Vector3.new(16, 3, 0.4), cf * CFrame.new(0, 16, -12), C(60, 60, 65), M.Metal)
	end,
	Portrait = function(f, cf)
		part(f, "Frame", Vector3.new(0.2, 5, 4), cf * CFrame.new(29.8, 8, -16), C(150, 110, 50), M.Wood)
		local pic = part(f, "Picture", Vector3.new(0.1, 4.2, 3.2), cf * CFrame.new(29.65, 8, -16), C(240, 220, 180))
		surfaceText(pic, Enum.NormalId.Left, "FIRST LIGHT\nOPENING NIGHT", C(90, 60, 30), 40)
	end,
	KoiSign = function(f, cf)
		local s = part(f, "KoiSign", Vector3.new(0.2, 4, 7), cf * CFrame.new(-29.85, 9, 4), C(20, 20, 30))
		local t = surfaceText(s, Enum.NormalId.Right, "><(((°>", C(255, 140, 60), 40)
		t.TextStrokeColor3 = C(255, 140, 60)
		t.TextStrokeTransparency = 0.2
		CollectionService:AddTag(s, "Flicker")
	end,
}

---------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------
function StoreBuilder.Build(index, plotCFrame, parent)
	local cf = plotCFrame
	local model = Instance.new("Model")
	model.Name = "Store" .. index
	model:SetAttribute("PlotIndex", index)
	model.Parent = parent

	local store = { Index = index, CFrame = cf, Model = model, Themed = { Wall = {}, Floor = {}, Trim = {}, Neon = {}, Roof = {}, Sign = {}, Exterior = {} } }
	local T = store.Themed
	local W = C(235, 232, 222)

	-- Lot, floor and walls
	local lot = part(model, "ParkingLot", Vector3.new(66, 0.2, 28), cf * CFrame.new(0, 0.12, -35), C(48, 48, 54), M.Asphalt, { CanCollide = false })
	for _, x in ipairs({ -24, -12, 12, 24 }) do
		part(model, "ParkingLine", Vector3.new(0.5, 0.05, 10), cf * CFrame.new(x, 0.25, -38), C(220, 220, 220), M.SmoothPlastic, { CanCollide = false })
	end
	store.Lot = lot
	table.insert(T.Floor, part(model, "Floor", Vector3.new(60, 0.2, 40), cf * CFrame.new(0, 0.12, 0), C(200, 200, 205), M.Marble, { CanCollide = false }))
	table.insert(T.Wall, part(model, "BackWall", Vector3.new(62, 14, 1), cf * CFrame.new(0, 7, 20.5), W))
	table.insert(T.Wall, part(model, "LeftWall", Vector3.new(1, 14, 42), cf * CFrame.new(-30.5, 7, 0), W))
	table.insert(T.Wall, part(model, "RightWall", Vector3.new(1, 14, 42), cf * CFrame.new(30.5, 7, 0), W))
	for _, side in ipairs({ -1, 1 }) do
		local x = side * 18
		table.insert(T.Exterior, part(model, "FrontLow", Vector3.new(25, 3, 1), cf * CFrame.new(x, 1.5, -20.5), W))
		table.insert(T.Exterior, part(model, "FrontHigh", Vector3.new(25, 5, 1), cf * CFrame.new(x, 11.5, -20.5), W))
		part(model, "Window", Vector3.new(25, 6, 0.3), cf * CFrame.new(x, 6, -20.5), C(180, 220, 255), M.Glass, { Transparency = 0.6 })
	end
	table.insert(T.Exterior, part(model, "Lintel", Vector3.new(11, 4, 1), cf * CFrame.new(0, 12, -20.5), W))
	table.insert(T.Roof, part(model, "Roof", Vector3.new(63, 1, 43), cf * CFrame.new(0, 14.5, 0), C(70, 75, 85)))
	-- Door trim + automatic sliding doors (animated on each client)
	for _, x in ipairs({ -5.6, 5.6 }) do
		table.insert(T.Trim, part(model, "DoorFrame", Vector3.new(0.6, 10, 1.2), cf * CFrame.new(x, 5, -20.5), C(40, 110, 200), M.Metal))
	end
	for _, side in ipairs({ -1, 1 }) do
		local door = part(model, "AutoDoor", Vector3.new(5, 9.6, 0.2), cf * CFrame.new(side * 2.5, 4.8, -20.6), C(190, 225, 255), M.Glass, { Transparency = 0.55, CanCollide = false })
		door:SetAttribute("Side", side)
		CollectionService:AddTag(door, "AutoDoor")
	end
	-- Sign band
	local signBoard = part(model, "SignBoard", Vector3.new(36, 4, 0.8), cf * CFrame.new(0, 16.6, -21), C(40, 110, 200))
	table.insert(T.Sign, signBoard)
	store.SignLabel = surfaceText(signBoard, Enum.NormalId.Front, "FOR RENT", C(255, 255, 255), 30)
	local signGlow = part(model, "SignGlow", Vector3.new(37, 0.4, 0.4), cf * CFrame.new(0, 14.4, -21.3), C(255, 200, 80), M.Neon, { CanCollide = false })
	table.insert(T.Neon, signGlow)
	-- Ceiling lights
	for _, z in ipairs({ -10, 2, 14 }) do
		local panel = part(model, "CeilingLight", Vector3.new(40, 0.2, 2), cf * CFrame.new(0, 13.9, z), C(255, 250, 235), M.Neon, { CanCollide = false })
		local light = Instance.new("SurfaceLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 16
		light.Brightness = 1.2
		light.Color = C(255, 245, 225)
		light.Parent = panel
	end
	-- Warm light spilling into the parking lot at night
	local spill = Instance.new("SurfaceLight")
	spill.Face = Enum.NormalId.Front
	spill.Range = 24
	spill.Brightness = 1.5
	spill.Color = C(255, 230, 190)
	spill.Parent = signBoard

	-- Counter + register
	table.insert(T.Trim, part(model, "Counter", Vector3.new(12, 4, 3), cf * CFrame.new(22, 2, -12), C(40, 110, 200)))
	part(model, "CounterTop", Vector3.new(12.4, 0.3, 3.4), cf * CFrame.new(22, 4.15, -12), C(240, 240, 240), M.Marble)
	local register = part(model, "Register", Vector3.new(2.4, 1.2, 2), cf * CFrame.new(22, 4.9, -12.3), C(50, 50, 60), M.Metal)
	part(model, "RegisterScreen", Vector3.new(1.6, 0.9, 0.1), cf * CFrame.new(22, 5.9, -12.9) * CFrame.Angles(math.rad(-15), 0, 0), C(80, 255, 160), M.Neon, { CanCollide = false })
	store.Register = register
	store.RegisterPrompt = prompt(register, "Ring Up", "Register", 12)
	store.RegisterPrompt.KeyboardKeyCode = Enum.KeyCode.E
	store.RegisterPrompt.Enabled = false

	-- Guestbook for visitors
	part(model, "Podium", Vector3.new(2, 3.6, 2), cf * CFrame.new(-9, 1.8, -17), C(120, 85, 55), M.Wood)
	local book = part(model, "Guestbook", Vector3.new(1.8, 0.3, 1.4), cf * CFrame.new(-9, 3.75, -17), C(150, 40, 40))
	store.GuestbookPrompt = prompt(book, "Rate Store", "Guestbook", 8)

	-- Stockroom partition
	local partition = part(model, "Partition", Vector3.new(60, 14, 1), cf * CFrame.new(0, 7, PARTITION_Z[1]), W)
	table.insert(T.Wall, partition)
	surfaceText(partition, Enum.NormalId.Front, "STOCKROOM\nexpand your store to unlock this space", C(120, 120, 130), 20)
	store.Partition = partition

	-- Units
	store.Units = {}
	for i = 1, StoreBuilder.UnitCount do
		store.Units[i] = buildUnit(store, i)
	end

	-- Decor folder
	store.Decor = Instance.new("Folder")
	store.Decor.Name = "Decor"
	store.Decor.Parent = model

	StoreBuilder.ApplyTheme(store, Cosmetics.ThemeById.Classic)
	StoreBuilder.ApplyLayout(store, "Classic", 1)
	return store
end

---------------------------------------------------------------------------
-- Restyling
---------------------------------------------------------------------------
function StoreBuilder.ApplyTheme(store, theme)
	local T = store.Themed
	for _, p in ipairs(T.Wall) do
		p.Color = theme.Wall
		p.Material = theme.WallMat
	end
	for _, p in ipairs(T.Floor) do
		p.Color = theme.Floor
		p.Material = theme.FloorMat
	end
	for _, p in ipairs(T.Trim) do
		p.Color = theme.Trim
	end
	for _, p in ipairs(T.Neon) do
		p.Color = theme.Neon
	end
	for _, p in ipairs(T.Roof) do
		p.Color = theme.Roof
	end
	for _, p in ipairs(T.Sign) do
		p.Color = theme.Sign
	end
	for _, p in ipairs(T.Exterior) do
		p.Color = theme.Exterior
		p.Material = theme.WallMat
	end
	for _, unit in ipairs(store.Units or {}) do
		for _, p in ipairs(unit.ShelfParts) do
			p.Color = theme.Shelf
		end
	end
	store.ThemeId = theme.Id
end

function StoreBuilder.ApplyLayout(store, layoutId, expansion)
	local layout = StoreBuilder.Layouts[layoutId] or StoreBuilder.Layouts.Classic
	for i, unit in ipairs(store.Units) do
		local info = layout[i]
		unit.CFrame = store.CFrame * CFrame.new(info[1], 0, info[2]) * CFrame.Angles(0, math.rad(info[3]), 0)
		unit.Model:PivotTo(unit.CFrame)
		local open = StoreBuilder.UnitTier(i) <= expansion
		unit.Model.Parent = open and store.Model or nil
		unit.Prompt.Enabled = open
		unit.Open = open
		-- where customers stand to browse this unit
		unit.Front = (unit.CFrame * CFrame.new(0, 0, -(unit.Size.Z / 2 + 2.5))).Position
	end
	local z = PARTITION_Z[expansion]
	if z then
		store.Partition.Parent = store.Model
		store.Partition.CFrame = store.CFrame * CFrame.new(0, 7, z)
	else
		store.Partition.Parent = nil
	end
	store.Expansion = expansion
	store.LayoutId = layoutId
end

local SHAPES = {
	Can = { Vector3.new(0.8, 1.1, 0.8), Enum.PartType.Cylinder },
	Bottle = { Vector3.new(0.6, 1.5, 0.6), Enum.PartType.Cylinder },
	Box = { Vector3.new(0.9, 1.2, 0.6), Enum.PartType.Block },
	Bag = { Vector3.new(1, 1.3, 0.5), Enum.PartType.Block },
	Jar = { Vector3.new(0.8, 0.9, 0.8), Enum.PartType.Cylinder },
}

-- slots: array [1..4] of { P = productId, Q = qty } or nil
function StoreBuilder.UpdateUnit(store, unitIndex, slots, capacity)
	local unit = store.Units[unitIndex]
	unit.Items:ClearAllChildren()
	local slotWidth = unit.Size.X / Config.SlotsPerUnit
	for slot = 1, Config.SlotsPerUnit do
		local entry = slots[slot]
		local tag = unit.Tags[slot]
		if entry and entry.P and entry.Q > 0 then
			local product = Products.ById[entry.P]
			tag.Text = ("%s %d/%d"):format(product and product.Name or "?", entry.Q, capacity)
			tag.TextColor3 = entry.Q <= 2 and C(220, 60, 60) or C(30, 30, 40)
			local shown = math.clamp(math.ceil(entry.Q / capacity * 4), 1, 4)
			local shape = SHAPES[product and product.Shape or "Box"]
			local x = -unit.Size.X / 2 + slotWidth * (slot - 0.5)
			for n = 1, shown do
				local row = unit.Rows[(n - 1) // 2 + 1]
				local dx = ((n - 1) % 2 == 0) and -slotWidth * 0.22 or slotWidth * 0.22
				local size = shape[1]
				local item = Instance.new("Part")
				item.Name = entry.P
				item.Anchored = true
				item.CanCollide = false
				item.CanQuery = false
				item.CanTouch = false
				item.Color = product and product.Color or C(200, 200, 200)
				item.Material = M.SmoothPlastic
				if shape[2] == Enum.PartType.Cylinder then
					item.Shape = Enum.PartType.Cylinder
					item.Size = Vector3.new(size.Y, size.X, size.Z)
					item.CFrame = unit.CFrame * CFrame.new(x + dx, row + size.Y / 2 - 0.55, -0.2) * CFrame.Angles(0, 0, math.rad(90))
				else
					item.Size = size
					item.CFrame = unit.CFrame * CFrame.new(x + dx, row + size.Y / 2 - 0.55, -0.2)
				end
				item.Parent = unit.Items
			end
		else
			tag.Text = "empty"
			tag.TextColor3 = C(150, 150, 160)
		end
	end
end

function StoreBuilder.SetSign(store, text, color)
	store.SignLabel.Text = text
	for _, p in ipairs(store.Themed.Sign) do
		p.Color = color
	end
end

function StoreBuilder.ApplyDecor(store, decorOn)
	store.Decor:ClearAllChildren()
	for id, on in pairs(decorOn or {}) do
		local build = DECOR_BUILDERS[id]
		if on and build then
			build(store.Decor, store.CFrame)
		end
	end
end

-- A glowing note on the counter (Mysterious Message event / founder clue)
function StoreBuilder.SetNote(store, visible)
	if visible and not store.Note then
		local note = part(store.Model, "MysteryNote", Vector3.new(1, 0.1, 0.8), store.CFrame * CFrame.new(18, 4.35, -12), C(255, 245, 220), M.Neon, { CanCollide = false })
		store.Note = note
		store.NotePrompt = prompt(note, "Read note", "Folded note", 8)
		return store.NotePrompt
	elseif not visible and store.Note then
		store.Note:Destroy()
		store.Note = nil
		store.NotePrompt = nil
	end
	return nil
end

function StoreBuilder.WorldPoint(store, localPoint)
	return (store.CFrame * CFrame.new(localPoint)).Position
end

return StoreBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">StoreService</string><ProtectedString name="Source"><![CDATA[-- Store ownership, shelves, checkout queue and customization.
--
-- Shelf contents live in the player's save (data.Shelves) and are mirrored
-- to the 3D store. Players stock shelves by walking to them (prompt opens
-- the stock menu; the server re-checks distance on every request).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Products = require(Shared:WaitForChild("Products"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Effects = require(Shared:WaitForChild("Effects"))
local Unlocks = require(Shared:WaitForChild("Unlocks"))
local Util = require(Shared:WaitForChild("Util"))

local Log = require(script.Parent.Log)
local Bus = require(script.Parent.Bus)
local Net = require(script.Parent.Net)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local CycleService = require(script.Parent.CycleService)
local StoreBuilder = require(script.Parent.StoreBuilder)

local StoreService = {}

local stores = {} -- [plotIndex] = store
local byPlayer = {} -- [Player] = store
local storesFolder

StoreService.OnCheckout = nil -- set by CustomerService: function(store, customer, byPlayer)
StoreService.OnClosing = nil -- set by CustomerService: function(store) returns carts, removes NPCs

local function slotKey(unit, slot)
	return "u" .. unit .. "s" .. slot
end

function StoreService.All()
	return stores
end

function StoreService.ForPlayer(player)
	return byPlayer[player]
end

function StoreService.EffectsFor(player)
	local store = byPlayer[player]
	if store and store.Effects then
		return store.Effects
	end
	local data = DataService.Get(player)
	return Effects.Compute(data and data.Upgrades)
end

-- Which store (if any) contains this world position
function StoreService.StoreAt(position)
	for _, store in pairs(stores) do
		local p = store.CFrame:PointToObjectSpace(position)
		if math.abs(p.X) <= 31 and p.Z >= -21 and p.Z <= 21 and p.Y > -5 and p.Y < 20 then
			return store
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Shelf state
---------------------------------------------------------------------------
function StoreService.Slots(store, unitIndex)
	local data = store.Owner and DataService.Get(store.Owner)
	local slots = {}
	if data then
		for slot = 1, Config.SlotsPerUnit do
			slots[slot] = data.Shelves[slotKey(unitIndex, slot)]
		end
	end
	return slots
end

function StoreService.RefreshUnit(store, unitIndex)
	StoreBuilder.UpdateUnit(store, unitIndex, StoreService.Slots(store, unitIndex), store.Effects.SlotCapacity)
end

function StoreService.RefreshAllUnits(store)
	for i = 1, StoreBuilder.UnitCount do
		StoreService.RefreshUnit(store, i)
	end
end

-- Every stocked slot in open units: { Unit, Slot, P, Q, Front }
function StoreService.Stocked(store)
	local list = {}
	local data = store.Owner and DataService.Get(store.Owner)
	if not data then
		return list
	end
	for _, unit in ipairs(store.Units) do
		if unit.Open then
			for slot = 1, Config.SlotsPerUnit do
				local entry = data.Shelves[slotKey(unit.Index, slot)]
				if entry and entry.Q > 0 then
					table.insert(list, { Unit = unit.Index, Slot = slot, P = entry.P, Q = entry.Q, Front = unit.Front })
				end
			end
		end
	end
	return list
end

-- A customer takes up to qty units from a slot. Returns how many they got.
function StoreService.Take(store, unitIndex, slot, productId, qty)
	local data = store.Owner and DataService.Get(store.Owner)
	if not data then
		return 0
	end
	local key = slotKey(unitIndex, slot)
	local entry = data.Shelves[key]
	if not entry or entry.P ~= productId or entry.Q <= 0 then
		return 0
	end
	local taken = math.min(qty, entry.Q)
	entry.Q = entry.Q - taken
	if entry.Q <= 0 then
		data.Shelves[key] = nil
	end
	StoreService.RefreshUnit(store, unitIndex)
	Bus.Fire("Dirty", store.Owner)
	return taken
end

-- Put items back (customer left without paying)
function StoreService.Return(store, unitIndex, slot, productId, qty)
	local data = store.Owner and DataService.Get(store.Owner)
	if not data or qty <= 0 then
		return
	end
	local key = slotKey(unitIndex, slot)
	local entry = data.Shelves[key]
	if not entry then
		data.Shelves[key] = { P = productId, Q = qty }
	elseif entry.P == productId then
		entry.Q = entry.Q + qty
	else
		data.Inventory[productId] = (data.Inventory[productId] or 0) + qty
	end
	StoreService.RefreshUnit(store, unitIndex)
	Bus.Fire("Dirty", store.Owner)
end

---------------------------------------------------------------------------
-- Reviews & rating (moving average over roughly the last 30 reviews)
---------------------------------------------------------------------------
function StoreService.AddReview(player, author, stars, text)
	local data = player and DataService.Get(player)
	if not data then
		return
	end
	stars = math.clamp(math.floor(stars), 1, 5)
	local r = data.Rating
	local window = math.min(r.Count, 30)
	r.Value = (r.Value * window + stars) / (window + 1)
	r.Count = r.Count + 1
	table.insert(r.Recent, 1, { A = author, S = stars, T = text })
	while #r.Recent > 6 do
		table.remove(r.Recent)
	end
	if stars == 5 then
		data.Stats.FiveStars = data.Stats.FiveStars + 1
	end
	Net.Notify(player, ("%s %s: \"%s\""):format(Util.Stars(stars), author, text), "review")
	Bus.Fire("Review", player, stars)
	Bus.Fire("RatingChanged", player)
	Bus.Fire("Dirty", player)
end

---------------------------------------------------------------------------
-- Checkout queue
---------------------------------------------------------------------------
function StoreService.JoinQueue(store, customer)
	if #store.Queue >= #StoreBuilder.QueuePoints then
		return false
	end
	table.insert(store.Queue, customer)
	return true
end

function StoreService.LeaveQueue(store, customer)
	for i, c in ipairs(store.Queue) do
		if c == customer then
			table.remove(store.Queue, i)
			return
		end
	end
end

function StoreService.QueuePosition(store, customer)
	for i, c in ipairs(store.Queue) do
		if c == customer then
			return i, StoreBuilder.WorldPoint(store, StoreBuilder.QueuePoints[i])
		end
	end
	return nil
end

local function checkout(store, by)
	local front = store.Queue[1]
	if not front or not front.AtCounter or front.State ~= "Queued" then
		return false
	end
	table.remove(store.Queue, 1)
	front.State = "Paid"
	if StoreService.OnCheckout then
		StoreService.OnCheckout(store, front, by)
	end
	return true
end

---------------------------------------------------------------------------
-- Applying a player's save to their store
---------------------------------------------------------------------------
local function unlockCtx(player, data)
	return Unlocks.Context(data, data.Level)
end

local function applyUniform(player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local uniform = Cosmetics.UniformById[data.Store.Uniform] or Cosmetics.UniformById.Classic
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	local old = character:FindFirstChild("Apron")
	if old then
		old:Destroy()
	end
	local apron = Instance.new("Part")
	apron.Name = "Apron"
	apron.Size = Vector3.new(1.8, 1.9, 0.15)
	apron.Color = uniform.Color
	apron.Material = uniform.Neon and Enum.Material.Neon or Enum.Material.Fabric
	apron.CanCollide = false
	apron.CanQuery = false
	apron.Massless = true
	apron.CFrame = torso.CFrame * CFrame.new(0, -0.35, -torso.Size.Z / 2 - 0.08)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = torso
	weld.Part1 = apron
	weld.Parent = apron
	apron.Parent = character
end

function StoreService.ApplyAll(store)
	local player = store.Owner
	local data = player and DataService.Get(player)
	if not data then
		return
	end
	store.Effects = Effects.Compute(data.Upgrades)
	local theme = Cosmetics.ThemeById[data.Store.Theme] or Cosmetics.ThemeById.Classic
	StoreBuilder.ApplyTheme(store, theme)
	StoreBuilder.ApplyLayout(store, data.Store.Layout, store.Effects.Expansion)
	local name = data.Store.Name ~= "" and data.Store.Name or (player.DisplayName .. "'s Mart")
	StoreBuilder.SetSign(store, name, Cosmetics.SignColors[data.Store.SignColor] or theme.Sign)
	StoreBuilder.ApplyDecor(store, data.Store.DecorOn)
	StoreService.RefreshAllUnits(store)
	store.Model:SetAttribute("OwnerUserId", player.UserId)
	store.Model:SetAttribute("StoreName", name)
	store.Model:SetAttribute("Rating", data.Rating.Value)
end

local function resetStore(store)
	store.Owner = nil
	store.Active = false
	store.Queue = {}
	store.Effects = Effects.Defaults()
	StoreBuilder.ApplyTheme(store, Cosmetics.ThemeById.Classic)
	StoreBuilder.ApplyLayout(store, "Classic", 1)
	StoreBuilder.SetSign(store, "FOR RENT", Cosmetics.ThemeById.Classic.Sign)
	StoreBuilder.ApplyDecor(store, {})
	StoreBuilder.SetNote(store, false)
	for i = 1, StoreBuilder.UnitCount do
		StoreBuilder.UpdateUnit(store, i, {}, store.Effects.SlotCapacity)
	end
	store.RegisterPrompt.Enabled = false
	store.Model:SetAttribute("OwnerUserId", 0)
	store.Model:SetAttribute("StoreName", "")
end

local function spawnAtStore(player)
	local store = byPlayer[player]
	local character = player.Character
	if not store or not character then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return
	end
	if not character.Parent then
		character.AncestryChanged:Wait()
	end
	task.wait()
	character:PivotTo(store.CFrame * CFrame.new(StoreBuilder.OwnerSpawn) * CFrame.Angles(0, math.pi, 0))
end

local function claimPlot(player, data)
	for i = 1, Config.PlotCount do
		local store = stores[i]
		if store and not store.Owner then
			store.Owner = player
			store.Active = true
			store.Queue = {}
			store.SpawnTimer = 0
			store.RestockTimer = 0
			byPlayer[player] = store
			player:SetAttribute("PlotIndex", i)
			store.RegisterPrompt.Enabled = true
			StoreService.ApplyAll(store)
			Log.Info("Store", player.Name, "owns plot", i)
			Bus.Fire("StoreOpened", store)
			Bus.Fire("Dirty", player)
			return store
		end
	end
	Net.Notify(player, "All shops on the street are taken. Explore the town and visit other stores!", "info")
	return nil
end

---------------------------------------------------------------------------
-- Note on the counter (mystery)
---------------------------------------------------------------------------
local function showNote(store)
	local p = StoreBuilder.SetNote(store, true)
	if p then
		p.Triggered:Connect(function(player)
			if player == store.Owner then
				Bus.Fire("MysteryObject", player, "messageNote")
			else
				Net.Notify(player, "That note is for the shopkeeper.", "info")
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Requests
---------------------------------------------------------------------------
local function nearUnit(player, store, unitIndex)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local unit = store.Units[unitIndex]
	return root and unit and (root.Position - unit.CFrame.Position).Magnitude <= Config.StockInteractDistance
end

local function validUnit(store, payload)
	local unitIndex = Net.Int(payload.Unit, 1, StoreBuilder.UnitCount)
	if not unitIndex or not store.Units[unitIndex].Open then
		return nil
	end
	return unitIndex
end

local function registerRequests()
	Net.Handle("StockSlot", { Rate = 6, Burst = 10 }, function(player, payload)
		local store = byPlayer[player]
		local data = DataService.Get(player)
		if not store or not data then
			return Net.Fail("You don't have a store yet.")
		end
		local unitIndex = validUnit(store, payload)
		local slot = Net.Int(payload.Slot, 1, Config.SlotsPerUnit)
		local productId = Net.Key(payload.Product, Products.ById)
		if not unitIndex or not slot or not productId then
			return Net.Fail("Invalid shelf.")
		end
		if not nearUnit(player, store, unitIndex) then
			return Net.Fail("Walk closer to the shelf.")
		end
		local product = Products.ById[productId]
		if product.Cold ~= StoreBuilder.IsCooler(unitIndex) then
			return Net.Fail(product.Cold and "Drinks go in a cooler." or "That goes on a shelf, not in the cooler.")
		end
		local have = data.Inventory[productId] or 0
		if have <= 0 then
			return Net.Fail("None in your backroom. Order more!")
		end
		local key = slotKey(unitIndex, slot)
		local entry = data.Shelves[key]
		if entry and entry.P ~= productId then
			-- swap: old product goes back to the backroom
			data.Inventory[entry.P] = (data.Inventory[entry.P] or 0) + entry.Q
			entry = nil
		end
		local current = entry and entry.Q or 0
		local add = math.min(store.Effects.SlotCapacity - current, have)
		if add <= 0 then
			return Net.Fail("That slot is already full.")
		end
		data.Shelves[key] = { P = productId, Q = current + add }
		data.Inventory[productId] = have - add
		if data.Inventory[productId] <= 0 then
			data.Inventory[productId] = nil
		end
		data.Stats.Stocked = data.Stats.Stocked + add
		StoreService.RefreshUnit(store, unitIndex)
		Bus.Fire("Stocked", player, add)
		Bus.Fire("Dirty", player)
		return Net.Ok(("Stocked %d %s."):format(add, product.Name))
	end)

	Net.Handle("ClearSlot", { Rate = 6, Burst = 10 }, function(player, payload)
		local store = byPlayer[player]
		local data = DataService.Get(player)
		if not store or not data then
			return Net.Fail("No store.")
		end
		local unitIndex = validUnit(store, payload)
		local slot = Net.Int(payload.Slot, 1, Config.SlotsPerUnit)
		if not unitIndex or not slot then
			return Net.Fail("Invalid shelf.")
		end
		if not nearUnit(player, store, unitIndex) then
			return Net.Fail("Walk closer to the shelf.")
		end
		local key = slotKey(unitIndex, slot)
		local entry = data.Shelves[key]
		if not entry then
			return Net.Fail("Already empty.")
		end
		data.Inventory[entry.P] = (data.Inventory[entry.P] or 0) + entry.Q
		data.Shelves[key] = nil
		StoreService.RefreshUnit(store, unitIndex)
		Bus.Fire("Dirty", player)
		return Net.Ok("Moved back to the backroom.")
	end)

	Net.Handle("RestockUnit", { Rate = 3, Burst = 5 }, function(player, payload)
		local store = byPlayer[player]
		local data = DataService.Get(player)
		if not store or not data then
			return Net.Fail("No store.")
		end
		local unitIndex = validUnit(store, payload)
		if not unitIndex then
			return Net.Fail("Invalid shelf.")
		end
		if not nearUnit(player, store, unitIndex) then
			return Net.Fail("Walk closer to the shelf.")
		end
		local total = 0
		for slot = 1, Config.SlotsPerUnit do
			local entry = data.Shelves[slotKey(unitIndex, slot)]
			if entry then
				local have = data.Inventory[entry.P] or 0
				local add = math.min(store.Effects.SlotCapacity - entry.Q, have)
				if add > 0 then
					entry.Q = entry.Q + add
					data.Inventory[entry.P] = have - add
					if data.Inventory[entry.P] <= 0 then
						data.Inventory[entry.P] = nil
					end
					total = total + add
				end
			end
		end
		if total == 0 then
			return Net.Fail("Nothing to refill. Pick products for empty slots or order more stock.")
		end
		data.Stats.Stocked = data.Stats.Stocked + total
		StoreService.RefreshUnit(store, unitIndex)
		Bus.Fire("Stocked", player, total)
		Bus.Fire("Dirty", player)
		return Net.Ok(("Refilled %d items."):format(total))
	end)

	-- Customization -------------------------------------------------------
	local function equip(kind, map, field, after)
		Net.Handle("Set" .. kind, { Rate = 2, Burst = 4 }, function(player, payload)
			local data = DataService.Get(player)
			local store = byPlayer[player]
			if not data then
				return Net.Fail("Still loading.")
			end
			local id = Net.Key(payload.Id, map)
			if not id then
				return Net.Fail("Unknown item.")
			end
			local ok, reason = Unlocks.Check(map[id].Unlock, unlockCtx(player, data))
			if not ok then
				return Net.Fail("Locked: " .. reason)
			end
			data.Store[field] = id
			if after then
				after(player, store, id)
			end
			Bus.Fire("Dirty", player)
			return Net.Ok(map[id].Name .. " equipped.")
		end)
	end
	equip("Theme", Cosmetics.ThemeById, "Theme", function(_, store)
		if store then
			StoreService.ApplyAll(store)
		end
	end)
	equip("Layout", Cosmetics.LayoutById, "Layout", function(player, store, id)
		if store then
			StoreBuilder.ApplyLayout(store, id, store.Effects.Expansion)
			StoreService.RefreshAllUnits(store)
			Bus.Fire("LayoutChanged", store, player)
		end
	end)
	equip("Uniform", Cosmetics.UniformById, "Uniform", function(player)
		applyUniform(player)
	end)
	equip("Effect", Cosmetics.EffectById, "Effect", nil)

	Net.Handle("BuyDecor", { Rate = 2, Burst = 4 }, function(player, payload)
		local data = DataService.Get(player)
		local id = data and Net.Key(payload.Id, Cosmetics.DecorById)
		if not id then
			return Net.Fail("Unknown decoration.")
		end
		local decor = Cosmetics.DecorById[id]
		local ok, reason = Unlocks.Check(decor.Unlock, unlockCtx(player, data))
		if not ok then
			return Net.Fail("Locked: " .. reason)
		end
		if data.Owned.Decor[id] or decor.Price == 0 then
			return Net.Fail("You already own this.")
		end
		if not EconomyService.Spend(player, decor.Price) then
			return Net.Fail("You need " .. Util.Money(decor.Price) .. ".")
		end
		data.Owned.Decor[id] = true
		data.Store.DecorOn[id] = true
		local store = byPlayer[player]
		if store then
			StoreBuilder.ApplyDecor(store, data.Store.DecorOn)
		end
		Bus.Fire("Dirty", player)
		return Net.Ok(decor.Name .. " placed in your store!")
	end)

	Net.Handle("ToggleDecor", { Rate = 4, Burst = 6 }, function(player, payload)
		local data = DataService.Get(player)
		local id = data and Net.Key(payload.Id, Cosmetics.DecorById)
		if not id then
			return Net.Fail("Unknown decoration.")
		end
		local decor = Cosmetics.DecorById[id]
		local unlocked = Unlocks.Check(decor.Unlock, unlockCtx(player, data))
		local owned = data.Owned.Decor[id] or (decor.Price == 0 and unlocked)
		if not owned then
			return Net.Fail("You don't own this yet.")
		end
		data.Store.DecorOn[id] = (not data.Store.DecorOn[id]) or nil
		local store = byPlayer[player]
		if store then
			StoreBuilder.ApplyDecor(store, data.Store.DecorOn)
		end
		Bus.Fire("Dirty", player)
		return Net.Ok(data.Store.DecorOn[id] and (decor.Name .. " placed.") or (decor.Name .. " put away."))
	end)

	Net.Handle("SetSign", { Rate = 0.2, Burst = 2 }, function(player, payload)
		local data = DataService.Get(player)
		local name = Net.Str(payload.Name, 24)
		local color = Net.Int(payload.Color, 1, #Cosmetics.SignColors)
		if not data or not name or not color then
			return Net.Fail("Invalid sign.")
		end
		name = name:gsub("^%s+", ""):gsub("%s+$", "")
		if #name < 2 then
			return Net.Fail("Pick a name with at least 2 characters.")
		end
		local ok, filtered = pcall(function()
			local result = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
			return result:GetNonChatStringForBroadcastAsync()
		end)
		if not ok then
			Log.Warn("Store", "text filter failed", filtered)
			return Net.Fail("Couldn't check that name right now. Try again in a moment.")
		end
		data.Store.Name = filtered
		data.Store.SignColor = color
		local store = byPlayer[player]
		if store then
			StoreService.ApplyAll(store)
		end
		Bus.Fire("Dirty", player)
		return Net.Ok("Sign updated: " .. filtered)
	end)
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------
function StoreService.Init(worldRefs)
	storesFolder = Instance.new("Folder")
	storesFolder.Name = "Stores"
	storesFolder.Parent = workspace

	for i = 1, Config.PlotCount do
		local store = StoreBuilder.Build(i, worldRefs.Plots[i], storesFolder)
		store.Queue = {}
		store.Effects = Effects.Defaults()
		stores[i] = store
		resetStore(store)

		for _, unit in ipairs(store.Units) do
			unit.Prompt.Triggered:Connect(function(player)
				if player == store.Owner then
					Net.Events.OpenStock:FireClient(player, unit.Index, StoreBuilder.IsCooler(unit.Index))
				else
					Net.Notify(player, "Only the shopkeeper can stock these shelves.", "info")
				end
			end)
		end
		store.RegisterPrompt.Triggered:Connect(function(player)
			if player ~= store.Owner then
				return
			end
			if not checkout(store, player) then
				Net.Notify(player, "Nobody is waiting at the register yet.", "info")
			end
		end)
		store.GuestbookPrompt.Triggered:Connect(function(player)
			if not store.Owner then
				return
			end
			if player == store.Owner then
				Net.Notify(player, "Visitors can rate your store here. Invite friends!", "info")
				return
			end
			Net.Events.OpenRate:FireClient(player, store.Owner.UserId, store.Model:GetAttribute("StoreName"))
		end)
	end

	Bus.On("ProfileLoaded", function(player, data)
		claimPlot(player, data)
		player.CharacterAdded:Connect(function()
			spawnAtStore(player)
			task.wait(0.5)
			applyUniform(player)
		end)
		if player.Character then
			spawnAtStore(player)
			applyUniform(player)
		end
	end)

	-- Runs before the leaving player's final save
	DataService.BeforeRelease(function(player)
		local store = byPlayer[player]
		if store then
			if StoreService.OnClosing then
				StoreService.OnClosing(store)
			end
			byPlayer[player] = nil
			resetStore(store)
			Bus.Fire("StoreClosed", store)
		end
	end)

	Bus.On("UpgradesChanged", function(player)
		local store = byPlayer[player]
		local data = DataService.Get(player)
		if not store or not data then
			return
		end
		local before = store.Effects.Expansion
		store.Effects = Effects.Compute(data.Upgrades)
		if store.Effects.Expansion ~= before then
			StoreBuilder.ApplyLayout(store, data.Store.Layout, store.Effects.Expansion)
			Bus.Fire("LayoutChanged", store, player)
		end
		StoreService.RefreshAllUnits(store)
	end)

	Bus.On("RatingChanged", function(player)
		local store = byPlayer[player]
		local data = DataService.Get(player)
		if store and data then
			store.Model:SetAttribute("Rating", data.Rating.Value)
		end
	end)

	-- Notes on counters: the Mysterious Message event, or the founder story
	Bus.On("NightStarted", function()
		for _, store in pairs(stores) do
			local data = store.Owner and DataService.Get(store.Owner)
			if data then
				data.Stats.Nights = data.Stats.Nights + 1
				local founderNote = data.Clues.f1 and not data.Clues.f2
				if CycleService.EventId() == "Message" or founderNote then
					showNote(store)
				end
				Bus.Fire("Dirty", store.Owner)
			end
		end
	end)
	Bus.On("DayStarted", function()
		for _, store in pairs(stores) do
			StoreBuilder.SetNote(store, false)
		end
	end)

	registerRequests()

	-- Store tick: auto-checkout and the stock clerk
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			for _, store in pairs(stores) do
				local data = store.Owner and DataService.Get(store.Owner)
				if data then
					local fx = store.Effects
					local front = store.Queue[1]
					if fx.CheckoutDelay and front and front.AtCounter and front.State == "Queued" and now - front.ArrivedAt >= fx.CheckoutDelay then
						checkout(store, nil)
					end
					if fx.RestockInterval then
						store.RestockTimer = (store.RestockTimer or 0) + 0.5
						if store.RestockTimer >= fx.RestockInterval then
							store.RestockTimer = 0
							for unitIndex = 1, StoreBuilder.UnitCount do
								local done = false
								if store.Units[unitIndex].Open then
									for slot = 1, Config.SlotsPerUnit do
										local entry = data.Shelves[slotKey(unitIndex, slot)]
										local have = entry and data.Inventory[entry.P] or 0
										if entry and entry.Q < fx.SlotCapacity and have > 0 then
											local add = math.min(fx.SlotCapacity - entry.Q, have)
											entry.Q = entry.Q + add
											data.Inventory[entry.P] = have - add
											if data.Inventory[entry.P] <= 0 then
												data.Inventory[entry.P] = nil
											end
											StoreService.RefreshUnit(store, unitIndex)
											Bus.Fire("Dirty", store.Owner)
											done = true
											break
										end
									end
								end
								if done then
									break
								end
							end
						end
					end
				end
			end
		end
	end)
end

StoreService.ApplyUniform = applyUniform
return StoreService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds the town from code: main street with 6 store plots, back alleys,
-- Willow Lane homes, a tailor and a park, the gas station, an empty lot,
-- the town square with its clock tower, the boarded-up First Light Mart, and
-- a waterfront with a pier and lighthouse. Returns the markers other
-- services need (plot frames, mystery objects, zones, lamps, waypoints).
--
-- Layout (studs): main street runs along X at z = 0. Plots 1-3 sit north
-- (z = +70, facing the street), plots 4-6 south (z = -70, rotated 180).
local CollectionService = game:GetService("CollectionService")

local WorldBuilder = {}

local C = Color3.fromRGB
local M = Enum.Material

local world -- Folder in workspace

local function part(props)
	local p = Instance.new(props.ClassName or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = M.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Parent" and k ~= "ClassName" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or world
	return p
end
WorldBuilder.Part = part

local function box(parent, name, size, position, color, material, extra)
	local props = { Parent = parent, Name = name, Size = size, Color = color, Material = material or M.SmoothPlastic }
	if typeof(position) == "CFrame" then
		props.CFrame = position
	else
		props.Position = position
	end
	for k, v in pairs(extra or {}) do
		props[k] = v
	end
	return part(props)
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent or world
	return f
end

-- Flat ground decoration (non-colliding so NPC pathing stays simple)
local function flat(parent, name, center, sizeX, sizeZ, color, material, yOffset)
	return box(parent, name, Vector3.new(sizeX, 0.2, sizeZ), center + Vector3.new(0, 0.1 + (yOffset or 0), 0), color, material, { CanCollide = false })
end

local function label(parentPart, face, text, color, bg, pixels)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixels or 30
	gui.LightInfluence = 0
	gui.Parent = parentPart
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = bg and 0 or 1
	t.BackgroundColor3 = bg or C(0, 0, 0)
	t.TextColor3 = color
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
	return t
end
WorldBuilder.Label = label

local function neonSign(parent, text, cframe, size, color, flicker)
	local backing = box(parent, "NeonSign", size, cframe, C(20, 20, 25), M.SmoothPlastic)
	local glow = label(backing, Enum.NormalId.Front, text, color, nil, 40)
	glow.TextStrokeColor3 = color
	glow.TextStrokeTransparency = 0.4
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Front
	light.Color = color
	light.Range = 14
	light.Brightness = 2
	light.Parent = backing
	if flicker then
		CollectionService:AddTag(backing, "Flicker")
	end
	return backing
end
WorldBuilder.NeonSign = neonSign

local lamps = {}
local function streetLamp(parent, position, armDirection)
	box(parent, "Pole", Vector3.new(0.8, 18, 0.8), position + Vector3.new(0, 9, 0), C(45, 45, 50), M.Metal)
	box(parent, "Arm", Vector3.new(0.5, 0.5, 4), CFrame.lookAt(position + Vector3.new(0, 17.8, 0) + armDirection * 2, position + Vector3.new(0, 17.8, 0) + armDirection * 4), C(45, 45, 50), M.Metal)
	local head = box(parent, "LampHead", Vector3.new(1.6, 0.6, 1.6), position + Vector3.new(0, 17.4, 0) + armDirection * 4, C(255, 225, 170), M.Neon, { CanCollide = false })
	local light = Instance.new("PointLight")
	light.Range = 34
	light.Brightness = 1.6
	light.Color = C(255, 215, 160)
	light.Shadows = false
	light.Parent = head
	table.insert(lamps, { Head = head, Light = light })
end

local function tree(parent, position, scale)
	scale = scale or 1
	box(parent, "Trunk", Vector3.new(1.6, 9, 1.6) * scale, position + Vector3.new(0, 4.5 * scale, 0), C(90, 65, 45), M.Wood)
	local leaves = box(parent, "Leaves", Vector3.new(9, 9, 9) * scale, position + Vector3.new(0, 11 * scale, 0), C(45, 95, 60), M.LeafyGrass)
	leaves.Shape = Enum.PartType.Ball
end

local function parkedCar(parent, cframe, color)
	local body = box(parent, "Car", Vector3.new(6, 2, 12), cframe * CFrame.new(0, 1.4, 0), color, M.SmoothPlastic)
	box(parent, "CarTop", Vector3.new(5.4, 1.8, 6), cframe * CFrame.new(0, 3.3, 0.6), C(150, 180, 200), M.Glass, { Transparency = 0.3 })
	for _, x in ipairs({ -3, 3 }) do
		for _, z in ipairs({ -4, 4 }) do
			local w = box(parent, "Wheel", Vector3.new(1, 2.4, 2.4), cframe * CFrame.new(x, 1.2, z), C(25, 25, 25), M.Rubber)
			w.Shape = Enum.PartType.Cylinder
		end
	end
	return body
end

local function house(parent, position, facing, color, roofColor)
	local cf = CFrame.lookAt(position, position + facing)
	box(parent, "House", Vector3.new(26, 14, 20), cf * CFrame.new(0, 7, 0), color, M.Brick)
	local roof = box(parent, "Roof", Vector3.new(28, 2, 22), cf * CFrame.new(0, 15, 0), roofColor, M.Slate)
	roof.Name = "Roof"
	box(parent, "Door", Vector3.new(4, 8, 0.4), cf * CFrame.new(0, 4, -10.1), C(90, 60, 40), M.Wood)
	for _, x in ipairs({ -8, 8 }) do
		local window = box(parent, "Window", Vector3.new(5, 4, 0.3), cf * CFrame.new(x, 8, -10.1), C(255, 210, 140), M.Neon)
		window.Transparency = 0.25
	end
	return cf
end

local function mysteryObject(parent, id, size, position, color, material, actionText)
	local p = box(parent, id, size, position, color, material)
	p.CanCollide = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText or "Inspect"
	prompt.ObjectText = ""
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = p
	return { Part = p, Prompt = prompt }
end

function WorldBuilder.Build()
	for _, name in ipairs({ "Baseplate", "SpawnLocation" }) do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local existing = workspace:FindFirstChild("Town")
	if existing then
		existing:Destroy()
	end
	world = folder("Town", workspace)
	lamps = {}

	local refs = { Plots = {}, MysteryObjects = {}, Zones = {}, Lamps = lamps, WetParts = {}, Waypoints = {} }

	-- Ground
	local ground = box(world, "Ground", Vector3.new(900, 4, 640), Vector3.new(0, -2, 20), C(55, 70, 55), M.Grass)
	ground.CanCollide = true

	local roads = folder("Roads")
	local function road(center, sx, sz)
		local r = flat(roads, "Road", center, sx, sz, C(38, 38, 44), M.Asphalt)
		table.insert(refs.WetParts, r)
		return r
	end
	local function sidewalk(center, sx, sz)
		local s = flat(roads, "Sidewalk", center, sx, sz, C(120, 120, 125), M.Concrete, 0.02)
		table.insert(refs.WetParts, s)
		return s
	end

	-- Main street + sidewalks + lane markings
	road(Vector3.new(0, 0, 0), 820, 30)
	sidewalk(Vector3.new(0, 0, 18), 820, 6)
	sidewalk(Vector3.new(0, 0, -18), 820, 6)
	for x = -380, 380, 40 do
		flat(roads, "Lane", Vector3.new(x, 0, 0), 14, 0.8, C(230, 220, 160), M.SmoothPlastic, 0.03)
	end
	-- Back alleys
	road(Vector3.new(0, 0, 105), 700, 14)
	road(Vector3.new(0, 0, -105), 700, 14)
	-- Side alleys between plots
	for _, x in ipairs({ -85, 85 }) do
		road(Vector3.new(x, 0, 63), 14, 84)
		road(Vector3.new(x, 0, -63), 14, 84)
	end
	-- Connector streets to Willow Lane (north) and the waterfront (south)
	road(Vector3.new(-255, 0, 95), 20, 150)
	road(Vector3.new(260, 0, 95), 20, 150)
	road(Vector3.new(-255, 0, -85), 20, 130)
	road(Vector3.new(260, 0, -85), 20, 130)
	-- Willow Lane
	road(Vector3.new(-20, 0, 178), 600, 20)
	sidewalk(Vector3.new(-20, 0, 192), 600, 6)
	sidewalk(Vector3.new(-20, 0, 164), 600, 6)
	-- Waterfront boardwalk
	local boardwalk = box(world, "Boardwalk", Vector3.new(760, 1, 26), Vector3.new(0, 0, -158), C(120, 90, 60), M.WoodPlanks)
	table.insert(refs.WetParts, boardwalk)

	-- Street lamps
	local lampFolder = folder("Lamps")
	for x = -360, 360, 60 do
		streetLamp(lampFolder, Vector3.new(x, 0, 19.5), Vector3.new(0, 0, -1))
		streetLamp(lampFolder, Vector3.new(x + 30, 0, -19.5), Vector3.new(0, 0, 1))
	end
	for x = -300, 260, 70 do
		streetLamp(lampFolder, Vector3.new(x, 0, 165), Vector3.new(0, 0, 1))
	end
	for x = -330, 330, 80 do
		streetLamp(lampFolder, Vector3.new(x, 0, -147), Vector3.new(0, 0, -1))
	end

	-- Store plots (StoreBuilder builds the stores themselves)
	local plotXs = { -170, 0, 170 }
	for i, x in ipairs(plotXs) do
		refs.Plots[i] = CFrame.new(x, 0, 70)
		refs.Plots[i + 3] = CFrame.new(x, 0, -70) * CFrame.Angles(0, math.pi, 0)
	end

	-- Puddles that shine under lamps
	local puddles = folder("Puddles")
	local rng = Random.new(7)
	for _ = 1, 40 do
		local x = rng:NextInteger(-380, 380)
		local z = rng:NextInteger(-12, 12)
		local p = flat(puddles, "Puddle", Vector3.new(x, 0, z), rng:NextInteger(4, 9), rng:NextInteger(3, 6), C(20, 25, 35), M.Glass, 0.05)
		p.Reflectance = 0.35
		p.Transparency = 0.2
	end

	-- Parked cars along the street
	local cars = folder("ParkedCars")
	local carColors = { C(180, 40, 40), C(40, 80, 160), C(230, 230, 230), C(40, 40, 45), C(60, 140, 90), C(200, 160, 50) }
	for i, x in ipairs({ -330, -250, -90, 90, 250, 330 }) do
		parkedCar(cars, CFrame.new(x, 0, 11) * CFrame.Angles(0, math.rad(90), 0), carColors[i])
	end

	---------------------------------------------------------------------
	-- Alleys: dumpsters, crates, steam and a laundromat sign
	---------------------------------------------------------------------
	local alleys = folder("Alleys")
	-- Tall brick walls make the side alleys feel tucked away
	for _, x in ipairs({ -85, 85 }) do
		for _, side in ipairs({ 1, -1 }) do
			for _, dx in ipairs({ -8, 8 }) do
				box(alleys, "AlleyWall", Vector3.new(1, 18, 76), Vector3.new(x + dx, 9, side * 62), C(95, 70, 60), M.Brick)
			end
		end
	end
	for _, info in ipairs({ { 85, 60 }, { -85, 60 }, { 85, -60 }, { -85, -60 } }) do
		local x, z = info[1], info[2]
		box(alleys, "Dumpster", Vector3.new(4, 5, 8), Vector3.new(x + 4, 2.5, z + 12), C(40, 90, 60), M.Metal)
		box(alleys, "Crate", Vector3.new(3, 3, 3), Vector3.new(x - 4.5, 1.5, z - 8), C(140, 100, 60), M.WoodPlanks)
		box(alleys, "Crate", Vector3.new(2.5, 2.5, 2.5), Vector3.new(x - 4.5, 4.25, z - 8), C(150, 110, 70), M.WoodPlanks)
		local vent = box(alleys, "SteamVent", Vector3.new(3, 0.3, 3), Vector3.new(x, 0.15, z), C(60, 60, 60), M.DiamondPlate)
		local steam = Instance.new("ParticleEmitter")
		steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
		steam.Rate = 6
		steam.Lifetime = NumberRange.new(2, 4)
		steam.Speed = NumberRange.new(2, 4)
		steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
		steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
		steam.Color = ColorSequence.new(C(200, 200, 210))
		steam.EmissionDirection = Enum.NormalId.Top
		steam.Parent = vent
	end
	neonSign(alleys, "LAUNDRY 24H", CFrame.new(-92.4, 12, 40) * CFrame.Angles(0, math.rad(-90), 0), Vector3.new(12, 3, 0.4), C(90, 220, 255), true)
	neonSign(alleys, "NOODLES", CFrame.new(77.6, 12, -40) * CFrame.Angles(0, math.rad(-90), 0), Vector3.new(10, 3, 0.4), C(255, 120, 80), true)

	---------------------------------------------------------------------
	-- Background buildings that frame the street
	---------------------------------------------------------------------
	local blocks = folder("Buildings")
	local function backdrop(x, z, w, d, h, color, sign, signColor, facing)
		local b = box(blocks, "Building", Vector3.new(w, h, d), Vector3.new(x, h / 2, z), color, M.Concrete)
		for row = 1, math.floor(h / 8) - 1 do
			local win = box(blocks, "Windows", Vector3.new(w - 4, 2, 0.2), Vector3.new(x, row * 8, z + facing * (d / 2 + 0.1)), C(255, 200, 120), M.Neon)
			win.Transparency = rng:NextNumber(0.3, 0.8)
		end
		if sign then
			neonSign(blocks, sign, CFrame.new(x, 10, z + facing * (d / 2 + 0.3)) * CFrame.Angles(0, facing > 0 and math.pi or 0, 0), Vector3.new(math.min(w - 4, 18), 3.2, 0.4), signColor, true)
		end
		return b
	end
	backdrop(-400, 70, 50, 40, 34, C(70, 70, 85), "HOTEL", C(255, 90, 140), -1)
	backdrop(-400, -70, 50, 40, 26, C(90, 75, 70), "KARAOKE", C(200, 120, 255), 1)
	backdrop(420, -70, 50, 40, 30, C(70, 80, 90), "ARCADE", C(80, 255, 200), 1)

	---------------------------------------------------------------------
	-- Gas station (northeast)
	---------------------------------------------------------------------
	local gas = folder("GasStation")
	local gp = Vector3.new(335, 0, 70)
	flat(gas, "Lot", gp, 80, 70, C(60, 60, 66), M.Concrete, 0.03)
	box(gas, "Canopy", Vector3.new(44, 2, 26), gp + Vector3.new(0, 15, -8), C(230, 230, 235), M.SmoothPlastic)
	local canopyLight = box(gas, "CanopyGlow", Vector3.new(40, 0.3, 22), gp + Vector3.new(0, 13.9, -8), C(255, 255, 240), M.Neon)
	local glow = Instance.new("SurfaceLight")
	glow.Face = Enum.NormalId.Bottom
	glow.Range = 20
	glow.Brightness = 2
	glow.Parent = canopyLight
	for _, x in ipairs({ -15, 15 }) do
		box(gas, "Pillar", Vector3.new(1.5, 14, 1.5), gp + Vector3.new(x, 7, -8), C(200, 40, 40), M.Metal)
		box(gas, "Pump", Vector3.new(3, 6, 2), gp + Vector3.new(x * 0.5, 3, -8), C(220, 50, 50), M.SmoothPlastic)
	end
	neonSign(gas, "FUEL", CFrame.new(gp + Vector3.new(0, 15, -21.2)), Vector3.new(14, 2, 0.4), C(255, 70, 70), false)
	box(gas, "GasShop", Vector3.new(30, 12, 18), gp + Vector3.new(0, 6, 22), C(200, 200, 205), M.Concrete)
	box(gas, "IceMachine", Vector3.new(5, 7, 3), gp + Vector3.new(20, 3.5, 22), C(180, 220, 255), M.SmoothPlastic)
	refs.MysteryObjects.buttonGas = mysteryObject(gas, "buttonGas", Vector3.new(0.8, 0.2, 0.8), gp + Vector3.new(23.5, 0.3, 22), C(190, 150, 70), M.Metal, "Reach behind")

	---------------------------------------------------------------------
	-- Empty lot (southeast) - founder's photo
	---------------------------------------------------------------------
	local lot = folder("EmptyLot")
	local lp = Vector3.new(335, 0, -75)
	flat(lot, "Dirt", lp, 70, 60, C(90, 75, 55), M.Ground, 0.03)
	for i = -3, 3 do
		box(lot, "Fence", Vector3.new(10, 6, 0.4), lp + Vector3.new(i * 10, 3, 30), C(110, 100, 90), M.WoodPlanks)
	end
	for _ = 1, 25 do
		local g = box(lot, "TallGrass", Vector3.new(1, rng:NextNumber(2, 4), 1), lp + Vector3.new(rng:NextInteger(-30, 30), 1.5, rng:NextInteger(-25, 25)), C(110, 140, 70), M.Grass, { CanCollide = false })
		g.Transparency = 0.1
	end
	refs.MysteryObjects.founderPhoto = mysteryObject(lot, "founderPhoto", Vector3.new(1.4, 0.2, 1), lp + Vector3.new(12, 0.3, -14), C(240, 230, 200), M.SmoothPlastic, "Pick up")

	---------------------------------------------------------------------
	-- Town square + clock tower (southwest)
	---------------------------------------------------------------------
	local square = folder("TownSquare")
	local sq = Vector3.new(-320, 0, -72)
	flat(square, "Plaza", sq, 70, 60, C(150, 140, 130), M.Cobblestone, 0.03)
	box(square, "ClockTower", Vector3.new(12, 50, 12), sq + Vector3.new(0, 25, -10), C(150, 120, 100), M.Brick)
	local face = box(square, "ClockFace", Vector3.new(9, 9, 0.4), CFrame.new(sq + Vector3.new(0, 42, -3.8)) * CFrame.Angles(0, math.pi, 0), C(240, 235, 220), M.SmoothPlastic)
	label(face, Enum.NormalId.Front, "11:11", C(40, 30, 20), nil, 40)
	local faceLight = Instance.new("SurfaceLight")
	faceLight.Face = Enum.NormalId.Front
	faceLight.Range = 12
	faceLight.Color = C(255, 230, 180)
	faceLight.Parent = face
	refs.ClockFace = face
	refs.MysteryObjects.clockPlaque = mysteryObject(square, "clockPlaque", Vector3.new(3, 2, 0.3), sq + Vector3.new(0, 3, -3.9), C(190, 150, 70), M.Metal, "Read plaque")
	refs.Zones.clockTower = { Position = sq, Radius = 28 }
	box(square, "Fountain", Vector3.new(14, 2, 14), sq + Vector3.new(0, 1, 16), C(170, 170, 175), M.Marble)
	box(square, "FountainWater", Vector3.new(12, 0.4, 12), sq + Vector3.new(0, 2, 16), C(80, 140, 200), M.Glass, { Transparency = 0.3 })
	-- Leaderboards
	local boards = {}
	for i, info in ipairs({ { "TOP EARNERS", -20 }, { "BEST RATED", 20 } }) do
		local b = box(square, "Leaderboard", Vector3.new(16, 20, 1), CFrame.new(sq + Vector3.new(info[2], 11, 22)) * CFrame.Angles(0, math.pi, 0), C(25, 25, 35), M.SmoothPlastic)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 25
		gui.LightInfluence = 0
		gui.Parent = b
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0.14, 0)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextColor3 = C(255, 200, 90)
		title.Text = info[1]
		title.Parent = gui
		local list = Instance.new("Frame")
		list.Name = "List"
		list.BackgroundTransparency = 1
		list.Position = UDim2.new(0.05, 0, 0.16, 0)
		list.Size = UDim2.new(0.9, 0, 0.82, 0)
		list.Parent = gui
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
		boards[i] = list
	end
	refs.Leaderboards = { Earned = boards[1], Rating = boards[2] }
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.Position = sq + Vector3.new(0, 0.5, 4)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Parent = square

	---------------------------------------------------------------------
	-- The First Light Mart: the boarded-up original store (northwest)
	---------------------------------------------------------------------
	local first = folder("FirstLightMart")
	local fp = CFrame.new(-325, 0, 70)
	local fw = C(120, 110, 100)
	box(first, "Back", Vector3.new(40, 14, 1), fp * CFrame.new(0, 7, 15), fw, M.Brick)
	box(first, "Left", Vector3.new(1, 14, 30), fp * CFrame.new(-20, 7, 0), fw, M.Brick)
	box(first, "Right", Vector3.new(1, 14, 30), fp * CFrame.new(20, 7, 0), fw, M.Brick)
	box(first, "FrontL", Vector3.new(16, 14, 1), fp * CFrame.new(-12, 7, -15), fw, M.Brick)
	box(first, "FrontR", Vector3.new(16, 14, 1), fp * CFrame.new(12, 7, -15), fw, M.Brick)
	box(first, "Lintel", Vector3.new(8, 4, 1), fp * CFrame.new(0, 12, -15), fw, M.Brick)
	box(first, "Roof", Vector3.new(42, 1, 32), fp * CFrame.new(0, 14.5, 0), C(60, 55, 50), M.Slate)
	flat(first, "Floor", fp.Position, 40, 30, C(90, 80, 70), M.WoodPlanks, 0.03)
	for i = -1, 1 do
		box(first, "Plank", Vector3.new(14, 1, 0.3), fp * CFrame.new(-12, 6 + i * 2.5, -15.7) * CFrame.Angles(0, 0, math.rad(8 * i)), C(130, 100, 70), M.WoodPlanks)
		box(first, "Plank", Vector3.new(14, 1, 0.3), fp * CFrame.new(12, 6 + i * 2.5, -15.7) * CFrame.Angles(0, 0, math.rad(-8 * i)), C(130, 100, 70), M.WoodPlanks)
	end
	local oldSign = box(first, "OldSign", Vector3.new(24, 3, 0.4), fp * CFrame.new(0, 16.5, -15), C(60, 50, 45), M.Wood)
	label(oldSign, Enum.NormalId.Front, "FIRST LIGHT MART", C(200, 170, 120), nil, 30)
	box(first, "DustyCounter", Vector3.new(10, 4, 3), fp * CFrame.new(8, 2, 6), C(100, 80, 60), M.Wood)
	box(first, "EmptyShelf", Vector3.new(12, 6, 2), fp * CFrame.new(-10, 3, 8), C(90, 75, 60), M.Wood)
	refs.MysteryObjects.oldReceipt = mysteryObject(first, "oldReceipt", Vector3.new(1, 0.1, 1.4), (fp * CFrame.new(8, 4.1, 6)).Position, C(240, 235, 210), M.SmoothPlastic, "Read")

	---------------------------------------------------------------------
	-- Willow Lane: homes, the tailor, a park, the old oak
	---------------------------------------------------------------------
	local lane = folder("WillowLane")
	local houseColors = { C(200, 170, 150), C(160, 180, 200), C(210, 200, 160), C(170, 150, 190), C(180, 200, 170) }
	local hi = 0
	for _, x in ipairs({ -230, -170, -40, 30, 220 }) do
		hi = hi + 1
		house(lane, Vector3.new(x, 0, 140), Vector3.new(0, 0, 1), houseColors[hi], C(80, 60, 60))
	end
	for _, x in ipairs({ -240, -160, -60, 20, 250 }) do
		hi = hi % #houseColors + 1
		house(lane, Vector3.new(x, 0, 218), Vector3.new(0, 0, -1), houseColors[hi], C(60, 60, 80))
	end
	-- Tailor shop
	local tp = Vector3.new(-115, 0, 140)
	local tcf = house(lane, tp, Vector3.new(0, 0, 1), C(150, 110, 160), C(70, 50, 80))
	neonSign(lane, "TAILOR", tcf * CFrame.new(0, 12.5, -10.4), Vector3.new(10, 2.4, 0.4), C(230, 160, 255), false)
	refs.MysteryObjects.buttonTailor = mysteryObject(lane, "buttonTailor", Vector3.new(0.7, 0.2, 0.7), (tcf * CFrame.new(8, 5.9, -10.6)).Position, C(190, 150, 70), M.Metal, "Take button")
	box(lane, "Ledge", Vector3.new(6, 0.4, 1), tcf * CFrame.new(8, 5.6, -10.6), C(220, 220, 220), M.SmoothPlastic)
	refs.Zones.tailorDoor = { Position = (tcf * CFrame.new(0, 0, -14)).Position, Radius = 8 }
	-- Park
	local park = Vector3.new(130, 0, 222)
	flat(lane, "ParkGrass", park, 70, 40, C(70, 120, 70), M.Grass, 0.03)
	for _, offset in ipairs({ Vector3.new(-25, 0, -10), Vector3.new(25, 0, 10), Vector3.new(-20, 0, 12), Vector3.new(28, 0, -12) }) do
		tree(lane, park + offset, 1.1)
	end
	box(lane, "BenchSeat", Vector3.new(8, 0.6, 2.4), park + Vector3.new(0, 2, -8), C(120, 80, 50), M.WoodPlanks)
	box(lane, "BenchBack", Vector3.new(8, 2.4, 0.5), park + Vector3.new(0, 3.2, -6.9), C(120, 80, 50), M.WoodPlanks)
	refs.MysteryObjects.buttonPark = mysteryObject(lane, "buttonPark", Vector3.new(0.7, 0.2, 0.7), park + Vector3.new(1.5, 0.3, -8), C(190, 150, 70), M.Metal, "Take button")
	-- Old oak + mailbox at the far west end of the lane
	local oak = Vector3.new(-318, 0, 178)
	tree(lane, oak, 1.8)
	box(lane, "MailboxPost", Vector3.new(0.5, 4, 0.5), oak + Vector3.new(4, 2, -3), C(80, 60, 40), M.Wood)
	refs.MysteryObjects.oakMailbox = mysteryObject(lane, "oakMailbox", Vector3.new(1.6, 1.2, 2.4), oak + Vector3.new(4, 4.6, -3), C(120, 60, 50), M.Metal, "Open mailbox")
	refs.Zones.willowEnd = { Position = Vector3.new(-305, 0, 178), Radius = 24 }
	local streetSign = box(lane, "StreetSign", Vector3.new(8, 1.6, 0.3), Vector3.new(-290, 9, 188), C(40, 110, 60), M.SmoothPlastic)
	label(streetSign, Enum.NormalId.Front, "WILLOW LANE", C(255, 255, 255), nil, 30)
	label(streetSign, Enum.NormalId.Back, "WILLOW LANE", C(255, 255, 255), nil, 30)

	---------------------------------------------------------------------
	-- Hidden alley clues
	---------------------------------------------------------------------
	refs.MysteryObjects.lostLetter = mysteryObject(alleys, "lostLetter", Vector3.new(1.2, 0.1, 0.8), Vector3.new(88, 0.3, 82), C(235, 230, 210), M.SmoothPlastic, "Pick up")
	refs.MysteryObjects.gearAlley = mysteryObject(alleys, "gearAlley", Vector3.new(1, 0.3, 1), Vector3.new(-82, 0.3, -88), C(200, 160, 60), M.Metal, "Pick up")

	---------------------------------------------------------------------
	-- Waterfront: water, pier and lighthouse
	---------------------------------------------------------------------
	local water = folder("Waterfront")
	pcall(function()
		workspace.Terrain:FillBlock(CFrame.new(0, -6, -300), Vector3.new(900, 10, 270), Enum.Material.Water)
	end)
	ground.Size = Vector3.new(900, 4, 480)
	ground.Position = Vector3.new(0, -2, 70)
	for i = 0, 9 do
		box(water, "PierPlank", Vector3.new(10, 1, 10), Vector3.new(100, 0, -175 - i * 10), C(130, 100, 70), M.WoodPlanks)
	end
	for i = 0, 9, 3 do
		box(water, "PierPost", Vector3.new(1, 8, 1), Vector3.new(95, -3, -175 - i * 10), C(90, 70, 50), M.Wood)
		box(water, "PierPost", Vector3.new(1, 8, 1), Vector3.new(105, -3, -175 - i * 10), C(90, 70, 50), M.Wood)
	end
	refs.Zones.pierEnd = { Position = Vector3.new(100, 0, -258), Radius = 18 }
	local rock = box(water, "Rock", Vector3.new(6, 30, 30), CFrame.new(100, -1, -285) * CFrame.Angles(0, 0, math.rad(90)), C(90, 90, 95), M.Rock)
	rock.Shape = Enum.PartType.Cylinder
	for i = 0, 7 do
		local stripe = box(water, "Lighthouse", Vector3.new(5, 10, 10), CFrame.new(100, 4.5 + i * 5, -288) * CFrame.Angles(0, 0, math.rad(90)), i % 2 == 0 and C(240, 240, 240) or C(200, 50, 50), M.SmoothPlastic)
		stripe.Shape = Enum.PartType.Cylinder
		stripe.Size = Vector3.new(5, 10 - i * 0.4, 10 - i * 0.4)
	end
	local lamp = box(water, "LighthouseLamp", Vector3.new(5, 5, 5), Vector3.new(100, 44.5, -288), C(255, 240, 180), M.Neon)
	local beam = Instance.new("SpotLight")
	beam.Range = 60
	beam.Angle = 30
	beam.Brightness = 6
	beam.Color = C(255, 240, 200)
	beam.Parent = lamp
	CollectionService:AddTag(lamp, "Spin")
	box(water, "Steps", Vector3.new(6, 1, 4), Vector3.new(100, 2.5, -275), C(150, 150, 155), M.Concrete)
	refs.MysteryObjects.musicBox = mysteryObject(water, "musicBox", Vector3.new(1.2, 0.9, 0.9), Vector3.new(100, 3.5, -275), C(150, 90, 60), M.Wood, "Open music box")

	---------------------------------------------------------------------
	-- Trees + ambient pedestrians' routes
	---------------------------------------------------------------------
	local trees = folder("Trees")
	for x = -350, 350, 70 do
		tree(trees, Vector3.new(x + 15, 0, 125), 1)
		tree(trees, Vector3.new(x - 15, 0, -125), 1)
	end
	refs.Waypoints = {
		{ Vector3.new(-380, 0, 18), Vector3.new(380, 0, 18), Vector3.new(380, 0, -18), Vector3.new(-380, 0, -18) },
		{ Vector3.new(-300, 0, 192), Vector3.new(260, 0, 192), Vector3.new(260, 0, 164), Vector3.new(-300, 0, 164) },
		{ Vector3.new(-350, 0, -158), Vector3.new(350, 0, -158) },
	}

	return refs
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerStorage" referent="RBX00000024"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX00000023"><Properties><string name="Name">ServerData</string></Properties><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Mysteries</string><ProtectedString name="Source"><![CDATA[-- The five town mysteries (server-only, so clients can't read ahead).
-- Clue types:
--   Serve   serve a customer type (optionally while they buy Product)
--   Object  interact with a hidden object in town (MysteryObjects)
--   Zone    stand in a town location (optionally at night / within hours)
--   Pattern serve a customer type on N different nights
-- Requires   clue ids that must be found first
-- NewDay     must be found on a later (UTC) day than the required clues,
--            so a mystery spans several sessions
-- UnlockProduct  unlocks a secret product to order
local Mysteries = {}

Mysteries.List = {
	{
		Id = "letters", Name = "Letters to Nowhere", Reward = 2000,
		RewardText = "Unlocked the Old Post Office theme.",
		Clues = {
			{ Id = "l1", Type = "Serve", Customer = "courier", Hint = "Someone delivers letters on rainy nights...",
				Text = "The Midnight Courier is looking for \"Willow Lane, number zero\". But Willow Lane starts at number one." },
			{ Id = "l2", Type = "Object", Object = "lostLetter", Requires = { "l1" }, Hint = "Maybe the courier dropped something in an alley behind the stores. Look at night.",
				Text = "A damp envelope in the alley: \"To whoever keeps the last light on. Under the oak at the end of the lane.\"" },
			{ Id = "l3", Type = "Zone", Zone = "willowEnd", Night = true, Requires = { "l2" }, Hint = "Visit the far end of Willow Lane at night.",
				Text = "At the end of Willow Lane stands an old oak with a rusty mailbox nailed to it. Its flag is up." },
			{ Id = "l4", Type = "Object", Object = "oakMailbox", Requires = { "l3" }, NewDay = true, UnlockProduct = "stamp",
				Hint = "The mailbox is jammed tonight. Try again tomorrow.",
				Text = "Inside the mailbox: a sheet of vintage stamps and a note: \"Sell these to the courier so the letters can finally go home.\" (Vintage Stamp unlocked!)" },
			{ Id = "l5", Type = "Serve", Customer = "courier", Product = "stamp", Requires = { "l4" }, Hint = "Stock Vintage Stamps and sell one to the Midnight Courier.",
				Text = "The courier smiles: the letters were the founder's thank-you notes to the town, delayed for fifty years. Now they're delivered." },
		},
	},
	{
		Id = "lighthouse", Name = "The Lighthouse Hum", Reward = 2500,
		RewardText = "Unlocked the Fish Tank decoration.",
		Clues = {
			{ Id = "h1", Type = "Serve", Customer = "fisherman", Hint = "An old fisherman shops here at night.",
				Text = "The Old Fisherman keeps humming a tune he hears near the pier at night." },
			{ Id = "h2", Type = "Zone", Zone = "pierEnd", Night = true, Requires = { "h1" }, Hint = "Walk to the end of the pier at night and listen.",
				Text = "At the end of the pier you hear it too: a soft music-box melody drifting from the lighthouse." },
			{ Id = "h3", Type = "Object", Object = "musicBox", Requires = { "h2" }, UnlockProduct = "lemonade", Hint = "Something on the lighthouse steps glows at night.",
				Text = "A tiny music box on the lighthouse steps, with a lemonade recipe tucked inside. (Lighthouse Lemonade unlocked!)" },
			{ Id = "h4", Type = "Pattern", Customer = "fisherman", Nights = 3, Requires = { "h3" }, Hint = "Serve the Old Fisherman on 3 different nights.",
				Text = "Night after night, the fisherman hums a little more of the song. It's a lullaby the lighthouse keeper played for passing ships." },
			{ Id = "h5", Type = "Serve", Customer = "fisherman", Product = "lemonade", Requires = { "h4" }, Hint = "Sell Lighthouse Lemonade to the Old Fisherman.",
				Text = "One sip and he remembers: he WAS the lighthouse keeper's apprentice. He promises to wind the music box every night." },
		},
	},
	{
		Id = "buttons", Name = "The Cat Who Pays in Buttons", Reward = 1500,
		RewardText = "Unlocked the Tailor's Vest uniform.",
		Clues = {
			{ Id = "b1", Type = "Serve", Customer = "buttons", Hint = "A very small, very fluffy customer visits at night.",
				Text = "Mr. Buttons paid with a shiny brass button, then trotted toward the tailor's shop. Where does a cat get buttons?" },
			{ Id = "b2", Type = "Object", Object = "buttonPark", Requires = { "b1" }, Hint = "Cats love park benches.",
				Text = "A brass button under the park bench, engraved with a tiny needle and thread." },
			{ Id = "b3", Type = "Object", Object = "buttonTailor", Requires = { "b1" }, Hint = "Check the tailor's window ledge.",
				Text = "Another button on the tailor's window ledge. Same engraving." },
			{ Id = "b4", Type = "Object", Object = "buttonGas", Requires = { "b1" }, NewDay = true, Hint = "One more button... somewhere near the gas station's ice machine. (Look on a new day.)",
				Text = "The third button, hidden behind the ice machine. It's warm, as if someone was just holding it." },
			{ Id = "b5", Type = "Zone", Zone = "tailorDoor", Requires = { "b2", "b3", "b4" }, UnlockProduct = "buttoncookie", Hint = "Bring the three buttons to the tailor's door.",
				Text = "The retired tailor laughs: Mr. Buttons has been 'paying' for treats with her button jar for years. She gives you her cookie recipe. (Button Cookies unlocked!)" },
		},
	},
	{
		Id = "clock", Name = "The Stopped Clock", Reward = 3000,
		RewardText = "Unlocked the Clockwork theme.",
		Clues = {
			{ Id = "c1", Type = "Object", Object = "clockPlaque", Hint = "Read the plaque on the town clock tower.",
				Text = "The plaque reads: \"This clock will run as long as the town's last store stays open.\" The hands are stuck at 11:11." },
			{ Id = "c2", Type = "Serve", Customer = "clockmaker", Requires = { "c1" }, Hint = "Someone shops only around 11 PM.",
				Text = "The Clockmaker says one gear went missing from the tower years ago. \"Gears roll downhill... into alleys.\"" },
			{ Id = "c3", Type = "Object", Object = "gearAlley", Requires = { "c2" }, UnlockProduct = "toffee", Hint = "Search the west alley at night.",
				Text = "A small brass gear glinting in the west alley, wrapped in an old toffee wrapper with a recipe. (Clockwork Toffee unlocked!)" },
			{ Id = "c4", Type = "Serve", Customer = "clockmaker", Product = "toffee", Requires = { "c3" }, NewDay = true, Hint = "On another day, sell Clockwork Toffee to the Clockmaker.",
				Text = "The Clockmaker accepts the toffee and the gear. \"Meet me at the tower at eleven.\"" },
			{ Id = "c5", Type = "Zone", Zone = "clockTower", Night = true, HourMin = 22.5, HourMax = 24, Requires = { "c4" }, Hint = "Be at the clock tower between 10:30 PM and midnight.",
				Text = "With a click the hands start moving again. 11:12. The whole town seems to breathe out." },
		},
	},
	{
		Id = "founder", Name = "The Store That Was Here Before", Reward = 10000, RequiresSolved = 1,
		RewardText = "Unlocked the Founder's Portrait and the title \"Keeper of the Last Light\".",
		Clues = {
			{ Id = "f1", Type = "Object", Object = "oldReceipt", RequiresSolved = 1, Hint = "Solve any other mystery first, then look inside the boarded-up First Light Mart.",
				Text = "A faded receipt from the First Light Mart, dated opening night. On the back: \"Keep one light on, always.\"" },
			{ Id = "f2", Type = "Object", Object = "messageNote", Requires = { "f1" }, Hint = "A note will appear on your counter one night. Read it.",
				Text = "The note on your counter: \"Thank you for keeping the light on. My grandchild is coming to find you.\"" },
			{ Id = "f3", Type = "Serve", Customer = "grandkid", Requires = { "f2" }, Hint = "Someone special will visit your store at night.",
				Text = "The Founder's Grandkid says there was a photo from opening night, lost somewhere in the empty lot by the gas station." },
			{ Id = "f4", Type = "Object", Object = "founderPhoto", Requires = { "f3" }, NewDay = true, UnlockProduct = "foundersoda", Hint = "Search the empty lot at night (on another day).",
				Text = "The photo: the founder behind a tiny counter, holding a bottle of their homemade soda. The recipe is on the back. (Founder's Soda unlocked!)" },
			{ Id = "f5", Type = "Serve", Customer = "grandkid", Product = "foundersoda", Requires = { "f4" }, Hint = "Sell Founder's Soda to the Founder's Grandkid.",
				Text = "They taste it and laugh through happy tears: \"It's exactly like the stories. The last open store is in good hands.\"" },
		},
	},
}

-- Hidden objects placed by WorldBuilder. Night = only visible after dark.
-- Flavor = what you see before you know what you're looking for.
Mysteries.Objects = {
	lostLetter = { Night = true, Flavor = "A soggy envelope. The address is smudged." },
	oakMailbox = { Night = false, Flavor = "An old mailbox nailed to the oak. It's rusted shut." },
	musicBox = { Night = true, Flavor = "A tiny wooden box. It's quiet... for now." },
	buttonPark = { Night = false, Flavor = "Something shiny under the bench. Just a button." },
	buttonTailor = { Night = false, Flavor = "A button on the window ledge." },
	buttonGas = { Night = false, Flavor = "There's something behind the ice machine, but you can't reach it." },
	clockPlaque = { Night = false, Flavor = "" },
	gearAlley = { Night = true, Flavor = "A bit of brass in the gutter." },
	oldReceipt = { Night = false, Flavor = "Dusty shelves, a dark counter. The First Light Mart closed long ago." },
	founderPhoto = { Night = true, Flavor = "Tall grass and an old fence. Nothing else." },
	messageNote = { Night = false, Flavor = "A blank folded note." },
}

Mysteries.ById = {}
Mysteries.ClueById = {}
for _, m in ipairs(Mysteries.List) do
	Mysteries.ById[m.Id] = m
	for _, clue in ipairs(m.Clues) do
		clue.Mystery = m.Id
		Mysteries.ClueById[clue.Id] = clue
	end
end

return Mysteries
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX0000002F"><Properties><string name="Name">StarterGui</string></Properties><Item class="ScreenGui" referent="RBX0000002E"><Properties><string name="Name">MainUI</string><bool name="ResetOnSpawn">false</bool><bool name="IgnoreGuiInset">false</bool></Properties><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Customize</string><ProtectedString name="Source"><![CDATA[-- Store customization: themes, shelf layouts, uniforms, decor, checkout
-- effects and the store sign. Robux buttons only appear for items that have
-- a Developer Product ID configured (and every item is earnable anyway).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local Unlocks = require(Shared:WaitForChild("Unlocks"))
local Util = require(Shared:WaitForChild("Util"))

local Customize = {}

local robuxIds = {}
for _, product in ipairs(Config.RobuxProducts) do
	if product.ProductId ~= 0 then
		robuxIds[product.Key] = product.ProductId
	end
end

function Customize.Build(Kit, State)
	local C = Kit.Colors
	local new = Kit.new
	local player = Players.LocalPlayer
	local panel = Kit.Panel("Customize", "CUSTOMIZE YOUR STORE", 740, 540)
	local list = Kit.Scroll(panel.Body, UDim2.new(1, 0, 1, -48), UDim2.new(0, 0, 0, 48))
	local tab = "Themes"
	local signColor = nil

	-- card(title, swatches, statusText, buttons = { {Text, Style, OnClick} })
	local function card(order, title, titleColor, swatches, status, buttons)
		local c = Kit.Card(list, order)
		local x = 0
		for i, color in ipairs(swatches or {}) do
			new("Frame", { Parent = c, Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0, (i - 1) * 26, 0, 2), BackgroundColor3 = color }, { Kit.Corner(6), Kit.Stroke(Color3.new(1, 1, 1), 0.7) })
			x = i * 26 + 8
		end
		Kit.Text({ Parent = c, Text = title, Font = Kit.Fonts.Bold, TextSize = 17, TextColor3 = titleColor or C.Text, Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 300, 0, 22), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		Kit.Text({ Parent = c, Text = status, TextSize = 13, TextColor3 = C.Muted, Position = UDim2.new(0, x, 0, 24), Size = UDim2.new(1, -x - 300, 0, 0), AutoY = true })
		for i, b in ipairs(buttons) do
			Kit.Button({ Parent = c, Text = b[1], Size = UDim2.new(0, 140, 0, 38), Position = UDim2.new(1, -146 * i, 0, 0), TextSize = 14 }, b[3], b[2])
		end
		new("Frame", { Parent = c, Size = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1 })
	end

	local function robuxButton(rules, buttons)
		local key = Unlocks.RobuxKey(rules)
		local id = key and robuxIds[key]
		if id then
			table.insert(buttons, { "Robux", Color3.fromRGB(40, 160, 90), function()
				MarketplaceService:PromptProductPurchase(player, id)
			end })
		end
	end

	-- Standard equip-able list (themes, layouts, uniforms, effects)
	local function equipList(items, current, action, swatchFn)
		for i, item in ipairs(items) do
			local unlocked, reason = State.IsUnlocked(item.Unlock)
			local buttons = {}
			local status
			if current == item.Id then
				status = "Equipped"
				table.insert(buttons, { "Equipped ✓", "good", nil })
			elseif unlocked then
				status = "Unlocked"
				table.insert(buttons, { "Equip", nil, function()
					State.Act(action, { Id = item.Id }, Kit)
				end })
			else
				status = "🔒 " .. reason
				table.insert(buttons, { "Locked", "locked", nil })
				robuxButton(item.Unlock, buttons)
			end
			card(i, item.Name, unlocked and C.Text or C.Muted, swatchFn and swatchFn(item) or nil, status, buttons)
		end
	end

	local function render()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(list)
		local store = data.Store
		if tab == "Themes" then
			equipList(Cosmetics.Themes, store.Theme, "SetTheme", function(t)
				return { t.Wall, t.Floor, t.Trim, t.Neon }
			end)
		elseif tab == "Layouts" then
			equipList(Cosmetics.Layouts, store.Layout, "SetLayout", nil)
		elseif tab == "Uniforms" then
			equipList(Cosmetics.Uniforms, store.Uniform, "SetUniform", function(u)
				return { u.Color }
			end)
		elseif tab == "Effects" then
			equipList(Cosmetics.Effects, store.Effect, "SetEffect", function(e)
				return e.Colors
			end)
		elseif tab == "Decor" then
			for i, d in ipairs(Cosmetics.Decor) do
				local unlocked, reason = State.IsUnlocked(d.Unlock)
				local owned = data.Owned.Decor[d.Id] or (d.Price == 0 and unlocked)
				local buttons = {}
				local status
				if owned then
					local on = store.DecorOn[d.Id]
					status = on and "Placed in your store" or "In storage"
					table.insert(buttons, { on and "Put away" or "Place", on and "secondary" or nil, function()
						State.Act("ToggleDecor", { Id = d.Id }, Kit)
					end })
				elseif unlocked then
					status = "Available"
					table.insert(buttons, { "Buy " .. Util.Money(d.Price), data.Cash >= d.Price and nil or "locked", function()
						State.Act("BuyDecor", { Id = d.Id }, Kit)
					end })
				else
					status = "🔒 " .. reason
					table.insert(buttons, { "Locked", "locked", nil })
					robuxButton(d.Unlock, buttons)
				end
				card(i, d.Name, owned and C.Text or C.Muted, nil, status, buttons)
			end
		elseif tab == "Sign" then
			local c = Kit.Card(list, 1)
			Kit.List(nil, 10).Parent = c
			Kit.Text({ Parent = c, LayoutOrder = 1, Text = "Store name (shown on your sign, filtered for everyone)", Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 20) })
			local box = new("TextBox", {
				Parent = c, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = C.Panel, TextColor3 = C.Text,
				Font = Kit.Fonts.Bold, TextSize = 18, ClearTextOnFocus = false, PlaceholderText = player.DisplayName .. "'s Mart",
				Text = store.Name, TextXAlignment = Enum.TextXAlignment.Left,
			}, { Kit.Corner(10), new("UIPadding", { PaddingLeft = UDim.new(0, 12) }) })
			box:GetPropertyChangedSignal("Text"):Connect(function()
				if #box.Text > 24 then
					box.Text = box.Text:sub(1, 24)
				end
			end)
			Kit.Text({ Parent = c, LayoutOrder = 3, Text = "Sign color", Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 20) })
			local swatches = new("Frame", { Parent = c, LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, { Kit.List(Enum.FillDirection.Horizontal, 8) })
			signColor = signColor or store.SignColor
			for i, color in ipairs(Cosmetics.SignColors) do
				local b = Kit.Button({ Parent = swatches, LayoutOrder = i, Text = i == signColor and "✓" or "", Size = UDim2.new(0, 40, 0, 40), TextColor3 = Color3.new(1, 1, 1) }, function()
					signColor = i
					render()
				end, color)
				Kit.Stroke(Color3.new(1, 1, 1), i == signColor and 0 or 0.8, 2).Parent = b
			end
			Kit.Button({ Parent = c, LayoutOrder = 5, Text = "Save sign", Size = UDim2.new(0, 160, 0, 40) }, function()
				State.Act("SetSign", { Name = box.Text, Color = signColor }, Kit)
			end)
		end
	end

	local tabs = Kit.Tabs(panel.Body, {
		{ "Themes", "Themes" }, { "Layouts", "Layout" }, { "Decor", "Decor" },
		{ "Uniforms", "Uniform" }, { "Effects", "Checkout FX" }, { "Sign", "Sign" },
	}, function(id)
		tab = id
		render()
	end)
	panel.OnOpen = function()
		signColor = nil
		tabs.Select(tab)
	end

	local queued = false
	State.On(function()
		if Kit.IsOpen("Customize") and tab ~= "Sign" and not queued then
			queued = true
			task.delay(0.6, function()
				queued = false
				if Kit.IsOpen("Customize") and tab ~= "Sign" then
					render()
				end
			end)
		end
	end)
end

return Customize
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Dialogs</string><ProtectedString name="Source"><![CDATA[-- Context dialogs opened by the server from in-world prompts:
--   Stock dialog (shelf/cooler prompt) and Rate dialog (guestbook prompt).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Dialogs = {}

function Dialogs.Build(Kit, State)
	local C = Kit.Colors
	local new = Kit.new
	local player = Players.LocalPlayer

	---------------------------------------------------------------------
	-- STOCK
	---------------------------------------------------------------------
	local stock = Kit.Panel("Stock", "STOCK SHELF", 620, 500)
	local stockList = Kit.Scroll(stock.Body)
	local unitIndex, isCooler = 1, false
	local picking = nil -- slot we're choosing a product for

	local function render()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(stockList)
		local cap = data.Effects.SlotCapacity
		if picking then
			local head = Kit.Card(stockList, 0)
			Kit.Text({ Parent = head, Text = ("Choose a product for slot %d"):format(picking), Font = Kit.Fonts.Bold, Size = UDim2.new(1, -130, 0, 22) })
			Kit.Button({ Parent = head, Text = "Back", Size = UDim2.new(0, 110, 0, 34), Position = UDim2.new(1, -110, 0, -6) }, function()
				picking = nil
				render()
			end, "secondary")
			local ids = {}
			for id, count in pairs(data.Inventory) do
				local p = Products.ById[id]
				if p and count > 0 and p.Cold == isCooler then
					table.insert(ids, id)
				end
			end
			table.sort(ids, function(a, b)
				return Products.ById[a].Order < Products.ById[b].Order
			end)
			if #ids == 0 then
				local c = Kit.Card(stockList, 1)
				Kit.Text({ Parent = c, Text = isCooler and "No drinks in your backroom. Order some!" or "No shelf products in your backroom. Order some!", TextColor3 = C.Muted, Size = UDim2.new(1, -150, 0, 22) })
				Kit.Button({ Parent = c, Text = "Order stock", Size = UDim2.new(0, 140, 0, 34), Position = UDim2.new(1, -140, 0, -6) }, function()
					Kit.Open("Order")
				end)
			end
			for i, id in ipairs(ids) do
				local p = Products.ById[id]
				local c = Kit.Card(stockList, i)
				new("Frame", { Parent = c, Size = UDim2.new(0, 30, 0, 30), BackgroundColor3 = p.Color }, { Kit.Corner(6) })
				Kit.Text({ Parent = c, Text = ("%s  x%d"):format(p.Name, data.Inventory[id]), Font = Kit.Fonts.Bold, Position = UDim2.new(0, 40, 0, 0), Size = UDim2.new(1, -190, 0, 30), TextYAlignment = Enum.TextYAlignment.Center })
				local slot = picking
				Kit.Button({ Parent = c, Text = "Put here", Size = UDim2.new(0, 130, 0, 34), Position = UDim2.new(1, -130, 0, -2) }, function()
					local result = State.Act("StockSlot", { Unit = unitIndex, Slot = slot, Product = id }, Kit)
					if result.ok then
						picking = nil
						task.delay(0.3, render)
					end
				end)
			end
			return
		end
		local head = Kit.Card(stockList, 0)
		Kit.Text({ Parent = head, Text = ("%s #%d  ·  up to %d per slot"):format(isCooler and "Cooler" or "Shelf", unitIndex, cap), Font = Kit.Fonts.Bold, Size = UDim2.new(1, -150, 0, 22) })
		Kit.Button({ Parent = head, Text = "Refill all", Size = UDim2.new(0, 140, 0, 34), Position = UDim2.new(1, -140, 0, -6) }, function()
			State.Act("RestockUnit", { Unit = unitIndex }, Kit)
			task.delay(0.3, render)
		end)
		for slot = 1, 4 do
			local entry = data.Shelves["u" .. unitIndex .. "s" .. slot]
			local p = entry and Products.ById[entry.P]
			local c = Kit.Card(stockList, slot)
			new("Frame", { Parent = c, Size = UDim2.new(0, 30, 0, 30), BackgroundColor3 = p and p.Color or C.Panel }, { Kit.Corner(6) })
			local text = p and ("%s  %d/%d  (backroom: %d)"):format(p.Name, entry.Q, cap, data.Inventory[entry.P] or 0) or "Empty slot"
			Kit.Text({ Parent = c, Text = ("Slot %d: %s"):format(slot, text), Font = Kit.Fonts.Bold, TextSize = 15, TextColor3 = p and C.Text or C.Muted, Position = UDim2.new(0, 40, 0, 0), Size = UDim2.new(1, -330, 0, 30), TextYAlignment = Enum.TextYAlignment.Center })
			Kit.Button({ Parent = c, Text = p and "Change" or "Stock", Size = UDim2.new(0, 90, 0, 34), Position = UDim2.new(1, -280, 0, -2) }, function()
				picking = slot
				render()
			end, p and "secondary" or nil)
			if p then
				Kit.Button({ Parent = c, Text = "Refill", Size = UDim2.new(0, 90, 0, 34), Position = UDim2.new(1, -185, 0, -2) }, function()
					State.Act("StockSlot", { Unit = unitIndex, Slot = slot, Product = entry.P }, Kit)
					task.delay(0.3, render)
				end)
				Kit.Button({ Parent = c, Text = "Clear", Size = UDim2.new(0, 90, 0, 34), Position = UDim2.new(1, -90, 0, -2) }, function()
					State.Act("ClearSlot", { Unit = unitIndex, Slot = slot }, Kit)
					task.delay(0.3, render)
				end, "secondary")
			end
		end
		local tip = Kit.Card(stockList, 10)
		Kit.Text({ Parent = tip, Text = isCooler and "Coolers hold drinks. Customers grab from the front, so keep popular items full!" or "Shelves hold snacks, food, sweets and household goods.", TextColor3 = C.Muted, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
	end

	Remotes:WaitForChild("OpenStock").OnClientEvent:Connect(function(index, cooler)
		unitIndex, isCooler = index, cooler
		picking = nil
		if not Kit.IsOpen("Stock") then
			Kit.Open("Stock")
		end
		render()
	end)
	stock.OnOpen = render
	local queued = false
	State.On(function()
		if queued then
			return
		end
		queued = true
		task.delay(0.5, function()
			queued = false
			if Kit.IsOpen("Stock") and not picking then
				render()
			end
		end)
	end)
	-- Close the stock dialog if you walk away from the shelf
	task.spawn(function()
		while true do
			task.wait(0.5)
			if Kit.IsOpen("Stock") and State.Data then
				local stores = workspace:FindFirstChild("Stores")
				local model = stores and stores:FindFirstChild("Store" .. State.Data.PlotIndex)
				local unit = model and model:FindFirstChild("Unit" .. unitIndex)
				local back = unit and unit:FindFirstChild("Back")
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if back and root and (back.Position - root.Position).Magnitude > 18 then
					Kit.Close()
				end
			end
		end
	end)

	---------------------------------------------------------------------
	-- RATE
	---------------------------------------------------------------------
	local rate = Kit.Panel("Rate", "SIGN THE GUESTBOOK", 460, 300)
	local ownerId, stars = nil, 5
	local storeLabel = Kit.Text({ Parent = rate.Body, Text = "", Font = Kit.Fonts.Bold, TextSize = 17, Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center })
	local starRow = new("Frame", { Parent = rate.Body, Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1 }, { Kit.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
	local starButtons = {}
	local function paintStars()
		for i, b in ipairs(starButtons) do
			b.Text = i <= stars and "★" or "☆"
			b.TextColor3 = i <= stars and C.Amber or C.Muted
		end
	end
	for i = 1, 5 do
		starButtons[i] = Kit.Button({ Parent = starRow, LayoutOrder = i, Text = "★", TextSize = 34, Size = UDim2.new(0, 60, 0, 60) }, function()
			stars = i
			paintStars()
		end, "secondary")
	end
	Kit.Button({ Parent = rate.Body, Text = "Submit rating", Size = UDim2.new(0, 200, 0, 44), Position = UDim2.new(0.5, -100, 0, 120) }, function()
		local result = State.Act("RateStore", { Owner = ownerId, Stars = stars }, Kit)
		if result.ok then
			Kit.Close()
		end
	end)
	Kit.Text({ Parent = rate.Body, Text = "You can rate each store once per day.", TextColor3 = C.Muted, TextSize = 13, Position = UDim2.new(0, 0, 0, 176), Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
	Remotes:WaitForChild("OpenRate").OnClientEvent:Connect(function(id, name)
		ownerId = id
		stars = 5
		storeLabel.Text = "How was " .. (name ~= "" and name or "this store") .. "?"
		paintStars()
		Kit.Open("Rate")
	end)
end

return Dialogs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Extras</string><ProtectedString name="Source"><![CDATA[-- Town (visit stores + leaderboards), Daily (streak, challenges, weekly
-- event) and Settings panels.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local WorldState = ReplicatedStorage:WaitForChild("WorldState")

local Extras = {}

function Extras.Build(Kit, State)
	local C = Kit.Colors
	local new = Kit.new

	---------------------------------------------------------------------
	-- TOWN
	---------------------------------------------------------------------
	local town = Kit.Panel("Town", "TOWN", 700, 520)
	local townList = Kit.Scroll(town.Body, UDim2.new(1, 0, 1, -48), UDim2.new(0, 0, 0, 48))
	local townTab = "Stores"
	local function renderTown()
		Kit.Clear(townList)
		if townTab == "Stores" then
			local result = State.Request("GetStores", {})
			if not result.ok then
				Kit.Text({ Parent = townList, Text = result.msg or "Couldn't load stores.", TextColor3 = C.Bad, Size = UDim2.new(1, 0, 0, 30) })
				return
			end
			local intro = Kit.Card(townList, 0)
			Kit.Text({ Parent = intro, Text = "Visit other shopkeepers, rate their stores in their guestbook, and earn a bonus when you visit a friend each day.", TextColor3 = C.Muted, TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
			for i, s in ipairs(result.Stores) do
				local c = Kit.Card(townList, i)
				local name = s.StoreName ~= "" and s.StoreName or (s.Name .. "'s Mart")
				local tags = (s.Mine and "  (you)" or "") .. (s.Friend and "  ★ friend" or "")
				Kit.Text({ Parent = c, Text = name .. tags, Font = Kit.Fonts.Bold, TextSize = 17, TextColor3 = s.Friend and C.Teal or C.Text, Size = UDim2.new(1, -150, 0, 22) })
				Kit.Text({ Parent = c, Text = ("%s %.1f (%d reviews)  ·  Keeper: %s  ·  Level %d%s"):format(Util.Stars(s.Rating), s.Rating, s.Reviews, s.Name, s.Level, s.Title ~= "" and ("  ·  " .. s.Title) or ""), TextSize = 13, TextColor3 = C.Muted, Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, -150, 0, 0), AutoY = true })
				Kit.Button({ Parent = c, Text = s.Mine and "Go home" or "Visit", Size = UDim2.new(0, 130, 0, 38), Position = UDim2.new(1, -130, 0, 0) }, function()
					State.Act("Visit", { UserId = s.UserId }, Kit)
					Kit.Close()
				end, s.Mine and "secondary" or nil)
				new("Frame", { Parent = c, Size = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1 })
			end
		else
			local result = State.Request("GetLeaderboards", {})
			local boards = result.ok and result.Boards or { Earned = {}, Rating = {} }
			for i, info in ipairs({ { "Top earners (all time)", boards.Earned, false }, { "Best rated stores", boards.Rating, true } }) do
				local c = Kit.Card(townList, i)
				Kit.List(nil, 4).Parent = c
				Kit.Text({ Parent = c, LayoutOrder = 0, Text = info[1], Font = Kit.Fonts.Display, TextSize = 18, TextColor3 = C.Amber, Size = UDim2.new(1, 0, 0, 24) })
				if #info[2] == 0 then
					Kit.Text({ Parent = c, LayoutOrder = 1, Text = "No entries yet (leaderboards update every couple of minutes in live servers).", TextColor3 = C.Muted, TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
				end
				for _, e in ipairs(info[2]) do
					local value = info[3] and ("%.2f ★"):format(e.Value) or Util.Money(e.Value)
					Kit.Text({ Parent = c, LayoutOrder = e.Rank, Text = ("%d.  %s   %s"):format(e.Rank, e.Name, value), TextSize = 15, TextColor3 = e.Rank == 1 and C.Amber or C.Text, Size = UDim2.new(1, 0, 0, 20) })
				end
			end
		end
	end
	local townTabs = Kit.Tabs(town.Body, { { "Stores", "Open Stores" }, { "Leaderboards", "Leaderboards" } }, function(id)
		townTab = id
		renderTown()
	end)
	town.OnOpen = function()
		townTabs.Select(townTab)
	end

	---------------------------------------------------------------------
	-- DAILY
	---------------------------------------------------------------------
	local daily = Kit.Panel("Daily", "DAILY REWARDS", 700, 540)
	local dailyList = Kit.Scroll(daily.Body)
	local function renderDaily()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(dailyList)
		local d = data.Daily
		local claimedToday = d.LastDay == d.Today
		local continuing = d.LastDay == d.Today - 1
		local nextStreak = claimedToday and d.Streak or (continuing and d.Streak + 1 or 1)
		local currentIndex = (nextStreak - 1) % #Config.DailyRewards + 1

		local streakCard = Kit.Card(dailyList, 1)
		Kit.List(nil, 10).Parent = streakCard
		Kit.Text({ Parent = streakCard, LayoutOrder = 0, Text = ("Login streak: %d day%s  ·  Best: %d"):format(d.Streak, d.Streak == 1 and "" or "s", d.BestStreak), Font = Kit.Fonts.Display, TextSize = 18, TextColor3 = C.Amber, Size = UDim2.new(1, 0, 0, 24) })
		local row = new("Frame", { Parent = streakCard, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1 }, { Kit.List(Enum.FillDirection.Horizontal, 6) })
		for i, amount in ipairs(Config.DailyRewards) do
			local done = claimedToday and i <= currentIndex or (not claimedToday and i < currentIndex)
			local isNext = i == currentIndex
			local tile = new("Frame", { Parent = row, LayoutOrder = i, Size = UDim2.new(1 / 7, -6, 1, 0), BackgroundColor3 = isNext and C.Amber or (done and C.PanelLight or C.Panel) }, { Kit.Corner(10) })
			Kit.Text({ Parent = tile, Text = "Day " .. i, Font = Kit.Fonts.Bold, TextSize = 13, TextColor3 = isNext and Color3.fromRGB(30, 22, 10) or C.Muted, Size = UDim2.new(1, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center })
			Kit.Text({ Parent = tile, Text = (done and "✓ " or "") .. Util.Money(amount) .. (i == 7 and "\n+ bonus" or ""), Font = Kit.Fonts.Bold, TextSize = 14, TextColor3 = isNext and Color3.fromRGB(30, 22, 10) or C.Text, Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 1, -24), TextXAlignment = Enum.TextXAlignment.Center })
		end
		if claimedToday then
			local hours = math.floor(d.SecondsLeft / 3600)
			local minutes = math.floor(d.SecondsLeft % 3600 / 60)
			Kit.Text({ Parent = streakCard, LayoutOrder = 2, Text = ("Claimed! Next reward in %dh %dm."):format(hours, minutes), TextColor3 = C.Good, Size = UDim2.new(1, 0, 0, 22) })
		else
			Kit.Button({ Parent = streakCard, LayoutOrder = 2, Text = "Claim day " .. nextStreak .. " reward", Size = UDim2.new(0, 220, 0, 42) }, function()
				State.Act("ClaimDaily", {}, Kit)
			end)
		end
		Kit.Text({ Parent = streakCard, LayoutOrder = 3, Text = "Reach a 7-day streak to unlock the Hearts checkout effect and the Sakura Night theme. Missing a day resets the streak, but never your best.", TextColor3 = C.Muted, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutoY = true })

		local chCard = Kit.Card(dailyList, 2)
		Kit.List(nil, 8).Parent = chCard
		Kit.Text({ Parent = chCard, LayoutOrder = 0, Text = "Today's challenges", Font = Kit.Fonts.Display, TextSize = 18, TextColor3 = C.Amber, Size = UDim2.new(1, 0, 0, 24) })
		for i, ch in ipairs(data.Challenges) do
			local line = new("Frame", { Parent = chCard, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1 })
			Kit.Text({ Parent = line, Text = ("%s  (%d/%d)"):format(ch.Desc, ch.Progress, ch.Goal), Font = Kit.Fonts.Bold, TextSize = 15, Size = UDim2.new(1, -150, 0, 20) })
			local bar = Kit.Bar(line, ch.Progress / ch.Goal, ch.Progress >= ch.Goal and C.Good or C.Amber, 8)
			bar.Position = UDim2.new(0, 0, 0, 28)
			bar.Size = UDim2.new(1, -150, 0, 8)
			if ch.Claimed then
				Kit.Button({ Parent = line, Text = "Claimed ✓", Size = UDim2.new(0, 136, 0, 38), Position = UDim2.new(1, -136, 0, 4) }, nil, "good")
			elseif ch.Progress >= ch.Goal then
				Kit.Button({ Parent = line, Text = "Claim " .. Util.Money(ch.Reward), Size = UDim2.new(0, 136, 0, 38), Position = UDim2.new(1, -136, 0, 4) }, function()
					State.Act("ClaimChallenge", { Index = i }, Kit)
				end)
			else
				Kit.Button({ Parent = line, Text = Util.Money(ch.Reward), Size = UDim2.new(0, 136, 0, 38), Position = UDim2.new(1, -136, 0, 4) }, nil, "locked")
			end
		end
		Kit.Text({ Parent = chCard, LayoutOrder = 10, Text = "New challenges every day at 00:00 UTC.", TextColor3 = C.Muted, TextSize = 13, Size = UDim2.new(1, 0, 0, 18) })

		local weekCard = Kit.Card(dailyList, 3)
		Kit.Text({ Parent = weekCard, Text = "This week: " .. (WorldState:GetAttribute("WeeklyName") or ""), Font = Kit.Fonts.Display, TextSize = 18, TextColor3 = C.Teal, Size = UDim2.new(1, 0, 0, 24) })
		Kit.Text({ Parent = weekCard, Text = WorldState:GetAttribute("WeeklyDesc") or "", TextColor3 = C.Muted, TextSize = 14, Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 0), AutoY = true })
		new("Frame", { Parent = weekCard, Size = UDim2.new(0, 0, 0, 48), BackgroundTransparency = 1 })

		local month = data.Month
		local seasonText = (month == 10 and "Harvest season! Log in this month to unlock the Harvest Orange uniform forever.")
			or (month == 12 and "Snowfall season! Log in this month to unlock the Snowfall theme forever.")
			or "Seasonal cosmetics arrive in October (Harvest) and December (Snowfall). Log in during those months to keep them forever."
		local seasonCard = Kit.Card(dailyList, 4)
		Kit.Text({ Parent = seasonCard, Text = seasonText, TextColor3 = C.Purple, TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
	end
	daily.OnOpen = renderDaily

	---------------------------------------------------------------------
	-- SETTINGS
	---------------------------------------------------------------------
	local settings = Kit.Panel("Settings", "SETTINGS", 560, 500)
	local setList = Kit.Scroll(settings.Body)
	local hasAudio = false
	for _, id in pairs(Config.Audio) do
		if id ~= "" then
			hasAudio = true
		end
	end
	local function renderSettings()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(setList)
		local s = data.Settings
		local function toggle(order, label, desc, key)
			local c = Kit.Card(setList, order)
			Kit.Text({ Parent = c, Text = label, Font = Kit.Fonts.Bold, TextSize = 16, Size = UDim2.new(1, -120, 0, 20) })
			Kit.Text({ Parent = c, Text = desc, TextSize = 13, TextColor3 = C.Muted, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -120, 0, 0), AutoY = true })
			Kit.Button({ Parent = c, Text = s[key] and "ON" or "OFF", Size = UDim2.new(0, 100, 0, 36), Position = UDim2.new(1, -100, 0, 0) }, function()
				State.Request("SetSetting", { Key = key, Value = not s[key] })
			end, s[key] and "good" or "secondary")
			new("Frame", { Parent = c, Size = UDim2.new(0, 0, 0, 38), BackgroundTransparency = 1 })
		end
		toggle(1, "Rain effects", "Falling rain and lightning flashes.", "Rain")
		toggle(2, "Low graphics mode", "Turns off glow, flickering neon and particle effects. Great for older phones.", "LowGraphics")
		toggle(3, "Customer speech bubbles", "Show what customers say above their heads.", "Bubbles")

		local scaleCard = Kit.Card(setList, 4)
		Kit.Text({ Parent = scaleCard, Text = "Interface size", Font = Kit.Fonts.Bold, TextSize = 16, Size = UDim2.new(1, 0, 0, 20) })
		local row = new("Frame", { Parent = scaleCard, Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, { Kit.List(Enum.FillDirection.Horizontal, 8) })
		for i, opt in ipairs({ { "Small", 0.85 }, { "Normal", 1 }, { "Large", 1.15 } }) do
			Kit.Button({ Parent = row, LayoutOrder = i, Text = opt[1], Size = UDim2.new(0, 110, 1, 0) }, function()
				State.Request("SetSetting", { Key = "UIScale", Value = opt[2] })
			end, math.abs(s.UIScale - opt[2]) < 0.01 and nil or "secondary")
		end
		new("Frame", { Parent = scaleCard, Size = UDim2.new(0, 0, 0, 66), BackgroundTransparency = 1 })

		if hasAudio then
			local volCard = Kit.Card(setList, 5)
			Kit.Text({ Parent = volCard, Text = ("Ambience volume: %d%%"):format(math.floor(s.Volume * 100 + 0.5)), Font = Kit.Fonts.Bold, TextSize = 16, Size = UDim2.new(1, 0, 0, 20) })
			local vrow = new("Frame", { Parent = volCard, Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, { Kit.List(Enum.FillDirection.Horizontal, 8) })
			for i, v in ipairs({ 0, 0.25, 0.5, 0.75, 1 }) do
				Kit.Button({ Parent = vrow, LayoutOrder = i, Text = math.floor(v * 100) .. "%", Size = UDim2.new(0, 70, 1, 0) }, function()
					State.Request("SetSetting", { Key = "Volume", Value = v })
				end, math.abs(s.Volume - v) < 0.01 and nil or "secondary")
			end
			new("Frame", { Parent = volCard, Size = UDim2.new(0, 0, 0, 66), BackgroundTransparency = 1 })
		end

		local tut = Kit.Card(setList, 6)
		Kit.Text({ Parent = tut, Text = "Tutorial", Font = Kit.Fonts.Bold, TextSize = 16, Size = UDim2.new(1, -170, 0, 20) })
		Kit.Button({ Parent = tut, Text = "Show it again", Size = UDim2.new(0, 160, 0, 36), Position = UDim2.new(1, -160, 0, 0) }, function()
			State.Act("RestartTutorial", {}, Kit)
		end, "secondary")
		new("Frame", { Parent = tut, Size = UDim2.new(0, 0, 0, 38), BackgroundTransparency = 1 })

		local info = Kit.Card(setList, 7)
		Kit.Text({ Parent = info, Text = (data.Saving and "✓ Your progress is saving." or "⚠ Progress is NOT saving in this session (in Studio, enable API access).") .. "\nControls: walk up to shelves, coolers and the register and press E (or tap the prompt). Shortcuts: O Order · I Stock · U Upgrades · J Journal · C Customize · T Town · G Daily.", TextSize = 13, TextColor3 = data.Saving and C.Muted or C.Bad, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
	end
	settings.OnOpen = renderSettings

	local queued = false
	State.On(function()
		if queued then
			return
		end
		queued = true
		task.delay(0.5, function()
			queued = false
			if Kit.IsOpen("Daily") then
				renderDaily()
			elseif Kit.IsOpen("Settings") then
				renderSettings()
			end
		end)
	end)
end

return Extras
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Always-visible HUD: cash, level, rating, clock/weather/event, nav bar,
-- toasts, tutorial guide (with a beam to the target), floating sale text.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local WorldState = ReplicatedStorage:WaitForChild("WorldState")

local Hud = {}

local TUTORIAL = {
	{ Title = "Ring up your first customer", Text = "Customers grab items and line up at the register. Walk behind the counter and press E on the register (or tap Ring Up).", Target = "Register" },
	{ Title = "Order more stock", Text = "Shelves run low fast. Open Order and buy something new for your backroom.", Nav = "Order" },
	{ Title = "Stock a shelf", Text = "Walk up to a shelf or cooler and press E to put items from your backroom on it.", Target = "Unit" },
	{ Title = "Buy an upgrade", Text = "Open Upgrades and install your first one. Sturdy Shelves is a great start!", Nav = "Upgrades" },
}

function Hud.Build(Kit, State)
	local C = Kit.Colors
	local new = Kit.new
	local root = Kit.Root
	local player = Players.LocalPlayer
	local hud = {}

	---------------------------------------------------------------------
	-- Top-left: cash, level, rating
	---------------------------------------------------------------------
	local stats = new("Frame", {
		Parent = root, Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(0, 260, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Panel, BackgroundTransparency = 0.15,
	}, { Kit.Corner(16), Kit.Pad(12), Kit.List(nil, 6), Kit.Stroke(C.Amber, 0.7) })
	local cashLabel = Kit.Text({ Parent = stats, LayoutOrder = 1, Text = "$0", Font = Kit.Fonts.Display, TextSize = 30, TextColor3 = C.Good, Size = UDim2.new(1, 0, 0, 32), TextWrapped = false })
	local levelLabel = Kit.Text({ Parent = stats, LayoutOrder = 2, Text = "Level 1", Font = Kit.Fonts.Bold, TextSize = 15, Size = UDim2.new(1, 0, 0, 18) })
	local xpBack, xpFill = Kit.Bar(stats, 0, C.Amber, 8)
	xpBack.LayoutOrder = 3
	local ratingLabel = Kit.Text({ Parent = stats, LayoutOrder = 4, Text = "", Font = Kit.Fonts.Bold, TextSize = 15, TextColor3 = C.Amber, Size = UDim2.new(1, 0, 0, 18) })

	local shownCash = 0
	local targetCash = 0
	task.spawn(function()
		while true do
			task.wait(0.03)
			if shownCash ~= targetCash then
				local diff = targetCash - shownCash
				local step = math.max(1, math.floor(math.abs(diff) * 0.2))
				shownCash = shownCash + (diff > 0 and math.min(step, diff) or math.max(-step, diff))
				cashLabel.Text = Util.Money(shownCash)
			end
		end
	end)

	---------------------------------------------------------------------
	-- Top-center: clock, weather, tonight's event
	---------------------------------------------------------------------
	local clockPill = new("Frame", {
		Parent = root, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0, 230, 0, 40),
		BackgroundColor3 = C.Panel, BackgroundTransparency = 0.15,
	}, { Kit.Corner(20), Kit.Stroke(C.Stroke, 0.6) })
	local clockLabel = Kit.Text({ Parent = clockPill, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Kit.Fonts.Bold, TextSize = 18, Text = "" })
	local eventChip = Kit.Button({
		Parent = root, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.new(0, 0, 0, 30),
		AutomaticSize = Enum.AutomaticSize.X, Text = "", TextSize = 14, Visible = false,
	}, function()
		Kit.Toast(WorldState:GetAttribute("EventDesc") or "", "event")
	end, C.PanelLight)
	new("UIPadding", { Parent = eventChip, PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) })

	local function weatherIcon(night)
		local w = WorldState:GetAttribute("Weather")
		if w == "Rain" then
			return "🌧"
		elseif w == "Storm" then
			return "⛈"
		elseif w == "Fog" then
			return "🌫"
		end
		return night and "☾" or "☀"
	end
	local function refreshEvent()
		local name = WorldState:GetAttribute("EventName") or ""
		eventChip.Visible = name ~= ""
		eventChip.Text = "✦ " .. name .. "  (tap for details)"
		eventChip.TextColor3 = WorldState:GetAttribute("EventColor") or C.Text
	end
	WorldState:GetAttributeChangedSignal("EventName"):Connect(refreshEvent)
	refreshEvent()
	task.spawn(function()
		while true do
			local night = WorldState:GetAttribute("Night")
			clockLabel.Text = ("%s  %s  %s"):format(weatherIcon(night), Util.Clock(Lighting.ClockTime), night and "NIGHT" or "DAY")
			clockLabel.TextColor3 = night and Color3.fromRGB(190, 200, 255) or C.Text
			task.wait(0.5)
		end
	end)

	---------------------------------------------------------------------
	-- Toasts (right side)
	---------------------------------------------------------------------
	local toastList = new("Frame", {
		Parent = root, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 120), Size = UDim2.new(0, 330, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 40,
	}, { Kit.List(nil, 6, Enum.HorizontalAlignment.Right) })
	local kindColor = { info = C.Text, good = C.Good, bad = C.Bad, event = C.Purple, review = C.Amber, clue = C.Teal, level = C.Amber }
	local order = 0
	function hud.Toast(text, kind)
		order = order + 1
		local items = {}
		for _, child in ipairs(toastList:GetChildren()) do
			if child:IsA("Frame") then
				table.insert(items, child)
			end
		end
		if #items >= 5 then
			table.sort(items, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
			items[1]:Destroy()
		end
		local long = (kind == "clue" or kind == "event" or kind == "level")
		local card = new("Frame", {
			Parent = toastList, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = C.Panel, BackgroundTransparency = 0.1, ZIndex = 40,
		}, { Kit.Corner(12), Kit.Pad(10), Kit.Stroke(kindColor[kind] or C.Text, 0.4) })
		local t = Kit.Text({ Parent = card, Text = text, TextColor3 = kindColor[kind] or C.Text, Size = UDim2.new(1, 0, 0, 0), AutoY = true, TextSize = 15, ZIndex = 41 })
		card.Position = UDim2.new(0, 40, 0, 0)
		t.TextTransparency = 1
		Kit.Tween(t, { TextTransparency = 0 }, 0.2)
		task.delay(long and 9 or 4.5, function()
			if card.Parent then
				Kit.Tween(t, { TextTransparency = 1 }, 0.3)
				Kit.Tween(card, { BackgroundTransparency = 1 }, 0.3).Completed:Wait()
				card:Destroy()
			end
		end)
	end
	Kit.Toast = hud.Toast
	Remotes:WaitForChild("Notify").OnClientEvent:Connect(hud.Toast)

	---------------------------------------------------------------------
	-- Nav bar (bottom)
	---------------------------------------------------------------------
	local nav = new("Frame", {
		Parent = root, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0, 0, 0, 72),
		AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = C.Panel, BackgroundTransparency = 0.15,
	}, { Kit.Corner(20), Kit.Pad(8), Kit.List(Enum.FillDirection.Horizontal, 6), Kit.Stroke(C.Amber, 0.7) })
	hud.NavButtons = {}
	hud.Dots = {}
	local NAV = {
		{ "Order", "🛒", "Order", Enum.KeyCode.O },
		{ "Inventory", "📦", "Stock", Enum.KeyCode.I },
		{ "Upgrades", "⬆", "Upgrade", Enum.KeyCode.U },
		{ "Journal", "📖", "Journal", Enum.KeyCode.J },
		{ "Customize", "🎨", "Style", Enum.KeyCode.C },
		{ "Town", "🏙", "Town", Enum.KeyCode.T },
		{ "Daily", "🎁", "Daily", Enum.KeyCode.G },
		{ "Settings", "⚙", "Settings", nil },
	}
	hud.Keys = {}
	for i, info in ipairs(NAV) do
		local b = Kit.Button({ Parent = nav, LayoutOrder = i, Size = UDim2.new(0, 64, 1, 0), Text = "" }, function()
			Kit.Open(info[1])
		end, "secondary")
		Kit.Text({ Parent = b, Text = info[2], TextSize = 24, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 4), TextXAlignment = Enum.TextXAlignment.Center })
		Kit.Text({ Parent = b, Text = info[3], TextSize = 12, Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -20), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Muted })
		local dot = new("Frame", { Parent = b, Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -14, 0, 2), BackgroundColor3 = C.Bad, Visible = false }, { Kit.Corner(6) })
		hud.NavButtons[info[1]] = b
		hud.Dots[info[1]] = dot
		if info[4] then
			hud.Keys[info[4]] = info[1]
		end
	end
	hud.Nav = nav

	---------------------------------------------------------------------
	-- Tutorial card + guide beam
	---------------------------------------------------------------------
	local tutorial = new("Frame", {
		Parent = root, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.55, 0), Size = UDim2.new(0, 280, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.Panel, BackgroundTransparency = 0.1, Visible = false,
	}, { Kit.Corner(14), Kit.Pad(12), Kit.List(nil, 6), Kit.Stroke(C.Teal, 0.4) })
	local tutStep = Kit.Text({ Parent = tutorial, LayoutOrder = 1, Text = "", Font = Kit.Fonts.Bold, TextSize = 13, TextColor3 = C.Teal, Size = UDim2.new(1, 0, 0, 16) })
	local tutTitle = Kit.Text({ Parent = tutorial, LayoutOrder = 2, Text = "", Font = Kit.Fonts.Display, TextSize = 18, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
	local tutText = Kit.Text({ Parent = tutorial, LayoutOrder = 3, Text = "", TextSize = 14, TextColor3 = C.Muted, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
	Kit.Button({ Parent = tutorial, LayoutOrder = 4, Text = "Skip tutorial", Size = UDim2.new(0, 120, 0, 30), TextSize = 13 }, function()
		State.Act("SkipTutorial", {}, Kit)
	end, "secondary")

	local beamAttach0, beamAttach1, beam
	local function setBeamTarget(part)
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not part or not rootPart then
			if beam then
				beam.Enabled = false
			end
			return
		end
		if not beam then
			beamAttach0 = Instance.new("Attachment")
			beamAttach1 = Instance.new("Attachment")
			beam = Instance.new("Beam")
			beam.Width0 = 0.6
			beam.Width1 = 0.6
			beam.FaceCamera = true
			beam.LightEmission = 1
			beam.Color = ColorSequence.new(C.Teal)
			beam.Transparency = NumberSequence.new(0.3)
			beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			beam.TextureSpeed = 2
			beam.TextureLength = 2
			beam.Parent = workspace.Terrain
		end
		beamAttach0.Parent = rootPart
		beamAttach1.Parent = part
		beam.Attachment0 = beamAttach0
		beam.Attachment1 = beamAttach1
		beam.Enabled = true
	end

	local lastStep = nil
	local pulseToken = 0
	function hud.UpdateTutorial(data, force)
		local key = data.Tutorial .. ":" .. (data.PlotIndex or 0)
		if key == lastStep and not force then
			return
		end
		lastStep = key
		pulseToken = pulseToken + 1
		for _, b in pairs(hud.NavButtons) do
			b.Rotation = 0
		end
		local step = TUTORIAL[data.Tutorial]
		tutorial.Visible = step ~= nil
		if not step then
			setBeamTarget(nil)
			return
		end
		tutStep.Text = ("GETTING STARTED  %d/%d"):format(data.Tutorial, #TUTORIAL)
		tutTitle.Text = step.Title
		tutText.Text = step.Text
		local target = nil
		local stores = workspace:FindFirstChild("Stores")
		local storeModel = stores and stores:FindFirstChild("Store" .. (data.PlotIndex or 0))
		if storeModel and step.Target == "Register" then
			target = storeModel:FindFirstChild("Register")
		elseif storeModel and step.Target == "Unit" then
			local unit = storeModel:FindFirstChild("Unit1")
			target = unit and unit:FindFirstChild("Back")
		end
		setBeamTarget(target)
		local navButton = step.Nav and hud.NavButtons[step.Nav]
		if navButton then
			local token = pulseToken
			task.spawn(function()
				local angle = 6
				while token == pulseToken do
					Kit.Tween(navButton, { Rotation = angle }, 0.35, Enum.EasingStyle.Sine)
					angle = -angle
					task.wait(0.35)
				end
				navButton.Rotation = 0
			end)
		end
	end
	player.CharacterAdded:Connect(function()
		task.wait(1)
		if State.Data then
			hud.UpdateTutorial(State.Data, true)
		end
	end)

	Remotes:WaitForChild("Tutorial").OnClientEvent:Connect(function(kind)
		if kind == "CustomerWaiting" and State.Data and State.Data.Tutorial == 1 then
			hud.Toast("A customer is waiting at your register! Press E to ring them up.", "good")
		end
	end)

	---------------------------------------------------------------------
	-- Floating "+$" text and checkout bursts (rendered locally)
	---------------------------------------------------------------------
	Remotes:WaitForChild("Floating").OnClientEvent:Connect(function(position, text, color, burstColors)
		local camera = workspace.CurrentCamera
		if not camera or (camera.CFrame.Position - position).Magnitude > 140 then
			return
		end
		local anchor = Instance.new("Part")
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.Position = position
		anchor.Parent = workspace.Terrain
		local gui = new("BillboardGui", { Parent = anchor, Size = UDim2.new(0, 220, 0, 40), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 0, 0), LightInfluence = 0 })
		local label = Kit.Text({ Parent = gui, Size = UDim2.fromScale(1, 1), Text = text, Font = Kit.Fonts.Display, TextSize = 26, TextColor3 = color, TextStrokeTransparency = 0.3, TextXAlignment = Enum.TextXAlignment.Center })
		Kit.Tween(gui, { StudsOffset = Vector3.new(0, 4, 0) }, 1.4)
		task.delay(0.8, function()
			Kit.Tween(label, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.6)
		end)
		if burstColors and #burstColors > 0 and not (State.Data and State.Data.Settings.LowGraphics) then
			local keypoints = {}
			for i, c in ipairs(burstColors) do
				table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / math.max(1, #burstColors - 1), c))
			end
			if #keypoints == 1 then
				table.insert(keypoints, ColorSequenceKeypoint.new(1, burstColors[1]))
			end
			local emitter = new("ParticleEmitter", {
				Parent = anchor, Rate = 0, Lifetime = NumberRange.new(0.6, 1.2), Speed = NumberRange.new(8, 16),
				SpreadAngle = Vector2.new(180, 180), Color = ColorSequence.new(keypoints), LightEmission = 0.6,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
				Acceleration = Vector3.new(0, -25, 0), Drag = 2,
			})
			emitter:Emit(28)
		end
		Debris:AddItem(anchor, 2.5)
	end)

	---------------------------------------------------------------------
	-- Refresh from state
	---------------------------------------------------------------------
	function hud.Update(data)
		targetCash = data.Cash
		if shownCash == 0 then
			shownCash = data.Cash
			cashLabel.Text = Util.Money(data.Cash)
		end
		levelLabel.Text = ("Level %d%s"):format(data.Level, data.Title ~= "" and ("  ·  " .. data.Title) or "")
		xpFill.Size = UDim2.new(math.clamp(data.Xp / math.max(1, data.XpNeed), 0, 1), 0, 1, 0)
		ratingLabel.Text = ("%s %.1f  (%d reviews)"):format(Util.Stars(data.Rating.Value), data.Rating.Value, data.Rating.Count)
		-- red dots: rewards waiting
		local dailyReady = data.Daily.LastDay ~= data.Daily.Today
		local challengeReady = false
		for _, ch in ipairs(data.Challenges) do
			if ch.Progress >= ch.Goal and not ch.Claimed then
				challengeReady = true
			end
		end
		hud.Dots.Daily.Visible = dailyReady or challengeReady
		hud.UpdateTutorial(data)
	end

	return hud
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Journal</string><ProtectedString name="Source"><![CDATA[-- The collection book: mysteries, products, customers, events, achievements.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))
local CustomerTypes = require(Shared:WaitForChild("CustomerTypes"))
local Events = require(Shared:WaitForChild("Events"))
local Achievements = require(Shared:WaitForChild("Achievements"))
local Util = require(Shared:WaitForChild("Util"))

local Journal = {}

function Journal.Build(Kit, State)
	local C = Kit.Colors
	local new = Kit.new
	local panel = Kit.Panel("Journal", "MYSTERY JOURNAL", 760, 540)
	local list = Kit.Scroll(panel.Body, UDim2.new(1, 0, 1, -48), UDim2.new(0, 0, 0, 48))
	local tab = "Mysteries"

	local function header(text, sub, order)
		local card = Kit.Card(list, order or 0)
		Kit.Text({ Parent = card, Text = text, Font = Kit.Fonts.Display, TextSize = 18, TextColor3 = C.Amber, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
		if sub then
			Kit.Text({ Parent = card, Text = sub, TextSize = 14, TextColor3 = C.Muted, Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 0), AutoY = true })
			new("Frame", { Parent = card, Size = UDim2.new(0, 0, 0, 44), BackgroundTransparency = 1 })
		end
	end

	local function grid(order, cellHeight)
		local frame = new("Frame", { Parent = list, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
		new("UIGridLayout", { Parent = frame, CellSize = UDim2.new(0.5, -6, 0, cellHeight), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
		return frame
	end

	local function tile(parent, order, title, titleColor, sub, swatch)
		local card = new("Frame", { Parent = parent, LayoutOrder = order, BackgroundColor3 = C.Card }, { Kit.Corner(10), Kit.Pad(8), Kit.Stroke(C.Stroke, 0.75) })
		local x = 0
		if swatch then
			new("Frame", { Parent = card, Size = UDim2.new(0, 28, 0, 28), BackgroundColor3 = swatch }, { Kit.Corner(6) })
			x = 36
		end
		Kit.Text({ Parent = card, Text = title, Font = Kit.Fonts.Bold, TextSize = 15, TextColor3 = titleColor, Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x, 0, 18), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		Kit.Text({ Parent = card, Text = sub, TextSize = 12, TextColor3 = C.Muted, Position = UDim2.new(0, x, 0, 20), Size = UDim2.new(1, -x, 1, -20) })
		return card
	end

	local function line(order, swatch, title, titleColor, sub)
		local card = Kit.Card(list, order)
		new("Frame", { Parent = card, Size = UDim2.new(0, 32, 0, 32), BackgroundColor3 = swatch }, { Kit.Corner(8) })
		Kit.Text({ Parent = card, Text = title, Font = Kit.Fonts.Bold, TextSize = 16, TextColor3 = titleColor, Position = UDim2.new(0, 44, 0, 0), Size = UDim2.new(1, -44, 0, 20) })
		Kit.Text({ Parent = card, Text = sub, TextSize = 13, TextColor3 = C.Muted, Position = UDim2.new(0, 44, 0, 22), Size = UDim2.new(1, -44, 0, 0), AutoY = true })
		new("Frame", { Parent = card, Size = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1 })
	end

	local function num(n)
		return Util.Money(n):sub(2)
	end

	local function render()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(list)
		if tab == "Mysteries" then
			local solved = 0
			for _, m in ipairs(data.Journal) do
				if m.Solved then
					solved = solved + 1
				end
			end
			header(("Mysteries solved: %d / %d"):format(solved, #data.Journal), "Clues come from customer chats, odd objects around town (some only at night), places at special times, and patterns over many nights. Some take several days.", 0)
			for i, m in ipairs(data.Journal) do
				local card = Kit.Card(list, i)
				Kit.List(nil, 6).Parent = card
				local status = m.Solved and "  ✓ SOLVED" or ("  %d/%d clues"):format(m.Found, m.Total)
				Kit.Text({ Parent = card, LayoutOrder = 0, Text = m.Name .. status, Font = Kit.Fonts.Display, TextSize = 18, TextColor3 = m.Solved and C.Good or (m.Found > 0 and C.Teal or C.Text), Size = UDim2.new(1, 0, 0, 0), AutoY = true })
				if m.Locked then
					Kit.Text({ Parent = card, LayoutOrder = 1, Text = "🔒 " .. m.Locked, TextSize = 14, TextColor3 = C.Muted, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
				else
					for j, clue in ipairs(m.Clues) do
						local text, color
						if clue.Found then
							text, color = "✓  " .. clue.Text, C.Text
						elseif clue.Hint then
							text, color = "→  Next lead: " .. clue.Hint, C.Teal
						else
							text, color = "•  ???", C.Locked
						end
						Kit.Text({ Parent = card, LayoutOrder = j, Text = text, TextSize = 14, TextColor3 = color, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
					end
				end
				if m.Reward then
					Kit.Text({ Parent = card, LayoutOrder = 99, Text = "Reward: " .. m.Reward, TextSize = 14, Font = Kit.Fonts.Bold, TextColor3 = C.Amber, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
				end
			end
		elseif tab == "Products" then
			local found = Util.Count(data.Products)
			header(("Products discovered: %d / %d"):format(found, #Products.List), "Order a product for the first time to add it here. Rare ones only appear during special nights, rain, or mysteries.", 0)
			local g = grid(1, 58)
			for _, p in ipairs(Products.List) do
				local sold = data.Products[p.Id]
				if sold ~= nil then
					tile(g, p.Order, p.Name, Products.RarityColors[p.Rarity], ("%s · %s · sold %d"):format(p.Rarity, p.Category, sold), p.Color)
				else
					tile(g, p.Order, "???", C.Locked, p.Rarity == "Secret" and "Secret product" or (p.Event and "Appears on a special night" or (p.Weather and "Appears in the rain" or ("Unlocks at level " .. p.Level))), Color3.fromRGB(45, 48, 65))
				end
			end
		elseif tab == "Customers" then
			header(("Customers met: %d / %d"):format(Util.Count(data.Customers), #CustomerTypes.List), "Serve someone to learn who they are. Some only appear at night, in the rain, or when a story begins.", 0)
			local g = grid(1, 74)
			for i, t in ipairs(CustomerTypes.List) do
				local served = data.Customers[t.Id]
				if served then
					tile(g, i, t.Name .. (t.Mystery and "  ✦" or ""), t.Mystery and C.Purple or C.Text, ("%s  Served %d."):format(t.Desc, served), t.Shirt)
				else
					tile(g, i, "???", C.Locked, CustomerTypes.Hint(t), Color3.fromRGB(45, 48, 65))
				end
			end
		elseif tab == "Events" then
			header(("Night events seen: %d / %d"):format(Util.Count(data.EventsSeen), #Events.Night), "A random event may roll every night for the whole server.", 0)
			for i, e in ipairs(Events.Night) do
				if data.EventsSeen[e.Id] then
					local desc = (e.Desc:gsub("%%s", "a random category"))
					line(i, e.Color, e.Name, e.Color, desc)
				else
					line(i, Color3.fromRGB(45, 48, 65), "??? Unknown event", C.Locked, "Keep your store open at night to witness it.")
				end
			end
		elseif tab == "Achievements" then
			local got = Util.Count(data.Achievements)
			header(("Achievements: %d / %d"):format(got, #Achievements.List), nil, 0)
			for i, a in ipairs(Achievements.List) do
				local card = Kit.Card(list, i)
				local value = data.StatValues[a.Stat] or 0
				local done = data.Achievements[a.Id] ~= nil
				Kit.Text({ Parent = card, Text = (done and "✓ " or "") .. a.Name, Font = Kit.Fonts.Bold, TextSize = 16, TextColor3 = done and C.Good or C.Text, Size = UDim2.new(1, -120, 0, 20) })
				Kit.Text({ Parent = card, Text = Util.Money(a.Reward), Font = Kit.Fonts.Bold, TextSize = 15, TextColor3 = C.Amber, Position = UDim2.new(1, -110, 0, 0), Size = UDim2.new(0, 110, 0, 20), TextXAlignment = Enum.TextXAlignment.Right })
				Kit.Text({ Parent = card, Text = a.Desc, TextSize = 13, TextColor3 = C.Muted, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 18) })
				local bar = Kit.Bar(card, value / a.Goal, done and C.Good or C.Amber, 8)
				bar.Position = UDim2.new(0, 0, 0, 46)
				bar.Size = UDim2.new(1, -110, 0, 8)
				Kit.Text({ Parent = card, Text = ("%s / %s"):format(num(math.min(value, a.Goal)), num(a.Goal)), TextSize = 12, TextColor3 = C.Muted, Position = UDim2.new(1, -100, 0, 40), Size = UDim2.new(0, 100, 0, 18), TextXAlignment = Enum.TextXAlignment.Right })
				new("Frame", { Parent = card, Size = UDim2.new(0, 0, 0, 58), BackgroundTransparency = 1 })
			end
		end
	end

	local tabs = Kit.Tabs(panel.Body, {
		{ "Mysteries", "Mysteries" }, { "Products", "Products" }, { "Customers", "Customers" },
		{ "Events", "Night Events" }, { "Achievements", "Achievements" },
	}, function(id)
		tab = id
		render()
	end)
	panel.OnOpen = function()
		tabs.Select(tab)
	end

	local queued = false
	State.On(function()
		if Kit.IsOpen("Journal") and not queued then
			queued = true
			task.delay(1, function()
				queued = false
				if Kit.IsOpen("Journal") then
					render()
				end
			end)
		end
	end)
end

return Journal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[-- UI kit: colors, fonts and reusable components so every menu looks and
-- behaves the same. Works with mouse, touch and gamepad (all buttons are
-- Selectable for console navigation).
local TweenService = game:GetService("TweenService")

local Kit = {}

Kit.Colors = {
	Panel = Color3.fromRGB(16, 18, 30),
	PanelLight = Color3.fromRGB(28, 31, 48),
	Card = Color3.fromRGB(34, 38, 58),
	Stroke = Color3.fromRGB(80, 90, 130),
	Text = Color3.fromRGB(240, 238, 232),
	Muted = Color3.fromRGB(160, 165, 185),
	Amber = Color3.fromRGB(255, 192, 92), -- the glow of the open-store sign
	Teal = Color3.fromRGB(90, 220, 200),
	Good = Color3.fromRGB(110, 225, 140),
	Bad = Color3.fromRGB(240, 100, 100),
	Locked = Color3.fromRGB(70, 74, 95),
	Purple = Color3.fromRGB(200, 130, 255),
}
local C = Kit.Colors

Kit.Fonts = {
	Display = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
}

function Kit.Tween(obj, props, seconds, style)
	local t = TweenService:Create(obj, TweenInfo.new(seconds or 0.2, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

function Kit.new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local new = Kit.new

function Kit.Corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Kit.Stroke(color, transparency, thickness)
	return new("UIStroke", { Color = color or C.Stroke, Transparency = transparency or 0.5, Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Kit.Pad(px)
	return new("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end

function Kit.List(dir, gap, align)
	return new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})
end

function Kit.Text(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or C.Text
	props.Font = props.Font or Kit.Fonts.Body
	props.TextSize = props.TextSize or 16
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextWrapped = props.TextWrapped ~= false
	if props.AutoY then
		props.AutoY = nil
		props.AutomaticSize = Enum.AutomaticSize.Y
	end
	return new("TextLabel", props)
end

-- Button with hover/press feedback. style: "primary" | "secondary" | "good" | "locked" | Color3
function Kit.Button(props, onClick, style)
	local base = C.Amber
	local textColor = Color3.fromRGB(30, 22, 10)
	if style == "secondary" then
		base, textColor = C.PanelLight, C.Text
	elseif style == "good" then
		base, textColor = C.Good, Color3.fromRGB(10, 30, 15)
	elseif style == "locked" then
		base, textColor = C.Locked, C.Muted
	elseif typeof(style) == "Color3" then
		base, textColor = style, C.Text
	end
	props.BackgroundColor3 = base
	props.TextColor3 = props.TextColor3 or textColor
	props.Font = props.Font or Kit.Fonts.Bold
	props.TextSize = props.TextSize or 16
	props.AutoButtonColor = false
	props.Selectable = true
	local button = new("TextButton", props, { Kit.Corner(10) })
	local scale = new("UIScale", { Parent = button })
	local hover = base:Lerp(Color3.new(1, 1, 1), 0.12)
	button.MouseEnter:Connect(function()
		Kit.Tween(button, { BackgroundColor3 = hover }, 0.12)
	end)
	button.MouseLeave:Connect(function()
		Kit.Tween(button, { BackgroundColor3 = base }, 0.12)
		Kit.Tween(scale, { Scale = 1 }, 0.1)
	end)
	button.SelectionGained:Connect(function()
		Kit.Tween(button, { BackgroundColor3 = hover }, 0.12)
	end)
	button.SelectionLost:Connect(function()
		Kit.Tween(button, { BackgroundColor3 = base }, 0.12)
	end)
	button.MouseButton1Down:Connect(function()
		Kit.Tween(scale, { Scale = 0.95 }, 0.06)
	end)
	button.MouseButton1Up:Connect(function()
		Kit.Tween(scale, { Scale = 1 }, 0.1)
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function Kit.Scroll(parent, size, position)
	local scroll = new("ScrollingFrame", {
		Parent = parent, Size = size or UDim2.fromScale(1, 1), Position = position or UDim2.new(),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.Stroke, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, Selectable = false,
	}, { Kit.List(nil, 8), new("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) }) })
	return scroll
end

function Kit.Card(parent, order, height)
	return new("Frame", {
		Parent = parent, LayoutOrder = order or 0, BackgroundColor3 = C.Card,
		Size = UDim2.new(1, 0, 0, height or 0), AutomaticSize = height and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
	}, { Kit.Corner(12), Kit.Pad(12), Kit.Stroke(C.Stroke, 0.75) })
end

function Kit.Bar(parent, fraction, color, height)
	local back = new("Frame", { Parent = parent, Size = UDim2.new(1, 0, 0, height or 8), BackgroundColor3 = C.Panel, BorderSizePixel = 0 }, { Kit.Corner(99) })
	local fill = new("Frame", { Parent = back, Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0), BackgroundColor3 = color or C.Amber, BorderSizePixel = 0 }, { Kit.Corner(99) })
	return back, fill
end

function Kit.Clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end
end

-- Row of tab buttons. tabs = { {Id, Label}, ... }; onSelect(id)
function Kit.Tabs(parent, tabs, onSelect)
	local row = new("ScrollingFrame", {
		Parent = parent, Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(), Selectable = false,
	}, { Kit.List(Enum.FillDirection.Horizontal, 6) })
	local buttons = {}
	local current = nil
	local api = {}
	function api.Select(id)
		current = id
		for tabId, b in pairs(buttons) do
			b.BackgroundColor3 = tabId == id and C.Amber or C.PanelLight
			b.TextColor3 = tabId == id and Color3.fromRGB(30, 22, 10) or C.Text
		end
		onSelect(id)
	end
	function api.Current()
		return current
	end
	for i, tab in ipairs(tabs) do
		local b = new("TextButton", {
			Parent = row, LayoutOrder = i, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, -4),
			BackgroundColor3 = C.PanelLight, TextColor3 = C.Text, Font = Kit.Fonts.Bold, TextSize = 15, Text = tab[2],
			AutoButtonColor = true, Selectable = true,
		}, { Kit.Corner(10), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
		b.Activated:Connect(function()
			api.Select(tab[1])
		end)
		buttons[tab[1]] = b
	end
	api.Row = row
	return api
end

---------------------------------------------------------------------------
-- Panels (modal windows). One open at a time; B / the X button closes.
---------------------------------------------------------------------------
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

Kit.Root = nil -- ScreenGui, set by the controller
Kit.Panels = {}
Kit.OpenId = nil
Kit.OnPanelChanged = function() end

function Kit.Panel(id, title, width, height)
	local root = new("CanvasGroup", {
		Name = id, Parent = Kit.Root, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.new(0, width or 640, 0, height or 460), BackgroundColor3 = C.Panel, BackgroundTransparency = 0.04,
		Visible = false, GroupTransparency = 1, ZIndex = 20,
	}, { Kit.Corner(18), Kit.Stroke(C.Amber, 0.6, 1.5) })
	local scale = new("UIScale", { Parent = root, Scale = 0.94 })
	local header = new("Frame", { Parent = root, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.PanelLight, BorderSizePixel = 0 })
	Kit.Text({ Parent = header, Text = title, Font = Kit.Fonts.Display, TextSize = 24, TextColor3 = C.Amber, Position = UDim2.new(0, 20, 0, 0), Size = UDim2.new(1, -90, 1, 0), TextWrapped = false })
	local close = Kit.Button({ Parent = header, Text = "X", Size = UDim2.new(0, 40, 0, 40), Position = UDim2.new(1, -50, 0, 8), TextSize = 18 }, function()
		Kit.Close()
	end, "secondary")
	local body = new("Frame", { Parent = root, Position = UDim2.new(0, 16, 0, 66), Size = UDim2.new(1, -32, 1, -78), BackgroundTransparency = 1 })
	local panel = { Id = id, Root = root, Body = body, Scale = scale, CloseButton = close, OnOpen = nil }
	Kit.Panels[id] = panel
	return panel
end

function Kit.Open(id)
	if Kit.OpenId == id then
		Kit.Close()
		return
	end
	Kit.Close(true)
	local panel = Kit.Panels[id]
	if not panel then
		return
	end
	Kit.OpenId = id
	panel.Root.Visible = true
	panel.Root.GroupTransparency = 1
	panel.Scale.Scale = 0.94
	Kit.Tween(panel.Root, { GroupTransparency = 0 }, 0.18)
	Kit.Tween(panel.Scale, { Scale = 1 }, 0.22, Enum.EasingStyle.Back)
	if panel.OnOpen then
		task.spawn(panel.OnOpen)
	end
	if UserInputService.GamepadEnabled then
		task.defer(function()
			for _, d in ipairs(panel.Body:GetDescendants()) do
				if d:IsA("GuiButton") and d.Visible and d.Selectable then
					GuiService.SelectedObject = d
					return
				end
			end
			GuiService.SelectedObject = panel.CloseButton
		end)
	end
	Kit.OnPanelChanged(id)
end

function Kit.Close(instant)
	local panel = Kit.OpenId and Kit.Panels[Kit.OpenId]
	Kit.OpenId = nil
	if panel then
		if instant then
			panel.Root.Visible = false
		else
			local t = Kit.Tween(panel.Root, { GroupTransparency = 1 }, 0.14)
			Kit.Tween(panel.Scale, { Scale = 0.96 }, 0.14)
			t.Completed:Connect(function()
				if Kit.OpenId ~= panel.Id then
					panel.Root.Visible = false
				end
			end)
		end
		if panel.OnClose then
			task.spawn(panel.OnClose)
		end
	end
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(Kit.Root) then
		GuiService.SelectedObject = nil
	end
	Kit.OnPanelChanged(nil)
end

function Kit.IsOpen(id)
	return Kit.OpenId == id
end

Kit.Toast = function() end -- replaced by the HUD
return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[-- Order Stock, Backroom inventory and Upgrades panels.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Products = require(Shared:WaitForChild("Products"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))
local Util = require(Shared:WaitForChild("Util"))
local WorldState = ReplicatedStorage:WaitForChild("WorldState")

local Menus = {}

function Menus.Build(Kit, State)
	local C = Kit.Colors
	local new = Kit.new

	-- A list row: color swatch, title, subtitle, action button
	local function row(parent, order, swatch, title, titleColor, subtitle, buttonText, buttonStyle, onClick)
		local card = Kit.Card(parent, order)
		if swatch then
			new("Frame", { Parent = card, Size = UDim2.new(0, 36, 0, 36), BackgroundColor3 = swatch }, { Kit.Corner(8) })
		end
		local x = swatch and 48 or 0
		Kit.Text({ Parent = card, Text = title, Font = Kit.Fonts.Bold, TextSize = 17, TextColor3 = titleColor or C.Text, Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x - 170, 0, 20), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		Kit.Text({ Parent = card, Text = subtitle, TextSize = 13, TextColor3 = C.Muted, Position = UDim2.new(0, x, 0, 22), Size = UDim2.new(1, -x - 170, 0, 0), AutoY = true })
		if buttonText then
			Kit.Button({ Parent = card, Text = buttonText, Size = UDim2.new(0, 156, 0, 38), Position = UDim2.new(1, -156, 0, 0), TextSize = 14, TextWrapped = true }, onClick, buttonStyle)
		end
		new("Frame", { Parent = card, Size = UDim2.new(0, 0, 0, 38), BackgroundTransparency = 1 })
		return card
	end
	Menus.Row = row

	---------------------------------------------------------------------
	-- ORDER STOCK
	---------------------------------------------------------------------
	local order = Kit.Panel("Order", "ORDER STOCK", 720, 520)
	local qty = 10
	local qtyRow = new("Frame", { Parent = order.Body, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.new(0, 0, 0, 46), BackgroundTransparency = 1 }, { Kit.List(Enum.FillDirection.Horizontal, 6) })
	Kit.Text({ Parent = qtyRow, LayoutOrder = 0, Text = "Quantity:", Font = Kit.Fonts.Bold, Size = UDim2.new(0, 80, 1, 0), TextYAlignment = Enum.TextYAlignment.Center })
	local qtyButtons = {}
	local orderList
	local renderOrder
	for i, n in ipairs({ 1, 5, 10, 25, 50 }) do
		qtyButtons[n] = Kit.Button({ Parent = qtyRow, LayoutOrder = i, Text = "x" .. n, Size = UDim2.new(0, 56, 1, 0) }, function()
			qty = n
			renderOrder()
		end, "secondary")
	end
	local hint = Kit.Text({ Parent = qtyRow, LayoutOrder = 10, Text = "", TextSize = 13, TextColor3 = C.Muted, Size = UDim2.new(0, 260, 1, 0), TextYAlignment = Enum.TextYAlignment.Center })
	orderList = Kit.Scroll(order.Body, UDim2.new(1, 0, 1, -92), UDim2.new(0, 0, 0, 92))

	local category = "All"
	local function inTab(p)
		if category == "All" then
			return true
		elseif category == "Special" then
			return p.Rarity == "Rare" or p.Rarity == "Legendary" or p.Rarity == "Secret"
		end
		return p.Category == category and p.Rarity ~= "Secret"
	end

	renderOrder = function()
		local data = State.Data
		if not data then
			return
		end
		for n, b in pairs(qtyButtons) do
			b.BackgroundColor3 = n == qty and C.Amber or C.PanelLight
			b.TextColor3 = n == qty and Color3.fromRGB(30, 22, 10) or C.Text
		end
		local discount = data.Effects.StockDiscount or 0
		hint.Text = discount > 0 and ("Bulk discount: -%d%%"):format(math.floor(discount * 100 + 0.5)) or ""
		Kit.Clear(orderList)
		local ctx = { Level = data.Level, Secrets = data.Secrets, EventId = WorldState:GetAttribute("EventId"), Weather = WorldState:GetAttribute("Weather") }
		local n = 0
		for _, p in ipairs(Products.List) do
			if inTab(p) then
				n = n + 1
				local ok, reason = Products.CanOrder(p, ctx)
				if p.Secret and not ok then
					row(orderList, 1000 + n, Color3.fromRGB(60, 50, 80), "??? Secret product", Products.RarityColors.Secret, "Uncover a mystery to unlock this.", nil)
				else
					local cost = math.ceil(p.Cost * qty * (1 - discount))
					local have = data.Inventory[p.Id] or 0
					local limited = (p.Event or p.Weather) and "  ·  LIMITED TIME" or ""
					local sub = ("%s  ·  Wholesale %s → Sells %s  ·  Backroom: %d  ·  %s%s"):format(p.Rarity, Util.Money(p.Cost), Util.Money(p.Price), have, p.Cold and "Cooler" or "Shelf", limited)
					local title = p.Name .. (data.Products[p.Id] == nil and "  (new!)" or "")
					if ok then
						row(orderList, n, p.Color, title, Products.RarityColors[p.Rarity], sub, ("Buy x%d  %s"):format(qty, Util.Money(cost)), data.Cash >= cost and nil or "locked", function()
							State.Act("BuyStock", { Product = p.Id, Qty = qty }, Kit)
						end)
					else
						row(orderList, 500 + n, p.Color, title, C.Muted, sub, reason, "locked", nil)
					end
				end
			end
		end
	end

	local tabs = Kit.Tabs(order.Body, {
		{ "All", "All" }, { "Snacks", "Snacks" }, { "Drinks", "Drinks" }, { "Instant", "Instant" },
		{ "Sweets", "Sweets" }, { "Household", "Household" }, { "Special", "Rare & Secret" },
	}, function(id)
		category = id
		renderOrder()
	end)
	order.OnOpen = function()
		tabs.Select(category)
	end

	---------------------------------------------------------------------
	-- BACKROOM (inventory)
	---------------------------------------------------------------------
	local inv = Kit.Panel("Inventory", "BACKROOM STOCK", 620, 480)
	local invList = Kit.Scroll(inv.Body)
	local function renderInventory()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(invList)
		local stockedSlots, openSlots = 0, 0
		for unit = 1, 12 do
			if math.ceil(unit / 3) <= data.Effects.Expansion then
				for slot = 1, 4 do
					openSlots = openSlots + 1
					local e = data.Shelves["u" .. unit .. "s" .. slot]
					if e and e.Q > 0 then
						stockedSlots = stockedSlots + 1
					end
				end
			end
		end
		local summary = Kit.Card(invList, 0)
		Kit.Text({ Parent = summary, Text = ("Shelf slots stocked: %d / %d   ·   Items per slot: %d"):format(stockedSlots, openSlots, data.Effects.SlotCapacity), Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 0), AutoY = true })
		Kit.Text({ Parent = summary, Text = "Walk to a shelf or cooler and press E to stock it from here.", TextColor3 = C.Muted, TextSize = 14, Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, -150, 0, 0), AutoY = true })
		Kit.Button({ Parent = summary, Text = "Order more", Size = UDim2.new(0, 130, 0, 34), Position = UDim2.new(1, -130, 0, 20) }, function()
			Kit.Open("Order")
		end)
		new("Frame", { Parent = summary, Size = UDim2.new(0, 0, 0, 56), BackgroundTransparency = 1 })
		local ids = {}
		for id, count in pairs(data.Inventory) do
			if count > 0 and Products.ById[id] then
				table.insert(ids, id)
			end
		end
		table.sort(ids, function(a, b)
			return Products.ById[a].Order < Products.ById[b].Order
		end)
		if #ids == 0 then
			row(invList, 1, nil, "Your backroom is empty", C.Muted, "Order stock to keep your shelves full.", nil)
		end
		for i, id in ipairs(ids) do
			local p = Products.ById[id]
			row(invList, i, p.Color, ("%s  x%d"):format(p.Name, data.Inventory[id]), Products.RarityColors[p.Rarity], ("Goes on a %s  ·  Sells for %s"):format(p.Cold and "cooler" or "shelf", Util.Money(p.Price)), nil)
		end
	end
	inv.OnOpen = renderInventory

	---------------------------------------------------------------------
	-- UPGRADES
	---------------------------------------------------------------------
	local up = Kit.Panel("Upgrades", "STORE UPGRADES", 720, 520)
	local upList = Kit.Scroll(up.Body, UDim2.new(1, 0, 1, -48), UDim2.new(0, 0, 0, 48))
	local branch = "Shelves"
	local function renderUpgrades()
		local data = State.Data
		if not data then
			return
		end
		Kit.Clear(upList)
		local owned = Util.Count(data.Upgrades)
		local head = Kit.Card(upList, 0)
		Kit.Text({ Parent = head, Text = ("Installed: %d / %d upgrades"):format(owned, #Upgrades.List), Font = Kit.Fonts.Bold, Size = UDim2.new(1, 0, 0, 20) })
		for _, u in ipairs(Upgrades.List) do
			if u.Branch == branch then
				local sub = ("%s  ·  Level %d  ·  %s%s"):format(u.Desc, u.Level, Util.Money(u.Cost), u.Requires and ("  ·  Needs " .. Upgrades.ById[u.Requires].Name) or "")
				if data.Upgrades[u.Id] then
					row(upList, u.Order, nil, u.Name, C.Good, sub, "Installed ✓", "good", nil)
				elseif u.Requires and not data.Upgrades[u.Requires] then
					row(upList, u.Order, nil, u.Name, C.Muted, sub, "Locked", "locked", nil)
				elseif data.Level < u.Level then
					row(upList, u.Order, nil, u.Name, C.Muted, sub, "Level " .. u.Level, "locked", nil)
				else
					row(upList, u.Order, nil, u.Name, C.Amber, sub, "Buy " .. Util.Money(u.Cost), data.Cash >= u.Cost and nil or "locked", function()
						State.Act("BuyUpgrade", { Id = u.Id }, Kit)
					end)
				end
			end
		end
	end
	local upTabs = {}
	for _, b in ipairs(Upgrades.Branches) do
		table.insert(upTabs, { b, b })
	end
	local upgradeTabs = Kit.Tabs(up.Body, upTabs, function(id)
		branch = id
		renderUpgrades()
	end)
	up.OnOpen = function()
		upgradeTabs.Select(branch)
	end

	-- Live refresh while open (throttled so lists don't flicker during rushes)
	local queued = false
	State.On(function()
		if queued then
			return
		end
		queued = true
		task.delay(0.8, function()
			queued = false
			if Kit.IsOpen("Order") then
				renderOrder()
			elseif Kit.IsOpen("Inventory") then
				renderInventory()
			elseif Kit.IsOpen("Upgrades") then
				renderUpgrades()
			end
		end)
	end)
	WorldState.AttributeChanged:Connect(function()
		if Kit.IsOpen("Order") then
			renderOrder()
		end
	end)
end

return Menus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Client-side copy of the player's state (sent by the server) + a helper to
-- make validated requests. The client never decides money or items; it only
-- asks the server and shows the answer.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Unlocks = require(Shared:WaitForChild("Unlocks"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RequestRemote = Remotes:WaitForChild("Request")

local State = { Data = nil }
local listeners = {}

function State.On(callback)
	table.insert(listeners, callback)
	if State.Data then
		task.spawn(callback, State.Data)
	end
end

local function set(data)
	if not data then
		return
	end
	State.Data = data
	for _, callback in ipairs(listeners) do
		task.spawn(callback, data)
	end
end

Remotes:WaitForChild("State").OnClientEvent:Connect(set)

-- Returns { ok = bool, msg = string?, ... }
function State.Request(action, payload)
	local ok, result = pcall(function()
		return RequestRemote:InvokeServer(action, payload)
	end)
	if not ok or type(result) ~= "table" then
		return { ok = false, msg = "Connection hiccup. Try again." }
	end
	return result
end

-- Request + show the server's message as a toast
function State.Act(action, payload, Kit)
	local result = State.Request(action, payload)
	if result.msg and result.msg ~= "" and Kit then
		Kit.Toast(result.msg, result.ok and "good" or "bad")
	end
	return result
end

function State.UnlockContext()
	local d = State.Data
	if not d then
		return {}
	end
	return {
		Level = d.Level, Achievements = d.Achievements, Solved = d.Solved, Robux = d.Owned.Robux,
		Month = d.Month, SeasonUnlocks = d.SeasonUnlocks, BestStreak = d.Daily.BestStreak,
	}
end

function State.IsUnlocked(rules)
	return Unlocks.Check(rules, State.UnlockContext())
end

task.spawn(function()
	local result = State.Request("GetState", {})
	if result.ok and result.State and not State.Data then
		set(result.State)
	end
end)

return State
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX0000002D"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[-- Boots the whole interface. Lives inside the MainUI ScreenGui (ResetOnSpawn
-- off) so menus persist across respawns.
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local gui = script.Parent
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.ResetOnSpawn = false

local Kit = require(gui:WaitForChild("Kit"))
local State = require(gui:WaitForChild("State"))
Kit.Root = gui

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- Responsive scale: designed for 1280x720, scaled for phones and TVs,
-- multiplied by the player's Interface size setting.
local scale = Instance.new("UIScale")
scale.Parent = gui
local function rescale()
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local base = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.4)
	local user = State.Data and State.Data.Settings.UIScale or 1
	scale.Scale = base * user
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

local Hud = require(gui:WaitForChild("Hud"))
local hud = Hud.Build(Kit, State)
require(gui:WaitForChild("Menus")).Build(Kit, State)
require(gui:WaitForChild("Journal")).Build(Kit, State)
require(gui:WaitForChild("Customize")).Build(Kit, State)
require(gui:WaitForChild("Extras")).Build(Kit, State)
require(gui:WaitForChild("Dialogs")).Build(Kit, State)

State.On(function(data)
	hud.Update(data)
	rescale()
end)

-- Keyboard shortcuts + gamepad
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local panel = hud.Keys[input.KeyCode]
	if panel then
		Kit.Open(panel)
	elseif input.KeyCode == Enum.KeyCode.ButtonB and Kit.OpenId then
		Kit.Close()
	elseif input.KeyCode == Enum.KeyCode.ButtonY then
		-- jump straight into the nav bar on console
		if GuiService.SelectedObject then
			GuiService.SelectedObject = nil
		else
			GuiService.SelectedObject = hud.NavButtons.Order
		end
	end
end)

-- On console, show a hint for opening the menu bar
if UserInputService.GamepadEnabled then
	Kit.Toast("Press Y to use the menu bar, B to close menus.", "info")
end
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000033"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000032"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000031"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX00000030"><Properties><string name="Name">Atmosphere</string><ProtectedString name="Source"><![CDATA[-- Local-only atmosphere: rain that follows the camera, lightning flashes in
-- storms, flickering neon, sliding automatic doors, the spinning lighthouse,
-- bobbing shooting stars, the lucky cat's wave, optional ambience audio, and
-- the player's graphics settings. Nothing here affects gameplay.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local WorldState = ReplicatedStorage:WaitForChild("WorldState")

local settings = { Rain = true, LowGraphics = false, Bubbles = true, Volume = 0.5 }

Remotes:WaitForChild("State").OnClientEvent:Connect(function(state)
	if state and state.Settings then
		settings = state.Settings
	end
end)

---------------------------------------------------------------------------
-- Rain
---------------------------------------------------------------------------
local rainPart = Instance.new("Part")
rainPart.Name = "LocalRain"
rainPart.Anchored = true
rainPart.CanCollide = false
rainPart.CanQuery = false
rainPart.CanTouch = false
rainPart.Transparency = 1
rainPart.Size = Vector3.new(150, 1, 150)
rainPart.Parent = workspace.Terrain

local rain = Instance.new("ParticleEmitter")
rain.Texture = "rbxasset://textures/particles/sparkles_main.dds"
rain.EmissionDirection = Enum.NormalId.Bottom
rain.Orientation = Enum.ParticleOrientation.VelocityParallel
rain.Speed = NumberRange.new(90, 110)
rain.Lifetime = NumberRange.new(0.7, 0.9)
rain.Size = NumberSequence.new(0.12)
rain.Squash = NumberSequence.new(2.5)
rain.Transparency = NumberSequence.new(0.35)
rain.Color = ColorSequence.new(Color3.fromRGB(190, 210, 240))
rain.LightEmission = 0.2
rain.LightInfluence = 1
rain.Rate = 0
rain.Parent = rainPart

local flash = Instance.new("ColorCorrectionEffect")
flash.Name = "LocalLightning"
flash.Brightness = 0
flash.Parent = Lighting

local function weather()
	return WorldState:GetAttribute("Weather")
end

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if camera then
		rainPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 45, 0))
	end
end)

task.spawn(function()
	while true do
		local w = weather()
		local enabled = settings.Rain and not settings.LowGraphics
		local rate = 0
		if enabled and w == "Rain" then
			rate = 450
		elseif enabled and w == "Storm" then
			rate = 1000
		end
		rain.Rate = rate
		if enabled and w == "Storm" and math.random() < 0.06 then
			flash.Brightness = 0.55
			TweenService:Create(flash, TweenInfo.new(0.35), { Brightness = 0 }):Play()
			task.wait(0.12)
			flash.Brightness = 0.35
			TweenService:Create(flash, TweenInfo.new(0.5), { Brightness = 0 }):Play()
		end
		-- graphics setting: glow effects
		local bloom = Lighting:FindFirstChild("LOSBloom")
		if bloom then
			bloom.Enabled = not settings.LowGraphics
		end
		task.wait(1)
	end
end)

---------------------------------------------------------------------------
-- Flickering neon (tagged by the server)
---------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(0.15)
		if not settings.LowGraphics then
			local tagged = CollectionService:GetTagged("Flicker")
			if #tagged > 0 and math.random() < 0.35 then
				local target = tagged[math.random(1, #tagged)]
				local light = target:FindFirstChildOfClass("SurfaceLight")
				local original = target.Transparency
				target.Transparency = math.min(1, original + 0.6)
				if light then
					light.Enabled = false
				end
				task.wait(math.random(4, 12) / 100)
				target.Transparency = original
				if light then
					light.Enabled = true
				end
			end
		end
	end
end)

---------------------------------------------------------------------------
-- Automatic sliding doors
---------------------------------------------------------------------------
local doors = {} -- [part] = { Closed = CFrame, Open = bool }
local function trackDoor(door)
	doors[door] = { Closed = door.CFrame, Open = false }
end
for _, d in ipairs(CollectionService:GetTagged("AutoDoor")) do
	trackDoor(d)
end
CollectionService:GetInstanceAddedSignal("AutoDoor"):Connect(trackDoor)
CollectionService:GetInstanceRemovedSignal("AutoDoor"):Connect(function(d)
	doors[d] = nil
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		local positions = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(positions, root.Position)
			end
		end
		local customers = workspace:FindFirstChild("Customers")
		if customers then
			for _, npc in ipairs(customers:GetChildren()) do
				local root = npc:FindFirstChild("HumanoidRootPart")
				if root then
					table.insert(positions, root.Position)
				end
			end
		end
		for door, info in pairs(doors) do
			if door.Parent then
				local near = false
				for _, pos in ipairs(positions) do
					if (pos - info.Closed.Position).Magnitude < 10 then
						near = true
						break
					end
				end
				if near ~= info.Open then
					info.Open = near
					local side = door:GetAttribute("Side") or 1
					local goal = near and (info.Closed * CFrame.new(side * 4.4, 0, 0)) or info.Closed
					TweenService:Create(door, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { CFrame = goal }):Play()
				end
			end
		end
	end
end)

---------------------------------------------------------------------------
-- Spinning lighthouse, bobbing stars, waving lucky cat
---------------------------------------------------------------------------
local spinners = {}
for _, p in ipairs(CollectionService:GetTagged("Spin")) do
	spinners[p] = p.CFrame
end
CollectionService:GetInstanceAddedSignal("Spin"):Connect(function(p)
	spinners[p] = p.CFrame
end)

local wavers = {}
local function trackWave(p)
	wavers[p] = p.CFrame
end
for _, p in ipairs(CollectionService:GetTagged("Wave")) do
	trackWave(p)
end
CollectionService:GetInstanceAddedSignal("Wave"):Connect(trackWave)
CollectionService:GetInstanceRemovedSignal("Wave"):Connect(function(p)
	wavers[p] = nil
end)

local stars = {}
local function watchTown(town)
	town.ChildAdded:Connect(function(child)
		if child:GetAttribute("Bob") then
			stars[child] = child.Position
		end
	end)
end
local town = workspace:WaitForChild("Town", 30)
if town then
	watchTown(town)
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for part, base in pairs(spinners) do
		if part.Parent then
			part.CFrame = base * CFrame.Angles(0, t * 0.8, 0)
		else
			spinners[part] = nil
		end
	end
	for part, base in pairs(stars) do
		if part.Parent then
			part.CFrame = CFrame.new(base + Vector3.new(0, math.sin(t * 3) * 0.6, 0)) * CFrame.Angles(0, t * 2, 0)
		else
			stars[part] = nil
		end
	end
	for part, base in pairs(wavers) do
		if part.Parent then
			part.CFrame = base * CFrame.Angles(math.sin(t * 6) * 0.5, 0, 0)
		else
			wavers[part] = nil
		end
	end
end)

---------------------------------------------------------------------------
-- Customer speech bubbles setting
---------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(1)
		local customers = workspace:FindFirstChild("Customers")
		if customers then
			for _, gui in ipairs(customers:GetDescendants()) do
				if gui:IsA("BillboardGui") and gui.Name == "CustomerGui" then
					local bubble = gui:FindFirstChild("Bubble")
					if bubble and not settings.Bubbles then
						bubble.Visible = false
					end
				end
			end
		end
	end
end)

---------------------------------------------------------------------------
-- Optional ambience (only if sound IDs are configured)
---------------------------------------------------------------------------
local sounds = {}
for key, id in pairs(Config.Audio) do
	if id ~= "" and key ~= "Register" then
		local s = Instance.new("Sound")
		s.Name = "Ambience_" .. key
		s.SoundId = id
		s.Looped = true
		s.Volume = 0
		s.Parent = SoundService
		pcall(function()
			s:Play()
		end)
		sounds[key] = s
	end
end
if next(sounds) then
	task.spawn(function()
		while true do
			local night = WorldState:GetAttribute("Night")
			local w = weather()
			local volume = settings.Volume or 0.5
			local targets = {
				Rain = (w == "Rain" or w == "Storm") and volume or 0,
				NightAmbience = night and volume * 0.6 or 0,
				DayAmbience = (not night) and volume * 0.6 or 0,
			}
			for key, s in pairs(sounds) do
				TweenService:Create(s, TweenInfo.new(2), { Volume = targets[key] or 0 }):Play()
			end
			task.wait(2)
		end
	end)
end

]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
