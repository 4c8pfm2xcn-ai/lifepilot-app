<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX0000000E"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000D"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Achievements</string><ProtectedString name="Source"><![CDATA[-- 25 achievements. Stat values are computed by ProgressionService:
-- Served, Earned, Stocked, FiveStars, ProductsFound, CustomersMet, Clues,
-- Mysteries, Nights, Expansion, UpgradesOwned, Stars, Visits, Level, BestRating
local Achievements = {}
Achievements.List = {
	{ Id = "served1", Name = "First Customer", Desc = "Serve your very first customer.", Stat = "Served", Goal = 1, Reward = 50 },
	{ Id = "served25", Name = "Regulars", Desc = "Serve 25 customers.", Stat = "Served", Goal = 25, Reward = 200 },
	{ Id = "served100", Name = "Local Favorite", Desc = "Serve 100 customers. Unlocks the Mint Fresh theme.", Stat = "Served", Goal = 100, Reward = 600 },
	{ Id = "served500", Name = "Neighborhood Hero", Desc = "Serve 500 customers.", Stat = "Served", Goal = 500, Reward = 2500 },
	{ Id = "served2000", Name = "Legend of the Night", Desc = "Serve 2,000 customers.", Stat = "Served", Goal = 2000, Reward = 10000 },
	{ Id = "earned1k", Name = "First Thousand", Desc = "Earn $1,000 in sales.", Stat = "Earned", Goal = 1000, Reward = 150 },
	{ Id = "earned10k", Name = "Small Business", Desc = "Earn $10,000. Unlocks the Confetti effect.", Stat = "Earned", Goal = 10000, Reward = 800 },
	{ Id = "earned100k", Name = "Tycoon of the Block", Desc = "Earn $100,000.", Stat = "Earned", Goal = 100000, Reward = 5000 },
	{ Id = "earned1m", Name = "Millionaire Mart", Desc = "Earn $1,000,000.", Stat = "Earned", Goal = 1000000, Reward = 25000 },
	{ Id = "stocked100", Name = "Shelf Stacker", Desc = "Stock 100 items.", Stat = "Stocked", Goal = 100, Reward = 150 },
	{ Id = "stocked2000", Name = "Restock Royalty", Desc = "Stock 2,000 items.", Stat = "Stocked", Goal = 2000, Reward = 3000 },
	{ Id = "fivestar10", Name = "Five Stars!", Desc = "Get 10 five-star reviews.", Stat = "FiveStars", Goal = 10, Reward = 300 },
	{ Id = "fivestar100", Name = "Critically Acclaimed", Desc = "Get 100 five-star reviews.", Stat = "FiveStars", Goal = 100, Reward = 4000 },
	{ Id = "products10", Name = "Collector's Start", Desc = "Discover 10 products.", Stat = "ProductsFound", Goal = 10, Reward = 200 },
	{ Id = "products30", Name = "Well Stocked", Desc = "Discover 30 products.", Stat = "ProductsFound", Goal = 30, Reward = 1500 },
	{ Id = "products50", Name = "Complete Catalog", Desc = "Discover all 50 products.", Stat = "ProductsFound", Goal = 50, Reward = 20000 },
	{ Id = "customers10", Name = "People Person", Desc = "Meet 10 types of customers.", Stat = "CustomersMet", Goal = 10, Reward = 500 },
	{ Id = "customers20", Name = "Everyone's Welcome", Desc = "Meet all 20 types of customers.", Stat = "CustomersMet", Goal = 20, Reward = 8000 },
	{ Id = "clue1", Name = "Something's Odd", Desc = "Find your first mystery clue.", Stat = "Clues", Goal = 1, Reward = 150 },
	{ Id = "mystery1", Name = "Case Closed", Desc = "Solve a mystery.", Stat = "Mysteries", Goal = 1, Reward = 1000 },
	{ Id = "mystery5", Name = "Keeper of Secrets", Desc = "Solve all 5 mysteries.", Stat = "Mysteries", Goal = 5, Reward = 15000 },
	{ Id = "nights10", Name = "Night Owl", Desc = "Keep your store open through 10 nights.", Stat = "Nights", Goal = 10, Reward = 800 },
	{ Id = "expansion4", Name = "Night Market", Desc = "Fully expand your store.", Stat = "Expansion", Goal = 4, Reward = 5000 },
	{ Id = "stars20", Name = "Star Catcher", Desc = "Catch 20 shooting stars.", Stat = "Stars", Goal = 20, Reward = 1500 },
	{ Id = "visits10", Name = "Good Neighbor", Desc = "Visit 10 other players' stores.", Stat = "Visits", Goal = 10, Reward = 1000 },
}
Achievements.ById = {}
for _, a in ipairs(Achievements.List) do
	Achievements.ById[a.Id] = a
end
return Achievements
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Challenges</string><ProtectedString name="Source"><![CDATA[-- Daily challenge pool. Each UTC day every player gets 3, picked with a
-- per-player seed. Keys are progress events fired by the server.
local Challenges = {}
Challenges.List = {
	{ Id = "serve15", Desc = "Serve 15 customers", Key = "Served", Goal = 15, Reward = 300 },
	{ Id = "serve40", Desc = "Serve 40 customers", Key = "Served", Goal = 40, Reward = 800 },
	{ Id = "snacks10", Desc = "Sell 10 snacks", Key = "Sold_Snacks", Goal = 10, Reward = 250 },
	{ Id = "drinks12", Desc = "Sell 12 drinks", Key = "Sold_Drinks", Goal = 12, Reward = 250 },
	{ Id = "sweets10", Desc = "Sell 10 sweets", Key = "Sold_Sweets", Goal = 10, Reward = 250 },
	{ Id = "instant8", Desc = "Sell 8 instant foods", Key = "Sold_Instant", Goal = 8, Reward = 300 },
	{ Id = "earn1500", Desc = "Earn $1,500 in sales", Key = "Earned", Goal = 1500, Reward = 400 },
	{ Id = "stock60", Desc = "Stock 60 items on shelves", Key = "Stocked", Goal = 60, Reward = 300 },
	{ Id = "fivestar3", Desc = "Get 3 five-star reviews", Key = "FiveStars", Goal = 3, Reward = 350 },
	{ Id = "night20", Desc = "Make 20 sales at night", Key = "NightSales", Goal = 20, Reward = 400 },
	{ Id = "visit1", Desc = "Visit another player's store", Key = "Visits", Goal = 1, Reward = 200 },
	{ Id = "fast5", Desc = "Ring up 5 customers within 4 seconds", Key = "FastCheckout", Goal = 5, Reward = 350 },
}
Challenges.ById = {}
for _, c in ipairs(Challenges.List) do
	Challenges.ById[c.Id] = c
end
return Challenges
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- The Last Open Store: global tuning. Every number that shapes the game lives
-- here (or in the catalog modules next to it), so balancing never requires
-- touching gameplay code.
local Config = {}

Config.GameName = "The Last Open Store"
Config.Debug = false -- true prints detailed [LOS] logs in the Output window

---------------------------------------------------------------------------
-- Saving
---------------------------------------------------------------------------
Config.DataStoreName = "LastOpenStore_Player_v1"
Config.LeaderboardEarned = "LastOpenStore_TopEarned_v1"
Config.LeaderboardRating = "LastOpenStore_TopRating_v1"
Config.SessionLockTimeout = 600 -- a lock older than this is considered abandoned
Config.AutosaveInterval = 90

---------------------------------------------------------------------------
-- Economy
---------------------------------------------------------------------------
Config.StartingCash = 150
Config.StartingInventory = { chips = 6, cola = 6, gummy = 4 } -- in the backroom (shelves start stocked too)
Config.MaxLevel = 50
Config.MaxOrderQuantity = 100

function Config.XpForLevel(level)
	-- XP needed to go from `level` to `level + 1`
	return math.floor(60 * level ^ 1.6)
end

---------------------------------------------------------------------------
-- World
---------------------------------------------------------------------------
Config.PlotCount = 6 -- set Max Players to 6 in Game Settings

-- Day/night: one full 24h cycle takes this many real minutes
Config.DayLengthMinutes = 12
Config.NightStart = 18.5
Config.NightEnd = 5.5
Config.StartClockTime = 17.2
Config.NightEventChance = 0.7

---------------------------------------------------------------------------
-- Customers
---------------------------------------------------------------------------
Config.CustomerSpawnInterval = 8 -- seconds between customers per store, before bonuses
Config.NightCustomerBonus = 1.25 -- it's the last open store: nights are busier
Config.MaxCustomersPerStore = 3
Config.GlobalCustomerCap = 30
Config.MysteryCustomerChance = 0.07
Config.ReviewChance = 0.4
Config.Pedestrians = 4
Config.NPCWalkSpeed = 11

-- Roblox's default R15 animations (owned by Roblox, usable in any game)
Config.NPCAnimations = {
	Walk = "rbxassetid://507777826",
	Idle = "rbxassetid://507766388",
}

---------------------------------------------------------------------------
-- Shelves
---------------------------------------------------------------------------
Config.SlotsPerUnit = 4
Config.BaseSlotCapacity = 8
Config.StockInteractDistance = 16

---------------------------------------------------------------------------
-- Daily rewards (7-day streak). Day 7 also unlocks the Hearts checkout effect.
---------------------------------------------------------------------------
Config.DailyRewards = { 100, 150, 250, 350, 500, 700, 1200 }
Config.DailyChallengesPerDay = 3
Config.FriendVisitBonus = 75

---------------------------------------------------------------------------
-- Optional audio. Paste sound asset IDs you own (or free ones from the
-- Creator Store) to enable ambience. Empty = no sound and no volume setting.
---------------------------------------------------------------------------
Config.Audio = {
	Rain = "",
	NightAmbience = "",
	DayAmbience = "",
	Register = "",
}

---------------------------------------------------------------------------
-- Optional Robux cosmetics. Create Developer Products in the Creator
-- Dashboard and paste their IDs. ProductId 0 = not for sale (the item is
-- still earnable through gameplay). Nothing here affects gameplay power.
---------------------------------------------------------------------------
Config.RobuxProducts = {
	{ Key = "ThemeGalaxy", ProductId = 0, Name = "Galaxy Store Theme", Grant = { Kind = "Theme", Id = "Galaxy" } },
	{ Key = "ThemeSnowfall", ProductId = 0, Name = "Snowfall Store Theme", Grant = { Kind = "Theme", Id = "Snowfall" } },
	{ Key = "UniformStarlight", ProductId = 0, Name = "Starlight Uniform", Grant = { Kind = "Uniform", Id = "Starlight" } },
	{ Key = "UniformRoyal", ProductId = 0, Name = "Royal Uniform", Grant = { Kind = "Uniform", Id = "Royal" } },
	{ Key = "EffectRainbow", ProductId = 0, Name = "Rainbow Checkout Effect", Grant = { Kind = "Effect", Id = "Rainbow" } },
	{ Key = "DecorKoi", ProductId = 0, Name = "Neon Koi Sign", Grant = { Kind = "Decor", Id = "KoiSign" } },
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[-- Store customization catalog: 10 themes, uniforms, decor, checkout effects,
-- shelf layouts and sign colors. Every item is earnable through gameplay;
-- some can ALSO be bought with Robux (see Config.RobuxProducts).
-- Unlock rules are "any of" lists, checked by Unlocks.lua.
local Cosmetics = {}
local C = Color3.fromRGB
local M = Enum.Material

local FREE = { { Type = "Free" } }

Cosmetics.Themes = {
	{ Id = "Classic", Name = "Classic Mart", Unlock = FREE,
		Wall = C(235, 232, 222), WallMat = M.SmoothPlastic, Floor = C(200, 200, 205), FloorMat = M.Marble,
		Trim = C(40, 110, 200), Neon = C(255, 200, 80), Shelf = C(230, 230, 235), Exterior = C(220, 215, 205), Roof = C(70, 75, 85), Sign = C(40, 110, 200) },
	{ Id = "NeonNight", Name = "Midnight Neon", Unlock = { { Type = "Level", Level = 5 } },
		Wall = C(30, 30, 50), WallMat = M.SmoothPlastic, Floor = C(25, 25, 35), FloorMat = M.Glass,
		Trim = C(255, 60, 200), Neon = C(0, 240, 255), Shelf = C(45, 45, 70), Exterior = C(35, 35, 55), Roof = C(20, 20, 30), Sign = C(255, 60, 200) },
	{ Id = "CozyWood", Name = "Cozy Wood", Unlock = { { Type = "Level", Level = 8 } },
		Wall = C(190, 150, 110), WallMat = M.WoodPlanks, Floor = C(130, 90, 60), FloorMat = M.Wood,
		Trim = C(90, 60, 40), Neon = C(255, 180, 90), Shelf = C(150, 105, 70), Exterior = C(120, 85, 60), Roof = C(70, 50, 40), Sign = C(90, 60, 40) },
	{ Id = "Mint", Name = "Mint Fresh", Unlock = { { Type = "Achievement", Id = "served100" } },
		Wall = C(210, 245, 230), WallMat = M.SmoothPlastic, Floor = C(240, 250, 245), FloorMat = M.Marble,
		Trim = C(60, 190, 150), Neon = C(120, 255, 200), Shelf = C(250, 255, 252), Exterior = C(190, 235, 220), Roof = C(60, 130, 110), Sign = C(60, 190, 150) },
	{ Id = "Retro", Name = "Retro Diner", Unlock = { { Type = "Level", Level = 12 } },
		Wall = C(250, 240, 220), WallMat = M.SmoothPlastic, Floor = C(30, 30, 30), FloorMat = M.Pavement,
		Trim = C(220, 40, 50), Neon = C(255, 80, 90), Shelf = C(200, 210, 220), Exterior = C(240, 70, 70), Roof = C(60, 60, 70), Sign = C(220, 40, 50) },
	{ Id = "Sakura", Name = "Sakura Night", Unlock = { { Type = "Streak", Days = 7 }, { Type = "Level", Level = 18 } },
		Wall = C(255, 225, 235), WallMat = M.SmoothPlastic, Floor = C(220, 190, 200), FloorMat = M.Wood,
		Trim = C(230, 110, 150), Neon = C(255, 150, 200), Shelf = C(255, 240, 245), Exterior = C(240, 200, 215), Roof = C(120, 60, 80), Sign = C(230, 110, 150) },
	{ Id = "Postal", Name = "Old Post Office", Unlock = { { Type = "Mystery", Id = "letters" } },
		Wall = C(170, 60, 50), WallMat = M.Brick, Floor = C(110, 80, 60), FloorMat = M.WoodPlanks,
		Trim = C(30, 60, 40), Neon = C(255, 210, 120), Shelf = C(120, 90, 60), Exterior = C(150, 55, 45), Roof = C(40, 50, 45), Sign = C(30, 60, 40) },
	{ Id = "Clockwork", Name = "Clockwork", Unlock = { { Type = "Mystery", Id = "clock" } },
		Wall = C(90, 70, 50), WallMat = M.Metal, Floor = C(60, 50, 40), FloorMat = M.DiamondPlate,
		Trim = C(200, 150, 60), Neon = C(255, 190, 90), Shelf = C(150, 110, 60), Exterior = C(80, 65, 50), Roof = C(50, 40, 30), Sign = C(200, 150, 60) },
	{ Id = "Snowfall", Name = "Snowfall", Unlock = { { Type = "Season", Month = 12 }, { Type = "Level", Level = 22 }, { Type = "Robux", Key = "ThemeSnowfall" } },
		Wall = C(235, 245, 255), WallMat = M.Ice, Floor = C(220, 235, 250), FloorMat = M.Glacier,
		Trim = C(120, 170, 230), Neon = C(170, 220, 255), Shelf = C(250, 252, 255), Exterior = C(225, 235, 250), Roof = C(250, 250, 255), Sign = C(120, 170, 230) },
	{ Id = "Galaxy", Name = "Galaxy", Unlock = { { Type = "Level", Level = 26 }, { Type = "Robux", Key = "ThemeGalaxy" } },
		Wall = C(20, 15, 50), WallMat = M.Glass, Floor = C(10, 10, 30), FloorMat = M.Glass,
		Trim = C(140, 90, 255), Neon = C(200, 120, 255), Shelf = C(40, 30, 80), Exterior = C(25, 20, 60), Roof = C(10, 10, 25), Sign = C(140, 90, 255) },
}

-- Apron colors worn by the shopkeeper
Cosmetics.Uniforms = {
	{ Id = "Classic", Name = "Classic Blue", Color = C(40, 110, 200), Unlock = FREE },
	{ Id = "NightShift", Name = "Night Shift", Color = C(30, 30, 40), Unlock = { { Type = "Level", Level = 3 } } },
	{ Id = "Mint", Name = "Mint Apron", Color = C(90, 210, 170), Unlock = { { Type = "Level", Level = 6 } } },
	{ Id = "Retro", Name = "Retro Red", Color = C(210, 40, 50), Unlock = { { Type = "Level", Level = 10 } } },
	{ Id = "Tailor", Name = "Tailor's Vest", Color = C(120, 80, 140), Unlock = { { Type = "Mystery", Id = "buttons" } } },
	{ Id = "Harvest", Name = "Harvest Orange", Color = C(240, 140, 40), Unlock = { { Type = "Season", Month = 10 }, { Type = "Level", Level = 20 } } },
	{ Id = "Starlight", Name = "Starlight", Color = C(250, 240, 180), Neon = true, Unlock = { { Type = "Level", Level = 28 }, { Type = "Robux", Key = "UniformStarlight" } } },
	{ Id = "Royal", Name = "Royal Purple", Color = C(110, 50, 180), Neon = true, Unlock = { { Type = "Level", Level = 35 }, { Type = "Robux", Key = "UniformRoyal" } } },
}

-- Decorations live in fixed spots in the store. Cash ones are a cash sink;
-- buying one is permanent. Toggle them on/off any time.
Cosmetics.Decor = {
	{ Id = "Plant", Name = "Potted Plant", Price = 300, Unlock = FREE },
	{ Id = "Calendar", Name = "Cat Calendar", Price = 500, Unlock = FREE },
	{ Id = "Bench", Name = "Front Bench", Price = 900, Unlock = { { Type = "Level", Level = 3 } } },
	{ Id = "StringLights", Name = "String Lights", Price = 800, Unlock = { { Type = "Level", Level = 4 } } },
	{ Id = "Gumball", Name = "Gumball Machine", Price = 1200, Unlock = { { Type = "Level", Level = 5 } } },
	{ Id = "FishTank", Name = "Fish Tank", Price = 2500, Unlock = { { Type = "Level", Level = 8 }, { Type = "Mystery", Id = "lighthouse" } } },
	{ Id = "LuckyCat", Name = "Waving Lucky Cat", Price = 3000, Unlock = { { Type = "Level", Level = 10 } } },
	{ Id = "Arcade", Name = "Arcade Cabinet", Price = 4000, Unlock = { { Type = "Level", Level = 12 } } },
	{ Id = "RoofSign", Name = "Rooftop 'OPEN 24/7' Sign", Price = 6000, Unlock = { { Type = "Level", Level = 14 } } },
	{ Id = "Portrait", Name = "Founder's Portrait", Price = 0, Unlock = { { Type = "Mystery", Id = "founder" } } },
	{ Id = "KoiSign", Name = "Neon Koi Sign", Price = 0, Unlock = { { Type = "Level", Level = 30 }, { Type = "Robux", Key = "DecorKoi" } } },
}

-- Particle burst when you ring up a customer
Cosmetics.Effects = {
	{ Id = "None", Name = "None", Unlock = FREE, Colors = {} },
	{ Id = "Coins", Name = "Coin Shower", Unlock = FREE, Colors = { C(255, 210, 60), C(255, 240, 150) } },
	{ Id = "Sparkles", Name = "Sparkles", Unlock = { { Type = "Level", Level = 4 } }, Colors = { C(200, 230, 255), C(255, 255, 255) } },
	{ Id = "Hearts", Name = "Hearts", Unlock = { { Type = "Streak", Days = 7 } }, Colors = { C(255, 90, 140), C(255, 170, 200) } },
	{ Id = "Confetti", Name = "Confetti", Unlock = { { Type = "Achievement", Id = "earned10k" } }, Colors = { C(255, 80, 80), C(80, 200, 255), C(255, 220, 60), C(120, 255, 120) } },
	{ Id = "Rainbow", Name = "Rainbow Burst", Unlock = { { Type = "Level", Level = 24 }, { Type = "Robux", Key = "EffectRainbow" } }, Colors = { C(255, 60, 60), C(255, 160, 40), C(255, 240, 60), C(60, 220, 90), C(60, 140, 255), C(170, 80, 255) } },
}

-- Shelf arrangements (all keep the checkout lane clear)
Cosmetics.Layouts = {
	{ Id = "Classic", Name = "Classic Rows", Unlock = FREE },
	{ Id = "TwinAisles", Name = "Twin Aisles", Unlock = { { Type = "Level", Level = 4 } } },
	{ Id = "MarketHall", Name = "Market Hall", Unlock = { { Type = "Level", Level = 9 } } },
}

Cosmetics.SignColors = {
	C(40, 110, 200), C(220, 40, 50), C(60, 190, 150), C(255, 170, 40),
	C(170, 80, 255), C(255, 90, 160), C(30, 30, 40), C(240, 240, 240),
}

local function index(list)
	local map = {}
	for _, item in ipairs(list) do
		map[item.Id] = item
	end
	return map
end

Cosmetics.ThemeById = index(Cosmetics.Themes)
Cosmetics.UniformById = index(Cosmetics.Uniforms)
Cosmetics.DecorById = index(Cosmetics.Decor)
Cosmetics.EffectById = index(Cosmetics.Effects)
Cosmetics.LayoutById = index(Cosmetics.Layouts)

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">CustomerTypes</string><ProtectedString name="Source"><![CDATA[-- 20 customer personalities. 15 everyday types + 5 mysterious ones whose
-- visits feed the mystery system.
--
-- Patience   seconds they'll wait in line (before upgrades)
-- Budget     {min, max} dollars they'll spend
-- Items      {min, max} different products they want
-- Prefers    categories they look for (Collector looks for rarities instead)
-- Flexible   buys something else if their favorites are missing
-- PriceMult  how much extra they pay; TipChance / Tip = tipping habits
-- Spawn      Time ("Any"/"Day"/"Night"), Weather, HourMin/HourMax, RequiresClue
local CustomerTypes = {}
local C = Color3.fromRGB

CustomerTypes.List = {
	{ Id = "neighbor", Name = "Friendly Neighbor", Desc = "Pops in every day for a little of everything.",
		Shirt = C(90, 140, 200), Pants = C(60, 60, 80), Patience = 30, Budget = { 10, 40 }, Items = { 1, 3 },
		Prefers = { "Snacks", "Drinks", "Sweets", "Instant" }, Flexible = true, PriceMult = 1, TipChance = 0.1, Tip = 0.1,
		Spawn = { Time = "Any" }, Weight = 14, Speed = 1,
		Lines = { Enter = { "Evening! Just grabbing a few things.", "Hi again!" }, Happy = { "Thanks, see you tomorrow!", "Always a pleasure." }, Sad = { "Maybe next time...", "Hmm, out of stock." }, Good = { "My favorite little shop.", "Friendly and quick!" }, Bad = { "Took a while today.", "Shelves were a bit empty." } } },
	{ Id = "office", Name = "Office Worker", Desc = "Needs caffeine and a quick lunch, fast.",
		Shirt = C(240, 240, 245), Pants = C(40, 45, 60), Patience = 20, Budget = { 15, 45 }, Items = { 1, 2 },
		Prefers = { "Drinks", "Instant" }, Flexible = false, PriceMult = 1.05, TipChance = 0.05, Tip = 0.1,
		Spawn = { Time = "Day" }, Weight = 10, Speed = 1.15,
		Lines = { Enter = { "Five minutes till my meeting!", "Coffee. Please." }, Happy = { "Lifesaver!", "Back to work..." }, Sad = { "No time for this.", "I'll try the gas station." }, Good = { "Fast service, great coffee.", "Perfect lunch stop." }, Bad = { "Too slow for a lunch break.", "Didn't have what I needed." } } },
	{ Id = "student", Name = "Student", Desc = "Tight budget, big appetite for snacks.",
		Shirt = C(255, 180, 60), Pants = C(70, 90, 140), Patience = 30, Budget = { 6, 18 }, Items = { 1, 3 },
		Prefers = { "Snacks", "Sweets", "Instant" }, Flexible = true, PriceMult = 1, TipChance = 0.03, Tip = 0.05,
		Spawn = { Time = "Any" }, Weight = 10, Speed = 1.05,
		Lines = { Enter = { "Study snacks, go!", "Is there a student discount? Kidding." }, Happy = { "Fuel for the exam!", "Thanks!!" }, Sad = { "Guess it's plain rice tonight.", "Aww." }, Good = { "Cheap snacks, cool vibes.", "Best late-night study stop." }, Bad = { "Waited forever.", "Nothing in my budget." } } },
	{ Id = "commuter", Name = "Impatient Commuter", Desc = "Hates waiting. Tips big if you're quick.",
		Shirt = C(120, 120, 130), Pants = C(30, 30, 35), Patience = 12, Budget = { 10, 35 }, Items = { 1, 2 },
		Prefers = { "Drinks", "Snacks" }, Flexible = true, PriceMult = 1, TipChance = 0.5, Tip = 0.3, FastTipOnly = true,
		Spawn = { Time = "Any" }, Weight = 8, Speed = 1.3,
		Lines = { Enter = { "My train leaves in three minutes!", "Quick quick quick." }, Happy = { "Made it! Keep the change.", "Speedy, love it." }, Sad = { "Forget it, I'm late!", "Too slow!" }, Good = { "In and out in seconds!", "Fastest store in town." }, Bad = { "Missed my train.", "Way too slow." } } },
	{ Id = "nightowl", Name = "Night Owl", Desc = "Only comes out after dark. Loves ramen and cold drinks.",
		Shirt = C(60, 50, 110), Pants = C(30, 30, 50), Patience = 35, Budget = { 15, 50 }, Items = { 1, 3 },
		Prefers = { "Instant", "Drinks" }, Flexible = true, PriceMult = 1.1, TipChance = 0.15, Tip = 0.15,
		Spawn = { Time = "Night" }, Weight = 12, Speed = 0.95,
		Lines = { Enter = { "Glad someone's still open.", "The night's just getting started." }, Happy = { "You're a legend.", "See you at 3 AM." }, Sad = { "Even the last open store is empty...", "Hm." }, Good = { "The only light on this street.", "Perfect midnight ramen." }, Bad = { "Lonely shelves tonight.", "Slow queue." } } },
	{ Id = "collector", Name = "Collector", Desc = "Hunts rare products and pays double for them.",
		Shirt = C(110, 80, 60), Pants = C(60, 50, 40), Patience = 40, Budget = { 40, 160 }, Items = { 1, 2 },
		Prefers = {}, Rarities = { "Rare", "Legendary", "Secret" }, Flexible = false, PriceMult = 2, TipChance = 0.2, Tip = 0.2,
		Spawn = { Time = "Any" }, Weight = 4, Speed = 0.9,
